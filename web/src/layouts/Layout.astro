                ➕ NUEVO MODELO EN STUDIO
              </a>
            </div>
            <div id="inv-drafts-list" style="max-height: 440px; overflow-y: auto; display: flex; flex-direction: column; gap: 0.65rem;">
              <!-- Dynamic list of drafts -->
            </div>
          </div>

          <!-- TAB 2: FAVORITES -->
          <div class="inv-tab-panel hidden" id="inv-panel-favorites">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
