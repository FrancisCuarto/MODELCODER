        </div>

        <div class="auth-modal-body">
          <div class="auth-tabs">
            <button type="button" class="auth-tab active" data-tab="oauth">OAUTH GITHUB</button>
            <button type="button" class="auth-tab" data-tab="login">INICIAR SESIÓN</button>
            <button type="button" class="auth-tab" data-tab="signup">REGISTRARSE</button>
          </div>

          <!-- TAB 1: GITHUB OAUTH -->
          <div class="auth-tab-panel" id="tab-oauth">
            <p class="auth-desc">Identifícate con tu cuenta de GitHub para guardar tus configuraciones y sincronizar tus modelos procedurales en la nube.</p>
