              <!-- Dynamic list of collections -->
            </div>
          </div>
        </div>
      </div>
    </div>

    <footer class="site-footer">
      <div class="footer-container">
        <!-- Columna 1: Marca & Propósito -->
        <div class="footer-col footer-col-brand">
          <div class="footer-brand-header">
            <img src="/logo.png" alt="ModelCoder Logo" class="footer-brand-logo" width="36" height="36" />
            <div class="footer-brand-text">
              <span class="footer-brand-title">[ MODELCODER ]</span>
              <span class="footer-brand-tagline">HERRAMIENTA PROCEDURAL 3D</span>
