      // THEME MANAGER (Light Editorial default, Dark, System, Retro PS1)
      (function initThemeToggle() {
        const storageKey = 'modelcoder-theme';
        const options = document.querySelectorAll('.theme-option');
        const root = document.documentElement;
        const mql = window.matchMedia('(prefers-color-scheme: dark)');
        const forcedTheme = (window as any).__MODELCODER_FORCE_THEME__ as string | undefined;

        const getStored = () => localStorage.getItem(storageKey) || 'light';

        function applyTheme(raw: string) {
          let resolved = raw;
          if (raw === 'system') {
            resolved = mql.matches ? 'dark' : 'light';
          }
          if (resolved !== 'light' && resolved !== 'dark' && resolved !== 'dark-professional' && resolved !== 'ps1') {
            resolved = 'light';
          }
          if (!forcedTheme) {
            root.setAttribute('data-theme', resolved);
          }
          try {
            localStorage.setItem(storageKey, raw);
          } catch (e) {}
          options.forEach((btn) => {
            const choice = btn.getAttribute('data-theme-choice');
            const isActive = choice === raw;
            btn.setAttribute('aria-checked', isActive ? 'true' : 'false');
            const check = btn.querySelector('.theme-check');
            if (check) check.textContent = isActive ? '●' : '○';
          });
        }

        applyTheme(getStored());

        options.forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const choice = btn.getAttribute('data-theme-choice');
            if (choice) {
              applyTheme(choice);
              navMoreMenu?.classList.add('hidden');
              navMoreContainer?.classList.remove('open');
              btnToggleNavMore?.setAttribute('aria-expanded', 'false');
            }
          });
        });

        mql.addEventListener('change', () => {
          if (getStored() === 'system') {
            applyTheme('system');
          }
        });
      })();

      document.addEventListener('click', () => {
        userDropdownMenu?.classList.add('hidden');
        navMoreMenu?.classList.add('hidden');
        navMoreContainer?.classList.remove('open');
