---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Biblioteca abierta de generadores procedurales 3D para Below Nominal" } = Astro.props;
import catalog from '../data/catalog.json';
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | ModelCoder PS1 3D Platform</title>

    <!-- Retro PS1 / Bitmap Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Share+Tech+Mono&family=Silkscreen:wght@400;700&family=VT323&display=swap" rel="stylesheet">

    <!-- Google Model Viewer Web Component -->
    <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>
  </head>
  <body>
    <!-- CRT Scanlines Overlay -->
    <div class="ps1-scanlines" aria-hidden="true"></div>

    <header class="site-header">
      <div class="header-container">
        <a href="/" class="brand-logo" title="ModelCoder — Generadores 3D Procedurales por IV Orbit Games">
          <img src="/logo.png" alt="Logo de ModelCoder" class="brand-logo-img" width="30" height="30" />
          <span class="brand-bracket">[</span>
          <span class="brand-name">MODELCODER</span>
          <span class="brand-bracket">]</span>
          <span class="brand-badge">MODELOS 3D</span>
        </a>

        <div class="system-status-indicator" title="Modelos 3D disponibles para personalizar y descargar">
          <span class="status-dot"></span>
          <span id="header-models-count" class="status-text">{catalog.length} MODELOS DISPONIBLES</span>
        </div>

        <nav class="nav-links">
          <a href="/" class="nav-link">&gt; Catálogo</a>
          <a href="/studio" class="nav-link nav-link-studio" style="color: var(--ps1-gold); border-color: var(--ps1-gold);">&gt; Studio 3D (Crear)</a>
          <button id="btn-open-global-inventory" class="nav-link nav-link-inventory" type="button" title="Mi Inventario: Borradores, Favoritos y Colecciones">
            🎒 Inventario (<span id="global-inv-count">0</span>)
          </button>
          <a href="/contribute" class="nav-link">&gt; Cómo funciona</a>
          <a href="/colaboradores" id="nav-collab-link" class="nav-link nav-link-collab" style="display: none; color: var(--ps1-gold); border-color: var(--ps1-gold);" title="Portal privado de colaboradores">
            👑 Colaboradores
          </a>
          <a href="https://ivorbitgames.online" target="_blank" rel="noopener noreferrer" class="nav-link nav-link-creator" title="Estudio Creador: IV Orbit Games (Argentina)">
            🪐 IV Orbit
          </a>
          <a href="https://github.com/FrancisCuarto/MODELCODER" target="_blank" rel="noopener noreferrer" class="nav-link nav-link-gh" title="Ver código fuente en GitHub">
            &gt; GitHub
          </a>

          <!-- User Authentication Widget -->
          <div id="user-auth-root" class="user-auth-container">
            <button id="btn-open-auth" class="ps1-btn-auth" type="button" title="Acceso de Usuario">
              <span class="auth-icon">👤</span>
              <span class="auth-label">&gt; Acceder</span>
            </button>

            <div id="user-logged-box" class="user-logged-pill hidden">
              <button id="user-profile-btn" class="user-profile-trigger" type="button" aria-haspopup="menu">
                <span class="user-avatar-tag">👾</span>
                <span id="user-display-name" class="user-display-name">PILOTO</span>
                <span class="user-caret">▼</span>
              </button>
              <div id="user-dropdown-menu" class="user-dropdown-ps1 hidden">
                <div class="user-dropdown-header">
                  <span class="ps1-badge-gold">SESIÓN SUPABASE</span>
                  <span id="user-email-text" class="user-email-text"></span>
                </div>
                <button id="dropdown-open-inventory" class="dropdown-item" type="button" style="text-align: left; width: 100%; background: transparent; border: none; font-family: inherit; font-size: inherit; cursor: pointer; color: var(--ps1-cyan);">&gt; MI INVENTARIO 🎒</button>
                <a href="/studio" class="dropdown-item">&gt; STUDIO WORKSPACE</a>
                <a href="/colaboradores" class="dropdown-item" style="color: var(--ps1-gold); font-weight: bold;">&gt; PANEL COLABORADORES 👑</a>
                <button id="btn-logout" class="dropdown-item dropdown-item-danger" type="button">&gt; CERRAR SESIÓN</button>
              </div>
            </div>
          </div>
        </nav>
      </div>
    </header>

    <main class="site-content">
      <slot />
    </main>

    <!-- Modal Retro PS1 de Autenticación de Usuarios (Supabase) -->
    <div id="ps1-auth-modal" class="ps1-modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="auth-modal-title">
      <div class="ps1-window auth-modal-window">
        <div class="ps1-titlebar">
          <div class="titlebar-title" id="auth-modal-title">
            <span class="title-glyph">▲</span>
            <span>BIOS // IDENTIFICACIÓN DE USUARIO</span>
          </div>
          <button type="button" class="ps1-window-btn" id="btn-close-auth-modal" aria-label="Cerrar">✕</button>
        </div>

        <div class="auth-modal-body">
          <div class="auth-tabs">
            <button type="button" class="auth-tab active" data-tab="oauth">OAUTH GITHUB</button>
            <button type="button" class="auth-tab" data-tab="login">INICIAR SESIÓN</button>
            <button type="button" class="auth-tab" data-tab="signup">REGISTRARSE</button>
          </div>

          <!-- TAB 1: GITHUB OAUTH -->
          <div class="auth-tab-panel" id="tab-oauth">
            <p class="auth-desc">Identifícate con tu cuenta de GitHub para guardar tus configuraciones y sincronizar tus modelos procedurales en la nube.</p>
            <button type="button" class="btn auth-action-btn btn-github-oauth" id="btn-auth-github">
              <span class="auth-btn-icon">🐱</span>
              <span>CONTINUAR CON GITHUB</span>
            </button>
            <div class="auth-note-box">
              <span class="note-tag">[SUPABASE AUTH]</span>
              <span>Conexión cifrada sin cookies de rastreo. Compatible con Vercel & Supabase.</span>
            </div>
          </div>

          <!-- TAB 2: EMAIL LOGIN -->
          <div class="auth-tab-panel hidden" id="tab-login">
            <form id="form-login" class="auth-form">
              <div class="auth-field">
                <label for="login-email">&gt; CORREO ELECTRÓNICO</label>
                <input type="email" id="login-email" class="ps1-input" required placeholder="piloto@below-nominal.space" />
              </div>
              <div class="auth-field">
                <label for="login-password">&gt; CONTRASEÑA</label>
                <input type="password" id="login-password" class="ps1-input" required placeholder="••••••••" />
              </div>
              <button type="submit" class="btn auth-action-btn" id="btn-submit-login">
                <span>[ ENTRAR ]</span>
              </button>
            </form>
          </div>

          <!-- TAB 3: EMAIL SIGNUP -->
          <div class="auth-tab-panel hidden" id="tab-signup">
            <form id="form-signup" class="auth-form">
              <div class="auth-field">
                <label for="signup-email">&gt; CORREO NUEVO</label>
                <input type="email" id="signup-email" class="ps1-input" required placeholder="nuevo_piloto@ejemplo.com" />
              </div>
              <div class="auth-field">
                <label for="signup-password">&gt; CONTRASEÑA (MÍN. 6 CARACTERES)</label>
                <input type="password" id="signup-password" minlength="6" class="ps1-input" required placeholder="••••••••" />
              </div>
              <button type="submit" class="btn auth-action-btn" id="btn-submit-signup" style="border-color: var(--ps1-cyan); color: var(--ps1-cyan);">
                <span>[ CREAR CUENTA ]</span>
              </button>
            </form>
          </div>

          <!-- Mensaje de estado dinámico -->
          <div id="auth-status-msg" class="auth-status-box hidden"></div>
        </div>
      </div>
    </div>

    <!-- Modal Retro PS1 de Mi Inventario, Favoritos y Colecciones -->
    <div id="ps1-inventory-modal" class="ps1-modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="inv-modal-title">
      <div class="ps1-window inv-modal-window" style="max-width: 840px; width: 95%;">
        <div class="ps1-titlebar">
          <div class="titlebar-title" id="inv-modal-title">
            <span class="title-glyph">▲</span>
            <span>BASE DE DATOS // MI INVENTARIO & COLECCIONES</span>
          </div>
          <button type="button" class="ps1-window-btn" id="btn-close-inventory-modal" aria-label="Cerrar">✕</button>
        </div>

        <div class="inv-modal-body" style="padding: 1.25rem;">
          <!-- Tabs -->
          <div class="inv-tabs" style="display: flex; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px solid var(--ps1-steel); padding-bottom: 0.5rem; flex-wrap: wrap;">
            <button type="button" class="inv-tab-btn active" data-tab="drafts">
              📁 BORRADORES EN CURSO (<span id="inv-tab-drafts-count">0</span>)
            </button>
            <button type="button" class="inv-tab-btn" data-tab="favorites">
              ⭐ MODELOS FAVORITOS (<span id="inv-tab-favs-count">0</span>)
            </button>
            <button type="button" class="inv-tab-btn" data-tab="collections">
              🗂️ COLECCIONES (<span id="inv-tab-colls-count">0</span>)
            </button>
          </div>

          <!-- TAB 1: DRAFTS -->
          <div class="inv-tab-panel" id="inv-panel-drafts">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
              <span style="font-size: 0.75rem; color: var(--text-dim);">
                Modelos que estás construyendo en el Studio. Puedes retomarlos en cualquier momento sin perder tu trabajo.
              </span>
              <a href="/studio" class="btn-mini btn-gold" style="text-decoration: none;">
                ➕ NUEVO MODELO EN STUDIO
              </a>
            </div>
            <div id="inv-drafts-list" style="max-height: 440px; overflow-y: auto; display: flex; flex-direction: column; gap: 0.65rem;">
              <!-- Dynamic list of drafts -->
            </div>
          </div>

          <!-- TAB 2: FAVORITES -->
          <div class="inv-tab-panel hidden" id="inv-panel-favorites">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
              <span style="font-size: 0.75rem; color: var(--text-dim);">
                Generadores y modelos guardados con estrella ⭐ en el catálogo para acceso rápido.
              </span>
              <a href="/#catalog-controls" class="btn-mini btn-outline" style="text-decoration: none;">
                🔍 EXPLORAR CATÁLOGO
              </a>
            </div>
            <div id="inv-favorites-list" style="max-height: 440px; overflow-y: auto; display: flex; flex-direction: column; gap: 0.65rem;">
              <!-- Dynamic list of favorites -->
            </div>
          </div>

          <!-- TAB 3: COLLECTIONS -->
          <div class="inv-tab-panel hidden" id="inv-panel-collections">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
              <span style="font-size: 0.75rem; color: var(--text-dim);">
                Agrupa tus modelos y piezas procedurales en conjuntos temáticos para tus escenas de Below Nominal.
              </span>
              <button id="btn-create-collection" class="btn-mini btn-cyan" type="button">
                ➕ NUEVA COLECCIÓN
              </button>
            </div>
            <div id="inv-create-coll-form" class="ps1-inset hidden" style="padding: 0.75rem; margin-bottom: 1rem; background: #07101e;">
              <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: flex-end;">
                <div style="flex-grow: 1; min-width: 200px;">
                  <label for="new-coll-name" style="display: block; font-family: var(--font-pixel); font-size: 0.7rem; color: var(--ps1-gold); margin-bottom: 0.25rem;">NOMBRE DE LA COLECCIÓN</label>
                  <input type="text" id="new-coll-name" class="ps1-input" placeholder="Ej: Laboratorio Subterráneo" style="width: 100%; font-size: 0.8rem;" />
                </div>
                <div style="flex-grow: 1; min-width: 200px;">
                  <label for="new-coll-desc" style="display: block; font-family: var(--font-pixel); font-size: 0.7rem; color: var(--ps1-cyan); margin-bottom: 0.25rem;">DESCRIPCIÓN (OPCIONAL)</label>
                  <input type="text" id="new-coll-desc" class="ps1-input" placeholder="Props para el sector médico..." style="width: 100%; font-size: 0.8rem;" />
                </div>
                <div style="display: flex; gap: 0.4rem;">
                  <button id="btn-submit-new-coll" class="btn-mini btn-gold" type="button">CREAR</button>
                  <button id="btn-cancel-new-coll" class="btn-mini btn-outline" type="button">CANCELAR</button>
                </div>
              </div>
            </div>
            <div id="inv-collections-list" style="max-height: 440px; overflow-y: auto; display: flex; flex-direction: column; gap: 0.75rem;">
              <!-- Dynamic list of collections -->
            </div>
          </div>
        </div>
      </div>
    </div>

    <footer class="site-footer">
      <div class="footer-container">
        <!-- Columna 1: Marca & Propósito -->
        <div class="footer-col footer-col-brand">
          <div class="footer-brand-header">
            <img src="/logo.png" alt="ModelCoder Logo" class="footer-brand-logo" width="36" height="36" />
            <div class="footer-brand-text">
              <span class="footer-brand-title">[ MODELCODER ]</span>
              <span class="footer-brand-tagline">HERRAMIENTA PROCEDURAL 3D</span>
            </div>
          </div>
          <p class="footer-desc">
            Plataforma web abierta para crear, personalizar y descargar modelos 3D low-poly en formato universal GLB. Diseñada con enfoque práctico para videojuegos independientes.
          </p>
          <div class="footer-badges">
            <span class="footer-tag">BLENDER 5.0</span>
            <span class="footer-tag">GLTF / GLB UNIVERSAL</span>
            <span class="footer-tag">GODOT 4 & UNITY</span>
            <span class="footer-tag">LICENCIA CC-BY 4.0</span>
          </div>
        </div>

        <!-- Columna 2: Creador & Estudio (IV Orbit Games) -->
        <div class="footer-col footer-col-creator">
          <h4 class="footer-col-title">// EL CREADOR & EL ESTUDIO</h4>
          <p class="footer-creator-text">
            Desarrollado y mantenido por <strong>Franciscuarto</strong> bajo el sello independiente <strong>IV Orbit Games</strong> desde Buenos Aires, Argentina.
          </p>
          <p class="footer-creator-mission">
            ModelCoder nació como el conjunto de herramientas internas para generar la maquinaria, mobiliario y accesorios modulares de <em>Below Nominal</em> (desarrollado con Godot Engine).
          </p>
          <div class="footer-creator-links">
            <a href="https://ivorbitgames.online" target="_blank" rel="noopener noreferrer" class="creator-link link-highlight">
              🪐 ivorbitgames.online (Web Oficial) &rarr;
            </a>
            <a href="https://iv-orbit.itch.io" target="_blank" rel="noopener noreferrer" class="creator-link">
              🎮 itch.io (Juegos & Demos) &rarr;
            </a>
            <a href="https://www.youtube.com/@Franciscuarto" target="_blank" rel="noopener noreferrer" class="creator-link">
              📺 YouTube (@Franciscuarto) &rarr;
            </a>
            <a href="https://github.com/FrancisCuarto" target="_blank" rel="noopener noreferrer" class="creator-link">
              🐙 GitHub (@FrancisCuarto) &rarr;
            </a>
          </div>
        </div>

        <!-- Columna 3: Videojuegos & Proyectos de IV Orbit Games -->
        <div class="footer-col footer-col-projects">
          <h4 class="footer-col-title">// JUEGOS DE IV ORBIT GAMES</h4>
          <ul class="footer-project-list">
            <li>
              <a href="https://iv-orbit.itch.io/belownominal" target="_blank" rel="noopener noreferrer" class="project-item">
                <div class="project-header">
                  <span class="project-name">🧊 Below Nominal</span>
                  <span class="project-badge">EN DESARROLLO</span>
                </div>
                <span class="project-desc">Terror y supervivencia bajo el hielo de Europa (Godot Engine, PC).</span>
              </a>
            </li>
            <li>
              <a href="https://ivorbitgames.online/juegos/puchito" target="_blank" rel="noopener noreferrer" class="project-item">
                <div class="project-header">
                  <span class="project-name">🚗 Puchito</span>
                  <span class="project-badge badge-avail">DISPONIBLE</span>
                </div>
                <span class="project-desc">Gestión y minijuegos arcade en taller espacial (PC).</span>
              </a>
            </li>
            <li>
              <a href="https://ivorbitgames.online/juegos/topoloco" target="_blank" rel="noopener noreferrer" class="project-item">
                <div class="project-header">
                  <span class="project-name">🎯 Topoloco</span>
                  <span class="project-badge badge-avail">ANDROID</span>
                </div>
                <span class="project-desc">Arcade casual de reflejos rápidos para móviles.</span>
              </a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Barra Inferior de Derechos -->
      <div class="footer-bottom-bar">
        <div class="footer-bottom-inner">
          <span>&copy; 2026 IV Orbit Games &bull; Franciscuarto &bull; Buenos Aires, Argentina</span>
          <div class="footer-bottom-links">
            <a href="https://github.com/FrancisCuarto/MODELCODER" target="_blank" rel="noopener noreferrer">Repositorio Open Source</a>
            <span class="sep">&bull;</span>
            <a href="https://ivorbitgames.online/contacto" target="_blank" rel="noopener noreferrer">Contacto Directo</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Script de Inicialización de Autenticación de Supabase -->
    <script>
      import { getSupabase, signInWithGitHub, signInWithEmail, signUpWithEmail, signOut, onAuthStateChange, checkUserRole, getCommunityModels } from '../lib/supabase';
      import {
        getProjectDrafts,
        getFavorites,
        getCollections,
        deleteProjectDraft,
        deleteCollection,
        toggleFavorite,
        saveCollection
      } from '../lib/user-inventory';

      // Sincronizar contador global de modelos en el encabezado
      async function syncHeaderModelCount() {
        try {
          const commModels = await getCommunityModels({ onlyPublic: true });
          const totalCount = 101 + (commModels ? commModels.length : 0);
          const el = document.getElementById('header-models-count');
          if (el) {
            el.textContent = `${totalCount} MODELOS DISPONIBLES`;
          }
        } catch {}
      }
      syncHeaderModelCount();

      const btnOpenAuth = document.getElementById('btn-open-auth');
      const authModal = document.getElementById('ps1-auth-modal');
      const btnCloseAuthModal = document.getElementById('btn-close-auth-modal');
      const userLoggedBox = document.getElementById('user-logged-box');
      const userProfileBtn = document.getElementById('user-profile-btn');
      const userDisplayName = document.getElementById('user-display-name');
      const userEmailText = document.getElementById('user-email-text');
      const userDropdownMenu = document.getElementById('user-dropdown-menu');
      const btnLogout = document.getElementById('btn-logout');

      const tabs = document.querySelectorAll('.auth-tab');
      const tabPanels = {
        oauth: document.getElementById('tab-oauth'),
        login: document.getElementById('tab-login'),
        signup: document.getElementById('tab-signup'),
      };
      const authStatusMsg = document.getElementById('auth-status-msg');

      function showStatus(text: string, isError = false) {
        if (!authStatusMsg) return;
        authStatusMsg.textContent = text;
        authStatusMsg.classList.remove('hidden', 'error', 'success');
        authStatusMsg.classList.add(isError ? 'error' : 'success');
      }

      function clearStatus() {
        if (!authStatusMsg) return;
        authStatusMsg.classList.add('hidden');
        authStatusMsg.textContent = '';
      }

      function openModal() {
        if (!authModal) return;
        authModal.classList.remove('hidden');
        clearStatus();
      }

      function closeModal() {
        if (!authModal) return;
        authModal.classList.add('hidden');
        clearStatus();
      }

      btnOpenAuth?.addEventListener('click', openModal);
      btnCloseAuthModal?.addEventListener('click', closeModal);

      // Close modal on backdrop click
      authModal?.addEventListener('click', (e) => {
        if (e.target === authModal) closeModal();
      });

      // Tab switcher
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          tabs.forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');
          const target = tab.getAttribute('data-tab');
          Object.keys(tabPanels).forEach((key) => {
            if (key === target) {
              tabPanels[key as keyof typeof tabPanels]?.classList.remove('hidden');
            } else {
              tabPanels[key as keyof typeof tabPanels]?.classList.add('hidden');
            }
          });
          clearStatus();
        });
      });

      // Toggle user profile dropdown
      userProfileBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        userDropdownMenu?.classList.toggle('hidden');
      });

      document.addEventListener('click', () => {
        userDropdownMenu?.classList.add('hidden');
      });

      // GitHub OAuth button
      document.getElementById('btn-auth-github')?.addEventListener('click', async () => {
        try {
          showStatus('Iniciando redirección a GitHub...');
          await signInWithGitHub();
        } catch (err: any) {
          showStatus(`Error OAuth: ${err?.message || err}`, true);
        }
      });

      // Form Login Email
      document.getElementById('form-login')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = (document.getElementById('login-email') as HTMLInputElement)?.value;
        const password = (document.getElementById('login-password') as HTMLInputElement)?.value;
        try {
          showStatus('Verificando credenciales...');
          await signInWithEmail(email, password);
          showStatus('¡Acceso correcto! Cargando sesión...', false);
          setTimeout(() => {
            closeModal();
            window.location.reload();
          }, 800);
        } catch (err: any) {
          showStatus(`Error: ${err?.message || err}`, true);
        }
      });

      // Form Signup Email
      document.getElementById('form-signup')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = (document.getElementById('signup-email') as HTMLInputElement)?.value;
        const password = (document.getElementById('signup-password') as HTMLInputElement)?.value;
        try {
          showStatus('Registrando nuevo piloto...');
          await signUpWithEmail(email, password);
          showStatus('¡Cuenta creada! Revisa tu bandeja de entrada si requiere confirmación.', false);
        } catch (err: any) {
          showStatus(`Error al registrar: ${err?.message || err}`, true);
        }
      });

      // Logout button
      btnLogout?.addEventListener('click', async () => {
        await signOut();
      });

      // Auth state observer
      async function updateSessionUI(user: any) {
        const navCollabLink = document.getElementById('nav-collab-link');
        if (user) {
          btnOpenAuth?.classList.add('hidden');
          userLoggedBox?.classList.remove('hidden');
          const name = user.user_metadata?.user_name || user.user_metadata?.name || user.email?.split('@')[0] || 'PILOTO';
          if (userDisplayName) userDisplayName.textContent = `@${name.toUpperCase()}`;
          if (userEmailText) userEmailText.textContent = user.email || '';

          // Verificar si es colaborador para mostrar el acceso directo
          const { isCollaborator, role } = await checkUserRole(user);
          if (navCollabLink) {
            navCollabLink.style.display = isCollaborator ? 'inline-flex' : 'none';
            if (role === 'owner') {
              navCollabLink.textContent = '👑 Colaboradores';
            }
          }
        } else {
          btnOpenAuth?.classList.remove('hidden');
          userLoggedBox?.classList.add('hidden');
          if (navCollabLink) navCollabLink.style.display = 'none';
        }
      }

      // Check current session
      // ==========================================
      // GESTOR DE INVENTARIO, FAVORITOS Y COLECCIONES
      // ==========================================
      const btnOpenInventory = document.getElementById('btn-open-global-inventory');
      const dropdownOpenInventory = document.getElementById('dropdown-open-inventory');
      const invModal = document.getElementById('ps1-inventory-modal');
      const btnCloseInvModal = document.getElementById('btn-close-inventory-modal');
      const globalInvCountEl = document.getElementById('global-inv-count');

      const invTabDraftsCount = document.getElementById('inv-tab-drafts-count');
      const invTabFavsCount = document.getElementById('inv-tab-favs-count');
      const invTabCollsCount = document.getElementById('inv-tab-colls-count');

      const invDraftsList = document.getElementById('inv-drafts-list');
      const invFavoritesList = document.getElementById('inv-favorites-list');
      const invCollectionsList = document.getElementById('inv-collections-list');

      const invTabBtns = document.querySelectorAll('.inv-tab-btn');
      const invPanels: Record<string, HTMLElement | null> = {
        drafts: document.getElementById('inv-panel-drafts'),
        favorites: document.getElementById('inv-panel-favorites'),
        collections: document.getElementById('inv-panel-collections')
      };

      function updateInventoryBadgeCounts(): void {
        const drafts = getProjectDrafts();
        const favs = getFavorites();
        const colls = getCollections();

        const total = drafts.length + favs.length;
        if (globalInvCountEl) globalInvCountEl.textContent = `${total}`;
        if (invTabDraftsCount) invTabDraftsCount.textContent = `${drafts.length}`;
        if (invTabFavsCount) invTabFavsCount.textContent = `${favs.length}`;
        if (invTabCollsCount) invTabCollsCount.textContent = `${colls.length}`;
      }

      function renderInvDrafts(): void {
        if (!invDraftsList) return;
        const drafts = getProjectDrafts();
        if (drafts.length === 0) {
          invDraftsList.innerHTML = `
            <div class="ps1-inset" style="padding: 2rem 1rem; text-align: center; color: var(--text-dim); background: #070d18;">
              <div style="font-size: 2.2rem; margin-bottom: 0.4rem;">📁</div>
              <p style="font-family: var(--font-pixel); font-size: 0.78rem; color: var(--ps1-gold); margin-bottom: 0.35rem;">
                NO TIENES BORRADORES NI PROYECTOS GUARDADOS
              </p>
              <span style="font-size: 0.75rem;">
                Entra a <a href="/studio" style="color: var(--ps1-cyan); text-decoration: underline;">Studio 3D</a> y guarda tu avance con 💾 GUARDAR para retomarlo cuando quieras.
              </span>
            </div>
          `;
          return;
        }

        invDraftsList.innerHTML = '';
        drafts.forEach(draft => {
          const item = document.createElement('div');
          item.className = 'ps1-inset';
          item.style.padding = '0.75rem';
          item.style.background = '#090e1c';
          item.style.border = '1px solid var(--ps1-steel)';
          const dStr = new Date(draft.updated_at).toLocaleString();

          item.innerHTML = `
            <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
              <div style="width: 64px; height: 64px; background: #060911; border: 1px solid var(--ps1-steel); display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden;">
                ${draft.thumbnail
                  ? `<img src="${draft.thumbnail}" alt="${draft.name}" style="width: 100%; height: 100%; object-fit: contain;" />`
                  : `<span style="font-size: 1.5rem;">📦</span>`
                }
              </div>
              <div style="flex-grow: 1; min-width: 180px;">
                <div style="display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.2rem; flex-wrap: wrap;">
                  <strong style="font-family: var(--font-pixel); font-size: 0.78rem; color: var(--ps1-gold);">${draft.name}</strong>
                  <span class="category-badge category-${draft.category}" style="font-size: 0.65rem;">${draft.category}</span>
                </div>
                <p style="font-size: 0.72rem; color: var(--text-dim); margin: 0 0 0.3rem 0;">
                  ${draft.description || 'Sin notas.'}
                </p>
                <div style="font-size: 0.68rem; color: var(--ps1-cyan); display: flex; gap: 0.5rem; flex-wrap: wrap;">
                  <span>📐 ${draft.components_count} piezas</span>
                  <span>&bull;</span>
                  <span>🔺 ~${draft.tri_count} tris</span>
                  <span>&bull;</span>
                  <span style="color: var(--text-dim);">🕒 ${dStr}</span>
                </div>
              </div>
              <div style="display: flex; gap: 0.35rem; align-items: center;">
                <a href="/studio?draft=${draft.id}" class="btn-mini btn-gold" style="text-decoration: none;">
                  ⚡ RETOMAR EN STUDIO
                </a>
                <button type="button" class="btn-mini btn-danger btn-del-inv-draft" data-id="${draft.id}" title="Eliminar borrador">
                  🗑️
                </button>
              </div>
            </div>
          `;
          invDraftsList.appendChild(item);
        });

        invDraftsList.querySelectorAll('.btn-del-inv-draft').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const id = (e.currentTarget as HTMLElement).dataset.id;
            if (!id) return;
            if (confirm('¿Eliminar este borrador?')) {
              deleteProjectDraft(id);
              updateInventoryBadgeCounts();
              renderInvDrafts();
            }
          });
        });
      }

      function renderInvFavorites(): void {
        if (!invFavoritesList) return;
        const favs = getFavorites();
        if (favs.length === 0) {
          invFavoritesList.innerHTML = `
            <div class="ps1-inset" style="padding: 2rem 1rem; text-align: center; color: var(--text-dim); background: #070d18;">
              <div style="font-size: 2.2rem; margin-bottom: 0.4rem;">⭐</div>
              <p style="font-family: var(--font-pixel); font-size: 0.78rem; color: var(--ps1-gold); margin-bottom: 0.35rem;">
                NO TIENES MODELOS EN FAVORITOS
              </p>
              <span style="font-size: 0.75rem;">
                Explora el catálogo y marca con estrella ⭐ los modelos que quieras guardar en tu inventario.
              </span>
            </div>
          `;
          return;
        }

        invFavoritesList.innerHTML = '';
        favs.forEach(fav => {
          const item = document.createElement('div');
          item.className = 'ps1-inset';
          item.style.padding = '0.75rem';
          item.style.background = '#090e1c';
          item.style.border = '1px solid var(--ps1-steel)';
          const dStr = new Date(fav.added_at).toLocaleDateString();

          item.innerHTML = `
            <div style="display: flex; gap: 0.75rem; align-items: center; justify-content: space-between; flex-wrap: wrap;">
              <div>
                <div style="display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.2rem; flex-wrap: wrap;">
                  <span style="color: var(--ps1-gold);">⭐</span>
                  <strong style="font-family: var(--font-pixel); font-size: 0.8rem; color: var(--ps1-gold);">${fav.name}</strong>
                  <span class="category-badge category-${fav.category}" style="font-size: 0.65rem;">${fav.category}</span>
                  <span class="ps1-telemetry-tag" style="font-size: 0.65rem;">${fav.type.toUpperCase()}</span>
                </div>
                <span style="font-size: 0.7rem; color: var(--text-dim);">Agregado: ${dStr}</span>
              </div>
              <div style="display: flex; gap: 0.4rem; align-items: center;">
                <a href="${fav.type === 'catalog' ? `/generators/${fav.id}` : '/studio'}" class="btn-mini btn-cyan" style="text-decoration: none;">
                  👁️ VER EN 3D
                </a>
                <button type="button" class="btn-mini btn-outline btn-del-inv-fav" data-id="${fav.id}" title="Quitar de favoritos">
                  ✕ QUITAR
                </button>
              </div>
            </div>
          `;
          invFavoritesList.appendChild(item);
        });

        invFavoritesList.querySelectorAll('.btn-del-inv-fav').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const id = (e.currentTarget as HTMLElement).dataset.id;
            if (!id) return;
            const item = favs.find(f => f.id === id);
            if (item) {
              toggleFavorite(item);
              updateInventoryBadgeCounts();
              renderInvFavorites();
            }
          });
        });
      }

      function renderInvCollections(): void {
        if (!invCollectionsList) return;
        const colls = getCollections();
        if (colls.length === 0) {
          invCollectionsList.innerHTML = `
            <div class="ps1-inset" style="padding: 2rem 1rem; text-align: center; color: var(--text-dim); background: #070d18;">
              <div style="font-size: 2.2rem; margin-bottom: 0.4rem;">🗂️</div>
              <p style="font-family: var(--font-pixel); font-size: 0.78rem; color: var(--ps1-gold); margin-bottom: 0.35rem;">
                NO HAS CREADO COLECCIONES AÚN
              </p>
              <span style="font-size: 0.75rem;">
                Crea una colección como "Estación Subterránea" o "Módulo Médico" para organizar tus sets de assets.
              </span>
            </div>
          `;
          return;
        }

        invCollectionsList.innerHTML = '';
        colls.forEach(coll => {
          const item = document.createElement('div');
          item.className = 'ps1-inset';
          item.style.padding = '0.75rem';
          item.style.background = '#090e1c';
          item.style.border = '1px solid var(--ps1-steel)';

          const modelIds = Array.isArray(coll.model_ids) ? coll.model_ids : [];
          item.innerHTML = `
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; flex-wrap: wrap; gap: 0.4rem;">
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 1.1rem;">🗂️</span>
                <strong style="font-family: var(--font-pixel); font-size: 0.82rem; color: var(--ps1-cyan);">${coll.name}</strong>
                <span class="ps1-telemetry-tag" style="font-size: 0.65rem;">${modelIds.length} MODELOS</span>
              </div>
              <button type="button" class="btn-mini btn-danger btn-del-coll" data-id="${coll.id}" title="Eliminar colección">
                🗑️ ELIMINAR
              </button>
            </div>
            <p style="font-size: 0.74rem; color: var(--text-dim); margin: 0 0 0.5rem 0;">
              ${coll.description || 'Colección personalizada de modelos procedurales.'}
            </p>
            ${modelIds.length > 0 ? `
              <div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
                ${modelIds.map(id => `<span class="ps1-telemetry-tag" style="font-size: 0.68rem; background: #060911;">#${id}</span>`).join('')}
              </div>
            ` : `<span style="font-size: 0.7rem; color: var(--text-dim); font-style: italic;">Colección vacía.</span>`}
          `;
          invCollectionsList.appendChild(item);
        });

        invCollectionsList.querySelectorAll('.btn-del-coll').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const id = (e.currentTarget as HTMLElement).dataset.id;
            if (!id) return;
            if (confirm('¿Eliminar esta colección?')) {
              deleteCollection(id);
              updateInventoryBadgeCounts();
              renderInvCollections();
            }
          });
        });
      }

      function openInventoryModal(defaultTab = 'drafts'): void {
        if (!invModal) return;
        updateInventoryBadgeCounts();
        invTabBtns.forEach(btn => {
          if (btn.getAttribute('data-tab') === defaultTab) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });
        Object.entries(invPanels).forEach(([key, panel]) => {
          if (panel) {
            panel.classList.toggle('hidden', key !== defaultTab);
          }
        });
        if (defaultTab === 'drafts') renderInvDrafts();
        else if (defaultTab === 'favorites') renderInvFavorites();
        else if (defaultTab === 'collections') renderInvCollections();

        invModal.classList.remove('hidden');
      }

      function closeInventoryModal(): void {
        if (!invModal) return;
        invModal.classList.add('hidden');
      }

      btnOpenInventory?.addEventListener('click', () => openInventoryModal('drafts'));
      dropdownOpenInventory?.addEventListener('click', () => {
        userDropdownMenu?.classList.add('hidden');
        openInventoryModal('drafts');
      });
      btnCloseInvModal?.addEventListener('click', closeInventoryModal);
      invModal?.addEventListener('click', (e) => {
        if (e.target === invModal) closeInventoryModal();
      });

      invTabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          invTabBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const tabKey = btn.getAttribute('data-tab') || 'drafts';
          Object.entries(invPanels).forEach(([key, panel]) => {
            if (panel) panel.classList.toggle('hidden', key !== tabKey);
          });
          if (tabKey === 'drafts') renderInvDrafts();
          else if (tabKey === 'favorites') renderInvFavorites();
          else if (tabKey === 'collections') renderInvCollections();
        });
      });

      // Collections creation form
      const btnCreateCollection = document.getElementById('btn-create-collection');
      const invCreateCollForm = document.getElementById('inv-create-coll-form');
      const btnSubmitNewColl = document.getElementById('btn-submit-new-coll');
      const btnCancelNewColl = document.getElementById('btn-cancel-new-coll');
      const inputNewCollName = document.getElementById('new-coll-name') as HTMLInputElement | null;
      const inputNewCollDesc = document.getElementById('new-coll-desc') as HTMLInputElement | null;

      btnCreateCollection?.addEventListener('click', () => {
        if (invCreateCollForm) invCreateCollForm.classList.remove('hidden');
        if (inputNewCollName) inputNewCollName.focus();
      });

      btnCancelNewColl?.addEventListener('click', () => {
        if (invCreateCollForm) invCreateCollForm.classList.add('hidden');
      });

      btnSubmitNewColl?.addEventListener('click', () => {
        const name = inputNewCollName?.value?.trim();
        const desc = inputNewCollDesc?.value?.trim() || '';
        if (!name) {
          alert('Por favor introduce un nombre para la colección.');
          return;
        }
        saveCollection({ name, description: desc });
        if (inputNewCollName) inputNewCollName.value = '';
        if (inputNewCollDesc) inputNewCollDesc.value = '';
        if (invCreateCollForm) invCreateCollForm.classList.add('hidden');
        updateInventoryBadgeCounts();
        renderInvCollections();
      });

      updateInventoryBadgeCounts();
      window.addEventListener('modelcoder:inventory_updated', () => {
        updateInventoryBadgeCounts();
        if (invModal && !invModal.classList.contains('hidden')) {
          const activeTabBtn = document.querySelector('.inv-tab-btn.active');
          const activeTab = activeTabBtn?.getAttribute('data-tab') || 'drafts';
          if (activeTab === 'drafts') renderInvDrafts();
          else if (activeTab === 'favorites') renderInvFavorites();
          else if (activeTab === 'collections') renderInvCollections();
        }
      });

      // Check current session
      const supabase = getSupabase();
      if (supabase) {
        supabase.auth.getUser().then(({ data }) => {
          updateSessionUI(data.user);
        });
        onAuthStateChange((user) => {
          updateSessionUI(user);
        });
      }
    </script>

