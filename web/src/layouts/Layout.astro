              </a>
            </div>
          </div>
        </nav>

        <div class="nav-actions">
          <!-- User Authentication Widget -->
          <div id="user-auth-root" class="user-auth-container">
            <button id="btn-open-auth" class="btn btn-outline btn-sm" type="button" title="Acceder con tu cuenta">
