            </button>

            <div id="user-logged-box" class="user-logged-pill hidden">
              <button id="user-profile-btn" class="btn btn-outline btn-sm" type="button" aria-haspopup="menu">
                <span id="user-display-name">@PILOTO</span>
                <span class="user-caret">▾</span>
              </button>
              <div id="user-dropdown-menu" class="mc-dropdown-menu mc-dropdown-right hidden">
                <div class="mc-dropdown-header">
                  <span class="mc-dropdown-sub">Sesión activa</span>
                  <span id="user-email-text" class="mc-dropdown-email"></span>
                </div>
                <button id="dropdown-open-inventory" class="mc-dropdown-item" type="button">🎒 Mi Inventario</button>
                <button id="btn-export-session-code" class="mc-dropdown-item" type="button">🔑 Sincronizar App Escritorio</button>
                <a href="/studio" class="mc-dropdown-item">⚡ Abrir Studio 3D</a>
                <a href="/colaboradores" class="mc-dropdown-item">👑 Panel Colaboradores</a>
                <div class="mc-dropdown-divider"></div>
                <button id="btn-logout" class="mc-dropdown-item mc-dropdown-danger" type="button">Cerrar sesión</button>
              </div>
            </div>
          </div>

          <a href="/studio" class="nav-cta-studio">
            <span>Abrir Studio</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </header>
    )}

    <main class={hideGlobalNav ? 'site-content dcc-main-content' : 'site-content'}>
      <slot />
    </main>

    <!-- Modal de Autenticación de Usuarios (Supabase) -->
    <div id="ps1-auth-modal" class="mc-modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="auth-modal-title">
      <div class="mc-modal-window auth-modal-window">
        <div class="mc-modal-header">
          <div class="mc-modal-title" id="auth-modal-title">Acceso a ModelCoder</div>
          <button type="button" class="mc-modal-close" id="btn-close-auth-modal" aria-label="Cerrar">✕</button>
        </div>

        <div class="auth-modal-body">
          <div class="auth-tabs">
            <button type="button" class="auth-tab active" data-tab="oauth">GitHub</button>
            <button type="button" class="auth-tab" data-tab="login">Entrar</button>
            <button type="button" class="auth-tab" data-tab="signup">Crear cuenta</button>
            <button type="button" class="auth-tab" data-tab="desktop-sync" id="tab-btn-desktop-sync">Vincular App</button>
