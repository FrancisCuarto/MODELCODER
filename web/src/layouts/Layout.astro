          <a href="/docs" class={`nav-link ${currentPath.startsWith('/docs') ? 'active' : ''}`}>Docs</a>
          <a href="/devlog" class={`nav-link ${currentPath.startsWith('/devlog') ? 'active' : ''}`}>Devlog</a>
          <a href="/contribute" class={`nav-link ${currentPath.startsWith('/contribute') ? 'active' : ''}`}>Cómo funciona</a>

          <!-- Dropdown Más -->
