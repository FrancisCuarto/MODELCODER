            </button>
            <div id="nav-more-menu" class="mc-dropdown-menu hidden" role="menu">
              <button id="btn-open-global-inventory" class="mc-dropdown-item" type="button" role="menuitem">
                <span>🎒 Mi Inventario</span>
                <span class="mc-badge-pill" id="global-inv-count">0</span>
              </button>
              <a href="https://ivorbitgames.online/herramientas/texture-studio" target="_blank" rel="noopener noreferrer" class="mc-dropdown-item" role="menuitem">
