          <div id="auth-status-msg" class="auth-status-box hidden"></div>
        </div>
      </div>
    </div>

    <!-- Modal de Mi Inventario, Favoritos y Colecciones -->
    <div id="ps1-inventory-modal" class="mc-modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="inv-modal-title">
      <div class="mc-modal-window inv-modal-window">
        <div class="mc-modal-header">
          <div class="mc-modal-title" id="inv-modal-title">Mi Inventario y Colecciones</div>
          <button type="button" class="mc-modal-close" id="btn-close-inventory-modal" aria-label="Cerrar">✕</button>
        </div>

        <div class="inv-modal-body">
          <div class="inv-tabs">
            <button type="button" class="inv-tab-btn active" data-tab="drafts">
              Borradores (<span id="inv-tab-drafts-count">0</span>)
            </button>
            <button type="button" class="inv-tab-btn" data-tab="favorites">
              Favoritos (<span id="inv-tab-favs-count">0</span>)
            </button>
            <button type="button" class="inv-tab-btn" data-tab="collections">
              Colecciones (<span id="inv-tab-colls-count">0</span>)
            </button>
          </div>

          <div class="inv-tab-panel" id="inv-panel-drafts">
            <div class="inv-panel-head">
              <span class="inv-panel-sub">Modelos en curso guardados desde Studio 3D.</span>
              <a href="/studio" class="btn btn-primary btn-sm">+ Nuevo en Studio</a>
            </div>
            <div id="inv-drafts-list" class="inv-items-list"></div>
          </div>

          <div class="inv-tab-panel hidden" id="inv-panel-favorites">
            <div class="inv-panel-head">
              <span class="inv-panel-sub">Generadores y modelos guardados con estrella.</span>
