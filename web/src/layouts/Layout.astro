    <!-- Script de Inicialización de Autenticación de Supabase -->
    <script>
      import { getSupabase, signInWithGitHub, signInWithEmail, signUpWithEmail, signOut, onAuthStateChange, checkUserRole, getCommunityModels } from '../lib/supabase';
      import {
        getProjectDrafts,
        getFavorites,
        getCollections,
        deleteProjectDraft,
        deleteCollection,
        toggleFavorite,
        saveCollection,
        toggleModelInCollection
      } from '../lib/user-inventory';

      function escapeHtml(str: unknown): string {
        return String(str ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      // Sincronizar contador global de modelos en el encabezado
      async function syncHeaderModelCount() {
        try {
          const commModels = await getCommunityModels({ onlyPublic: true });
          const el = document.getElementById('header-models-count');
          const baseCount = Number(el?.dataset?.baseCount) || 201;
          const totalCount = baseCount + (commModels ? commModels.length : 0);
          if (el) {
            el.textContent = `${totalCount} MODELOS DISPONIBLES`;
          }
        } catch {}
      }
      syncHeaderModelCount();

      // Detección y Adaptación para Modo Escritorio (Tauri v2 Offline Workstation)
      const isDesktop = typeof window !== 'undefined' && (
        '__TAURI_INTERNALS__' in window ||
        '__TAURI__' in window ||
        window.location.hostname === 'tauri.localhost' ||
        window.location.protocol === 'tauri:'
      );
      if (isDesktop) {
        document.documentElement.classList.add('is-desktop-app');

        // 1. Logo conduce al Studio
        const brandLink = document.querySelector('.brand-logo');
        if (brandLink) {
          brandLink.setAttribute('href', '/studio');
          const badge = brandLink.querySelector('.brand-badge');
          if (badge) badge.textContent = 'DESKTOP';
        }

        // 2. Enlace al Catálogo Web Comunitario externo
        const catalogLinks = document.querySelectorAll('a[href="/"]');
        catalogLinks.forEach((link) => {
          if (link.classList.contains('nav-link') || link.textContent?.includes('Catálogo')) {
            link.textContent = '> Catálogo Web ↗';
            link.setAttribute('href', 'https://modelcoder.vercel.app');
            link.setAttribute('target', '_blank');
            link.setAttribute('rel', 'noopener noreferrer');
            link.setAttribute('title', 'Explorar catálogo de creaciones comunitarias en tu navegador web');
          }
        });

        // 3. Indicador de estado local offline
        const statusText = document.getElementById('header-models-count');
        if (statusText) {
          statusText.textContent = 'ESTUDIO OFFLINE';
          statusText.style.color = '#39ff14';
        }

        // 4. Botón de acceso directo a Texturas Locales en disco
        const navLinks = document.querySelector('.nav-links');
        if (navLinks && !document.getElementById('btn-desktop-textures')) {
          const btnTextures = document.createElement('button');
          btnTextures.id = 'btn-desktop-textures';
          btnTextures.className = 'nav-link';
          btnTextures.type = 'button';
          btnTextures.style.background = 'transparent';
          btnTextures.style.cursor = 'pointer';
          btnTextures.style.color = 'var(--ps1-cyan)';
          btnTextures.style.borderColor = 'var(--ps1-cyan)';
          btnTextures.textContent = '📂 Texturas';
          btnTextures.title = 'Abrir carpeta local de texturas personalizadas en disco';
          btnTextures.addEventListener('click', async () => {
            try {
              const invoke = (window as any).__TAURI_INTERNALS__?.invoke || (window as any).__TAURI__?.core?.invoke;
              if (invoke) {
                await invoke('open_textures_folder');
              }
            } catch (err) {
              console.warn('No se pudo invocar open_textures_folder:', err);
            }
          });
          const moreContainer = document.getElementById('nav-more-container');
          if (moreContainer) {
            navLinks.insertBefore(btnTextures, moreContainer);
          }
        }
      }

      const btnOpenAuth = document.getElementById('btn-open-auth');
      const authModal = document.getElementById('ps1-auth-modal');
      const btnCloseAuthModal = document.getElementById('btn-close-auth-modal');
      const userLoggedBox = document.getElementById('user-logged-box');
      const userProfileBtn = document.getElementById('user-profile-btn');
      const userDisplayName = document.getElementById('user-display-name');
      const userEmailText = document.getElementById('user-email-text');
      const userDropdownMenu = document.getElementById('user-dropdown-menu');
      const btnLogout = document.getElementById('btn-logout');

      const tabs = document.querySelectorAll('.auth-tab');
      const tabPanels = {
        oauth: document.getElementById('tab-oauth'),
        login: document.getElementById('tab-login'),
        signup: document.getElementById('tab-signup'),
      };
      const authStatusMsg = document.getElementById('auth-status-msg');

      function showStatus(text: string, isError = false) {
        if (!authStatusMsg) return;
        authStatusMsg.textContent = text;
        authStatusMsg.classList.remove('hidden', 'error', 'success');
        authStatusMsg.classList.add(isError ? 'error' : 'success');
      }

      function clearStatus() {
        if (!authStatusMsg) return;
        authStatusMsg.classList.add('hidden');
        authStatusMsg.textContent = '';
      }

      function openModal() {
        if (!authModal) return;
        authModal.classList.remove('hidden');
        clearStatus();
      }

      function closeModal() {
        if (!authModal) return;
        authModal.classList.add('hidden');
        clearStatus();
      }

      btnOpenAuth?.addEventListener('click', openModal);
      btnCloseAuthModal?.addEventListener('click', closeModal);

      // Close modal on backdrop click
      authModal?.addEventListener('click', (e) => {
        if (e.target === authModal) closeModal();
      });

      // Tab switcher
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          tabs.forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');
          const target = tab.getAttribute('data-tab');
          Object.keys(tabPanels).forEach((key) => {
            if (key === target) {
              tabPanels[key as keyof typeof tabPanels]?.classList.remove('hidden');
            } else {
              tabPanels[key as keyof typeof tabPanels]?.classList.add('hidden');
            }
          });
          clearStatus();
        });
      });

      // Toggle user profile dropdown
      userProfileBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        navMoreMenu?.classList.add('hidden');
        navMoreContainer?.classList.remove('open');
        userDropdownMenu?.classList.toggle('hidden');
      });

      // Toggle "⋯ MÁS" dropdown
      const btnToggleNavMore = document.getElementById('btn-toggle-nav-more');
      const navMoreMenu = document.getElementById('nav-more-menu');
      const navMoreContainer = document.getElementById('nav-more-container');

      btnToggleNavMore?.addEventListener('click', (e) => {
        e.stopPropagation();
        userDropdownMenu?.classList.add('hidden');
        navMoreMenu?.classList.toggle('hidden');
        const isOpen = !navMoreMenu?.classList.contains('hidden');
        btnToggleNavMore.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        navMoreContainer?.classList.toggle('open', isOpen);
      });

      document.addEventListener('click', () => {
        userDropdownMenu?.classList.add('hidden');
        navMoreMenu?.classList.add('hidden');
        navMoreContainer?.classList.remove('open');
        btnToggleNavMore?.setAttribute('aria-expanded', 'false');
      });

      // GitHub OAuth button
      document.getElementById('btn-auth-github')?.addEventListener('click', async () => {
        try {
          showStatus('Iniciando redirección a GitHub...');
          await signInWithGitHub();
        } catch (err: any) {
          showStatus(`Error OAuth: ${err?.message || err}`, true);
        }
      });

      // Form Login Email
      document.getElementById('form-login')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = (document.getElementById('login-email') as HTMLInputElement)?.value;
        const password = (document.getElementById('login-password') as HTMLInputElement)?.value;
        try {
          showStatus('Verificando credenciales...');
          await signInWithEmail(email, password);
          showStatus('¡Acceso correcto! Cargando sesión...', false);
          setTimeout(() => {
            closeModal();
            window.location.reload();
          }, 800);
        } catch (err: any) {
          showStatus(`Error: ${err?.message || err}`, true);
        }
      });

      // Form Signup Email
      document.getElementById('form-signup')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = (document.getElementById('signup-email') as HTMLInputElement)?.value;
        const password = (document.getElementById('signup-password') as HTMLInputElement)?.value;
        try {
          showStatus('Registrando nuevo piloto...');
          await signUpWithEmail(email, password);
          showStatus('¡Cuenta creada! Revisa tu bandeja de entrada si requiere confirmación.', false);
        } catch (err: any) {
          showStatus(`Error al registrar: ${err?.message || err}`, true);
        }
      });

      // Logout button
      btnLogout?.addEventListener('click', async () => {
        await signOut();
      });

      // Auth state observer
      async function updateSessionUI(user: any) {
        const navCollabLink = document.getElementById('nav-collab-link');
        if (user) {
          btnOpenAuth?.classList.add('hidden');
          userLoggedBox?.classList.remove('hidden');
          const name = user.user_metadata?.user_name || user.user_metadata?.name || user.email?.split('@')[0] || 'PILOTO';
          if (userDisplayName) userDisplayName.textContent = `@${name.toUpperCase()}`;
          if (userEmailText) userEmailText.textContent = user.email || '';

          // Verificar si es colaborador para mostrar el acceso directo
          const { isCollaborator, role } = await checkUserRole(user);
          if (navCollabLink) {
            navCollabLink.style.display = isCollaborator ? 'inline-flex' : 'none';
            if (role === 'owner') {
              navCollabLink.textContent = '👑 Colaboradores';
            }
          }
        } else {
          btnOpenAuth?.classList.remove('hidden');
          userLoggedBox?.classList.add('hidden');
          if (navCollabLink) navCollabLink.style.display = 'none';
        }
      }

      // Check current session
      // ==========================================
      // GESTOR DE INVENTARIO, FAVORITOS Y COLECCIONES
      // ==========================================
      const btnOpenInventory = document.getElementById('btn-open-global-inventory');
      const dropdownOpenInventory = document.getElementById('dropdown-open-inventory');
      const invModal = document.getElementById('ps1-inventory-modal');
      const btnCloseInvModal = document.getElementById('btn-close-inventory-modal');
      const globalInvCountEl = document.getElementById('global-inv-count');

      const invTabDraftsCount = document.getElementById('inv-tab-drafts-count');
      const invTabFavsCount = document.getElementById('inv-tab-favs-count');
      const invTabCollsCount = document.getElementById('inv-tab-colls-count');

      const invDraftsList = document.getElementById('inv-drafts-list');
      const invFavoritesList = document.getElementById('inv-favorites-list');
      const invCollectionsList = document.getElementById('inv-collections-list');

      const invTabBtns = document.querySelectorAll('.inv-tab-btn');
      const invPanels: Record<string, HTMLElement | null> = {
        drafts: document.getElementById('inv-panel-drafts'),
        favorites: document.getElementById('inv-panel-favorites'),
        collections: document.getElementById('inv-panel-collections')
      };

      function updateInventoryBadgeCounts(): void {
        const drafts = getProjectDrafts();
        const favs = getFavorites();
        const colls = getCollections();

        const total = drafts.length + favs.length;
        if (globalInvCountEl) globalInvCountEl.textContent = `${total}`;
        if (invTabDraftsCount) invTabDraftsCount.textContent = `${drafts.length}`;
        if (invTabFavsCount) invTabFavsCount.textContent = `${favs.length}`;
        if (invTabCollsCount) invTabCollsCount.textContent = `${colls.length}`;
      }

      function renderInvDrafts(): void {
        if (!invDraftsList) return;
        const drafts = getProjectDrafts();
        if (drafts.length === 0) {
          invDraftsList.innerHTML = `
            <div class="ps1-inset" style="padding: 2rem 1rem; text-align: center; color: var(--text-dim); background: #070d18;">
              <div style="font-size: 2.2rem; margin-bottom: 0.4rem;">📁</div>
              <p style="font-family: var(--font-pixel); font-size: 0.78rem; color: var(--ps1-gold); margin-bottom: 0.35rem;">
                NO TIENES BORRADORES NI PROYECTOS GUARDADOS
              </p>
              <span style="font-size: 0.75rem;">
                Entra a <a href="/studio" style="color: var(--ps1-cyan); text-decoration: underline;">Studio 3D</a> y guarda tu avance con 💾 GUARDAR para retomarlo cuando quieras.
              </span>
            </div>
          `;
          return;
        }

        invDraftsList.innerHTML = '';
        drafts.forEach(draft => {
          const item = document.createElement('div');
          item.className = 'ps1-inset';
          item.style.padding = '0.75rem';
          item.style.background = '#090e1c';
          item.style.border = '1px solid var(--ps1-steel)';
          const dStr = new Date(draft.updated_at).toLocaleString();

          const safeName = escapeHtml(draft.name);
          const safeCat = escapeHtml(draft.category);
          const safeDesc = escapeHtml(draft.description || 'Sin notas.');
          const safeId = escapeHtml(draft.id);

          item.innerHTML = `
            <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
              <div style="width: 64px; height: 64px; background: #060911; border: 1px solid var(--ps1-steel); display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden;">
                ${draft.thumbnail
                  ? `<img src="${escapeHtml(draft.thumbnail)}" alt="${safeName}" style="width: 100%; height: 100%; object-fit: contain;" />`
                  : `<span style="font-size: 1.5rem;">📦</span>`
                }
              </div>
              <div style="flex-grow: 1; min-width: 180px;">
                <div style="display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.2rem; flex-wrap: wrap;">
                  <strong style="font-family: var(--font-pixel); font-size: 0.78rem; color: var(--ps1-gold);">${safeName}</strong>
                  <span class="category-badge category-${safeCat}" style="font-size: 0.65rem;">${safeCat}</span>
                </div>
                <p style="font-size: 0.72rem; color: var(--text-dim); margin: 0 0 0.3rem 0;">
                  ${safeDesc}
                </p>
                <div style="font-size: 0.68rem; color: var(--ps1-cyan); display: flex; gap: 0.5rem; flex-wrap: wrap;">
                  <span>📐 ${Number(draft.components_count) || 0} piezas</span>
                  <span>&bull;</span>
                  <span>🔺 ~${Number(draft.tri_count) || 0} tris</span>
                  <span>&bull;</span>
                  <span style="color: var(--text-dim);">🕒 ${escapeHtml(dStr)}</span>
                </div>
              </div>
              <div style="display: flex; gap: 0.35rem; align-items: center;">
                <a href="/studio?draft=${encodeURIComponent(draft.id)}" class="btn-mini btn-gold" style="text-decoration: none;">
                  ⚡ RETOMAR EN STUDIO
                </a>
                <button type="button" class="btn-mini btn-danger btn-del-inv-draft" data-id="${safeId}" title="Eliminar borrador">
                  🗑️
                </button>
              </div>
            </div>
          `;
          invDraftsList.appendChild(item);
        });

        invDraftsList.querySelectorAll('.btn-del-inv-draft').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const id = (e.currentTarget as HTMLElement).dataset.id;
            if (!id) return;
            if (confirm('¿Eliminar este borrador?')) {
              deleteProjectDraft(id);
              updateInventoryBadgeCounts();
              renderInvDrafts();
            }
          });
        });
      }

      function renderInvFavorites(): void {
        if (!invFavoritesList) return;
        const favs = getFavorites();
        if (favs.length === 0) {
          invFavoritesList.innerHTML = `
            <div class="ps1-inset" style="padding: 2rem 1rem; text-align: center; color: var(--text-dim); background: #070d18;">
              <div style="font-size: 2.2rem; margin-bottom: 0.4rem;">⭐</div>
              <p style="font-family: var(--font-pixel); font-size: 0.78rem; color: var(--ps1-gold); margin-bottom: 0.35rem;">
                NO TIENES MODELOS EN FAVORITOS
              </p>
              <span style="font-size: 0.75rem;">
                Explora el catálogo y marca con estrella ⭐ los modelos que quieras guardar en tu inventario.
              </span>
            </div>
          `;
          return;
        }

        invFavoritesList.innerHTML = '';
        favs.forEach(fav => {
          const item = document.createElement('div');
          item.className = 'ps1-inset';
          item.style.padding = '0.75rem';
          item.style.background = '#090e1c';
          item.style.border = '1px solid var(--ps1-steel)';
          const dStr = new Date(fav.added_at).toLocaleDateString();
          const safeFavName = escapeHtml(fav.name);
          const safeFavCat = escapeHtml(fav.category);
          const safeFavId = escapeHtml(fav.id);

          item.innerHTML = `
            <div style="display: flex; gap: 0.75rem; align-items: center; justify-content: space-between; flex-wrap: wrap;">
              <div>
                <div style="display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.2rem; flex-wrap: wrap;">
                  <span style="color: var(--ps1-gold);">⭐</span>
                  <strong style="font-family: var(--font-pixel); font-size: 0.8rem; color: var(--ps1-gold);">${safeFavName}</strong>
                  <span class="category-badge category-${safeFavCat}" style="font-size: 0.65rem;">${safeFavCat}</span>
                  <span class="ps1-telemetry-tag" style="font-size: 0.65rem;">${escapeHtml(fav.type.toUpperCase())}</span>
                </div>
                <span style="font-size: 0.7rem; color: var(--text-dim);">Agregado: ${escapeHtml(dStr)}</span>
              </div>
              <div style="display: flex; gap: 0.4rem; align-items: center;">
                <a href="${fav.type === 'catalog' ? `/generators/${encodeURIComponent(fav.id)}` : '/studio'}" class="btn-mini btn-cyan" style="text-decoration: none;">
                  👁️ VER EN 3D
                </a>
                <button type="button" class="btn-mini btn-outline btn-del-inv-fav" data-id="${safeFavId}" title="Quitar de favoritos">
                  ✕ QUITAR
                </button>
              </div>
            </div>
          `;
          invFavoritesList.appendChild(item);
        });

        invFavoritesList.querySelectorAll('.btn-del-inv-fav').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const id = (e.currentTarget as HTMLElement).dataset.id;
            if (!id) return;
            const item = favs.find(f => f.id === id);
            if (item) {
              toggleFavorite(item);
              updateInventoryBadgeCounts();
              renderInvFavorites();
            }
          });
        });
      }

      function renderInvCollections(): void {
        if (!invCollectionsList) return;
        const colls = getCollections();
        if (colls.length === 0) {
          invCollectionsList.innerHTML = `
            <div class="ps1-inset" style="padding: 2rem 1rem; text-align: center; color: var(--text-dim); background: #070d18;">
              <div style="font-size: 2.2rem; margin-bottom: 0.4rem;">🗂️</div>
              <p style="font-family: var(--font-pixel); font-size: 0.78rem; color: var(--ps1-gold); margin-bottom: 0.35rem;">
                NO HAS CREADO COLECCIONES AÚN
              </p>
              <span style="font-size: 0.75rem;">
                Crea una colección como "Estación Subterránea" o "Módulo Médico" para organizar tus sets de assets.
              </span>
            </div>
          `;
          return;
        }

        invCollectionsList.innerHTML = '';
        colls.forEach(coll => {
          const item = document.createElement('div');
          item.className = 'ps1-inset';
          item.style.padding = '0.75rem';
          item.style.background = '#090e1c';
          item.style.border = '1px solid var(--ps1-steel)';

          const modelIds = Array.isArray(coll.model_ids) ? coll.model_ids : [];
          const safeCollId = escapeHtml(coll.id);
          const safeCollName = escapeHtml(coll.name);
          const safeCollDesc = escapeHtml(coll.description || 'Colección personalizada de modelos procedurales.');

          item.innerHTML = `
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; flex-wrap: wrap; gap: 0.4rem;">
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 1.1rem;">🗂️</span>
                <strong style="font-family: var(--font-pixel); font-size: 0.82rem; color: var(--ps1-cyan);">${safeCollName}</strong>
                <span class="ps1-telemetry-tag" style="font-size: 0.65rem;">${modelIds.length} MODELOS</span>
              </div>
              <button type="button" class="btn-mini btn-danger btn-del-coll" data-id="${safeCollId}" title="Eliminar colección">
                🗑️ ELIMINAR
              </button>
            </div>
            <p style="font-size: 0.74rem; color: var(--text-dim); margin: 0 0 0.5rem 0;">
              ${safeCollDesc}
            </p>
            ${modelIds.length > 0 ? `
              <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.5rem;">
                ${modelIds.map(id => {
                  const safeMid = escapeHtml(id);
                  return `<span class="ps1-telemetry-tag" style="font-size: 0.68rem; background: #060911; display: inline-flex; align-items: center; gap: 0.35rem; padding: 2px 6px;">
                    <a href="/generators/${encodeURIComponent(id)}" style="color: var(--ps1-cyan); text-decoration: none;" title="Abrir modelo #${safeMid}">#${safeMid}</a>
                    <button type="button" class="btn-remove-coll-model" data-coll-id="${safeCollId}" data-model-id="${safeMid}" title="Quitar #${safeMid} de la colección" style="background:none; border:none; color:var(--ps1-red); cursor:pointer; font-size:0.68rem; padding:0; line-height:1;">✕</button>
                  </span>`;
                }).join('')}
              </div>
            ` : `<div style="font-size: 0.7rem; color: var(--text-dim); font-style: italic; margin-bottom: 0.5rem;">Colección vacía. Añade modelos desde la vista de cualquier generador o escribe su ID aquí abajo:</div>`}
            <div style="display: flex; gap: 0.35rem; align-items: center; margin-top: 0.35rem;">
              <input type="text" class="ps1-input input-add-coll-model" data-coll-id="${safeCollId}" placeholder="Añadir ID de modelo (ej. crate, arcade_cabinet)..." style="font-size: 0.7rem; padding: 0.25rem 0.45rem; flex: 1;" />
              <button type="button" class="btn-mini btn-cyan btn-add-coll-model" data-coll-id="${safeCollId}">+ AÑADIR</button>
            </div>
          `;
          invCollectionsList.appendChild(item);
        });

        invCollectionsList.querySelectorAll('.btn-del-coll').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const id = (e.currentTarget as HTMLElement).dataset.id;
            if (!id) return;
            if (confirm('¿Eliminar esta colección?')) {
              deleteCollection(id);
              updateInventoryBadgeCounts();
              renderInvCollections();
            }
          });
        });

        invCollectionsList.querySelectorAll('.btn-remove-coll-model').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const el = e.currentTarget as HTMLElement;
            const collId = el.dataset.collId;
            const modelId = el.dataset.modelId;
            if (!collId || !modelId) return;
            toggleModelInCollection(collId, modelId);
            updateInventoryBadgeCounts();
            renderInvCollections();
          });
        });

        invCollectionsList.querySelectorAll('.btn-add-coll-model').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const el = e.currentTarget as HTMLElement;
            const collId = el.dataset.collId;
            if (!collId) return;
            const input = invCollectionsList.querySelector(`.input-add-coll-model[data-coll-id="${collId}"]`) as HTMLInputElement | null;
            const rawId = input?.value?.trim().toLowerCase().replace(/^#/, '');
            if (!rawId) {
              input?.focus();
              return;
            }
            toggleModelInCollection(collId, rawId);
            if (input) input.value = '';
            updateInventoryBadgeCounts();
            renderInvCollections();
          });
        });
      }

      function openInventoryModal(defaultTab = 'drafts'): void {
        if (!invModal) return;
        updateInventoryBadgeCounts();
        invTabBtns.forEach(btn => {
          if (btn.getAttribute('data-tab') === defaultTab) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });
        Object.entries(invPanels).forEach(([key, panel]) => {
          if (panel) {
            panel.classList.toggle('hidden', key !== defaultTab);
          }
        });
        if (defaultTab === 'drafts') renderInvDrafts();
        else if (defaultTab === 'favorites') renderInvFavorites();
        else if (defaultTab === 'collections') renderInvCollections();

        invModal.classList.remove('hidden');
      }

      function closeInventoryModal(): void {
        if (!invModal) return;
        invModal.classList.add('hidden');
      }

      btnOpenInventory?.addEventListener('click', () => openInventoryModal('drafts'));
      dropdownOpenInventory?.addEventListener('click', () => {
        userDropdownMenu?.classList.add('hidden');
        openInventoryModal('drafts');
      });
      btnCloseInvModal?.addEventListener('click', closeInventoryModal);
      invModal?.addEventListener('click', (e) => {
        if (e.target === invModal) closeInventoryModal();
      });

      // Global Escape key listener to close Auth and Inventory modals
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          if (invModal && !invModal.classList.contains('hidden')) {
            closeInventoryModal();
          }
          if (authModal && !authModal.classList.contains('hidden')) {
            closeModal();
          }
        }
      });

      invTabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          invTabBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const tabKey = btn.getAttribute('data-tab') || 'drafts';
          Object.entries(invPanels).forEach(([key, panel]) => {
            if (panel) panel.classList.toggle('hidden', key !== tabKey);
          });
          if (tabKey === 'drafts') renderInvDrafts();
          else if (tabKey === 'favorites') renderInvFavorites();
          else if (tabKey === 'collections') renderInvCollections();
        });
      });

      // Collections creation form
      const btnCreateCollection = document.getElementById('btn-create-collection');
      const invCreateCollForm = document.getElementById('inv-create-coll-form');
      const btnSubmitNewColl = document.getElementById('btn-submit-new-coll');
      const btnCancelNewColl = document.getElementById('btn-cancel-new-coll');
      const inputNewCollName = document.getElementById('new-coll-name') as HTMLInputElement | null;
      const inputNewCollDesc = document.getElementById('new-coll-desc') as HTMLInputElement | null;

      btnCreateCollection?.addEventListener('click', () => {
        if (invCreateCollForm) invCreateCollForm.classList.remove('hidden');
        if (inputNewCollName) inputNewCollName.focus();
      });

      btnCancelNewColl?.addEventListener('click', () => {
        if (invCreateCollForm) invCreateCollForm.classList.add('hidden');
      });

      btnSubmitNewColl?.addEventListener('click', () => {
        const name = inputNewCollName?.value?.trim();
        const desc = inputNewCollDesc?.value?.trim() || '';
        if (!name) {
          if (inputNewCollName) {
            inputNewCollName.style.borderColor = 'var(--ps1-red)';
            inputNewCollName.placeholder = '⚠️ Escribe un nombre para la colección...';
            inputNewCollName.focus();
          }
          return;
        }
        if (inputNewCollName) inputNewCollName.style.borderColor = '';
        saveCollection({ name, description: desc });
        if (inputNewCollName) inputNewCollName.value = '';
        if (inputNewCollDesc) inputNewCollDesc.value = '';
        if (invCreateCollForm) invCreateCollForm.classList.add('hidden');
        updateInventoryBadgeCounts();
        renderInvCollections();
      });

      updateInventoryBadgeCounts();
      window.addEventListener('modelcoder:inventory_updated', () => {
        updateInventoryBadgeCounts();
        if (invModal && !invModal.classList.contains('hidden')) {
          const activeTabBtn = document.querySelector('.inv-tab-btn.active');
          const activeTab = activeTabBtn?.getAttribute('data-tab') || 'drafts';
          if (activeTab === 'drafts') renderInvDrafts();
          else if (activeTab === 'favorites') renderInvFavorites();
          else if (activeTab === 'collections') renderInvCollections();
        }
      });

      // Check current session
      const supabase = getSupabase();
      if (supabase) {
        supabase.auth.getUser().then(({ data }) => {
          updateSessionUI(data.user);
        });
        onAuthStateChange((user) => {
          updateSessionUI(user);
        });
      }
    </script>

