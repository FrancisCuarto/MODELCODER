                <div style="flex: 1; min-width: 180px;">
                  <label for="new-coll-name" class="inv-field-lbl">Nombre</label>
                  <input type="text" id="new-coll-name" class="ps1-input" placeholder="Ej: Laboratorio Subterráneo" style="width: 100%;" />
                </div>
                <div style="flex: 1; min-width: 180px;">
                  <label for="new-coll-desc" class="inv-field-lbl">Descripción (opcional)</label>
                  <input type="text" id="new-coll-desc" class="ps1-input" placeholder="Props para el sector médico..." style="width: 100%;" />
                </div>
                <div style="display: flex; gap: 0.4rem;">
                  <button id="btn-submit-new-coll" class="btn btn-primary btn-sm" type="button">Crear</button>
                  <button id="btn-cancel-new-coll" class="btn btn-outline btn-sm" type="button">Cancelar</button>
                </div>
              </div>
            </div>
            <div id="inv-collections-list" class="inv-items-list"></div>
          </div>
        </div>
      </div>
    </div>

    {!hideGlobalNav && (
    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-col">
          <div class="footer-brand-header">
            <img src="/logo.png" alt="ModelCoder Logo" class="footer-brand-logo" width="28" height="28" />
            <span class="footer-brand-title">ModelCoder</span>
          </div>
          <p class="footer-desc">
            Plataforma abierta para diseñar, personalizar y exportar modelos 3D low-poly en formato universal GLB para Godot 4, Unity y Blender.
          </p>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">Recursos</h4>
          <ul class="footer-links-list">
            <li><a href="/">Catálogo 3D</a></li>
            <li><a href="/studio">Studio 3D Online</a></li>
            <li><a href="/docs">Documentación</a></li>
            <li><a href="/devlog">Devlog</a></li>
            <li><a href="/contribute">Cómo contribuir</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">IV Orbit Games</h4>
          <ul class="footer-links-list">
            <li><a href="https://ivorbitgames.online" target="_blank" rel="noopener noreferrer">Web Oficial ↗</a></li>
            <li><a href="https://ivorbitgames.online/herramientas/texture-studio" target="_blank" rel="noopener noreferrer">Texture Studio PBR ↗</a></li>
            <li><a href="https://iv-orbit.itch.io/belownominal" target="_blank" rel="noopener noreferrer">Below Nominal ↗</a></li>
            <li><a href="https://ivorbitgames.online/juegos/puchito" target="_blank" rel="noopener noreferrer">Puchito ↗</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">Comunidad</h4>
          <ul class="footer-links-list">
            <li><a href="https://github.com/FrancisCuarto/MODELCODER" target="_blank" rel="noopener noreferrer">GitHub Open Source ↗</a></li>
            <li><a href="https://www.youtube.com/@Franciscuarto" target="_blank" rel="noopener noreferrer">YouTube (@Franciscuarto) ↗</a></li>
            <li><a href="https://iv-orbit.itch.io" target="_blank" rel="noopener noreferrer">itch.io ↗</a></li>
            <li><a href="https://ivorbitgames.online/contacto" target="_blank" rel="noopener noreferrer">Contacto ↗</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom-bar">
        <span>© 2026 IV Orbit Games · Franciscuarto · Buenos Aires, Argentina · Licencia CC-BY 4.0</span>
        <div class="footer-bottom-links">
          <a href="/docs">Documentación</a>
          <a href="https://github.com/FrancisCuarto/MODELCODER" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </footer>
    )}

    <script>
      import { getSupabase, signInWithGitHub, signInWithEmail, signUpWithEmail, signOut, onAuthStateChange, checkUserRole, getCommunityModels, getSessionExportCode, importSessionFromCode } from '../lib/supabase';
      import { isTauriDesktop, initDesktopLinkInterceptor, openInExternalBrowser, getTauriInvoke } from '../lib/tauri-bridge';
      import {
        getProjectDrafts,
        getFavorites,
        getCollections,
        deleteProjectDraft,
        deleteCollection,
        toggleFavorite,
        saveCollection,
        toggleModelInCollection
      } from '../lib/user-inventory';

      initDesktopLinkInterceptor();

      function escapeHtml(str: unknown): string {
        return String(str ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      async function syncHeaderModelCount() {
        try {
          const commModels = await getCommunityModels({ onlyPublic: true });
          const el = document.getElementById('header-models-count');
          const baseCount = Number(el?.dataset?.baseCount) || 201;
          const totalCount = baseCount + (commModels ? commModels.length : 0);
          if (el) {
            el.textContent = `${totalCount} modelos`;
          }
        } catch {}
      }
      syncHeaderModelCount();

      const isDesktop = isTauriDesktop();
      if (isDesktop) {
        document.documentElement.classList.add('is-desktop-app');
