              </span>
              <button id="btn-create-collection" class="btn-mini btn-cyan" type="button">
                ➕ NUEVA COLECCIÓN
              </button>
            </div>
            <div id="inv-create-coll-form" class="ps1-inset hidden" style="padding: 0.75rem; margin-bottom: 1rem; background: #07101e;">
              <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: flex-end;">
                <div style="flex-grow: 1; min-width: 200px;">
                  <label for="new-coll-name" style="display: block; font-family: var(--font-pixel); font-size: 0.7rem; color: var(--ps1-gold); margin-bottom: 0.25rem;">NOMBRE DE LA COLECCIÓN</label>
