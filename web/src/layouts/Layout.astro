          <span class="brand-bracket">[</span>
          <span class="brand-name">MODELCODER</span>
          <span class="brand-bracket">]</span>
          <span class="brand-badge">MODELOS 3D</span>
        </a>

        <div class="system-status-indicator" title="Modelos 3D disponibles para personalizar y descargar">
          <span class="status-dot"></span>
          <span id="header-models-count" class="status-text" data-base-count={baseModelsCount}>{baseModelsCount} MODELOS DISPONIBLES</span>
        </div>

        <nav class="nav-links">
          <a href="/" class="nav-link">&gt; Catálogo</a>
          <a href="/studio" class="nav-link nav-link-studio" style="color: var(--ps1-gold); border-color: var(--ps1-gold);">&gt; Studio 3D (Crear)</a>

          <!-- Menú Desplegable Retro PS1: Más Opciones / Explorar -->
          <div id="nav-more-container" class="nav-more-container">
            <button id="btn-toggle-nav-more" class="nav-link nav-more-trigger" type="button" aria-haspopup="menu" aria-expanded="false" title="Más herramientas y enlaces">
              <span>⋯ MÁS</span>
              <span class="nav-caret">▼</span>
            </button>
            <div id="nav-more-menu" class="nav-more-menu-ps1 hidden" role="menu">
              <a href="/devlog" class="more-dropdown-item" role="menuitem">
                <span class="item-icon">📰</span>
                <span>&gt; Devlog & Actualizaciones</span>
                <span class="badge-new">NEW</span>
              </a>
              <a href="/docs" class="more-dropdown-item" role="menuitem">
                <span class="item-icon">📖</span>
                <span>&gt; Documentación</span>
              </a>
              <button id="btn-open-global-inventory" class="more-dropdown-item" type="button" role="menuitem" title="Mi Inventario: Borradores, Favoritos y Colecciones">
                <span class="item-icon">🎒</span>
                <span>&gt; Mi Inventario (<span id="global-inv-count">0</span>)</span>
              </button>
              <a href="/contribute" class="more-dropdown-item" role="menuitem">
                <span class="item-icon">ℹ️</span>
                <span>&gt; Cómo funciona</span>
              </a>
              <a href="/colaboradores" id="nav-collab-link" class="more-dropdown-item" style="display: none; color: var(--ps1-gold);" role="menuitem">
                <span class="item-icon">👑</span>
                <span>&gt; Portal Colaboradores</span>
              </a>
              <div class="more-dropdown-divider"></div>
              <a href="https://ivorbitgames.online" target="_blank" rel="noopener noreferrer" class="more-dropdown-item item-external" role="menuitem" title="Estudio Creador: IV Orbit Games (Argentina)">
                <span class="item-icon">🪐</span>
                <span>IV Orbit Games ↗</span>
              </a>
              <a href="https://github.com/FrancisCuarto/MODELCODER" target="_blank" rel="noopener noreferrer" class="more-dropdown-item item-external" role="menuitem" title="Ver código fuente en GitHub">
                <span class="item-icon">🐱</span>
                <span>GitHub ↗</span>
              </a>
