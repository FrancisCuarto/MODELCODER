    const fileName = preset.replace(/^(local|custom):/, '');
    try {
      const dataUrl = await invoke('read_local_texture_data_url', { fileName }) as string;
      if (dataUrl) {
        TextureLibrary.registerCustomTexture(preset, dataUrl);
        TextureLibrary.registerCustomTexture(fileName, dataUrl);
        TextureLibrary.registerCustomTexture('local:' + fileName, dataUrl);
