  }

  /* Docs Modal */
  .docs-modal {
    width: 900px;
    max-width: 95vw;
    height: 600px;
    background: #080c16;
    border: 2px solid var(--ps1-cyan);
    color: #e2e8f0;
    padding: 0;
  }

  .docs-modal-body {
    display: grid;
    grid-template-columns: 240px 1fr;
    height: calc(100% - 35px);
  }

  .docs-nav-tabs {
    background: #04060c;
    border-right: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .doc-tab {
    background: transparent;
    border: none;
