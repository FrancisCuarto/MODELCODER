<script is:inline>
  // Self-healing watchdog: if a stale cached HTML references an old chunk hash right after a deployment,
  // automatically reload once with cache-busting so the Studio UI never stays uninitialized.
  window.__modelcoderStudioReady = false;
  window.addEventListener('load', function () {
    setTimeout(function () {
      if (!window.__modelcoderStudioReady && !window.location.search.includes('_cb=')) {
        var sep = window.location.search ? '&' : '?';
        window.location.replace(window.location.pathname + window.location.search + sep + '_cb=' + Date.now());
      }
    }, 2200);
  });
</script>

