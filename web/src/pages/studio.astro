        "parameters": [
          { "key": "core_height", "label": "Altura del Reactor (m)", "type": "float", "default": 1.80, "min": 1.20, "max": 3.00, "step": 0.10, "group": "Dimensiones" },
          { "key": "core_radius", "label": "Radio (m)", "type": "float", "default": 0.50, "min": 0.30, "max": 0.90, "step": 0.05, "group": "Dimensiones" },
