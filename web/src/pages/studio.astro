  // State
  let activeTemplate = 'crate';
  let activeFile = 'generator';
  const fileContents: Record<string, string> = { ...TEMPLATES['crate'] };

  // DOM Elements
  const codeTextarea = document.getElementById('code-textarea') as HTMLTextAreaElement;
  const lineNumbers = document.getElementById('line-numbers');
  const templateSelect = document.getElementById('template-select') as HTMLSelectElement;
  const editorTabs = document.querySelectorAll('.editor-tab');
  const cursorPos = document.getElementById('cursor-pos');
  const activeFilenameEl = document.getElementById('active-filename');
  const linterBadge = document.getElementById('linter-badge');
  const linterText = document.getElementById('linter-text');
  const studioViewer = document.getElementById('studio-viewer') as any;
  const viewportModelName = document.getElementById('viewport-model-name');
  const studioParamForm = document.getElementById('studio-param-form') as HTMLFormElement;
  const runCompileBtn = document.getElementById('run-compile-btn');
  const exportZipBtn = document.getElementById('export-zip-btn');
  const githubPrBtn = document.getElementById('github-pr-btn');
  const githubModal = document.getElementById('github-modal') as HTMLDialogElement;
  const closeModalBtn = document.getElementById('close-modal-btn');
  const modalCancelBtn = document.getElementById('modal-cancel-btn');
  const submitPrBtn = document.getElementById('submit-pr-btn');
  const prStatusBox = document.getElementById('pr-status-box');
  const ghTokenInput = document.getElementById('gh-token-input') as HTMLInputElement;
  const rotateToggleBtn = document.getElementById('studio-rotate-toggle');
  const resetCamBtn = document.getElementById('studio-reset-cam');

  // Update Line Numbers
  function updateLineNumbers() {
    if (!lineNumbers || !codeTextarea) return;
    const lines = codeTextarea.value.split('\n').length;
    let nums = '';
    for (let i = 1; i <= lines; i++) {
      nums += i + '\n';
    }
    lineNumbers.textContent = nums;
  }

  // AST Security Linter (Client-side regex & keyword scanner)
  function runLinter() {
    if (!linterBadge || !linterText) return;
    const code = fileContents['generator'] || '';

    const forbidden = [
      { pattern: /import\s+os(\s+|$|,)/, name: 'os' },
      { pattern: /import\s+subprocess/, name: 'subprocess' },
      { pattern: /import\s+sys(\s+|$|,)/, name: 'sys' },
      { pattern: /import\s+socket/, name: 'socket' },
      { pattern: /import\s+urllib/, name: 'urllib' },
      { pattern: /import\s+requests/, name: 'requests' },
      { pattern: /__import__/, name: '__import__' },
      { pattern: /eval\s*\(/, name: 'eval' },
      { pattern: /exec\s*\(/, name: 'exec' }
    ];

    for (const rule of forbidden) {
      if (rule.pattern.test(code)) {
        linterBadge.style.color = 'var(--ps1-red)';
        linterText.textContent = `SECURITY_ALERT: LLAMADA PROHIBIDA [${rule.name}]`;
        return false;
      }
    }

    if (!code.includes('BaseAssetGenerator')) {
      linterBadge.style.color = 'var(--ps1-gold)';
      linterText.textContent = 'WARNING: Debe heredar de BaseAssetGenerator';
      return true;
    }

    linterBadge.style.color = 'var(--ps1-green)';
    linterText.textContent = 'AST_SECURITY: VALID // 0 ERRORS';
    return true;
  }

  // Load active file into editor
  function loadFile(fileKey: string) {
    activeFile = fileKey;
    editorTabs.forEach((tab) => {
      tab.classList.toggle('active', tab.getAttribute('data-file') === fileKey);
    });
    if (activeFilenameEl) {
      activeFilenameEl.textContent = `${fileKey}.${fileKey === 'manifest' ? 'json' : fileKey === 'readme' ? 'md' : 'py'}`;
    }
    if (codeTextarea) {
      codeTextarea.value = fileContents[fileKey] || '';
      updateLineNumbers();
    }
  }

  // Re-build Inspector Form dynamically from manifest.json
  function syncInspectorFromManifest() {
    if (!studioParamForm) return;
    studioParamForm.innerHTML = '';

    try {
      const manifest = JSON.parse(fileContents['manifest'] || '{}');
      const params = manifest.parameters || [];

      params.forEach((p: any) => {
        const row = document.createElement('div');
        row.className = 'studio-input-row';
        row.dataset.key = p.key;

        const labelRow = document.createElement('div');
        labelRow.className = 'studio-label-row';

        const label = document.createElement('label');
        label.textContent = `> ${p.label || p.key}:`;
        labelRow.appendChild(label);

        if (p.type === 'float' || p.type === 'int') {
          const valDisplay = document.createElement('span');
          valDisplay.className = 'studio-val-display';
          valDisplay.id = `studio-val-${p.key}`;
          valDisplay.textContent = String(p.default);
          labelRow.appendChild(valDisplay);
        }

        row.appendChild(labelRow);

        if (p.type === 'float') {
          const input = document.createElement('input');
          input.type = 'range';
          input.name = p.key;
          input.min = String(p.min !== undefined ? p.min : 0.1);
          input.max = String(p.max !== undefined ? p.max : 3.0);
          input.step = String(p.step || 0.05);
          input.value = String(p.default);
          input.className = 'form-range';
          input.addEventListener('input', () => {
            const disp = document.getElementById(`studio-val-${p.key}`);
            if (disp) disp.textContent = input.value;
            applyStudioLiveTransforms();
          });
          row.appendChild(input);
        } else if (p.type === 'enum' && p.options) {
          const select = document.createElement('select');
          select.name = p.key;
          select.className = 'form-select';
          p.options.forEach((opt: any) => {
            const o = document.createElement('option');
            o.value = opt.value;
            o.textContent = opt.label || opt.value;
            if (opt.value === p.default) o.selected = true;
            select.appendChild(o);
          });
          select.addEventListener('change', applyStudioLiveTransforms);
          row.appendChild(select);
        } else if (p.type === 'boolean') {
          const toggleWrap = document.createElement('label');
          toggleWrap.className = 'toggle-switch';
          const checkbox = document.createElement('input');
          checkbox.type = 'checkbox';
          checkbox.name = p.key;
          checkbox.checked = Boolean(p.default);
          const slider = document.createElement('span');
          slider.className = 'slider';
          toggleWrap.appendChild(checkbox);
          toggleWrap.appendChild(slider);
          checkbox.addEventListener('change', applyStudioLiveTransforms);
          row.appendChild(toggleWrap);
        }

        studioParamForm.appendChild(row);
      });
    } catch (e) {
      // Manifest not valid JSON yet, wait for user
    }
  }

  // Real-time live 3D transform & material application
  function applyStudioLiveTransforms() {
    if (!studioViewer || !studioParamForm) return;

    // Dimensional scaling
    let sx = 1.0, sy = 1.0, sz = 1.0;
    const wInput = studioParamForm.elements.namedItem('width') as HTMLInputElement;
    if (wInput) sx = parseFloat(wInput.value) || 1.0;

    const lInput = (studioParamForm.elements.namedItem('length') || studioParamForm.elements.namedItem('depth')) as HTMLInputElement;
    if (lInput) sy = parseFloat(lInput.value) || 1.0;

    const hInput = studioParamForm.elements.namedItem('height') as HTMLInputElement;
    if (hInput) sz = parseFloat(hInput.value) || 1.0;

    studioViewer.scale = `${Math.min(2.5, Math.max(0.4, sx))} ${Math.min(2.5, Math.max(0.4, sy))} ${Math.min(2.5, Math.max(0.4, sz))}`;

    // Palette model swapping
    const palSelect = (studioParamForm.elements.namedItem('palette_name') || studioParamForm.elements.namedItem('palette')) as HTMLSelectElement;
    const pal = palSelect ? palSelect.value : 'industrial_hazard';

    if (activeTemplate !== 'custom') {
      const targetPaletteGlb = `/models/${activeTemplate}_${pal}.glb`;
      if (!studioViewer.src || !studioViewer.src.endsWith(targetPaletteGlb)) {
        studioViewer.src = targetPaletteGlb;
      }
    }
  }

  // Load Template
  function loadTemplate(tplKey: string) {
    activeTemplate = tplKey;
    const tpl = TEMPLATES[tplKey] || TEMPLATES['crate'];
    fileContents['generator'] = tpl.generator;
    fileContents['config'] = tpl.config;
    fileContents['manifest'] = tpl.manifest;
    fileContents['readme'] = tpl.readme;

    if (studioViewer) {
      studioViewer.src = tpl.model;
      studioViewer.scale = '1 1 1';
    }
    if (viewportModelName) {
      viewportModelName.textContent = tplKey.toUpperCase();
    }

    loadFile(activeFile);
    syncInspectorFromManifest();
    runLinter();
  }

  // Listeners
  templateSelect?.addEventListener('change', () => {
    loadTemplate(templateSelect.value);
  });

  editorTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const f = tab.getAttribute('data-file');
      if (f) loadFile(f);
    });
  });

  codeTextarea?.addEventListener('input', () => {
    fileContents[activeFile] = codeTextarea.value;
    updateLineNumbers();
    if (activeFile === 'manifest') {
      syncInspectorFromManifest();
    }
    runLinter();
  });

  codeTextarea?.addEventListener('keyup', updateCursorPos);
  codeTextarea?.addEventListener('click', updateCursorPos);

  function updateCursorPos() {
    if (!codeTextarea || !cursorPos) return;
    const textLines = codeTextarea.value.substring(0, codeTextarea.selectionStart).split('\n');
    cursorPos.textContent = `LN ${textLines.length}, COL ${textLines[textLines.length - 1].length + 1}`;
  }

  // Compile button action
  runCompileBtn?.addEventListener('click', () => {
    if (studioViewer) {
      studioViewer.style.filter = 'brightness(1.4) contrast(1.2)';
      setTimeout(() => { studioViewer.style.filter = 'none'; }, 200);
      applyStudioLiveTransforms();
    }
    alert('✅ [ COMPILACIÓN EXITOSA ]\nMalla verificada y actualizada en el visor 3D.');
  });

  // Export ZIP Package
  exportZipBtn?.addEventListener('click', async () => {
    exportZipBtn.textContent = '⏳ Empaquetando...';
    try {
      const JSZip = (window as any).JSZip;
      if (!JSZip) throw new Error('JSZip no disponible');

      const zip = new JSZip();
      let familyName = 'mi_familia';
      try {
        const manifest = JSON.parse(fileContents['manifest'] || '{}');
        const parts = (manifest.id || '').split('.');
        familyName = parts[parts.length - 1] || 'mi_familia';
      } catch (e) {}

      const folder = zip.folder(`procedural_assets/generators/${familyName}`);
      folder.file('__init__.py', `from .config import *\nfrom .generator import *\n`);
      folder.file('generator.py', fileContents['generator']);
      folder.file('config.py', fileContents['config']);
      folder.file('manifest.json', fileContents['manifest']);
      folder.file('README.md', fileContents['readme']);

      const content = await zip.generateAsync({ type: 'blob' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(content);
      a.download = `${familyName}_generator_package.zip`;
      a.click();
    } catch (e: any) {
      alert(`Error al generar ZIP: ${e.message}`);
    } finally {
      exportZipBtn.textContent = '💾 DESCARGAR PAQUETE (.ZIP)';
    }
  });

  // GitHub Modal
  githubPrBtn?.addEventListener('click', () => {
    if (githubModal) githubModal.showModal();
  });

  closeModalBtn?.addEventListener('click', () => {
    if (githubModal) githubModal.close();
  });

  modalCancelBtn?.addEventListener('click', () => {
    if (githubModal) githubModal.close();
  });

  submitPrBtn?.addEventListener('click', async () => {
    const token = ghTokenInput?.value.trim();
    if (!token) {
      alert('Por favor introduce tu GitHub Personal Access Token con permiso repo.');
      return;
    }

    if (prStatusBox) {
      prStatusBox.style.display = 'block';
      prStatusBox.className = 'live-status-box status-loading';
      prStatusBox.textContent = '⏳ Conectando con GitHub API y creando rama de contribución...';
    }

    // Simulate PR creation workflow
    setTimeout(() => {
      if (prStatusBox) {
        prStatusBox.className = 'live-status-box status-success';
        prStatusBox.innerHTML = `✅ <strong>[ PULL REQUEST ABIERTO CON ÉXITO ]</strong><br>Rama <code>contrib/${activeTemplate}</code> creada.<br><a href="https://github.com/FrancisCuarto/MODELCODER/pulls" target="_blank" style="color: var(--ps1-cyan); text-decoration: underline;">Ver Pull Request en FrancisCuarto/MODELCODER &rarr;</a>`;
      }
    }, 1500);
  });

  // Controls
  let isRot = true;
  rotateToggleBtn?.addEventListener('click', () => {
    if (studioViewer) {
      isRot = !isRot;
      studioViewer.autoRotate = isRot;
      rotateToggleBtn.textContent = isRot ? '🔄 ROTACIÓN' : '⏸️ PAUSA';
    }
  });

  resetCamBtn?.addEventListener('click', () => {
    if (studioViewer) {
      studioViewer.resetTurntable();
      studioViewer.cameraOrbit = '0deg 75deg 105%';
    }
  });

  // Init
  loadTemplate('crate');
</script>

