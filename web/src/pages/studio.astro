      const maxT = Math.max(...customKeyframeList.map((k) => k.time));
      nextTime = Number(Math.min(totalDur, (maxT + 0.5)).toFixed(2));
    }
    const lastKf = customKeyframeList[customKeyframeList.length - 1];
    const copiedVal: [number, number, number] = lastKf ? [...lastKf.val] : [0, 0, 0];
