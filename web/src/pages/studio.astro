  // Handle URL parameters (?remix=family or ?slug=...) and hash (#model=...)
  async function handleInitialUrlSpec() {
    if (typeof window === 'undefined') return;

    const urlParams = new URLSearchParams(window.location.search);
    const modularFamily = urlParams.get('modular');
    const remixFamily = urlParams.get('remix');
    const slugParam = urlParams.get('slug') || urlParams.get('id');
    const hash = window.location.hash;

    // 0. Native Modular Model (?modular=family)
    if (modularFamily) {
      try {
        const { getModularModelByFamily } = await import('../data/modular-catalog.ts');
        const foundMod = getModularModelByFamily(modularFamily);
        if (foundMod && foundMod.spec) {
          currentSpec = JSON.parse(JSON.stringify(foundMod.spec));
          pushHistoryState(currentSpec);
          renderCurrentSpec('visual', false);
          showStudioToast(`✨ ¡Modelo modular "${currentSpec.name}" cargado! ${currentSpec.components.length} piezas listas para editar.`);
          return;
        }
      } catch (err) {
        console.warn('[ModelCoder Studio] Error cargando modelo modular:', err);
      }
    }

    // 1. Remix from Catalog Generator page
    if (remixFamily) {
      try {
        let userParams: Record<string, any> = {};
        const paramsStr = urlParams.get('params');
        if (paramsStr) {
          try {
            userParams = JSON.parse(decodeURIComponent(paramsStr));
          } catch (e) {}
        }
        showStudioToast(`📦 Cargando modelo original "${remixFamily}"...`);
        const remixSpec = await CatalogBridge.loadCatalogModelAsSpec(remixFamily, userParams);
        currentSpec = remixSpec;
        pushHistoryState(currentSpec);
        renderCurrentSpec('visual', false);
        showStudioToast(`📦 ¡Modelo "${remixSpec.name}" cargado con sus mallas originales!`);
        return;
      } catch (err) {
        console.warn('[ModelCoder Studio] Error cargando plantilla de catálogo:', err);
      }
    }

    // 2. Remix from Community Model slug
    if (slugParam) {
      try {
        const communityModels = await getCommunityModels({ onlyPublic: false });
        const decodedParam = decodeURIComponent(slugParam).trim();
        const found = communityModels.find(
          (m) =>
            m.slug === decodedParam ||
            m.id === decodedParam ||
            (m.slug && m.slug.toLowerCase() === decodedParam.toLowerCase())
        );
        if (found && found.spec) {
          let specData = found.spec;
          if (typeof specData === 'string') {
            try { specData = JSON.parse(specData); } catch {}
          }
          const remixSpec: ModelSpec = JSON.parse(JSON.stringify(specData));
          remixSpec.id = `remix.${found.slug || 'community'}.${Date.now().toString(36)}`;
          remixSpec.name = `${found.name || specData.name} (Remix)`;
          currentSpec = remixSpec;
          pushHistoryState(currentSpec);
          renderCurrentSpec('visual', false);
          showStudioToast(`📦 ¡Modelo de la comunidad "${remixSpec.name}" clonado para editar!`);
          return;
        }
      } catch (err) {
        console.warn('[ModelCoder Studio] Error cargando modelo de comunidad:', err);
      }
    }

    // 3. Hash model token (supports both Deflate z: and legacy base64)
    if (hash && (hash.includes('model=') || hash.length > 20)) {
      try {
        const decoded = await deserializeSpec(hash);
        if (decoded) {
          currentSpec = decoded;
          pushHistoryState(currentSpec);
          renderCurrentSpec('visual', false);
          showStudioToast(`📦 ¡Modelo "${currentSpec.name}" cargado desde enlace compartido!`);
          return;
        }
      } catch (err) {
        console.warn('[ModelCoder Studio] Error deserializando modelo desde hash:', err);
      }
    }
  }

