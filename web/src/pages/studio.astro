`,
      config: `from dataclasses import dataclass
from ...core.base_config import BaseAssetConfig

@dataclass
class BunkBedConfig(BaseAssetConfig):
    width: float = 1.05
    length: float = 2.05
    height: float = 2.05
    ladder_position: str = "front_right"
    upper_guardrail: bool = True
    palette_name: str = "industrial_hazard"
`,
      manifest: `{
  "$schema": "https://raw.githubusercontent.com/FrancisCuarto/MODELCODER/main/schemas/generator-v1.json",
  "id": "below_nominal.furniture.bunk_bed",
  "version": "1.0.0",
  "name": "Bunk Bed",
  "description": "Literas apiladas de dos niveles para camarotes de tripulación en Below Nominal.",
  "author": { "name": "Community Contributor", "github": "contributor" },
  "license": "CC-BY-4.0",
  "category": "furniture",
  "tags": ["bunk", "bed", "crew", "furniture"],
  "parameters": [
    { "key": "width", "label": "Ancho (m)", "type": "float", "default": 1.05, "min": 0.8, "max": 1.6, "step": 0.05, "group": "Dimensiones" },
    { "key": "length", "label": "Largo (m)", "type": "float", "default": 2.05, "min": 1.7, "max": 2.4, "step": 0.05, "group": "Dimensiones" },
    { "key": "height", "label": "Alto (m)", "type": "float", "default": 2.05, "min": 1.5, "max": 2.6, "step": 0.05, "group": "Dimensiones" },
    { "key": "upper_guardrail", "label": "Baranda Superior", "type": "boolean", "default": true, "group": "Seguridad" }
  ],
  "presets": [],
  "export_capabilities": { "target_tri_budget": 480, "supports_collision": true }
}`,
      readme: `# Bunk Bed

Camas de camarotes de Below Nominal.
`
    },
    custom: {
      model: '/models/crate.glb',
      generator: `import bpy
from ...core.base_generator import BaseAssetGenerator
from ...materials.palette import get_or_create_material
from .config import MiPropConfig

class MiPropGenerator(BaseAssetGenerator):
