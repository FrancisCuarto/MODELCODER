      const zip = new JSZip();
      let familyName = 'mi_familia';
      try {
        const manifest = JSON.parse(fileContents['manifest'] || '{}');
        const parts = (manifest.id || '').split('.');
        familyName = parts[parts.length - 1] || 'mi_familia';
      } catch (e) {}

      const folder = zip.folder(`procedural_assets/generators/${familyName}`);
      folder.file('__init__.py', `from .config import *\nfrom .generator import *\n`);
      folder.file('generator.py', fileContents['generator']);
      folder.file('config.py', fileContents['config']);
      folder.file('manifest.json', fileContents['manifest']);
      folder.file('README.md', fileContents['readme']);

      const content = await zip.generateAsync({ type: 'blob' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(content);
      a.download = `${familyName}_generator_package.zip`;
      a.click();
