          color: '#4a5568',
          roughness: 0.60,
          metalness: 0.30
        };
        break;
      case 'pipe':
        newComp = {
          name: `tubo_${count}`,
          shape: 'pipe',
          size: [0.5, 0.35, 1.0, 12],
          position: [0, 0.5, 0],
          rotation: [0, 0, 0],
          scale: [1, 1, 1],
          color: '#718096',
          roughness: 0.50,
          metalness: 0.50
        };
        break;
      case 'prism':
        newComp = {
          name: `prisma_${count}`,
          shape: 'prism',
          size: [0.5, 1.0, 6],
          position: [0, 0.5, 0],
          rotation: [0, 0, 0],
          scale: [1, 1, 1],
          color: '#2b6cb0',
          roughness: 0.65,
          metalness: 0.25
        };
        break;
      case 'pyramid':
        newComp = {
          name: `piramide_${count}`,
          shape: 'pyramid',
          size: [0.5, 1.0, 4],
          position: [0, 0.5, 0],
          rotation: [0, 0, 0],
          scale: [1, 1, 1],
          color: '#c53030',
          roughness: 0.70,
          metalness: 0.20
        };
        break;
    }

    currentSpec.components.push(newComp);
    selectedComponentIndex = currentSpec.components.length - 1;
    renderCurrentSpec('visual');
  }

  // --- PROPERTIES INSPECTOR PANEL ---
  function renderInspector(): void {
    if (!inspectorContentMount) return;

    if (selectedComponentIndex === null || !currentSpec.components[selectedComponentIndex]) {
      inspectorContentMount.innerHTML = `
        <div class="inspector-empty-state">
          <div class="empty-icon">🎯</div>
          <p class="empty-title">Ninguna pieza seleccionada</p>
          <small class="empty-desc">Haz clic en una pieza del Árbol de Componentes o directamente sobre el modelo en el visor 3D para editarla.</small>
        </div>
      `;
      if (inspectorCompBadge) inspectorCompBadge.textContent = '--';
      return;
    }

    const comp = currentSpec.components[selectedComponentIndex];
    if (inspectorCompBadge) {
      inspectorCompBadge.textContent = comp.shape.toUpperCase();
    }

    // Ensure defaults
    if (!comp.position) comp.position = [0, 0, 0];
    if (!comp.rotation) comp.rotation = [0, 0, 0];
    if (!comp.scale) comp.scale = [1, 1, 1];
    if (!comp.pivot) comp.pivot = [0, 0, 0];
    if (!comp.size) comp.size = getDefaultSizeForShape(comp.shape);

    const pos = comp.position;
    const rot = comp.rotation;
    const scl = comp.scale;
    const piv = comp.pivot;

    const isOpen = (secId: string) => inspectorSectionsOpen[secId] !== false;
    const activeTexBadge = comp.texturePreset ? escapeHtml(comp.texturePreset) : 'color plano';

    const otherComponents = currentSpec.components.filter((_, idx) => idx !== selectedComponentIndex);
    const parentOptionsHtml = currentSpec.components
      .filter((other) => other.name !== comp.name && !ProceduralEngine.wouldCreateCycle(currentSpec.components, comp.name, other.name))
      .map((other) => {
        const isSelected = comp.parentId === other.name ? 'selected' : '';
        return `<option value="${escapeHtml(other.name)}" ${isSelected}>↳ ${escapeHtml(other.name)} [${other.shape.toUpperCase()}]</option>`;
      })
      .join('');

    inspectorContentMount.innerHTML = `
      <!-- Component Header / Identifier -->
      <div class="prop-card-header ps1-inset">
        <div class="prop-row-item">
          <label class="field-label" for="inp-comp-name">NOMBRE DE LA PIEZA:</label>
          <input type="text" id="inp-comp-name" class="form-input comp-name-editor" value="${escapeHtml(comp.name)}" />
        </div>
        <div class="prop-row-item prop-parent-row">
          <label class="field-label" for="inp-comp-parent">PIEZA PADRE (JERARQUÍA):</label>
          <select id="inp-comp-parent" class="form-input comp-parent-selector" title="Vincula esta pieza como hija para heredar transformaciones y animaciones de su padre">
            <option value="">(Ninguno / Nivel Raíz)</option>
            ${parentOptionsHtml}
          </select>
        </div>
        <div class="prop-quick-btns">
          <button type="button" id="btn-prop-vis" class="btn-mini btn-outline" title="Visibilidad">
            ${comp.visible !== false ? '👁️ Visible' : '🚫 Oculta'}
          </button>
          <button type="button" id="btn-prop-dup" class="btn-mini btn-outline" title="Duplicar">
            📋 Duplicar
          </button>
          <button type="button" id="btn-prop-mirror" class="btn-mini btn-outline" title="Duplicar en espejo simétrico (reflejar en X/Y/Z)">
            🪞 Espejo
          </button>
          <button type="button" id="btn-prop-del" class="btn-mini btn-danger" title="Eliminar pieza seleccionada (Ctrl+X)">
            🗑️ Eliminar
          </button>
        </div>
      </div>

      <!-- Barra de Pestañas Expandibles / Contraíbles Rápidas -->
      <div class="inspector-tabs-bar ps1-inset" role="navigation" aria-label="Secciones de propiedades">
        <button type="button" class="insp-tab-pill ${isOpen('transform') ? 'active' : ''}" data-toggle-sec="transform" title="Expandir/contraer Transformación">
          📐 Transf.
        </button>
        <button type="button" class="insp-tab-pill ${isOpen('geometry') ? 'active' : ''}" data-toggle-sec="geometry" title="Expandir/contraer Geometría">
          📦 Geom.
        </button>
        <button type="button" class="insp-tab-pill ${isOpen('uv') ? 'active' : ''}" data-toggle-sec="uv" title="Expandir/contraer Mapeo UV y Anti-estiramiento">
          📏 UV
        </button>
        <button type="button" class="insp-tab-pill ${isOpen('surface') ? 'active' : ''}" data-toggle-sec="surface" title="Expandir/contraer Superficie PBR y Color">
          🎨 PBR
        </button>
        <button type="button" class="insp-tab-pill ${isOpen('textures') ? 'active' : ''}" data-toggle-sec="textures" title="Expandir/contraer Biblioteca de 138 Texturas">
          🧱 Texturas
        </button>
        <button type="button" class="insp-tab-pill ${isOpen('array') ? 'active' : ''}" data-toggle-sec="array" title="Expandir/contraer Modificador Array (Repetición Lineal y Radial)">
          ▦ Array
        </button>
        <button type="button" class="insp-tab-pill ${isOpen('boolean') ? 'active' : ''}" data-toggle-sec="boolean" title="Expandir/contraer Operaciones Booleanas CSG (Corte, Unión, Intersección)">
          ✂️ Booleana
        </button>
        <button type="button" class="insp-tab-pill ${isOpen('animation') ? 'active' : ''}" data-toggle-sec="animation" title="Expandir/contraer Pistas de Animación de esta pieza">
          🎬 Anim.
        </button>
        <button type="button" id="btn-toggle-all-secs" class="insp-tab-pill insp-tab-all" title="Expandir o contraer todas las pestañas">
          ↕ Todo
        </button>
