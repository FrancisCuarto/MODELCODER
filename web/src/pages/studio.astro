          { "key": "palette_name", "label": "Paleta de Sector", "type": "enum", "default": "command_bridge", "options": [{"value":"command_bridge","label":"Command Bridge"},{"value":"industrial_hazard","label":"Industrial Hazard"}], "group": "Materiales" }
        ],
        "presets": [{ "id": "standard", "name": "Operaciones Puente", "values": { "console_width": 1.60, "tape_module": true } }],
        "export_capabilities": { "target_tri_budget": 480, "supports_collision": true }
      },
      readme: `# Consola CRT Triple (PSX Low-Poly)\n\nConsola de comunicaciones navales retro.`
    },
    energy_core: {
      family: "energy_core",
      name: "Núcleo de Energía",
      generator: `import bpy
from ...core.base_generator import BaseAssetGenerator
from ...materials.palette import get_or_create_material
from .config import EnergyCoreConfig

class EnergyCoreGenerator(BaseAssetGenerator):
    def generate(self) -> bpy.types.Object:
        cfg = self.config
        bpy.ops.mesh.primitive_cylinder_add(
            vertices=10,
            radius=cfg.core_radius,
            depth=cfg.core_height,
            location=(0, 0, cfg.core_height * 0.5)
        )
        reactor = bpy.context.active_object
        reactor.name = cfg.name
        mat = get_or_create_material("casing", palette_name=cfg.palette_name)
        reactor.data.materials.append(mat)
        self.compact_materials(reactor)
        return reactor
`,
      config: `from dataclasses import dataclass
from ...core.base_config import BaseAssetConfig

@dataclass
class EnergyCoreConfig(BaseAssetConfig):
    name: str = "energy_core"
    core_height: float = 1.80
    core_radius: float = 0.50
    has_hazard_cage: bool = True
    palette_name: str = "industrial_hazard"
`,
      manifest: {
        "$schema": "https://raw.githubusercontent.com/FrancisCuarto/MODELCODER/main/schemas/generator-v1.json",
        "id": "below_nominal.structural.energy_core",
        "version": "1.0.0",
        "name": "Núcleo de Energía",
        "description": "Reactor auxiliar de plasma para subestación eléctrica de ingeniería.",
        "author": { "name": "AI Co-Pilot", "github": "modelcoder-ai" },
