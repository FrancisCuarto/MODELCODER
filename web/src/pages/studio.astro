      <!-- SECTION 1: TRANSFORMACIÓN -->
      <div class="prop-section collapsible-section ps1-inset ${isOpen('transform') ? 'is-open' : 'is-collapsed'}" data-sec-id="transform">
        <div class="section-titlebar section-toggle-header" data-sec-target="transform" role="button" tabindex="0" aria-expanded="${isOpen('transform')}">
          <span class="section-badge">1</span>
