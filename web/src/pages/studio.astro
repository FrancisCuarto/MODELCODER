---
import Layout from '../layouts/Layout.astro';
import catalog from '../data/catalog.json';
---

<Layout title="ModelCoder Web Studio - Editor de Generadores 3D">
  <div class="studio-container">
    <!-- Studio Header Bar -->
    <div class="ps1-window studio-topbar">
      <div class="ps1-titlebar">
        <span>// MODELCODER_WEB_STUDIO // IN-BROWSER 3D PROCEDURAL IDE</span>
        <span class="ps1-telemetry-tag">ENGINE: BLENDER 5.0 CORE</span>
      </div>

      <div class="topbar-actions">
        <!-- Template / Fork Selector -->
        <div class="template-selector-box">
          <label for="template-select" class="action-lbl">&gt; PLANTILLA / FORK:</label>
          <select id="template-select" class="form-select topbar-select">
            <option value="custom">NUEVO GENERADOR EN BLANCO</option>
            <option value="crate" selected>CLONAR: Crate (Contenedor)</option>
            <option value="terminal">CLONAR: Terminal (Computadora)</option>
            <option value="bunk_bed">CLONAR: Bunk Bed (Camas)</option>
            <option value="office_chair">CLONAR: Office Chair (Silla)</option>
          </select>
        </div>

        <!-- Action Buttons -->
        <div class="topbar-btn-group">
          <button id="run-compile-btn" class="btn btn-cyan" title="Compilar y Actualizar Visor 3D">
            ⚡ COMPILAR & VER 3D
          </button>
          <button id="export-zip-btn" class="btn btn-primary" title="Descargar paquete de 4 archivos listo para Pull Request">
            💾 DESCARGAR PAQUETE (.ZIP)
          </button>
          <button id="github-pr-btn" class="btn btn-green" title="Abrir Pull Request directo en GitHub">
            🚀 PUBLICAR PR
          </button>
        </div>
      </div>
    </div>

    <!-- AI Co-Pilot Command Center -->
    <div class="ps1-window ai-copilot-window" id="ai-copilot-box">
      <div class="ps1-titlebar ai-titlebar">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span class="ai-status-pulse"></span>
          <span>// MODELCODER_AI_COPILOT: GENERADOR_3D_POR_PROMPT</span>
          <span class="ai-badge-gemini">GEMINI 2.5 FLASH</span>
        </div>
        <div class="ai-titlebar-tools">
          <button type="button" id="toggle-gemini-key-btn" class="ps1-ctrl-btn" title="Configurar API Key de Gemini">
            🔑 API KEY
          </button>
          <button type="button" id="toggle-copilot-btn" class="ps1-ctrl-btn">
            [ MINIMIZAR ]
          </button>
        </div>
      </div>

      <div class="ai-copilot-body" id="ai-copilot-body">
        <!-- API Key Drawer (Initially Hidden if Key is Saved) -->
        <div id="gemini-key-drawer" class="gemini-key-drawer" style="display: none;">
          <div class="ps1-inset key-inset">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; flex-wrap: wrap; gap: 0.3rem;">
              <label for="gemini-api-key-input" class="field-label" style="color: var(--ps1-gold); font-size: 0.72rem; margin: 0;">
                CLAVE DE GOOGLE GEMINI API (100% GRATIS):
              </label>
              <a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener noreferrer" style="color: var(--ps1-cyan); font-size: 0.68rem; text-decoration: underline;">
                ➜ Obtener clave gratis en Google AI Studio
              </a>
            </div>
            <div style="display: flex; gap: 0.5rem;">
              <input 
                type="password" 
                id="gemini-api-key-input" 
                placeholder="Pega aquí tu clave: AIzaSy..." 
                class="form-input" 
                style="flex: 1; font-family: var(--font-mono); font-size: 0.75rem;"
              />
              <button type="button" id="save-gemini-key-btn" class="btn btn-gold" style="font-size: 0.7rem; padding: 0.35rem 0.8rem;">
                Guardar Clave
              </button>
            </div>
            <small style="color: var(--text-dim); font-size: 0.65rem; margin-top: 0.3rem; display: block;">
              Tu clave se almacena exclusivamente en tu navegador (localStorage) y nunca pasa por servidores de terceros.
            </small>
          </div>
        </div>

        <!-- Prompt Input and Action Row -->
        <div class="ai-prompt-row">
          <div class="prompt-input-wrap">
            <span class="prompt-prefix">&gt; PROMPT:</span>
            <input 
              type="text" 
              id="ai-prompt-input" 
              placeholder="ej. Diseña una torreta de vigilancia de pared con sensor rojo, doble cañón y soporte angular..." 
              class="ai-prompt-input"
            />
          </div>
          <button type="button" id="generate-ai-btn" class="btn btn-cyan ai-generate-btn">
            ⚡ GENERAR CON IA
          </button>
        </div>

        <!-- Quick Inspiration Chips -->
        <div class="ai-chips-row">
          <span class="chips-label">SUGERENCIAS:</span>
          <button type="button" class="ai-chip" data-preset="turret" data-prompt="Torreta de vigilancia robótica para pared con sensor láser rojo, cañón doble y soporte angular">
            🛸 Torreta de Pared
          </button>
          <button type="button" class="ai-chip" data-preset="cryo" data-prompt="Cápsula criogénica vertical con ventana de observación, tubos de refrigerante superiores y panel de signos vitales">
            🧊 Cápsula Criogénica
          </button>
          <button type="button" class="ai-chip" data-preset="crt_console" data-prompt="Consola de mando de seguridad con 3 pantallas CRT inclinadas, teclado angular y módulo de cinta">
            🖥️ Consola CRT Triple
          </button>
          <button type="button" class="ai-chip" data-preset="energy_core" data-prompt="Generador de escudo de energía con núcleo cilíndrico rotatorio, aletas de ventilación y jaula de seguridad">
            ⚡ Núcleo de Energía
          </button>
        </div>

        <div id="ai-loading-status" class="ai-status-indicator" style="display: none;"></div>
      </div>
    </div>

    <!-- Main Studio Split View (Left: Editor, Right: Viewport & Tests) -->
    <div class="studio-workspace">
      <!-- Left: Code Editor Window -->
      <div class="ps1-window editor-window">
        <!-- Tab Bar -->
        <div class="editor-tabs">
          <button class="editor-tab active" data-file="generator">
            generator.py <span class="tab-badge">MALLA</span>
          </button>
          <button class="editor-tab" data-file="config">
            config.py <span class="tab-badge">TYPES</span>
          </button>
          <button class="editor-tab" data-file="manifest">
            manifest.json <span class="tab-badge">SPEC</span>
          </button>
          <button class="editor-tab" data-file="readme">
            README.md <span class="tab-badge">DOCS</span>
          </button>
        </div>

        <!-- Editor Surface -->
        <div class="editor-surface">
          <div class="line-numbers" id="line-numbers">1</div>
          <textarea id="code-textarea" spellcheck="false" autocomplete="off"></textarea>
        </div>

        <!-- Editor Status & AST Security Linter -->
        <div class="editor-statusbar">
          <div class="status-left">
            <span id="cursor-pos">LN 1, COL 1</span>
            <span class="status-sep">|</span>
            <span id="active-filename">generator.py</span>
          </div>
          <div class="status-right" id="linter-badge">
            <span class="status-dot"></span>
            <span id="linter-text">AST_SECURITY: VALID // 0 ERRORS</span>
          </div>
        </div>
      </div>

      <!-- Right: Live 3D Viewport & Parameter Inspector -->
      <div class="preview-column">
        <!-- 3D Viewport Window -->
        <div class="ps1-window studio-viewport-window">
          <div class="ps1-titlebar">
            <span>// 3D_PREVIEW: [<span id="viewport-model-name">CRATE</span>]</span>
            <div class="viewport-quick-tools">
              <button id="studio-rotate-toggle" class="ps1-ctrl-btn">🔄 ROTACIÓN</button>
              <button id="studio-reset-cam" class="ps1-ctrl-btn">🎯 CENTRAR</button>
            </div>
          </div>

          <div class="ps1-inset studio-viewport-surface">
            <model-viewer
              id="studio-viewer"
              src="/models/crate.glb"
              alt="ModelCoder Studio Preview"
              camera-controls
              auto-rotate
              rotation-per-second="20deg"
              shadow-intensity="1.0"
              class="studio-model-viewer"
            ></model-viewer>
          </div>
        </div>

        <!-- Live Dynamic Parameter Inspector (Parsed from manifest.json) -->
        <div class="ps1-window inspector-window">
          <div class="ps1-titlebar">
            <span>// PARAMETERS_TEST_BENCH</span>
            <span class="ps1-telemetry-tag">REACTIVO EN TIEMPO REAL</span>
          </div>

          <div class="inspector-body">
            <p class="inspector-subtext">
              Los controles de abajo se generan automáticamente a partir del archivo <code>manifest.json</code> activo.
            </p>

            <form id="studio-param-form" class="studio-param-form">
              <!-- Dynamically populated from active manifest -->
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- GitHub Pull Request Modal -->
  <dialog id="github-modal" class="ps1-window gh-modal">
    <div class="ps1-titlebar">
      <span>// GITHUB_CONTRIBUTION_PIPELINE</span>
      <button id="close-modal-btn" class="ps1-ctrl-btn">X</button>
    </div>
    <div class="modal-body">
      <h3 style="color: var(--ps1-gold); font-family: var(--font-pixel); font-size: 0.9rem; margin-bottom: 0.5rem;">
        PUBLICAR DIRECTO A FrancisCuarto/MODELCODER
      </h3>
      <p style="font-size: 0.82rem; color: #b0c0d4; margin-bottom: 1rem; line-height: 1.5;">
        Puedes enviar tu generador automáticamente creando una rama en GitHub o copiando los 4 archivos a tu fork local.
      </p>

      <div class="ps1-inset" style="padding: 0.85rem; margin-bottom: 1rem;">
        <label for="gh-token-input" class="field-label" style="font-size: 0.75rem;">GitHub Personal Access Token (PAT):</label>
        <input type="password" id="gh-token-input" placeholder="ghp_xxxxxxxxxxxxxxxxxxxx" class="form-input" style="width: 100%; margin-top: 0.35rem;" />
        <small style="color: var(--text-dim); font-size: 0.68rem; display: block; margin-top: 0.35rem;">
          Requiere permisos <code>repo</code> para crear la rama <code>contrib/mi-generador</code> y abrir el PR. Tu token no se guarda en ningún servidor.
        </small>
      </div>

      <div style="display: flex; gap: 0.6rem;">
        <button id="submit-pr-btn" class="btn btn-green" style="flex: 1;">
          🚀 ENVIAR PULL REQUEST AHORA
        </button>
        <button id="modal-cancel-btn" class="btn btn-outline">
          CANCELAR
        </button>
      </div>

      <div id="pr-status-box" class="live-status-box" style="display: none; margin-top: 0.85rem;"></div>
    </div>
  </dialog>
</Layout>

<!-- Load JSZip for client-side packaging -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<script>
  // ==============================================================================
  // BUILT-IN TEMPLATES FOR FAST FORKING & AUTHORING
  // ==============================================================================
  const TEMPLATES: Record<string, { model: string; generator: string; config: string; manifest: string; readme: string }> = {
    crate: {
      model: '/models/crate.glb',
      generator: `import bpy
from ...core.base_generator import BaseAssetGenerator
from ...materials.palette import get_or_create_material
from .config import CrateConfig

class CrateGenerator(BaseAssetGenerator):
    """Generates procedural sci-fi cargo crates for Below Nominal."""
    def generate(self) -> bpy.types.Object:
        cfg = self.config
        mesh = bpy.data.meshes.new(f"{cfg.name}_mesh")
        obj = bpy.data.objects.new(cfg.name, mesh)
        bpy.context.collection.objects.link(obj)

        # Procedural casing and reinforced corner brackets
        mat_casing = get_or_create_material("casing", palette_name=cfg.palette_name)
        obj.data.materials.append(mat_casing)

        self.compact_materials(obj)
        return obj
`,
      config: `from dataclasses import dataclass
from ...core.base_config import BaseAssetConfig

@dataclass
class CrateConfig(BaseAssetConfig):
    """Configuration for procedural cargo crates."""
    width: float = 0.80
    length: float = 1.20
    height: float = 0.90
    wear_level: float = 0.65
    reinforced_corners: bool = True
    hazardous_contents: bool = False
    palette_name: str = "industrial_hazard"
`,
      manifest: `{
  "$schema": "https://raw.githubusercontent.com/FrancisCuarto/MODELCODER/main/schemas/generator-v1.json",
  "id": "below_nominal.furniture.crate",
  "version": "1.0.0",
  "name": "Cargo Crate",
  "description": "Contenedor de carga modular presurizado para bodegas y hangares de Below Nominal.",
  "author": { "name": "Community Contributor", "github": "contributor" },
  "license": "CC-BY-4.0",
  "category": "furniture",
  "tags": ["cargo", "crate", "industrial", "sci-fi", "storage"],
  "parameters": [
    {
      "key": "width",
      "label": "Ancho (m)",
      "type": "float",
      "default": 0.80,
      "min": 0.50,
      "max": 2.00,
      "step": 0.05,
      "group": "Dimensiones"
    },
    {
      "key": "length",
      "label": "Largo (m)",
      "type": "float",
      "default": 1.20,
      "min": 0.60,
      "max": 3.00,
      "step": 0.05,
      "group": "Dimensiones"
    },
    {
      "key": "height",
      "label": "Alto (m)",
      "type": "float",
      "default": 0.90,
      "min": 0.40,
      "max": 2.20,
      "step": 0.05,
      "group": "Dimensiones"
    },
    {
      "key": "wear_level",
      "label": "Desgaste y Óxido",
      "type": "float",
      "default": 0.65,
      "min": 0.0,
      "max": 1.0,
      "step": 0.05,
      "group": "Materiales"
    },
    {
      "key": "palette_name",
      "label": "Paleta de Sector",
      "type": "enum",
      "default": "industrial_hazard",
      "options": [
        { "value": "industrial_hazard", "label": "Industrial Hazard" },
        { "value": "medbay_clean", "label": "Medbay Clean" },
        { "value": "command_bridge", "label": "Command Bridge" },
        { "value": "derelict_decay", "label": "Derelict Decay" }
      ],
      "group": "Materiales"
    },
    {
      "key": "reinforced_corners",
      "label": "Esquinas Reforzadas",
      "type": "boolean",
      "default": true,
      "group": "Estructura"
    }
  ],
  "presets": [
    { "id": "standard", "name": "Estándar", "values": { "width": 0.8, "length": 1.2, "height": 0.9 } },
    { "id": "heavy_cargo", "name": "Carga Pesada", "values": { "width": 1.5, "length": 2.0, "height": 1.4 } }
  ],
  "export_capabilities": {
    "target_tri_budget": 420,
    "supports_collision": true
  }
}`,
      readme: `# Cargo Crate

Contenedor de carga modular presurizado diseñado para la estética low-poly PSX de Below Nominal.

## Parámetros Principales
- **width / length / height**: Dimensiones métricas normalizadas.
- **wear_level**: Controla la rugosidad, desgaste de vértices y marcas de óxido.
- **palette_name**: Aplica la colorimetría del sector designado en la estación.
`
    },
    terminal: {
      model: '/models/terminal.glb',
      generator: `import bpy
from ...core.base_generator import BaseAssetGenerator
from ...materials.palette import get_or_create_material
from .config import TerminalConfig

class TerminalGenerator(BaseAssetGenerator):
    """Generates sci-fi CRT wall terminals and workstation consoles."""
    def generate(self) -> bpy.types.Object:
        cfg = self.config
        mesh = bpy.data.meshes.new(f"{cfg.name}_mesh")
        obj = bpy.data.objects.new(cfg.name, mesh)
        bpy.context.collection.objects.link(obj)

        mat_casing = get_or_create_material("casing", palette_name=cfg.palette_name)
        mat_screen = get_or_create_material("crt_screen", palette_name=cfg.palette_name)
        obj.data.materials.extend([mat_casing, mat_screen])

        self.compact_materials(obj)
        return obj
`,
      config: `from dataclasses import dataclass
from ...core.base_config import BaseAssetConfig

@dataclass
class TerminalConfig(BaseAssetConfig):
    screen_diagonal: float = 14.0
    keyboard_tray: bool = True
    casing_style: str = "reinforced_bulkhead"
    palette_name: str = "command_bridge"
`,
      manifest: `{
  "$schema": "https://raw.githubusercontent.com/FrancisCuarto/MODELCODER/main/schemas/generator-v1.json",
  "id": "below_nominal.fixtures.terminal",
  "version": "1.0.0",
  "name": "Wall Terminal",
  "description": "Terminal CRT retro-sci-fi con teclado físico y chasis de mamparo.",
  "author": { "name": "Community Contributor", "github": "contributor" },
  "license": "CC-BY-4.0",
  "category": "fixtures",
  "tags": ["terminal", "crt", "computer", "sci-fi", "console"],
  "parameters": [
    { "key": "screen_diagonal", "label": "Diagonal Pantalla (pulgadas)", "type": "float", "default": 14.0, "min": 9.0, "max": 24.0, "step": 1.0, "group": "Pantalla" },
    { "key": "keyboard_tray", "label": "Bandeja de Teclado", "type": "boolean", "default": true, "group": "Accesorios" },
    { "key": "palette_name", "label": "Paleta", "type": "enum", "default": "command_bridge", "options": [{ "value": "command_bridge", "label": "Command Bridge" }, { "value": "industrial_hazard", "label": "Industrial Hazard" }], "group": "Materiales" }
  ],
  "presets": [],
  "export_capabilities": { "target_tri_budget": 450, "supports_collision": true }
}`,
      readme: `# Wall Terminal

Terminal CRT de diagnóstico de subsistemas de la nave.
`
    },
    bunk_bed: {
      model: '/models/bunk_bed.glb',
      generator: `import bpy
from ...core.base_generator import BaseAssetGenerator
from ...materials.palette import get_or_create_material
from .config import BunkBedConfig

class BunkBedGenerator(BaseAssetGenerator):
    def generate(self) -> bpy.types.Object:
        cfg = self.config
