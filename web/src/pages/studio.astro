import math
from ...core.base_generator import BaseAssetGenerator
from ...materials.palette import get_or_create_material
from .config import WallTurretConfig

class WallTurretGenerator(BaseAssetGenerator):
    """Generador procedural de torreta de vigilancia de pared (PSX Low-Poly)."""
    def generate(self) -> bpy.types.Object:
        cfg = self.config
        
        # 1. Base octogonal de montaje en pared
        bpy.ops.mesh.primitive_cylinder_add(
            vertices=8,
            radius=cfg.mount_radius,
            depth=0.12,
            location=(0, 0, 0)
        )
        base_obj = bpy.context.active_object
        base_obj.name = f"{cfg.name}_base"
        
        # 2. Pivote esférico central
        bpy.ops.mesh.primitive_uv_sphere_add(
            segments=8,
            ring_count=6,
            radius=cfg.mount_radius * 0.65,
            location=(0, 0, 0.15)
        )
        pivot_obj = bpy.context.active_object
        
        # 3. Doble cañón láser
        barrel_len = cfg.barrel_length
        for offset in [-0.08, 0.08]:
            bpy.ops.mesh.primitive_cylinder_add(
                vertices=6,
                radius=0.035,
                depth=barrel_len,
                location=(offset, barrel_len * 0.5, 0.18),
                rotation=(math.radians(90), 0, 0)
            )
            barrel = bpy.context.active_object
            
            # Unir con pivote
            ctx = bpy.context.copy()
            ctx['active_object'] = pivot_obj
            ctx['selected_editable_objects'] = [pivot_obj, barrel]
            bpy.ops.object.join(ctx)

        # 4. Asignar materiales temáticos
        mat_casing = get_or_create_material("casing", palette_name=cfg.palette_name)
        base_obj.data.materials.append(mat_casing)
        
        self.compact_materials(base_obj)
        return base_obj
`,
