  async function refreshLocalTextures(): Promise<void> {
    if (!isDesktopEnv) return;
    const invoke = getTauriInvoke();
    if (!invoke) return;
    try {
      const list = await invoke('list_local_textures') as string[];
      localTexturesList = Array.isArray(list) ? list : [];
      const countEl = document.getElementById('local-mat-count');
      if (countEl) countEl.textContent = String(localTexturesList.length);

      for (const file of localTexturesList) {
        if (!TextureLibrary.hasCustomTexture('local:' + file)) {
          try {
            const dataUrl = await invoke('read_local_texture_data_url', { fileName: file }) as string;
            if (dataUrl) {
              TextureLibrary.registerCustomTexture('local:' + file, dataUrl);
              TextureLibrary.registerCustomTexture(file, dataUrl);
            }
          } catch (e) {
            console.warn('Error reading texture', file, e);
          }
        }
      }
    } catch (err) {
      console.warn('Error fetching local textures:', err);
    }
  }

  async function ensureLocalTextureLoaded(preset: string): Promise<void> {
