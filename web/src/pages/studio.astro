  btnSubmitDirect?.addEventListener('click', async () => {
    const modelName = directUploadName?.value.trim() || currentSpec.name;
    const modelVis = directUploadVis?.value || 'public';
    const modelCat = directUploadCat?.value || currentSpec.category || 'furniture';
    const authorName = directUploadAuthor?.value.trim() || 'Piloto de la Comunidad';
    const description = directUploadDesc?.value.trim() || currentSpec.description || `Modelo procedural ${modelName}`;

    if (!modelName) {
      showStudioToast('⚠️ Por favor ingresa un nombre para el modelo.', true);
      directUploadName?.focus();
      return;
    }

    if (directUploadStatus) {
      directUploadStatus.classList.remove('hidden');
      directUploadStatus.style.display = 'block';
      directUploadStatus.style.color = 'var(--ps1-gold)';
      directUploadStatus.innerHTML = '⏳ <strong>Empaquetando modelo procedural y generando geometría 3D...</strong>';
    }
    btnSubmitDirect.disabled = true;

    try {
      const rootObj = viewport?.getVisibleObject();
      const glbBuffer = (viewport && rootObj)
        ? await viewport.executeWithOriginalMaterials((cleanRoot) => GLBExporterService.exportToArrayBuffer(cleanRoot))
        : await GLBExporterService.exportSpec(currentSpec);
      const blob = new Blob([glbBuffer], { type: 'model/gltf-binary' });
      const reader = new FileReader();

      reader.onloadend = async () => {
        try {
          const glbDataUrl = reader.result as string;
          const user = activeCurrentUser || await getCurrentUser();
          const authorEmail = user?.email || `${authorName.toLowerCase().replace(/[^a-z0-9]/g, '')}@modelcoder.community`;

          const res = await publishCommunityModel({
            name: modelName,
            category: modelCat,
            description,
            spec: currentSpec,
            tri_count: lastGeometricStats?.triangles || 350,
            author_name: authorName,
            author_email: authorEmail,
            is_public: modelVis === 'public',
            glb_data: glbDataUrl,
            isCollaborator: activeRoleInfo?.isCollaborator
          });

          btnSubmitDirect.disabled = false;
          if (res.success) {
            if (directUploadStatus) {
              if (res.isPendingReview) {
                directUploadStatus.style.color = 'var(--ps1-cyan)';
                directUploadStatus.innerHTML = `✅ <strong>¡SOLICITUD ENVIADA CON ÉXITO!</strong><br><span style="font-size:0.75rem; color:#c0d8f0;">Tu modelo <strong>"${modelName}"</strong> ha sido transmitido a la mesa de revisión.<br>En cuanto un colaborador o FrancisCuarto lo apruebe desde el portal, aparecerá automáticamente en el catálogo oficial de todos los pilotos.</span>`;
              } else {
                directUploadStatus.style.color = 'var(--ps1-green)';
                directUploadStatus.innerHTML = `👑 <strong>¡PUBLICADO EN EL CATÁLOGO CON ÉXITO!</strong><br><span style="font-size:0.75rem; color:#c0f0d0;">El modelo ya está disponible en la nube y visible en todas las computadoras.</span><br><a href="/" style="color:var(--ps1-gold);text-decoration:underline;display:inline-block;margin-top:6px;">Ver en Catálogo Principal &rarr;</a>`;
              }
            }
          } else {
            if (directUploadStatus) {
              directUploadStatus.style.color = '#ff4444';
              directUploadStatus.textContent = `❌ Error al subir: ${res.error || 'Error desconocido'}`;
            }
          }
        } catch (innerErr: any) {
          btnSubmitDirect.disabled = false;
          if (directUploadStatus) {
            directUploadStatus.style.color = '#ff4444';
            directUploadStatus.textContent = `❌ Error: ${innerErr.message || innerErr}`;
          }
        }
      };
      reader.readAsDataURL(blob);
    } catch (err: any) {
      btnSubmitDirect.disabled = false;
      if (directUploadStatus) {
