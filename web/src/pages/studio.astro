---
import Layout from '../layouts/Layout.astro';
import catalog from '../data/catalog.json';
---

<Layout title="ModelCoder Web Studio - Editor de Generadores 3D">
  <div class="studio-container">
    <!-- Studio Header Bar -->
    <div class="ps1-window studio-topbar">
      <div class="ps1-titlebar">
        <span>// MODELCODER_WEB_STUDIO // IN-BROWSER 3D PROCEDURAL IDE</span>
        <span class="ps1-telemetry-tag">ENGINE: BLENDER 5.0 CORE</span>
      </div>

      <div class="topbar-actions">
        <!-- Template / Fork Selector -->
        <div class="template-selector-box">
          <label for="template-select" class="action-lbl">&gt; PLANTILLA / FORK:</label>
          <select id="template-select" class="form-select topbar-select">
            <option value="custom">NUEVO GENERADOR EN BLANCO</option>
            <option value="crate" selected>CLONAR: Crate (Contenedor)</option>
            <option value="terminal">CLONAR: Terminal (Computadora)</option>
            <option value="bunk_bed">CLONAR: Bunk Bed (Camas)</option>
            <option value="office_chair">CLONAR: Office Chair (Silla)</option>
          </select>
        </div>

        <!-- Action Buttons -->
        <div class="topbar-btn-group">
          <button id="run-compile-btn" class="btn btn-cyan" title="Compilar y Actualizar Visor 3D">
            ⚡ COMPILAR & VER 3D
          </button>
          <button id="export-zip-btn" class="btn btn-primary" title="Descargar paquete de 4 archivos listo para Pull Request">
            💾 DESCARGAR PAQUETE (.ZIP)
          </button>
          <button id="github-pr-btn" class="btn btn-green" title="Abrir Pull Request directo en GitHub">
            🚀 PUBLICAR PR
          </button>
        </div>
      </div>
    </div>

    <!-- Main Studio Split View (Left: Editor, Right: Viewport & Tests) -->
    <div class="studio-workspace">
      <!-- Left: Code Editor Window -->
      <div class="ps1-window editor-window">
        <!-- Tab Bar -->
        <div class="editor-tabs">
          <button class="editor-tab active" data-file="generator">
            generator.py <span class="tab-badge">MALLA</span>
          </button>
          <button class="editor-tab" data-file="config">
            config.py <span class="tab-badge">TYPES</span>
          </button>
          <button class="editor-tab" data-file="manifest">
            manifest.json <span class="tab-badge">SPEC</span>
          </button>
          <button class="editor-tab" data-file="readme">
            README.md <span class="tab-badge">DOCS</span>
          </button>
        </div>

        <!-- Editor Surface -->
        <div class="editor-surface">
          <div class="line-numbers" id="line-numbers">1</div>
          <textarea id="code-textarea" spellcheck="false" autocomplete="off"></textarea>
        </div>

        <!-- Editor Status & AST Security Linter -->
        <div class="editor-statusbar">
          <div class="status-left">
            <span id="cursor-pos">LN 1, COL 1</span>
            <span class="status-sep">|</span>
            <span id="active-filename">generator.py</span>
          </div>
          <div class="status-right" id="linter-badge">
            <span class="status-dot"></span>
            <span id="linter-text">AST_SECURITY: VALID // 0 ERRORS</span>
          </div>
        </div>
      </div>

      <!-- Right: Live 3D Viewport & Parameter Inspector -->
      <div class="preview-column">
        <!-- 3D Viewport Window -->
        <div class="ps1-window studio-viewport-window">
          <div class="ps1-titlebar">
            <span>// 3D_PREVIEW: [<span id="viewport-model-name">CRATE</span>]</span>
            <div class="viewport-quick-tools">
              <button id="studio-rotate-toggle" class="ps1-ctrl-btn">🔄 ROTACIÓN</button>
              <button id="studio-reset-cam" class="ps1-ctrl-btn">🎯 CENTRAR</button>
            </div>
          </div>

          <div class="ps1-inset studio-viewport-surface">
            <model-viewer
              id="studio-viewer"
              src="/models/crate.glb"
              alt="ModelCoder Studio Preview"
              camera-controls
              auto-rotate
              rotation-per-second="20deg"
              shadow-intensity="1.0"
              class="studio-model-viewer"
            ></model-viewer>
          </div>
        </div>

        <!-- Live Dynamic Parameter Inspector (Parsed from manifest.json) -->
        <div class="ps1-window inspector-window">
          <div class="ps1-titlebar">
            <span>// PARAMETERS_TEST_BENCH</span>
            <span class="ps1-telemetry-tag">REACTIVO EN TIEMPO REAL</span>
          </div>

          <div class="inspector-body">
            <p class="inspector-subtext">
              Los controles de abajo se generan automáticamente a partir del archivo <code>manifest.json</code> activo.
            </p>

            <form id="studio-param-form" class="studio-param-form">
              <!-- Dynamically populated from active manifest -->
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- GitHub Pull Request Modal -->
  <dialog id="github-modal" class="ps1-window gh-modal">
    <div class="ps1-titlebar">
      <span>// GITHUB_CONTRIBUTION_PIPELINE</span>
      <button id="close-modal-btn" class="ps1-ctrl-btn">X</button>
    </div>
    <div class="modal-body">
      <h3 style="color: var(--ps1-gold); font-family: var(--font-pixel); font-size: 0.9rem; margin-bottom: 0.5rem;">
        PUBLICAR DIRECTO A FrancisCuarto/MODELCODER
      </h3>
      <p style="font-size: 0.82rem; color: #b0c0d4; margin-bottom: 1rem; line-height: 1.5;">
        Puedes enviar tu generador automáticamente creando una rama en GitHub o copiando los 4 archivos a tu fork local.
      </p>

      <div class="ps1-inset" style="padding: 0.85rem; margin-bottom: 1rem;">
        <label for="gh-token-input" class="field-label" style="font-size: 0.75rem;">GitHub Personal Access Token (PAT):</label>
        <input type="password" id="gh-token-input" placeholder="ghp_xxxxxxxxxxxxxxxxxxxx" class="form-input" style="width: 100%; margin-top: 0.35rem;" />
        <small style="color: var(--text-dim); font-size: 0.68rem; display: block; margin-top: 0.35rem;">
          Requiere permisos <code>repo</code> para crear la rama <code>contrib/mi-generador</code> y abrir el PR. Tu token no se guarda en ningún servidor.
        </small>
      </div>

      <div style="display: flex; gap: 0.6rem;">
        <button id="submit-pr-btn" class="btn btn-green" style="flex: 1;">
          🚀 ENVIAR PULL REQUEST AHORA
        </button>
        <button id="modal-cancel-btn" class="btn btn-outline">
          CANCELAR
        </button>
      </div>

      <div id="pr-status-box" class="live-status-box" style="display: none; margin-top: 0.85rem;"></div>
    </div>
  </dialog>
</Layout>

<!-- Load JSZip for client-side packaging -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<script>
  // ==============================================================================
  // BUILT-IN TEMPLATES FOR FAST FORKING & AUTHORING
