  function getDefaultSizeForShape(shape: ShapePrimitive): number[] {
    switch (shape) {
      case 'box': return [1.0, 1.0, 1.0];
      case 'cylinder': return [0.35, 0.35, 1.0, 8];
      case 'sphere': return [0.5, 8, 6];
      case 'wedge': return [1.0, 0.8, 0.8];
      case 'cone': return [0.4, 1.0, 8];
      case 'torus': return [0.5, 0.15, 6, 12];
      case 'capsule': return [0.25, 0.5, 4, 8];
      case 'plane': return [1.0, 1.0];
      case 'chamfer_box': return [1.0, 1.0, 1.0, 0.05, 2];
      case 'pipe': return [0.5, 0.35, 1.0, 12];
      case 'prism': return [0.5, 1.0, 6];
      case 'pyramid': return [0.5, 1.0, 4];
      case 'mesh': return [1.0, 1.0, 1.0];
      default: return [1.0, 1.0, 1.0];
    }
  }

  function getShapeIcon(shape: ShapePrimitive): string {
    switch (shape) {
      case 'box': return '📦';
      case 'cylinder': return '🛢️';
      case 'sphere': return '🔮';
      case 'wedge': return '📐';
      case 'cone': return '🔺';
      case 'torus': return '🍩';
      case 'capsule': return '💊';
      case 'plane': return '📄';
      case 'mesh': return '🧩';
      default: return '🔹';
    }
  }

  function updateEffectiveDimensions(comp: ComponentDef): void {
    const effDimsVal = document.getElementById('eff-dims-val');
    if (!effDimsVal) return;

    const s = comp.size || [1, 1, 1];
    const scl = comp.scale || [1, 1, 1];

    let w = 1.0;
    let h = 1.0;
    let d = 1.0;

    switch (comp.shape) {
      case 'box':
      case 'wedge':
        w = (s[0] ?? 1.0) * scl[0];
        h = (s[1] ?? 1.0) * scl[1];
        d = (s[2] ?? 1.0) * scl[2];
        break;
      case 'cylinder': {
        const maxR = Math.max(s[0] ?? 0.35, s[1] ?? 0.35);
        w = maxR * 2 * scl[0];
        h = (s[2] ?? 1.0) * scl[1];
        d = maxR * 2 * scl[2];
        break;
      }
      case 'sphere': {
        const r = s[0] ?? 0.5;
        w = r * 2 * scl[0];
        h = r * 2 * scl[1];
        d = r * 2 * scl[2];
        break;
      }
      case 'cone': {
        const r = s[0] ?? 0.4;
        w = r * 2 * scl[0];
        h = (s[1] ?? 1.0) * scl[1];
        d = r * 2 * scl[2];
        break;
      }
      case 'torus': {
        const R = s[0] ?? 0.5;
        const r = s[1] ?? 0.15;
        w = (R + r) * 2 * scl[0];
        h = r * 2 * scl[1];
        d = (R + r) * 2 * scl[2];
        break;
      }
      case 'capsule': {
        const r = s[0] ?? 0.25;
        const len = s[1] ?? 0.5;
        w = r * 2 * scl[0];
        h = (len + r * 2) * scl[1];
        d = r * 2 * scl[2];
        break;
      }
      case 'plane':
        w = (s[0] ?? 1.0) * scl[0];
        h = 0.01;
        d = (s[1] ?? 1.0) * scl[2];
        break;
    }

    effDimsVal.textContent = `Ancho: ${w.toFixed(2)}m | Alto: ${h.toFixed(2)}m | Prof: ${d.toFixed(2)}m`;
  }

  function updateTransformInspectorInputs(
    pos: [number, number, number],
    rot: [number, number, number],
    scale: [number, number, number]
  ): void {
    const inpPosX = document.getElementById('inp-pos-x') as HTMLInputElement | null;
    const inpPosY = document.getElementById('inp-pos-y') as HTMLInputElement | null;
    const inpPosZ = document.getElementById('inp-pos-z') as HTMLInputElement | null;

    const inpRotX = document.getElementById('inp-rot-x') as HTMLInputElement | null;
    const inpRotY = document.getElementById('inp-rot-y') as HTMLInputElement | null;
    const inpRotZ = document.getElementById('inp-rot-z') as HTMLInputElement | null;

    const inpSclX = document.getElementById('inp-scl-x') as HTMLInputElement | null;
    const inpSclY = document.getElementById('inp-scl-y') as HTMLInputElement | null;
    const inpSclZ = document.getElementById('inp-scl-z') as HTMLInputElement | null;

    if (inpPosX) inpPosX.value = `${pos[0]}`;
    if (inpPosY) inpPosY.value = `${pos[1]}`;
    if (inpPosZ) inpPosZ.value = `${pos[2]}`;

    if (inpRotX) inpRotX.value = `${rot[0]}`;
    if (inpRotY) inpRotY.value = `${rot[1]}`;
    if (inpRotZ) inpRotZ.value = `${rot[2]}`;

    if (inpSclX) inpSclX.value = `${scale[0]}`;
    if (inpSclY) inpSclY.value = `${scale[1]}`;
    if (inpSclZ) inpSclZ.value = `${scale[2]}`;
  }

  function updateSelectionPill(): void {
    if (!viewportSelectionPill || !viewportSelectionLabel) return;
    if (selectedComponentIndex !== null && currentSpec.components[selectedComponentIndex]) {
      const comp = currentSpec.components[selectedComponentIndex];
      viewportSelectionPill.style.display = 'flex';
      viewportSelectionLabel.textContent = `[${comp.shape.toUpperCase()}] ${comp.name}`;
    } else {
      viewportSelectionPill.style.display = 'none';
    }
  }

  function wireInspectorEventListeners(comp: ComponentDef): void {
    const idx = selectedComponentIndex!;

    // Helper: parse number while user is actively typing without breaking "-", ".", or empty string
    const parseTypingNumber = (inp: HTMLInputElement | null): number | null => {
      if (!inp) return null;
      const raw = inp.value.trim().replace(',', '.');
      if (raw === '' || raw === '-' || raw === '.' || raw === '-.' || raw === '+') {
        return null;
      }
      const num = Number(raw);
      return Number.isFinite(num) ? num : null;
    };

    // Helper to cascade component rename across children and animation tracks
    const cascadeComponentRename = (oldName: string, newName: string) => {
      if (!oldName || !newName || oldName === newName) return;
      currentSpec.components.forEach((c) => {
        if (c.parentId === oldName) {
          c.parentId = newName;
        }
      });
      if (currentSpec.animations) {
        currentSpec.animations.forEach((clip) => {
          if (clip.tracks) {
            clip.tracks.forEach((track) => {
              if (track.targetComponent === oldName) {
                track.targetComponent = newName;
              }
              if (track.targetName === oldName) {
                track.targetName = newName;
              }
            });
          }
        });
      }
    };

    // Name input
    const inpCompName = document.getElementById('inp-comp-name') as HTMLInputElement | null;
    inpCompName?.addEventListener('input', () => {
      const val = inpCompName.value.trim();
      if (val && val !== comp.name) {
        const oldName = comp.name;
        comp.name = val;
        cascadeComponentRename(oldName, val);
        renderOutliner();
        updateSelectionPill();
        syncEditorFromSpec();
      }
    });
    inpCompName?.addEventListener('change', () => {
      const oldName = comp.name;
      const targetName = inpCompName.value.trim() || `pieza_${idx + 1}`;
      comp.name = targetName;
      inpCompName.value = comp.name;
      cascadeComponentRename(oldName, targetName);
      renderCurrentSpec('visual', true, false);
    });

    // Parent selector input (Hierarchy)
    const inpCompParent = document.getElementById('inp-comp-parent') as HTMLSelectElement | null;
    inpCompParent?.addEventListener('change', () => {
      const chosenParent = inpCompParent.value.trim() || undefined;
      reparentComponent(comp.name, chosenParent);
    });

    // Collapsible Sections / Tabs logic
    const syncSectionDOM = (secId: string) => {
      const open = inspectorSectionsOpen[secId] !== false;
      const secEl = inspectorContentMount?.querySelector(`.collapsible-section[data-sec-id="${secId}"]`);
      const headerEl = secEl?.querySelector('.section-toggle-header');
      const chevronEl = secEl?.querySelector('.sec-chevron');
      const pillEl = inspectorContentMount?.querySelector(`.insp-tab-pill[data-toggle-sec="${secId}"]`);

      if (secEl) {
        secEl.classList.toggle('is-open', open);
        secEl.classList.toggle('is-collapsed', !open);
      }
      if (headerEl) {
        headerEl.setAttribute('aria-expanded', String(open));
      }
      if (chevronEl) {
        chevronEl.textContent = open ? '▼' : '▶';
      }
      if (pillEl) {
        pillEl.classList.toggle('active', open);
      }
    };

    const toggleSection = (secId: string) => {
      inspectorSectionsOpen[secId] = !(inspectorSectionsOpen[secId] !== false);
      syncSectionDOM(secId);
    };

    inspectorContentMount?.querySelectorAll('.section-toggle-header').forEach((hdr) => {
      hdr.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('button')) return; // Ignore clicks on inner action buttons like Reset
        const secId = (hdr as HTMLElement).dataset.secTarget;
        if (secId) toggleSection(secId);
      });
      hdr.addEventListener('keydown', (e) => {
        const ke = e as KeyboardEvent;
        if (ke.key === 'Enter' || ke.key === ' ') {
          ke.preventDefault();
          const secId = (hdr as HTMLElement).dataset.secTarget;
          if (secId) toggleSection(secId);
        }
      });
    });

    inspectorContentMount?.querySelectorAll('.insp-tab-pill[data-toggle-sec]').forEach((pill) => {
      pill.addEventListener('click', () => {
        const secId = (pill as HTMLElement).dataset.toggleSec;
        if (!secId) return;
        toggleSection(secId);
        if (inspectorSectionsOpen[secId]) {
          const secEl = inspectorContentMount?.querySelector(`.collapsible-section[data-sec-id="${secId}"]`);
          secEl?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    });

    document.getElementById('btn-toggle-all-secs')?.addEventListener('click', () => {
      const keys = ['transform', 'geometry', 'uv', 'surface', 'textures', 'array', 'animation'];
      const anyCollapsed = keys.some((k) => inspectorSectionsOpen[k] === false);
      const nextState = anyCollapsed ? true : false;
      keys.forEach((k) => {
        inspectorSectionsOpen[k] = nextState;
        syncSectionDOM(k);
      });
    });

    // Quick action buttons
    document.getElementById('btn-prop-vis')?.addEventListener('click', () => {
      toggleComponentVisibility(idx);
    });
    document.getElementById('btn-prop-dup')?.addEventListener('click', () => {
      duplicateComponent(idx);
    });
    document.getElementById('btn-prop-mirror')?.addEventListener('click', () => {
      const axis = prompt('¿En qué eje deseas duplicar en espejo? (X / Y / Z):', 'X')?.trim().toLowerCase();
      if (axis === 'x' || axis === 'y' || axis === 'z') {
        mirrorComponent(idx, axis as 'x' | 'y' | 'z');
      }
    });
    document.getElementById('btn-prop-del')?.addEventListener('click', () => {
      deleteComponent(idx);
    });

    // Reset Transform
    document.getElementById('btn-reset-transform')?.addEventListener('click', (e) => {
      e.stopPropagation();
      comp.position = [0, 0, 0];
      comp.rotation = [0, 0, 0];
      comp.scale = [1, 1, 1];
      renderCurrentSpec('visual', true, true);
    });

    // Position inputs (live update without destroying focused input; commit on change/blur)
    (['inp-pos-x', 'inp-pos-y', 'inp-pos-z'] as const).forEach((id, axisIdx) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      el?.addEventListener('input', () => {
        const val = parseTypingNumber(el);
        if (val === null) return; // User is clearing or typing '-' / '.'
        if (!comp.position) comp.position = [0, 0, 0];
        comp.position[axisIdx] = val;
        renderCurrentSpec('visual', false, false);
      });
      el?.addEventListener('change', () => {
        if (!comp.position) comp.position = [0, 0, 0];
        const val = parseTypingNumber(el);
        const finalVal = val !== null ? val : 0;
        comp.position[axisIdx] = finalVal;
        if (el) el.value = `${finalVal}`;
        renderCurrentSpec('visual', true, false);
      });
    });

    // Rotation inputs (live update without destroying focused input; commit on change/blur)
    (['inp-rot-x', 'inp-rot-y', 'inp-rot-z'] as const).forEach((id, axisIdx) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      el?.addEventListener('input', () => {
        const val = parseTypingNumber(el);
        if (val === null) return;
        if (!comp.rotation) comp.rotation = [0, 0, 0];
        comp.rotation[axisIdx] = val;
        renderCurrentSpec('visual', false, false);
      });
      el?.addEventListener('change', () => {
        if (!comp.rotation) comp.rotation = [0, 0, 0];
        const val = parseTypingNumber(el);
        const finalVal = val !== null ? val : 0;
        comp.rotation[axisIdx] = finalVal;
        if (el) el.value = `${finalVal}`;
        renderCurrentSpec('visual', true, false);
      });
    });

    // Scale Lock checkbox
    const chkScaleLock = document.getElementById('chk-scale-lock') as HTMLInputElement | null;
    chkScaleLock?.addEventListener('change', (e) => {
      isUniformScaleLocked = (e.target as HTMLInputElement).checked;
    });

    // Scale inputs
    const scaleIds = ['inp-scl-x', 'inp-scl-y', 'inp-scl-z'] as const;
    const applyScaleAxis = (axis: 0 | 1 | 2, val: number, isFinalCommit: boolean) => {
      if (!comp.scale) comp.scale = [1, 1, 1];

      if (isUniformScaleLocked) {
        const oldVal = comp.scale[axis] || 1.0;
        const ratio = oldVal > 0 ? val / oldVal : 1.0;
        comp.scale[0] = Math.max(0.01, parseFloat((comp.scale[0] * ratio).toFixed(3)));
        comp.scale[1] = Math.max(0.01, parseFloat((comp.scale[1] * ratio).toFixed(3)));
        comp.scale[2] = Math.max(0.01, parseFloat((comp.scale[2] * ratio).toFixed(3)));
        comp.scale[axis] = val;
        scaleIds.forEach((otherId, otherIdx) => {
          if (isFinalCommit || otherIdx !== axis) {
            const otherEl = document.getElementById(otherId) as HTMLInputElement | null;
            if (otherEl) otherEl.value = `${comp.scale![otherIdx]}`;
          }
        });
      } else {
        comp.scale[axis] = val;
        if (isFinalCommit) {
          const el = document.getElementById(scaleIds[axis]) as HTMLInputElement | null;
          if (el) el.value = `${val}`;
        }
      }
      renderCurrentSpec('visual', isFinalCommit, false);
    };

    scaleIds.forEach((id, idxAxis) => {
      const axis = idxAxis as 0 | 1 | 2;
      const el = document.getElementById(id) as HTMLInputElement | null;
      el?.addEventListener('input', () => {
        const val = parseTypingNumber(el);
        // Wait while user is typing '0' or '0.' on the way to '0.5'
        if (val === null || val < 0.01) return;
        applyScaleAxis(axis, val, false);
      });
      el?.addEventListener('change', () => {
        const val = parseTypingNumber(el);
        const safeVal = val !== null && val >= 0.01 ? val : (comp.scale?.[axis] || 1.0);
        applyScaleAxis(axis, safeVal, true);
      });
    });

    // Pivot inputs (live update geometry translation offset; commit on change/blur)
    (['inp-piv-x', 'inp-piv-y', 'inp-piv-z'] as const).forEach((id, axisIdx) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      el?.addEventListener('input', () => {
        const val = parseTypingNumber(el);
        if (val === null) return;
        if (!comp.pivot) comp.pivot = [0, 0, 0];
        comp.pivot[axisIdx] = val;
        renderCurrentSpec('visual', false, false);
      });
      el?.addEventListener('change', () => {
        if (!comp.pivot) comp.pivot = [0, 0, 0];
        const val = parseTypingNumber(el);
        const finalVal = val !== null ? val : 0;
        comp.pivot[axisIdx] = finalVal;
        if (el) el.value = `${finalVal}`;
        renderCurrentSpec('visual', true, false);
      });
    });

    // Reset Pivot to Center
    document.getElementById('btn-reset-pivot')?.addEventListener('click', (e) => {
      e.stopPropagation();
      comp.pivot = [0, 0, 0];
      renderCurrentSpec('visual', true, true);
    });

    // Pivot Presets (Center, Bottom, Top, Left, Right, Back)
    inspectorContentMount?.querySelectorAll('.btn-piv-preset').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const preset = (btn as HTMLElement).dataset.preset as any;
        if (!preset) return;
        comp.pivot = ProceduralEngine.computePresetPivot(preset, comp.shape, comp.size);
        renderCurrentSpec('visual', true, true);
      });
    });

    // Alignment: Ground (Y=0)
    document.getElementById('btn-align-ground')?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (selectedComponentIndex === null) return;
      const newPos = ProceduralEngine.alignComponentToGround(currentSpec, selectedComponentIndex);
      if (newPos) {
        renderCurrentSpec('visual', true, true);
        showStudioToast('⬇ Pieza asentada al suelo (Y=0.00)');
      }
    });

    // Alignment: Center Origin (X=0, Z=0)
    document.getElementById('btn-center-origin')?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (selectedComponentIndex === null) return;
      const newPos = ProceduralEngine.centerComponentOnOrigin(currentSpec, selectedComponentIndex, 'xz');
      if (newPos) {
        renderCurrentSpec('visual', true, true);
        showStudioToast('🎯 Pieza centrada en origen (X=0, Z=0)');
      }
    });

    // Alignment: Inspector Face Magnet button
    document.getElementById('btn-insp-magnet')?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleFaceMagnetMode();
    });

    // Alignment: Parent Face buttons
    inspectorContentMount?.querySelectorAll('.btn-parent-face').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (selectedComponentIndex === null) return;
        const face = (btn as HTMLElement).dataset.face as any;
        if (!face) return;
        const newPos = ProceduralEngine.alignComponentToParentFace(currentSpec, selectedComponentIndex, face);
        if (newPos) {
          renderCurrentSpec('visual', true, true);
          showStudioToast(`↔ Pieza alineada a cara ${face.toUpperCase()} del padre`);
        }
      });
    });

    // Shape-specific parameters
    document.querySelectorAll('.shape-num-inp').forEach((inp) => {
      const input = inp as HTMLInputElement;
      const paramIdx = parseInt(input.dataset.param || '0', 10);
      const minVal = parseFloat(input.min || '0.005') || 0.005;

      input.addEventListener('input', () => {
        const val = parseTypingNumber(input);
        if (val === null || val < minVal) return; // Allow typing '0.' before '0.25'
        if (!comp.size) comp.size = getDefaultSizeForShape(comp.shape);
        comp.size[paramIdx] = val;
        renderCurrentSpec('visual', false, false);
      });

      input.addEventListener('change', () => {
        if (!comp.size) comp.size = getDefaultSizeForShape(comp.shape);
        const val = parseTypingNumber(input);
        const defSizes = getDefaultSizeForShape(comp.shape);
        const safeVal = val !== null && val >= minVal ? val : (comp.size[paramIdx] ?? defSizes[paramIdx] ?? 0.1);
        comp.size[paramIdx] = safeVal;
        input.value = `${safeVal}`;
        renderCurrentSpec('visual', true, false);
      });
    });

    // Material Color
    const inpMatColor = document.getElementById('inp-mat-color') as HTMLInputElement | null;
    const inpMatColorHex = document.getElementById('inp-mat-color-hex') as HTMLInputElement | null;

    inpMatColor?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      comp.color = val;
      if (inpMatColorHex) inpMatColorHex.value = val;
      renderCurrentSpec('visual', false, false);
    });
    inpMatColor?.addEventListener('change', () => {
      pushHistoryState(currentSpec);
    });

    inpMatColorHex?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value.trim();
      if (/^#[0-9a-fA-F]{6}$/.test(val)) {
        comp.color = val;
        if (inpMatColor) inpMatColor.value = val;
        renderCurrentSpec('visual', false, false);
      }
    });
    inpMatColorHex?.addEventListener('change', (e) => {
      const val = (e.target as HTMLInputElement).value.trim() || '#4a5568';
      comp.color = val;
      if (inpMatColor && /^#[0-9a-fA-F]{6}$/.test(val)) inpMatColor.value = val;
      renderCurrentSpec('visual', true, false);
    });

    // Roughness & Metalness
    const inpRoughness = document.getElementById('inp-roughness') as HTMLInputElement | null;
    const dispRoughness = document.getElementById('disp-roughness');
    inpRoughness?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      comp.roughness = val;
      if (dispRoughness) dispRoughness.textContent = `${val}`;
      renderCurrentSpec('visual', false, false);
    });
    inpRoughness?.addEventListener('change', () => pushHistoryState(currentSpec));

    const inpMetalness = document.getElementById('inp-metalness') as HTMLInputElement | null;
    const dispMetalness = document.getElementById('disp-metalness');
    inpMetalness?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      comp.metalness = val;
      if (dispMetalness) dispMetalness.textContent = `${val}`;
      renderCurrentSpec('visual', false, false);
    });
    inpMetalness?.addEventListener('change', () => pushHistoryState(currentSpec));

    // Transparent & Opacity
    const chkTransparent = document.getElementById('chk-transparent') as HTMLInputElement | null;
    const inpOpacity = document.getElementById('inp-opacity') as HTMLInputElement | null;
    const dispOpacity = document.getElementById('disp-opacity');

    chkTransparent?.addEventListener('change', (e) => {
      const isChecked = (e.target as HTMLInputElement).checked;
      comp.transparent = isChecked;
      if (isChecked && (comp.opacity === undefined || comp.opacity >= 1.0)) {
        comp.opacity = 0.55;
        if (inpOpacity) inpOpacity.value = '0.55';
        if (dispOpacity) dispOpacity.textContent = '0.55';
      } else if (!isChecked) {
        comp.opacity = 1.0;
        if (inpOpacity) inpOpacity.value = '1.0';
        if (dispOpacity) dispOpacity.textContent = '1.00';
      }
      renderCurrentSpec('visual', true, false);
    });

    inpOpacity?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      comp.opacity = val;
      if (val < 1.0) {
        comp.transparent = true;
        if (chkTransparent) chkTransparent.checked = true;
      } else {
        comp.transparent = false;
        if (chkTransparent) chkTransparent.checked = false;
      }
      if (dispOpacity) dispOpacity.textContent = val.toFixed(2);
      renderCurrentSpec('visual', false, false);
    });
    inpOpacity?.addEventListener('change', () => pushHistoryState(currentSpec));

    // Texture Preset & Interactive Material Browser
    const selTexturePreset = document.getElementById('sel-texture-preset') as HTMLSelectElement | null;
    const matBrowserGrid = document.getElementById('mat-browser-grid');
    const inpMatSearch = document.getElementById('inp-mat-browser-search') as HTMLInputElement | null;
    const matCatPills = document.querySelectorAll('#mat-cat-pills .mat-cat-pill');
    let activeMatCategory = currentActiveMatCategory;

    const pillLocalPc = document.getElementById('pill-local-pc') as HTMLButtonElement | null;
    if (isDesktopEnv && pillLocalPc) {
      pillLocalPc.style.display = 'inline-flex';
      const countEl = document.getElementById('local-mat-count');
      if (countEl) countEl.textContent = String(localTexturesList.length);
    }

    if (activeMatCategory !== 'all') {
      matCatPills.forEach((p) => {
        if ((p as HTMLElement).dataset.matCat === activeMatCategory) {
          p.classList.add('active');
        } else {
          p.classList.remove('active');
        }
      });
    }

    const applyPresetToComponent = (val: string) => {
      if (val) {
        comp.texturePreset = val;
        if (val.startsWith('local:') || val.startsWith('custom:')) {
          comp.transparent = false;
          comp.opacity = 1.0;
          if (chkTransparent) chkTransparent.checked = false;
          if (inpOpacity) inpOpacity.value = '1.0';
          if (dispOpacity) dispOpacity.textContent = '1.00';
          comp.color = '#ffffff';
          const inpColor = document.getElementById('inp-mat-color') as HTMLInputElement | null;
          const inpHex = document.getElementById('inp-mat-color-hex') as HTMLInputElement | null;
          if (inpColor) inpColor.value = '#ffffff';
          if (inpHex) inpHex.value = '#ffffff';
          ensureLocalTextureLoaded(val);
        } else {
          const variant = TextureLibrary.getParametricVariant(val);
          const resolvedName = TextureLibrary.resolvePresetName(val);
          const profile = resolvedName ? TextureLibrary.PROFILES[resolvedName] : undefined;

          const isTransp = Boolean(variant?.transparent || profile?.transparent);
          const defOpacity = variant?.opacity ?? profile?.opacity ?? 0.55;

          if (isTransp) {
            comp.transparent = true;
            comp.opacity = defOpacity;
            if (chkTransparent) chkTransparent.checked = true;
            if (inpOpacity) inpOpacity.value = String(comp.opacity);
            if (dispOpacity) dispOpacity.textContent = comp.opacity.toFixed(2);
          } else {
            // Reset transparency when switching from glass/hologram to an opaque material
            comp.transparent = false;
            comp.opacity = 1.0;
            if (chkTransparent) chkTransparent.checked = false;
            if (inpOpacity) inpOpacity.value = '1.0';
            if (dispOpacity) dispOpacity.textContent = '1.00';
          }

          // Update roughness, metalness & normalStrength sliders to reflect selected material's physics defaults
          const targetRoughness = variant?.roughness ?? profile?.roughness;
          const targetMetalness = variant?.metalness ?? profile?.metalness;
          const targetNormal = profile?.normalStrength ?? 0.55;

          if (targetRoughness !== undefined) {
            comp.roughness = targetRoughness;
            const inpR = document.getElementById('inp-roughness') as HTMLInputElement | null;
            const dispR = document.getElementById('disp-roughness');
            if (inpR) inpR.value = String(targetRoughness);
            if (dispR) dispR.textContent = String(targetRoughness);
          }
          if (targetMetalness !== undefined) {
            comp.metalness = targetMetalness;
            const inpM = document.getElementById('inp-metalness') as HTMLInputElement | null;
            const dispM = document.getElementById('disp-metalness');
            if (inpM) inpM.value = String(targetMetalness);
            if (dispM) dispM.textContent = String(targetMetalness);
          }
          comp.normalStrength = targetNormal;
          const inpN = document.getElementById('inp-mat-normal') as HTMLInputElement | null;
          const dispN = document.getElementById('disp-mat-normal');
          if (inpN) inpN.value = String(targetNormal);
          if (dispN) dispN.textContent = targetNormal.toFixed(2);

          const targetWear = variant?.wear ?? 0;
          comp.wear = targetWear;
          const inpW = document.getElementById('inp-mat-wear') as HTMLInputElement | null;
          const dispW = document.getElementById('disp-mat-wear');
          if (inpW) inpW.value = String(targetWear);
          if (dispW) dispW.textContent = `${Math.round(targetWear * 100)}%`;
        }
      } else {
        delete comp.texturePreset;
        comp.transparent = false;
        comp.opacity = 1.0;
        if (chkTransparent) chkTransparent.checked = false;
        if (inpOpacity) inpOpacity.value = '1.0';
        if (dispOpacity) dispOpacity.textContent = '1.00';
      }

      if (selTexturePreset && selTexturePreset.value !== val) {
        selTexturePreset.value = val;
      }
      const dispActiveTexPill = document.getElementById('disp-active-tex-pill');
      if (dispActiveTexPill) {
        dispActiveTexPill.textContent = val || 'color plano';
      }
      renderMaterialBrowserCards();
      renderCurrentSpec('visual', true, false);
    };

    const renderMaterialBrowserCards = () => {
      if (!matBrowserGrid) return;
      const q = (inpMatSearch?.value || '').toLowerCase().trim();

      const PLACEHOLDER_THUMB = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';

      if (activeMatCategory === 'local_pc') {
        const filteredFiles = localTexturesList.filter((f) => !q || f.toLowerCase().includes(q));

        const toolbarHtml = `
          <div class="local-tex-toolbar" style="grid-column: 1 / -1; display: flex; gap: 0.35rem; margin-bottom: 0.5rem; flex-wrap: wrap; align-items: center; justify-content: space-between; padding: 0.4rem; background: #0c1017; border: 1px dashed var(--ps1-gold); border-radius: 4px;">
            <div style="display: flex; gap: 0.35rem; align-items: center; flex-wrap: wrap;">
              <button type="button" id="btn-open-tex-folder" class="btn-tool-mini" style="background: #1a2233; color: var(--ps1-gold); border: 1px solid var(--ps1-gold); font-size: 0.65rem; padding: 0.25rem 0.5rem; cursor: pointer; border-radius: 3px;" title="Abrir carpeta local de texturas en el explorador de archivos">
                📂 ABRIR CARPETA
              </button>
              <button type="button" id="btn-refresh-local-tex" class="btn-tool-mini" style="background: #1a2233; color: var(--ps1-cyan); border: 1px solid var(--ps1-cyan); font-size: 0.65rem; padding: 0.25rem 0.5rem; cursor: pointer; border-radius: 3px;" title="Volver a escanear archivos en disco">
                🔄 REFRESCAR
              </button>
              <a href="https://ivorbitgames.online/herramientas/texture-studio" target="_blank" rel="noopener noreferrer" class="btn-tool-mini" style="background: #0d1e33; color: var(--ps1-cyan); border: 1px solid var(--ps1-cyan); font-size: 0.65rem; padding: 0.25rem 0.5rem; text-decoration: none; border-radius: 3px; display: inline-flex; align-items: center; gap: 0.25rem;" title="Crear y extraer texturas PBR sin costuras con IV Orbit Texture Studio">
                🪐 TEXTURE STUDIO
              </a>
            </div>
            <label id="lbl-add-local-tex" class="btn-tool-mini" style="background: var(--ps1-gold); color: #000; font-weight: bold; font-size: 0.65rem; padding: 0.25rem 0.5rem; cursor: pointer; border-radius: 3px; display: inline-flex; align-items: center; gap: 0.25rem;" title="Importar imagen (PNG, JPG, WebP) directamente a la carpeta de texturas">
              ➕ AÑADIR
              <input type="file" id="inp-add-local-file" accept="image/png,image/jpeg,image/webp" style="display: none;" />
            </label>
          </div>
        `;

        const wireLocalToolbar = () => {
          const btnOpen = matBrowserGrid.querySelector('#btn-open-tex-folder');
          btnOpen?.addEventListener('click', async () => {
            const invoke = getTauriInvoke();
            if (invoke) {
              try {
                await invoke('open_textures_folder');
              } catch (err) {
                showStudioToast('No se pudo abrir la carpeta de texturas', true);
              }
            }
          });

          const btnRef = matBrowserGrid.querySelector('#btn-refresh-local-tex');
          btnRef?.addEventListener('click', async () => {
            showStudioToast('🔄 Escaneando texturas...');
            await refreshLocalTextures();
            renderMaterialBrowserCards();
            showStudioToast(`✅ ${localTexturesList.length} texturas listas`);
          });

          const inpFile = matBrowserGrid.querySelector('#inp-add-local-file') as HTMLInputElement | null;
          inpFile?.addEventListener('change', async () => {
            const file = inpFile.files?.[0];
            if (!file) return;
            const invoke = getTauriInvoke();
            if (!invoke) return;
            try {
              showStudioToast(`Importando ${file.name}...`);
              const reader = new FileReader();
              reader.onload = async () => {
                const dataUrl = reader.result as string;
                try {
                  await invoke('import_texture_to_folder', { fileName: file.name, base64Data: dataUrl });
                  TextureLibrary.registerCustomTexture('local:' + file.name, dataUrl);
                  TextureLibrary.registerCustomTexture(file.name, dataUrl);
                  await refreshLocalTextures();
                  renderMaterialBrowserCards();
                  showStudioToast(`✅ Textura guardada: ${file.name}`);
                } catch (e: any) {
                  showStudioToast(`Error al guardar textura: ${e}`, true);
                }
              };
              reader.readAsDataURL(file);
            } catch (err: any) {
              showStudioToast(`Error al leer archivo: ${err.message}`, true);
            }
          });
        };

        if (filteredFiles.length === 0) {
          matBrowserGrid.innerHTML = toolbarHtml + `
            <div class="mat-empty-msg" style="grid-column: 1 / -1; padding: 1.5rem 1rem; text-align: center; color: var(--text-dim); font-size: 0.75rem; background: #0c1017; border-radius: 4px; border: 1px dashed var(--ps1-steel);">
              ${localTexturesList.length === 0
                ? 'No hay texturas en <code>Documentos/ModelCoder/Textures/</code>.<br>Haz clic en <b>➕ AÑADIR</b> o <b>📂 ABRIR CARPETA</b> para colocar tus imágenes PNG o JPG.'
                : `Sin resultados para "${escapeHtml(q)}"`}
            </div>
          `;
          wireLocalToolbar();
          return;
        }

        matBrowserGrid.innerHTML = toolbarHtml + filteredFiles.map((file) => {
          const presetId = 'local:' + file;
          const isActive = comp.texturePreset === presetId || comp.texturePreset === file;
          const thumbUrl = TextureLibrary.getCustomDataUrl(presetId) || TextureLibrary.getCustomDataUrl(file) || PLACEHOLDER_THUMB;
          return `
            <button type="button" class="mat-card-btn ${isActive ? 'active' : ''}" data-preset-id="${presetId}" title="${escapeHtml(file)}">
              <img src="${thumbUrl}" alt="${escapeHtml(file)}" class="mat-card-thumb" style="object-fit: cover;" loading="lazy" />
              <div class="mat-card-meta">
                <span class="mat-card-title" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${escapeHtml(file)}</span>
                <div class="mat-card-badges">
                  <span class="mat-pbr-badge" style="background: var(--ps1-gold); color: #000; font-weight: bold;">PC</span>
                </div>
              </div>
            </button>
          `;
        }).join('');

        wireLocalToolbar();

        matBrowserGrid.querySelectorAll('.mat-card-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const presetId = (btn as HTMLElement).dataset.presetId || '';
            applyPresetToComponent(presetId);
          });
        });
        return;
      }

      interface BrowserItem {
        id: string;
        label: string;
        badges: string[];
      }
      const items: BrowserItem[] = [];

      if (activeMatCategory !== 'variants') {
        const profiles = TextureLibrary.getProfilesByCategory(
          activeMatCategory === 'all' ? 'all' : (activeMatCategory as MaterialFamilyCategory),
          q
        );
        for (const p of profiles) {
          const badges: string[] = [];
          if ((p.normalStrength ?? 0.5) > 0.1 && !p.transparent) badges.push('NORM');
          if (p.metalness >= 0.5) badges.push('METAL');
          if (p.emissive) badges.push('EMISSIVE');
          if (p.transparent) badges.push('ALPHA');
          items.push({ id: p.name, label: p.label, badges });
        }
      }

      if (activeMatCategory === 'all' || activeMatCategory === 'variants') {
        for (const v of Object.values(TextureLibrary.PARAMETRIC_VARIANTS)) {
          if (q) {
            const match =
              v.id.toLowerCase().includes(q) ||
              v.label.toLowerCase().includes(q) ||
              v.tags.some((t) => t.toLowerCase().includes(q));
            if (!match) continue;
          }
          const badges = ['VAR'];
          if (v.metalness >= 0.5) badges.push('METAL');
          if (v.transparent) badges.push('ALPHA');
          items.push({ id: v.id, label: v.label, badges });
        }
      }

      if (items.length === 0) {
        matBrowserGrid.innerHTML = `<div class="mat-empty-msg">Sin resultados para "${escapeHtml(q)}"</div>`;
        return;
      }

      const pendingThumbIds: string[] = [];

      matBrowserGrid.innerHTML = items
        .map((it, itemIdx) => {
          const isActive = comp.texturePreset === it.id;
          // Render first 16 visible cards (or active preset) immediately; hydrate remaining cards in non-blocking frames
          const immediateThumb = itemIdx < 16 || isActive;
          const thumbUrl = immediateThumb ? TextureLibrary.getThumbnailDataURL(it.id) : PLACEHOLDER_THUMB;
          if (!immediateThumb) {
            pendingThumbIds.push(it.id);
          }
          const badgeHtml = it.badges
            .slice(0, 2)
            .map((b) => `<span class="mat-pbr-badge badge-${b.toLowerCase()}">${b}</span>`)
            .join('');
          return `
            <button type="button" class="mat-card-btn ${isActive ? 'active' : ''}" data-preset-id="${it.id}" title="${escapeHtml(it.label)} (${it.id})">
              <img src="${thumbUrl}" data-thumb-preset="${it.id}" alt="${escapeHtml(it.label)}" class="mat-card-thumb" loading="lazy" />
              <div class="mat-card-meta">
                <span class="mat-card-title">${escapeHtml(it.label)}</span>
                <div class="mat-card-badges">${badgeHtml}</div>
              </div>
            </button>
          `;
        })
        .join('');

      if (pendingThumbIds.length > 0) {
        let cursor = 0;
        const hydrateBatch = () => {
          if (!matBrowserGrid || !matBrowserGrid.isConnected) return;
          const end = Math.min(cursor + 20, pendingThumbIds.length);
          for (; cursor < end; cursor++) {
            const presetId = pendingThumbIds[cursor];
            const imgEl = matBrowserGrid.querySelector(`img[data-thumb-preset="${presetId}"]`) as HTMLImageElement | null;
            if (imgEl) {
              const url = TextureLibrary.getThumbnailDataURL(presetId);
              if (url) imgEl.src = url;
            }
          }
          if (cursor < pendingThumbIds.length) {
            requestAnimationFrame(hydrateBatch);
          }
        };
        requestAnimationFrame(hydrateBatch);
      }

      matBrowserGrid.querySelectorAll('.mat-card-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const presetId = (btn as HTMLElement).dataset.presetId || '';
          applyPresetToComponent(presetId);
        });
      });
    };

    renderMaterialBrowserCards();

    selTexturePreset?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      applyPresetToComponent(val);
    });

    inpMatSearch?.addEventListener('input', () => {
      renderMaterialBrowserCards();
    });

    matCatPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        matCatPills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');
        activeMatCategory = (pill as HTMLElement).dataset.matCat || 'all';
        currentActiveMatCategory = activeMatCategory;
        renderMaterialBrowserCards();
      });
    });

    // Helper: Bake non-unit scale into geometry size and compute effective dimensions
    const bakeScaleIntoGeometrySize = (): { effW: number; effH: number; effD: number } => {
      if (!comp.size) comp.size = getDefaultSizeForShape(comp.shape);
      const s = comp.size;
      const [sx, sy, sz] = comp.scale || [1, 1, 1];
      const r2 = (n: number) => Math.max(0.01, parseFloat(n.toFixed(3)));

      let effW = 1.0;
      let effH = 1.0;
      let effD = 1.0;

      switch (comp.shape) {
        case 'box':
        case 'wedge':
          s[0] = r2((s[0] ?? 1.0) * sx);
          s[1] = r2((s[1] ?? 1.0) * sy);
          s[2] = r2((s[2] ?? 1.0) * sz);
          effW = s[0];
          effH = s[1];
          effD = s[2];
          break;
        case 'cylinder': {
          const radFactor = (sx + sz) / 2;
          s[0] = r2((s[0] ?? 0.35) * radFactor);
          s[1] = r2((s[1] ?? 0.35) * radFactor);
          s[2] = r2((s[2] ?? 1.0) * sy);
          const maxR = Math.max(s[0], s[1]);
          effW = maxR * 2;
          effH = s[2];
          effD = maxR * 2;
          break;
        }
        case 'sphere': {
          const avgS = (sx + sy + sz) / 3;
          s[0] = r2((s[0] ?? 0.5) * avgS);
          effW = s[0] * 2;
          effH = s[0] * 2;
          effD = s[0] * 2;
          break;
        }
        case 'cone': {
          const radFactor = (sx + sz) / 2;
          s[0] = r2((s[0] ?? 0.4) * radFactor);
          s[1] = r2((s[1] ?? 1.0) * sy);
          effW = s[0] * 2;
          effH = s[1];
          effD = s[0] * 2;
          break;
        }
        case 'torus': {
          const radFactor = (sx + sz) / 2;
          s[0] = r2((s[0] ?? 0.5) * radFactor);
          s[1] = r2((s[1] ?? 0.15) * sy);
          effW = (s[0] + s[1]) * 2;
          effH = s[1] * 2;
          effD = (s[0] + s[1]) * 2;
          break;
        }
        case 'capsule': {
          const radFactor = (sx + sz) / 2;
          s[0] = r2((s[0] ?? 0.25) * radFactor);
          s[1] = r2((s[1] ?? 0.5) * sy);
          effW = s[0] * 2;
          effH = s[1] + s[0] * 2;
          effD = s[0] * 2;
          break;
        }
        case 'plane':
          s[0] = r2((s[0] ?? 1.0) * sx);
          s[1] = r2((s[1] ?? 1.0) * sy);
          effW = s[0];
          effH = s[1];
          effD = s[1];
          break;
      }

      comp.scale = [1, 1, 1];
      return { effW, effH, effD };
    };

    // Auto-Adapt UV to Piece Scale button
    document.getElementById('btn-auto-fit-uv')?.addEventListener('click', () => {
      const { effW, effH, effD } = bakeScaleIntoGeometrySize();

      if (comp.shape === 'box' || comp.shape === 'wedge' || comp.shape === 'cylinder' || comp.shape === 'plane') {
        // World-space UV generators already multiply each face's width & height by uvScale[0] and uvScale[1].
        // Setting isotropic density = 1 / minMainDim fits 1 full tile across the narrowest dimension with zero stretching.
        const dims = comp.shape === 'plane' ? [effW, effH] : [effW, effH, effD];
        const minDim = Math.max(0.08, Math.min(...dims));
        const density = Math.max(0.25, Math.min(12.0, parseFloat((1.0 / minDim).toFixed(2))));
        comp.uvScale = [density, density];
      } else {
        // Parametric shapes (sphere, cone, torus, capsule) use normalized 0..1 UVs
        const uTiles = Math.max(0.5, Math.min(12.0, parseFloat((effW * 1.5).toFixed(2))));
        const vTiles = Math.max(0.5, Math.min(12.0, parseFloat((effH * 1.5).toFixed(2))));
        comp.uvScale = [uTiles, vTiles];
      }

      renderCurrentSpec('visual', true, true);
      showStudioToast(`📐 UV adaptada a la escala de "${comp.name}" (UV: ${comp.uvScale[0]} × ${comp.uvScale[1]})`, false);
    });

    // Reset UV to 1:1 Metric (1m x 1m world-space)
    document.getElementById('btn-reset-uv-metric')?.addEventListener('click', () => {
      bakeScaleIntoGeometrySize();
      comp.uvScale = [1.0, 1.0];
      renderCurrentSpec('visual', true, true);
      showStudioToast(`📏 UV restablecida a escala métrica 1:1 en "${comp.name}"`, false);
    });

    // UV Scale
    const inpUvU = document.getElementById('inp-uv-u') as HTMLInputElement | null;
    const inpUvV = document.getElementById('inp-uv-v') as HTMLInputElement | null;
    ([inpUvU, inpUvV] as const).forEach((el, uvIdx) => {
      el?.addEventListener('input', () => {
        const val = parseTypingNumber(el);
        if (val === null || val < 0.05) return;
        if (!comp.uvScale) comp.uvScale = [1.0, 1.0];
        comp.uvScale[uvIdx] = val;
        renderCurrentSpec('visual', false, false);
      });
      el?.addEventListener('change', () => {
        if (!comp.uvScale) comp.uvScale = [1.0, 1.0];
        const val = parseTypingNumber(el);
        const safeVal = val !== null && val >= 0.05 ? val : (comp.uvScale[uvIdx] || 1.0);
        comp.uvScale[uvIdx] = safeVal;
        if (el) el.value = `${safeVal}`;
        renderCurrentSpec('visual', true, false);
      });
    });

    // UV Rotation
    const inpUvRot = document.getElementById('inp-uv-rot') as HTMLInputElement | null;
    const dispUvRot = document.getElementById('disp-uv-rot');
    inpUvRot?.addEventListener('input', (e) => {
      const deg = parseFloat((e.target as HTMLInputElement).value) || 0;
      comp.uvRotation = deg;
      if (dispUvRot) dispUvRot.textContent = `${deg}°`;
      renderCurrentSpec('visual', false, false);
    });
    inpUvRot?.addEventListener('change', () => pushHistoryState(currentSpec));
    document.querySelectorAll('.uv-rot-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const deg = parseFloat((btn as HTMLElement).dataset.rot || '0') || 0;
        comp.uvRotation = deg;
        if (inpUvRot) inpUvRot.value = String(deg);
        if (dispUvRot) dispUvRot.textContent = `${deg}°`;
        renderCurrentSpec('visual', true, false);
      });
    });

    // Parametric Wear / Grime
    const inpMatWear = document.getElementById('inp-mat-wear') as HTMLInputElement | null;
    const dispMatWear = document.getElementById('disp-mat-wear');
    inpMatWear?.addEventListener('input', (e) => {
      const wearVal = parseFloat((e.target as HTMLInputElement).value) || 0;
      comp.wear = wearVal;
      if (dispMatWear) dispMatWear.textContent = `${Math.round(wearVal * 100)}%`;
      renderCurrentSpec('visual', false, false);
    });
    inpMatWear?.addEventListener('change', () => pushHistoryState(currentSpec));

    // Normal Map Relief Strength
    const inpMatNormal = document.getElementById('inp-mat-normal') as HTMLInputElement | null;
    const dispMatNormal = document.getElementById('disp-mat-normal');
    inpMatNormal?.addEventListener('input', (e) => {
      const normVal = parseFloat((e.target as HTMLInputElement).value) || 0;
      comp.normalStrength = normVal;
      if (dispMatNormal) dispMatNormal.textContent = normVal.toFixed(2);
      renderCurrentSpec('visual', false, false);
    });
    inpMatNormal?.addEventListener('change', () => pushHistoryState(currentSpec));

    // Wireframe
    document.getElementById('chk-comp-wireframe')?.addEventListener('change', (e) => {
      comp.wireframe = (e.target as HTMLInputElement).checked;
      renderCurrentSpec('visual', true, false);
    });

    // Label / Decal
    const inpCompLabel = document.getElementById('inp-comp-label') as HTMLInputElement | null;
    inpCompLabel?.addEventListener('input', () => {
      const val = inpCompLabel.value.trim();
      if (val) comp.label = val;
      else delete comp.label;
      renderCurrentSpec('visual', false, false);
    });
    inpCompLabel?.addEventListener('change', () => {
      const val = inpCompLabel.value.trim();
      if (val) comp.label = val;
      else delete comp.label;
      renderCurrentSpec('visual', true, false);
    });

    // Section 6: Array Modifier
    const chkArrayEnabled = document.getElementById('chk-array-enabled') as HTMLInputElement | null;
    const inpArrayCount = document.getElementById('inp-array-count') as HTMLInputElement | null;
    const inpArrOffX = document.getElementById('inp-arr-off-x') as HTMLInputElement | null;
    const inpArrOffY = document.getElementById('inp-arr-off-y') as HTMLInputElement | null;
    const inpArrOffZ = document.getElementById('inp-arr-off-z') as HTMLInputElement | null;
    const selArrRadialAxis = document.getElementById('sel-arr-radial-axis') as HTMLSelectElement | null;
    const inpArrRadialRadius = document.getElementById('inp-arr-radial-radius') as HTMLInputElement | null;
    const inpArrRadialAngle = document.getElementById('inp-arr-radial-angle') as HTMLInputElement | null;
    const btnUnrollArray = document.getElementById('btn-unroll-array');

    chkArrayEnabled?.addEventListener('change', () => {
      if (!comp.array) {
        comp.array = { enabled: chkArrayEnabled.checked, type: 'linear', count: 3, offset: [0.5, 0, 0] };
      } else {
        comp.array.enabled = chkArrayEnabled.checked;
      }
      renderCurrentSpec('visual', true, true);
    });

    inspectorContentMount?.querySelectorAll('.btn-array-type').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const type = (btn as HTMLElement).dataset.type as 'linear' | 'radial';
        if (!type) return;
        if (!comp.array) {
          comp.array = { enabled: true, type, count: 3 };
        } else {
          comp.array.type = type;
        }
        renderCurrentSpec('visual', true, true);
      });
    });

    inpArrayCount?.addEventListener('change', () => {
      const c = parseInt(inpArrayCount.value, 10);
      if (c >= 2 && c <= 64) {
        if (!comp.array) comp.array = { enabled: true, type: 'linear', count: c };
        else comp.array.count = c;
        renderCurrentSpec('visual', true, false);
      }
    });

    const updateArrayOffset = () => {
      if (!comp.array) comp.array = { enabled: true, type: 'linear', count: 3 };
      comp.array.offset = [
        parseFloat(inpArrOffX?.value || '0.5'),
        parseFloat(inpArrOffY?.value || '0'),
        parseFloat(inpArrOffZ?.value || '0')
      ];
      renderCurrentSpec('visual', true, false);
    };
    inpArrOffX?.addEventListener('change', updateArrayOffset);
    inpArrOffY?.addEventListener('change', updateArrayOffset);
    inpArrOffZ?.addEventListener('change', updateArrayOffset);

    selArrRadialAxis?.addEventListener('change', () => {
      if (!comp.array) comp.array = { enabled: true, type: 'radial', count: 4 };
      comp.array.radialAxis = (selArrRadialAxis.value || 'y') as any;
      renderCurrentSpec('visual', true, false);
    });

    inpArrRadialRadius?.addEventListener('change', () => {
      if (!comp.array) comp.array = { enabled: true, type: 'radial', count: 4 };
      comp.array.radialRadius = parseFloat(inpArrRadialRadius.value || '1.0');
      renderCurrentSpec('visual', true, false);
    });

    inpArrRadialAngle?.addEventListener('change', () => {
      if (!comp.array) comp.array = { enabled: true, type: 'radial', count: 4 };
      comp.array.radialAngle = parseFloat(inpArrRadialAngle.value || '360');
      renderCurrentSpec('visual', true, false);
    });

    btnUnrollArray?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!comp.array?.enabled) return;
      currentSpec = ProceduralEngine.unrollArrayModifier(currentSpec, selectedComponentIndex!);
      pushHistoryState(currentSpec);
      renderCurrentSpec('visual', true, true);
      showStudioToast('▦ Array desglosado en piezas independientes');
    });

    // Section 7: Boolean CSG operations
    const chkBoolEnabled = document.getElementById('chk-bool-enabled') as HTMLInputElement | null;
    const selectBoolTarget = document.getElementById('select-bool-target') as HTMLSelectElement | null;
    const chkBoolHideTarget = document.getElementById('chk-bool-hide-target') as HTMLInputElement | null;
    const btnBakeBoolean = document.getElementById('btn-bake-boolean');

    chkBoolEnabled?.addEventListener('change', () => {
      const otherComps = currentSpec.components.filter((_, idx) => idx !== selectedComponentIndex);
      const firstOther = otherComps[0]?.name || '';
      if (!comp.boolean) {
        comp.boolean = {
          enabled: chkBoolEnabled.checked,
          operation: 'difference',
          targetComponent: firstOther,
          hideTarget: true
        };
      } else {
        comp.boolean.enabled = chkBoolEnabled.checked;
        if (!comp.boolean.targetComponent && firstOther) {
          comp.boolean.targetComponent = firstOther;
        }
      }
      renderCurrentSpec('visual', true, true);
    });

    inspectorContentMount?.querySelectorAll('.btn-bool-op').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const op = (btn as HTMLElement).dataset.op as any;
        if (!op) return;
        const otherComps = currentSpec.components.filter((_, idx) => idx !== selectedComponentIndex);
        const firstOther = otherComps[0]?.name || '';
        if (!comp.boolean) {
          comp.boolean = { enabled: true, operation: op, targetComponent: firstOther, hideTarget: true };
        } else {
          comp.boolean.operation = op;
        }
        renderCurrentSpec('visual', true, true);
      });
    });

    selectBoolTarget?.addEventListener('change', () => {
      const target = selectBoolTarget.value;
      if (!comp.boolean) {
        comp.boolean = { enabled: true, operation: 'difference', targetComponent: target, hideTarget: true };
      } else {
        comp.boolean.targetComponent = target;
      }
      renderCurrentSpec('visual', true, true);
    });

    chkBoolHideTarget?.addEventListener('change', () => {
      if (!comp.boolean) {
        const otherComps = currentSpec.components.filter((_, idx) => idx !== selectedComponentIndex);
        const firstOther = otherComps[0]?.name || '';
        comp.boolean = {
          enabled: true,
          operation: 'difference',
          targetComponent: firstOther,
          hideTarget: chkBoolHideTarget.checked
        };
      } else {
        comp.boolean.hideTarget = chkBoolHideTarget.checked;
      }
      renderCurrentSpec('visual', true, true);
    });

    btnBakeBoolean?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!comp.boolean?.targetComponent) {
        showStudioToast('⚠️ Selecciona primero una pieza objetivo para la booleana', true);
        return;
      }
      currentSpec = ProceduralEngine.bakeBooleanOperation(currentSpec, selectedComponentIndex!, true);
      pushHistoryState(currentSpec);
      renderCurrentSpec('visual', true, true);
      showStudioToast('🍳 Booleana horneada con éxito a malla única');
    });

    // Section 8: Animation & Mechanics logic for this component
    const animsWrap = document.getElementById('inspector-comp-anims-wrap');
    const btnQuickAddAnim = document.getElementById('btn-quick-add-anim');

    btnQuickAddAnim?.addEventListener('click', (e) => {
      e.stopPropagation();
      openAnimationPresetModal(comp.name);
    });

    if (animsWrap) {
      const compAnims = (currentSpec.animations || []).filter(
        (a) => a.tracks && a.tracks.some((t) => t.targetComponent === comp.name)
      );

      if (compAnims.length > 0) {
        let html = '<div class="comp-anims-active-list">';
        compAnims.forEach((anim) => {
          html += `
            <div class="comp-anim-item ps1-inset" style="display: flex; justify-content: space-between; align-items: center; padding: 0.4rem 0.6rem; margin-bottom: 0.4rem; background: #080d18; border: 1px solid #1a253a;">
              <div>
                <strong style="color: var(--ps1-gold); font-family: var(--font-pixel); font-size: 0.72rem;">🎬 ${escapeHtml(anim.name)}</strong>
                <span style="display: block; font-family: var(--font-mono); font-size: 0.62rem; color: var(--text-muted);">${anim.duration.toFixed(1)}s · ${anim.loop || 'repeat'}</span>
              </div>
              <div style="display: flex; gap: 0.3rem;">
                <button type="button" class="btn-mini btn-cyan btn-test-comp-anim" data-anim-name="${escapeHtml(anim.name)}" title="Probar esta animación en el visor">
                  ▶ Probar
                </button>
                <button type="button" class="btn-mini btn-outline btn-edit-comp-anim" data-anim-name="${escapeHtml(anim.name)}" title="Editar fotogramas, curvas y tiempos de esta animación">
                  ✏️ Editar
                </button>
                <button type="button" class="btn-mini btn-danger-link btn-del-comp-anim" data-anim-name="${escapeHtml(anim.name)}" title="Eliminar animación">
                  🗑️
                </button>
              </div>
            </div>
          `;
        });
        html += '</div>';
        animsWrap.innerHTML = html;

        animsWrap.querySelectorAll('.btn-test-comp-anim').forEach((btn) => {
          btn.addEventListener('click', () => {
            const name = (btn as HTMLElement).dataset.animName;
            if (name) {
              if (animClipSelect) animClipSelect.value = name;
              viewport?.playAnimation(name);
              showStudioToast(`▶ Reproduciendo: ${name}`);
            }
          });
        });

        animsWrap.querySelectorAll('.btn-edit-comp-anim').forEach((btn) => {
          btn.addEventListener('click', () => {
            const name = (btn as HTMLElement).dataset.animName;
            if (name) {
              editExistingAnimation(name);
            }
          });
        });

        animsWrap.querySelectorAll('.btn-del-comp-anim').forEach((btn) => {
          btn.addEventListener('click', () => {
            const name = (btn as HTMLElement).dataset.animName;
            if (name && currentSpec.animations) {
              currentSpec.animations = currentSpec.animations.filter((a) => a.name !== name);
              renderCurrentSpec('visual', true, true);
              showStudioToast(`🗑️ Pista eliminada: ${name}`);
            }
          });
        });
      } else {
        animsWrap.innerHTML = `
          <div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted); margin-bottom: 0.5rem; line-height: 1.3;">
            Esta pieza no tiene animación asignada aún. Elige un comportamiento mecánico rápido:
          </div>
          <div class="quick-preset-chips" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.35rem;">
            <button type="button" class="btn-mini btn-outline btn-chip-preset" data-preset="sliding_door">🚪 Puerta Corrediza</button>
            <button type="button" class="btn-mini btn-outline btn-chip-preset" data-preset="hinge_lid">🧰 Tapa / Bisagra</button>
            <button type="button" class="btn-mini btn-outline btn-chip-preset" data-preset="button_press">🔘 Pulsador</button>
            <button type="button" class="btn-mini btn-outline btn-chip-preset" data-preset="spin_continuous">🔄 Giro 360°</button>
            <button type="button" class="btn-mini btn-outline btn-chip-preset" data-preset="mechanical_deploy">🚀 Despliegue</button>
            <button type="button" class="btn-mini btn-outline btn-chip-preset" data-preset="idle_hover">🛸 Flotación Idle</button>
          </div>
        `;

        animsWrap.querySelectorAll('.btn-chip-preset').forEach((btn) => {
          btn.addEventListener('click', () => {
            const preset = (btn as HTMLElement).dataset.preset as AnimationPresetType;
            openAnimationPresetModal(comp.name, preset);
          });
        });
      }
    }
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // --- GIZMO TOOLBAR CONTROLS ---
  function updateGizmoButtons(activeGizmoMode: TransformGizmoMode): void {
    [gizmoBtnSelect, gizmoBtnTranslate, gizmoBtnRotate, gizmoBtnScale].forEach((btn) => {
      btn?.classList.remove('active');
    });

    if (activeGizmoMode === 'none') gizmoBtnSelect?.classList.add('active');
    else if (activeGizmoMode === 'translate') gizmoBtnTranslate?.classList.add('active');
    else if (activeGizmoMode === 'rotate') gizmoBtnRotate?.classList.add('active');
    else if (activeGizmoMode === 'scale') gizmoBtnScale?.classList.add('active');
  }

  gizmoBtnSelect?.addEventListener('click', () => {
    viewport?.setGizmoMode('none');
    updateGizmoButtons('none');
  });
  gizmoBtnTranslate?.addEventListener('click', () => {
    viewport?.setGizmoMode('translate');
    updateGizmoButtons('translate');
  });
  gizmoBtnRotate?.addEventListener('click', () => {
    viewport?.setGizmoMode('rotate');
    updateGizmoButtons('rotate');
  });
  gizmoBtnScale?.addEventListener('click', () => {
    viewport?.setGizmoMode('scale');
    updateGizmoButtons('scale');
  });

  const selectSnapGrid = document.getElementById('select-snap-grid') as HTMLSelectElement | null;
  const selectSnapAngle = document.getElementById('select-snap-angle') as HTMLSelectElement | null;
  const gizmoBtnMagnet = document.getElementById('gizmo-btn-magnet');
  const btnCancelMagnet = document.getElementById('btn-cancel-magnet');

  gizmoBtnSnap?.addEventListener('click', () => {
    isGridSnapEnabled = !isGridSnapEnabled;
    gizmoBtnSnap.classList.toggle('active', isGridSnapEnabled);
    viewport?.setSnap(isGridSnapEnabled, currentTranslationSnap, currentRotationSnapDeg);
  });

  selectSnapGrid?.addEventListener('change', () => {
    currentTranslationSnap = parseFloat(selectSnapGrid.value) || 0.1;
    if (isGridSnapEnabled) {
      viewport?.setSnap(true, currentTranslationSnap, currentRotationSnapDeg);
    }
  });

  selectSnapAngle?.addEventListener('change', () => {
    currentRotationSnapDeg = parseFloat(selectSnapAngle.value) || 15;
    if (isGridSnapEnabled) {
      viewport?.setSnap(true, currentTranslationSnap, currentRotationSnapDeg);
    }
  });

  gizmoBtnMagnet?.addEventListener('click', () => {
    toggleFaceMagnetMode();
  });

  btnCancelMagnet?.addEventListener('click', () => {
    viewport?.deactivateFaceMagnet();
    updateMagnetUIState(false);
  });

  function toggleFaceMagnetMode(): void {
    if (!viewport) return;
    if (selectedComponentIndex === null) {
      showStudioToast('⚠️ Selecciona una pieza primero para activar el imán', true);
      return;
    }

    if (viewport.isFaceMagnetMode()) {
      viewport.deactivateFaceMagnet();
      updateMagnetUIState(false);
      return;
    }

    updateMagnetUIState(true);
    viewport.activateFaceMagnet(
      (hitPoint, normal, hitCompIdx) => {
        if (selectedComponentIndex === null) return;
        const comp = currentSpec.components[selectedComponentIndex];
        if (!comp) return;

        // Compute orientation aligned with surface normal
        const q = new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 1, 0), normal);
        const euler = new THREE.Euler().setFromQuaternion(q, 'XYZ');
        let rot: [number, number, number] = [
          parseFloat(THREE.MathUtils.radToDeg(euler.x).toFixed(1)),
          parseFloat(THREE.MathUtils.radToDeg(euler.y).toFixed(1)),
          parseFloat(THREE.MathUtils.radToDeg(euler.z).toFixed(1))
        ];

        // Compute offset along normal based on real dimensions of each shape
        const s = comp.size || [1, 1, 1];
        const scl = comp.scale || [1, 1, 1];
        let rawHeight = s[1] ?? 1.0;
        if (comp.shape === 'cylinder' || comp.shape === 'pipe') {
          rawHeight = s[2] ?? 1.0;
        } else if (comp.shape === 'sphere') {
          rawHeight = (s[0] ?? 0.5) * 2;
        }
        const height = Math.max(0.01, rawHeight * (scl[1] ?? 1.0));
        const isPivotAtBase = (comp.pivot?.[1] ?? 0) < -0.01;
        const offset = isPivotAtBase ? 0.002 : (height / 2 + 0.002);

        const targetPos = hitPoint.clone().addScaledVector(normal, offset);

        // If component has a parent, convert world position AND world orientation into parent local coordinate space
        if (comp.parentId) {
          const parentComp = currentSpec.components.find((c) => c.name === comp.parentId);
          if (parentComp) {
            const parentIdx = currentSpec.components.indexOf(parentComp);
            const parentMesh = viewport?.getMeshByComponentIndex?.(parentIdx);
            if (parentMesh) {
              const inv = parentMesh.matrixWorld.clone().invert();
              targetPos.applyMatrix4(inv);

              const parentQuat = new THREE.Quaternion();
              parentMesh.getWorldQuaternion(parentQuat);
              const localQ = parentQuat.clone().invert().multiply(q);
              const localEuler = new THREE.Euler().setFromQuaternion(localQ, 'XYZ');
              rot = [
                parseFloat(THREE.MathUtils.radToDeg(localEuler.x).toFixed(1)),
                parseFloat(THREE.MathUtils.radToDeg(localEuler.y).toFixed(1)),
                parseFloat(THREE.MathUtils.radToDeg(localEuler.z).toFixed(1))
              ];
            }
          }
        }

        comp.position = [
          parseFloat(targetPos.x.toFixed(3)),
          parseFloat(targetPos.y.toFixed(3)),
          parseFloat(targetPos.z.toFixed(3))
        ];
        comp.rotation = rot;

        updateMagnetUIState(false);
        renderCurrentSpec('visual', true, true);
        showStudioToast(hitCompIdx !== null ? '🧲 Pieza adherida a la superficie con éxito' : '🧲 Pieza adherida al suelo con éxito');
      },
      () => {
        updateMagnetUIState(false);
      }
    );
  }

  function updateMagnetUIState(active: boolean): void {
    const banner = document.getElementById('face-magnet-banner');
    if (banner) banner.classList.toggle('hidden', !active);
    const gizmoBtnMagnet = document.getElementById('gizmo-btn-magnet');
    if (gizmoBtnMagnet) gizmoBtnMagnet.classList.toggle('active', active);
    const inspBtnMagnet = document.getElementById('btn-insp-magnet');
    if (inspBtnMagnet) inspBtnMagnet.classList.toggle('active', active);
  }

  // Camera Presets
  document.querySelectorAll('.btn-cam-preset').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const preset = (e.currentTarget as HTMLElement).dataset.preset as CameraViewPreset;
      if (viewport && preset) {
        viewport.setViewPreset(preset);
      }
    });
  });

  // Focus Selected Component
  btnFocusSelected?.addEventListener('click', () => {
    if (viewport && selectedComponentIndex !== null) {
      viewport.focusComponent(selectedComponentIndex);
    }
  });

  // Toggle Grid & Axes
  let isGridVisible = true;
  btnToggleGrid?.addEventListener('click', () => {
    isGridVisible = !isGridVisible;
    btnToggleGrid.classList.toggle('active', isGridVisible);
    viewport?.setGridVisible(isGridVisible);
  });

  let isAxesVisible = true;
  btnToggleAxes?.addEventListener('click', () => {
    isAxesVisible = !isAxesVisible;
    btnToggleAxes.classList.toggle('active', isAxesVisible);
    viewport?.setAxesVisible(isAxesVisible);
  });

  // --- KEYBOARD SHORTCUTS ---
  window.addEventListener('keydown', (e) => {
    const targetEl = e.target as HTMLElement | null;
    const activeEl = document.activeElement as HTMLElement | null;
    const targetTag = targetEl?.tagName?.toLowerCase();
    const activeTag = activeEl?.tagName?.toLowerCase();
    const isInputActive =
      targetTag === 'input' ||
      targetTag === 'textarea' ||
      targetTag === 'select' ||
      activeTag === 'input' ||
      activeTag === 'textarea' ||
      activeTag === 'select' ||
      Boolean(targetEl?.isContentEditable) ||
      Boolean(activeEl?.isContentEditable);

    // Undo / Redo (when not typing inside text fields so native input Undo still works)
    if (!isInputActive && (e.ctrlKey || e.metaKey) && (e.key === 'z' || e.key === 'Z')) {
      e.preventDefault();
      if (e.shiftKey) redo();
      else undo();
      return;
    }
    if (!isInputActive && (e.ctrlKey || e.metaKey) && (e.key === 'y' || e.key === 'Y')) {
      e.preventDefault();
      redo();
      return;
    }

    // Delete selected component with Ctrl + X (only when not editing a text field)
    if (!isInputActive && (e.ctrlKey || e.metaKey) && (e.key === 'x' || e.key === 'X')) {
      e.preventDefault();
      if (selectedComponentIndex !== null) {
        deleteComponent(selectedComponentIndex);
      }
      return;
    }

    // Viewport & Editor single-key shortcuts when not typing in text fields or pressing modifiers
    if (!isInputActive && !e.ctrlKey && !e.metaKey && !e.altKey) {
      if (e.key === 'w' || e.key === 'W') {
        viewport?.setGizmoMode('translate');
        updateGizmoButtons('translate');
      } else if (e.key === 'e' || e.key === 'E') {
        viewport?.setGizmoMode('rotate');
        updateGizmoButtons('rotate');
      } else if (e.key === 'r' || e.key === 'R') {
        viewport?.setGizmoMode('scale');
        updateGizmoButtons('scale');
      } else if (e.key === 'q' || e.key === 'Q') {
        viewport?.setGizmoMode('none');
        updateGizmoButtons('none');
      } else if (e.key === 'f' || e.key === 'F') {
        if (selectedComponentIndex !== null) {
          viewport?.focusComponent(selectedComponentIndex);
        }
      } else if (e.code === 'Space') {
        e.preventDefault();
        const info = viewport?.getActiveClipInfo();
        if (info && info.clipCount > 0) {
          if (info.isPlaying) {
            viewport?.pauseAnimation();
            if (btnAnimPlay) btnAnimPlay.textContent = '▶ PLAY';
          } else {
            viewport?.playAnimation(animClipSelect?.value || undefined);
            if (btnAnimPlay) btnAnimPlay.textContent = '⏸ PAUSA';
          }
        }
      }
    }
  });

  // --- AI GENERATION COPILOT ---
  generateAiBtn?.addEventListener('click', () => triggerAIGeneration());
  aiPromptInput?.addEventListener('keydown', (e) => {
