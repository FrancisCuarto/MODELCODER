  function generateDslScriptFromSpec(spec: ModelSpec): string {
    let out = `// ModelCoder Procedural Builder\nbuilder.setName(${JSON.stringify(spec.name)});\n\n`;
    spec.components.forEach((c) => {
      const fn = c.shape === 'cylinder' ? 'addCylinder' : (c.shape === 'sphere' ? 'addSphere' : (c.shape === 'wedge' ? 'addWedge' : 'addBox'));
      const opts: any = {
        name: c.name,
        size: c.size || [1, 1, 1],
        position: c.position || [0, 0, 0],
        color: c.color || '#4a5568'
      };
      if (c.rotation && (c.rotation[0] !== 0 || c.rotation[1] !== 0 || c.rotation[2] !== 0)) {
        opts.rotation = c.rotation;
      }
      if (c.texturePreset) opts.texturePreset = c.texturePreset;
      if (c.materialType) opts.materialType = c.materialType;
      if (c.roughness !== undefined) opts.roughness = c.roughness;
      if (c.metalness !== undefined) opts.metalness = c.metalness;
      if (c.emissive) opts.emissive = c.emissive;
      if (c.emissiveIntensity !== undefined) opts.emissiveIntensity = c.emissiveIntensity;
      if (c.opacity !== undefined && c.opacity < 1.0) opts.opacity = c.opacity;
      if (c.transparent) opts.transparent = true;
      if (c.wireframe) opts.wireframe = true;
      if (c.label) opts.label = c.label;

      out += `builder.${fn}(${JSON.stringify(opts, null, 2)});\n\n`;
    });

    if (spec.animations && spec.animations.length > 0) {
      out += `// Pistas de Animación Cinemática\n`;
      spec.animations.forEach((anim) => {
        out += `builder.addAnimation(${JSON.stringify(anim, null, 2)});\n\n`;
      });
    }

    return out;
  }

  function generatePythonFromSpec(spec: ModelSpec): string {
    const className = (spec.name.replace(/[^a-zA-Z0-9]/g, '') || 'Model') + 'Generator';
    const fps = 30;

    let compCode = '';
    spec.components.forEach((c, idx) => {
      const pos = c.position || [0, 0, 0];
      const rot = c.rotation || [0, 0, 0];
      const scale = c.scale || [1, 1, 1];
      const size = c.size || [1, 1, 1];

      let bmeshPrimitive = '';
      if (c.shape === 'cylinder') {
        const r1 = size[0] || 0.4;
        const r2 = size[1] || 0.4;
        const h = size[2] || 1.0;
        const segs = size[3] || 16;
        bmeshPrimitive = `bmesh.ops.create_cone(bm, cap_ends=True, cap_triangles=False, segments=${segs}, radius1=${r1}, radius2=${r2}, depth=${h})`;
      } else if (c.shape === 'sphere') {
        const rad = size[0] || 0.5;
        const uSegs = size[1] || 16;
        const vSegs = size[2] || 12;
        bmeshPrimitive = `bmesh.ops.create_uvsphere(bm, u_segments=${uSegs}, v_segments=${vSegs}, radius=${rad})`;
      } else {
        bmeshPrimitive = `bmesh.ops.create_cube(bm, size=1.0)\n        bmesh.ops.scale(bm, vec=(${size[0]}, ${size[1]}, ${size[2]}), verts=bm.verts)`;
      }

      compCode += `        # Componente: ${c.name}\n` +
        `        mesh_${idx} = bpy.data.meshes.new("${c.name}_mesh")\n` +
        `        obj_${idx} = bpy.data.objects.new("${c.name}", mesh_${idx})\n` +
        `        bpy.context.collection.objects.link(obj_${idx})\n` +
        `        obj_${idx}.parent = root\n` +
        `        created_objects["${c.name}"] = obj_${idx}\n\n` +
        `        bm = bmesh.new()\n` +
        `        ${bmeshPrimitive}\n` +
        `        bm.to_mesh(mesh_${idx})\n` +
        `        bm.free()\n\n` +
        `        obj_${idx}.location = (${pos[0]}, ${pos[1]}, ${pos[2]})\n` +
        `        obj_${idx}.rotation_euler = (math.radians(${rot[0]}), math.radians(${rot[1]}), math.radians(${rot[2]}))\n` +
        `        obj_${idx}.scale = (${scale[0]}, ${scale[1]}, ${scale[2]})\n\n`;
    });

    let animCode = '';
    if (spec.animations && spec.animations.length > 0) {
      animCode += `        # 2. Pistas de Animación Cinemática para Blender Timeline\n` +
        `        scene = bpy.context.scene\n` +
        `        scene.render.fps = ${fps}\n\n`;

      spec.animations.forEach((clip, clipIdx) => {
        const endFrame = Math.max(1, Math.round(clip.duration * fps));
        animCode += `        # Clip: ${clip.name} (duración ${clip.duration}s)\n` +
          `        scene.frame_start = 0\n` +
          `        scene.frame_end = ${endFrame}\n`;

        clip.tracks.forEach((track) => {
          animCode += `        target_obj = created_objects.get("${track.targetName}")\n` +
            `        if target_obj:\n` +
            `            if not target_obj.animation_data:\n` +
            `                target_obj.animation_data_create()\n` +
            `            action_${clipIdx} = bpy.data.actions.new(name="${clip.name}_${track.targetName}")\n` +
            `            target_obj.animation_data.action = action_${clipIdx}\n`;

          track.keyframes.forEach((kf) => {
            const frame = Math.round(kf.time * fps);
            if (track.property === 'position') {
              animCode += `            target_obj.location = (${kf.value[0]}, ${kf.value[1]}, ${kf.value[2]})\n` +
                `            target_obj.keyframe_insert(data_path="location", frame=${frame})\n`;
            } else if (track.property === 'rotation') {
              animCode += `            target_obj.rotation_euler = (math.radians(${kf.value[0]}), math.radians(${kf.value[1]}), math.radians(${kf.value[2]}))\n` +
                `            target_obj.keyframe_insert(data_path="rotation_euler", frame=${frame})\n`;
            } else if (track.property === 'scale') {
              animCode += `            target_obj.scale = (${kf.value[0]}, ${kf.value[1]}, ${kf.value[2]})\n` +
                `            target_obj.keyframe_insert(data_path="scale", frame=${frame})\n`;
            }
          });
          animCode += `\n`;
        });
      });
    }

    return `"""
Generador procedural 3D para Blender 5.0
Generado automáticamente por ModelCoder Studio
Modelo: ${spec.name} (${spec.id})
"""
import bpy
import bmesh
import math

class ${className}:
    def __init__(self):
        self.fps = ${fps}

    def generate(self) -> bpy.types.Object:
        root = bpy.data.objects.new("${spec.name}", None)
        root.empty_display_type = 'ARROWS'
        bpy.context.collection.objects.link(root)

        created_objects = {}

        # 1. Geometría de Componentes
${compCode}
${animCode}        return root

# Ejecución directa en Blender Scripting
if __name__ == "__main__":
    generator = ${className}()
    generator.generate()
`;
  }

  runCompileBtn?.addEventListener('click', () => compileCode());

  function compileCode(): void {
    if (!codeTextarea) return;
    const code = codeTextarea.value;
    const { spec, error, errorLine } = CodeSandbox.executeCode(code);

    if (error) {
      setLinterError(error, errorLine);
      if (viewport) {
        viewport.displayError(error, `ERR-v${generationCounter}`, generationCounter, 'code');
      }
      return;
    }

    currentSpec = spec;
    selectedComponentIndex = 0;
    renderCurrentSpec('code');
  }

  function setLinterValid(): void {
    if (linterBadge) linterBadge.className = 'status-right status-ok';
    if (linterText) linterText.textContent = 'SINTAXIS: VÁLIDA // 0 ERRORES';
  }

  function setLinterError(msg: string, line?: number): void {
    if (linterBadge) linterBadge.className = 'status-right status-err';
    if (linterText) linterText.textContent = `ERROR ${line ? `LN ${line}: ` : ''}${msg.substring(0, 40)}`;
  }

  const editorTabs = document.querySelectorAll('.editor-tab');
  editorTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      editorTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      activeFile = (tab as HTMLElement).dataset.file as any;
      if (activeFilenameEl) {
        activeFilenameEl.textContent = activeFile === 'spec' ? 'model_spec.json' : (activeFile === 'script' ? 'procedural_script.js' : 'generator.py');
      }
      syncEditorFromSpec();
    });
  });

  codeTextarea?.addEventListener('input', () => updateLineNumbers());
  codeTextarea?.addEventListener('keyup', () => updateCursorPos());
  codeTextarea?.addEventListener('click', () => updateCursorPos());

  function updateLineNumbers(): void {
    if (!codeTextarea || !lineNumbers) return;
    const lines = codeTextarea.value.split('\n').length;
    lineNumbers.innerHTML = Array.from({ length: lines }, (_, i) => i + 1).join('<br>');
  }

  function updateCursorPos(): void {
    if (!codeTextarea || !cursorPos) return;
    const textLines = codeTextarea.value.substring(0, codeTextarea.selectionStart).split('\n');
    cursorPos.textContent = `LN ${textLines.length}, COL ${textLines[textLines.length - 1].length + 1}`;
  }

  // --- SHADING MODES ---
  const shadingBtns = document.querySelectorAll('.btn-shading');
  shadingBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      shadingBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const mode = (btn as HTMLElement).dataset.shading as ShadingMode;
      if (viewport && mode) {
        viewport.setShadingMode(mode);
      }
    });
