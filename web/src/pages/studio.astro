---
import Layout from '../layouts/Layout.astro';
import catalog from '../data/catalog.json';
---

<Layout 
  title="Studio 3D — Editor y Generador Procedural en el Navegador"
  description="Creá, modelá y personalizá objetos 3D procedurales low-poly con IA y controles visuales. Exportá archivos GLB universales listos para Godot, Unity y Blender directamente en tu navegador."
  keywords="editor 3d online, generador 3d procedural con ia, modelado 3d navegador, three.js 3d editor, exportar glb online"
  useModelViewer={false}
  forceTheme="ps1"
>
  <div class="studio-container">
    <!-- Studio Header Bar (Ultra-Compact DCC Style) -->
    <header class="ps1-window studio-topbar-compact" id="studio-topbar">
      <!-- Left zone: Brand logo + Workspace Tabs + Undo/Redo -->
      <div class="topbar-left-zone">
        <a href="/" title="Volver al Catálogo de ModelCoder" class="topbar-brand-link">
          <img src="/logo.png" alt="ModelCoder" class="topbar-brand-logo" />
          <span class="topbar-brand-text">STUDIO</span>
        </a>

        <nav class="workspace-tabs-group" id="workspace-tabs-group" aria-label="Espacios de trabajo">
          <button id="ws-tab-layout" class="btn-workspace-tab active" data-workspace="layout" title="Layout: Visor 3D, Árbol e Inspector">📐 LAYOUT</button>
          <button id="ws-tab-modeling" class="btn-workspace-tab" data-workspace="modeling" title="Modelado: Primitivas y Gizmos">🛠️ MODELADO</button>
          <button id="ws-tab-shading" class="btn-workspace-tab" data-workspace="shading" title="Shading: Texturas y Materiales">🎨 SHADING</button>
          <button id="ws-tab-render" class="btn-workspace-tab" data-workspace="render" title="Render: Vista limpia y turntable">🎬 RENDER</button>
          <button id="ws-tab-code" class="btn-workspace-tab" data-workspace="code" title="Editor de Código">💻 CÓDIGO</button>
          <button id="ws-tab-ai" class="btn-workspace-tab" data-workspace="ai" title="Copiloto IA Gemini">⚡ IA</button>
        </nav>

        <div class="history-actions-group">
          <button id="btn-topbar-undo" class="btn-mini ps1-ctrl-btn" title="Deshacer última acción (Ctrl+Z)" disabled>↩</button>
          <button id="btn-topbar-redo" class="btn-mini ps1-ctrl-btn" title="Rehacer acción (Ctrl+Y)" disabled>↪</button>
        </div>
      </div>

      <!-- Right zone: Quick actions + More tools dropdown + Fullscreen -->
      <div class="topbar-right-zone">
        <button id="btn-save-project" class="btn-mini btn-gold" title="Guardar borrador actual (Ctrl + S)">
          💾 GUARDAR
        </button>
        <button id="btn-my-projects" class="btn-mini ps1-ctrl-btn" title="Ver y retomar mis proyectos y borradores en curso">
          📂 PROYECTOS (<span id="studio-drafts-badge">0</span>)
        </button>
        <button id="btn-open-catalog-templates" class="btn-mini ps1-ctrl-btn" title="Cargar y desarmar cualquier modelo del catálogo para editarlo">
          📦 PLANTILLAS
        </button>
        <button id="run-compile-btn" class="btn-mini btn-cyan" title="Compilar código actual y actualizar visor 3D">
          ⚡ COMPILAR 3D
        </button>
        <button id="export-glb-btn" class="btn-mini btn-gold" title="Exportar modelo a formato universal GLB">
          💾 EXPORTAR GLB
        </button>
        <button id="export-godot-btn" class="btn-mini" style="background: #172a45; color: #6ee7b7; border: 1px solid #2563eb;" title="Exportar modelo con colisiones nativas para Godot 4 (-convcol / StaticBody3D)">
          🤖 GLB GODOT
        </button>

        <!-- Dropdown for Secondary Tools & Exports -->
        <div class="topbar-dropdown-wrap">
          <button id="btn-topbar-more" type="button" class="btn-mini ps1-ctrl-btn" title="Más herramientas, exportaciones y comunidad">
            ⋯ MÁS ▼
          </button>
          <div id="topbar-more-menu" class="topbar-dropdown-menu hidden">
            <button id="btn-menu-welcome-splash" type="button" class="topbar-menu-item" style="color: var(--ps1-cyan);">
              ⚡ PANTALLA DE INICIO (NUEVO / RETOMAR)
            </button>
            <button id="btn-menu-catalog-templates" type="button" class="topbar-menu-item" style="color: var(--ps1-gold);">
              📦 PLANTILLAS DEL CATÁLOGO (100+ MODELOS)
            </button>
            <button id="btn-export-godot-glb" type="button" class="topbar-menu-item" style="color: #6ee7b7;">
              🤖 EXPORTAR GLB CON COLISIÓN GODOT (-convcol)
            </button>
            <button id="btn-export-godot-tscn" type="button" class="topbar-menu-item" style="color: #6ee7b7;">
              🎬 EXPORTAR ESCENA GODOT 4 (.TSCN + COLLIDERS)
            </button>
            <button id="btn-header-story" type="button" class="topbar-menu-item">
              📱 HISTORIA IG / REEL (9:16 o 1:1)
            </button>
            <button id="btn-share-url" type="button" class="topbar-menu-item">
              🔗 COMPARTIR ENLACE
            </button>
            <button id="btn-gamedev-code" type="button" class="topbar-menu-item">
              🎮 CÓDIGO MOTOR (GODOT / UNITY)
            </button>
            <button id="export-zip-btn" type="button" class="topbar-menu-item">
              📦 PAQUETE BLENDER (.ZIP)
            </button>
            <div class="topbar-menu-divider"></div>
            <button id="github-pr-btn" type="button" class="topbar-menu-item" style="color: var(--ps1-green);">
              🚀 PUBLICAR EN CATÁLOGO
            </button>
            <button id="open-docs-btn" type="button" class="topbar-menu-item">
              📖 GUÍA Y DOCUMENTACIÓN
            </button>
          </div>
        </div>

        <button id="btn-toggle-fullscreen" class="btn-mini ps1-ctrl-btn btn-fullscreen-toggle" title="Pantalla Completa estilo Blender (F11 / ESC)">
          <span class="fs-icon">⛶</span> <span class="fs-text">PANTALLA COMPLETA</span>
        </button>
      </div>
    </header>

    <!-- Auto-draft Recovery Banner -->
    <div id="studio-autodraft-banner" class="autodraft-restore-banner" style="display: none;">
      <div class="autodraft-content">
        <span class="banner-icon">⚡</span>
        <span>Se detectó una sesión de modelado previa sin guardar: <strong id="autodraft-name">Borrador</strong> (<span id="autodraft-time">reciente</span>).</span>
      </div>
      <div class="autodraft-actions">
        <button id="btn-autodraft-restore" class="btn-mini btn-gold" type="button">⚡ RETOMAR TRABAJO</button>
        <button id="btn-autodraft-discard" class="btn-mini btn-outline" type="button">✕ DESCARTAR</button>
      </div>
    </div>

    <!-- Main Studio Split View (Responsive 3-Column / 2-Column Workspace) -->
    <div class="studio-workspace mode-visual-active" id="studio-workspace">
      
      <!-- LEFT COLUMN: CREATION / OUTLINER -->
      <div class="creation-column">
        
        <!-- MODE A: AI COPILOT WINDOW -->
        <div id="ai-mode-container" class="mode-panel">
          <div class="ps1-window">
            <div class="ps1-titlebar ai-titlebar">
              <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                <span class="ai-status-pulse"></span>
                <span>MODELCODER AI: CREACIÓN POR LENGUAJE NATURAL</span>
                <span id="ai-engine-badge" class="ai-badge-gemini">🤖 MOTOR PROCEDURAL LOCAL</span>
              </div>
              <div class="ai-titlebar-tools">
                <button type="button" id="toggle-gemini-key-btn" class="ps1-ctrl-btn" title="Configurar API Key de Google Gemini">
                  🔑 CONECTAR GEMINI (GRATIS)
                </button>
              </div>
            </div>

            <div class="ai-copilot-body">
              <!-- API Key Drawer -->
              <div id="gemini-key-drawer" class="gemini-key-drawer" style="display: none;">
                <div class="ps1-inset key-inset">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; flex-wrap: wrap; gap: 0.3rem;">
                    <label for="gemini-api-key-input" class="field-label" style="color: var(--ps1-gold); font-size: 0.72rem; margin: 0;">
                      CLAVE DE GOOGLE GEMINI API (DESBLOQUEA RAZONAMIENTO ILIMITADO):
                    </label>
                    <a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener noreferrer" style="color: var(--ps1-cyan); font-size: 0.68rem; text-decoration: underline;">
                      ➜ Obtener clave gratis en Google AI Studio (100% gratuita)
                    </a>
                  </div>
                  <div style="display: flex; gap: 0.5rem;">
                    <input 
                      type="password" 
                      id="gemini-api-key-input" 
                      placeholder="Pega aquí tu clave: AIzaSy..." 
                      class="form-input" 
                      style="flex: 1; font-family: var(--font-mono); font-size: 0.75rem;"
                    />
                    <button type="button" id="save-gemini-key-btn" class="btn btn-gold" style="font-size: 0.7rem; padding: 0.35rem 0.8rem;">
                      Guardar Clave
                    </button>
                  </div>
                  <small style="color: var(--text-dim); font-size: 0.65rem; margin-top: 0.3rem; display: block;">
                    💡 Sin clave, el estudio utiliza el sintetizador procedural geométrico local con más de 25 categorías sin costo alguno.
                  </small>
                </div>
              </div>

              <!-- Engine Choice Selector -->
              <div class="engine-selector-row">
                <span class="selector-heading">&gt; MODO DE GENERACIÓN:</span>
                <div class="engine-toggle-buttons">
                  <button type="button" class="btn-engine-toggle" id="btn-engine-ai" data-engine="ai" title="Google Gemini Generative AI - Diseña modelos 100% nuevos, creativos y originales sin basarse en los existentes">
                    ⚡ IA GENERATIVA (GEMINI) <span class="badge-unique">SIEMPRE NUEVO</span>
                  </button>
                  <button type="button" class="btn-engine-toggle active" id="btn-engine-local" data-engine="local" title="Motor Procedural Local - Rápido, determinista y sin API Key">
                    🤖 MOTOR PROCEDURAL LOCAL
                  </button>
                </div>
              </div>

              <!-- Prompt Input Row -->
              <div class="ai-prompt-row">
                <div class="prompt-input-wrap">
                  <span class="prompt-prefix">&gt; DESCRIBE TU MODELO:</span>
                  <input 
                    type="text" 
                    id="ai-prompt-input" 
                    placeholder="ej. auto deportivo rojo con ruedas / caza espacial con alas / robot mech / tarjeta de acceso" 
                    class="ai-prompt-input"
                  />
                </div>
                <button type="button" id="generate-ai-btn" class="btn btn-cyan ai-generate-btn">
                  ⚡ GENERAR GEOMETRÍA
                </button>
              </div>

              <!-- Quick Chips -->
              <div class="ai-chips-row">
                <span class="chips-label">PRUEBAS RÁPIDAS:</span>
                <button type="button" class="ai-chip" data-prompt="Auto deportivo retro con chasis bajo y cuatro ruedas con llantas metálicas">🚗 Auto Sci-Fi</button>
                <button type="button" class="ai-chip" data-prompt="Nave espacial interceptora orbital con alas en cuña y propulsores dobles">🚀 Caza Espacial</button>
                <button type="button" class="ai-chip" data-prompt="Robot bípedo de seguridad con torso acorazado y visor óptico">🤖 Robot Mech</button>
                <button type="button" class="ai-chip" data-prompt="Tarjeta de acceso de seguridad con chip dorado y banda magnética">💳 Tarjeta de Acceso</button>
                <button type="button" class="ai-chip" data-prompt="Blaster de plasma con cañón cilíndrico y celda de energía">🔫 Blaster Láser</button>
                <button type="button" class="ai-chip" data-prompt="Consola de navegación espacial con dos pantallas CRT inclinadas">🖥️ Consola CRT</button>
              </div>

              <div id="ai-loading-status" class="ai-status-indicator" style="display: none;"></div>
            </div>
          </div>
        </div>

        <!-- MODE B: OUTLINER COMPONENT TREE (MODO EDITOR 3D) -->
        <div id="outliner-mode-container" class="mode-panel active">
          <div class="ps1-window outliner-window">
            <div class="ps1-titlebar">
              <span>ÁRBOL DE COMPONENTES (<span id="outliner-count">0</span>)</span>
              <div class="outliner-titlebar-tools">
                <button type="button" id="btn-outliner-undo" class="ps1-ctrl-btn" title="Deshacer (Ctrl+Z)" disabled>↩</button>
                <button type="button" id="btn-outliner-redo" class="ps1-ctrl-btn" title="Rehacer (Ctrl+Y)" disabled>↪</button>
              </div>
            </div>

            <!-- Primitives Creation Toolbar -->
            <div class="primitives-palette-container">
              <span class="palette-label">AÑADIR PIEZA PRIMITIVA:</span>
              <div class="primitives-grid">
                <button type="button" class="btn-primitive" data-shape="box" title="Añadir Cubo / Prisma rectangular">+ CUBO</button>
                <button type="button" class="btn-primitive" data-shape="chamfer_box" title="Añadir Cubo Biselado con bordes suaves">+ BISELADO</button>
                <button type="button" class="btn-primitive" data-shape="cylinder" title="Añadir Cilindro / Tubo">+ CILINDRO</button>
                <button type="button" class="btn-primitive" data-shape="pipe" title="Añadir Tubo / Cilindro Hueco con grosor de pared">+ TUBO</button>
                <button type="button" class="btn-primitive" data-shape="prism" title="Añadir Prisma Regular (Hexagonal, etc.)">+ PRISMA</button>
                <button type="button" class="btn-primitive" data-shape="sphere" title="Añadir Esfera / Domo">+ ESFERA</button>
                <button type="button" class="btn-primitive" data-shape="wedge" title="Añadir Cuña prismática inclinada">+ CUÑA</button>
                <button type="button" class="btn-primitive" data-shape="cone" title="Añadir Cono">+ CONO</button>
                <button type="button" class="btn-primitive" data-shape="pyramid" title="Añadir Pirámide Regular (3 a 8 caras)">+ PIRÁMIDE</button>
                <button type="button" class="btn-primitive" data-shape="torus" title="Añadir Toroide / Anillo">+ TORO</button>
                <button type="button" class="btn-primitive" data-shape="capsule" title="Añadir Cápsula presurizada">+ CÁPSULA</button>
                <button type="button" class="btn-primitive" data-shape="plane" title="Añadir Plano bidimensional">+ PLANO</button>
              </div>
            </div>

            <!-- Outliner Tree List -->
            <div class="outliner-tree-wrapper ps1-inset">
              <div id="outliner-tree-list" class="outliner-tree-list">
                <!-- Dynamically populated component rows -->
              </div>
            </div>
            
            <div class="outliner-footer">
              <small class="outliner-hint">💡 Clic para seleccionar • 👁️ Visibilidad • 📋 Duplicar • 🗑️ Eliminar (Ctrl+X)</small>
            </div>
          </div>
        </div>

        <!-- MODE C: CODE EDITOR WINDOW -->
        <div id="code-mode-container" class="mode-panel">
          <div class="ps1-window editor-window">
            <div class="editor-tabs">
              <button class="editor-tab active" data-file="spec">
                model_spec.json <span class="tab-badge">GEOMETRÍA REAL</span>
              </button>
              <button class="editor-tab" data-file="script">
                procedural_script.js <span class="tab-badge">DSL SCRIPT</span>
              </button>
              <button class="editor-tab" data-file="generator_py">
                generator.py <span class="tab-badge">BLENDER 5.0</span>
              </button>
            </div>

            <div class="editor-surface">
              <div class="line-numbers" id="line-numbers">1</div>
              <textarea id="code-textarea" spellcheck="false" autocomplete="off"></textarea>
            </div>

            <div class="editor-statusbar">
              <div class="status-left">
                <span id="cursor-pos">LN 1, COL 1</span>
                <span class="status-sep">|</span>
                <span id="active-filename">model_spec.json</span>
              </div>
              <div class="status-right" id="linter-badge">
                <span class="status-dot"></span>
                <span id="linter-text">SINTAXIS: VÁLIDA · 0 ERRORES</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- CENTER COLUMN: LIVE 3D VIEWPORT -->
      <div class="viewport-column">
        <div class="ps1-window studio-viewport-window">
          <!-- Viewport Header Toolbar -->
          <div class="ps1-titlebar viewport-main-titlebar">
            <div class="viewport-title-left">
              <span class="viewport-tag">VISOR 3D:</span>
              <span id="viewport-model-name" class="viewport-model-title">MODELO ACTIVO</span>
            </div>

            <!-- Transform Gizmo Mode Toolbar -->
            <div class="gizmo-toolbar" id="gizmo-toolbar">
              <button type="button" class="btn-gizmo" data-mode="none" id="gizmo-btn-select" title="Modo Selección libre (Q)">
                ↖ Selección
              </button>
              <button type="button" class="btn-gizmo active" data-mode="translate" id="gizmo-btn-translate" title="Mover posición [W]">
                ✥ Mover
              </button>
              <button type="button" class="btn-gizmo" data-mode="rotate" id="gizmo-btn-rotate" title="Rotar en grados [E]">
                🔄 Rotar
              </button>
              <button type="button" class="btn-gizmo" data-mode="scale" id="gizmo-btn-scale" title="Escalar tamaño [R]">
                ⤢ Escalar
              </button>
              <button type="button" class="btn-gizmo" id="gizmo-btn-snap" title="Ajuste a la rejilla y rotación (Snap)">
                🧲 Snap
              </button>
              <select id="select-snap-grid" class="snap-select" title="Paso de rejilla / traslación">
                <option value="0.05">0.05m</option>
                <option value="0.1" selected>0.10m</option>
                <option value="0.25">0.25m</option>
                <option value="0.5">0.50m</option>
                <option value="1.0">1.00m</option>
              </select>
              <select id="select-snap-angle" class="snap-select" title="Paso de rotación en grados">
                <option value="5">5°</option>
                <option value="15" selected>15°</option>
                <option value="45">45°</option>
                <option value="90">90°</option>
              </select>
              <button type="button" class="btn-gizmo" id="gizmo-btn-magnet" title="Imán de caras: clic en cualquier superficie para adherir la pieza seleccionada">
                🎯 Imán
              </button>
            </div>

            <!-- Camera & View Helpers Toolbar -->
            <div class="viewport-camera-tools">
              <div class="camera-presets-group">
                <button type="button" class="btn-cam-preset ps1-ctrl-btn" data-preset="isometric" title="Vista Isométrica 3D">📐 ISO</button>
                <button type="button" class="btn-cam-preset ps1-ctrl-btn" data-preset="front" title="Vista Frontal (Eje Z)">FRONTAL</button>
                <button type="button" class="btn-cam-preset ps1-ctrl-btn" data-preset="side" title="Vista Lateral (Eje X)">LATERAL</button>
                <button type="button" class="btn-cam-preset ps1-ctrl-btn" data-preset="top" title="Vista Superior (Eje Y)">CENITAL</button>
              </div>
              <button type="button" id="btn-focus-selected" class="ps1-ctrl-btn btn-focus" title="Enfocar pieza seleccionada [F]">
                🔍 ENFOCAR
              </button>
              <button type="button" id="btn-toggle-grid" class="ps1-ctrl-btn active" title="Alternar visibilidad de cuadrícula">
                ▦ REJILLA
              </button>
              <button type="button" id="btn-toggle-axes" class="ps1-ctrl-btn active" title="Alternar visibilidad de ejes XYZ">
                🧭 EJES
              </button>
              <button type="button" id="studio-reset-cam" class="ps1-ctrl-btn" title="Restablecer cámara y centrar objeto">
                🎯 ENCUADRE
              </button>
            </div>
          </div>

          <!-- Viewport Three.js Canvas Container -->
          <div class="ps1-inset studio-viewport-surface" id="three-viewport-container">
            <div id="three-canvas-mount" class="three-canvas-mount"></div>

            <!-- Face Magnet Active Floating Banner -->
            <div id="face-magnet-banner" class="face-magnet-banner hidden">
              <span class="magnet-icon">🧲</span>
              <span class="magnet-text">MODO IMÁN ACTIVO: Haz clic en una superficie para pegar la pieza seleccionada</span>
              <button type="button" id="btn-cancel-magnet" class="btn-cancel-magnet-pill" title="Cancelar modo imán [ESC]">ESC Salir</button>
            </div>

            <!-- Overlay Controls (Shading & Status) -->
            <div class="viewport-overlay-controls">
              <div class="shading-toggles" id="shading-toggles-group">
                <button type="button" class="btn-shading active" data-shading="shaded" title="Sombreado estándar retro PSX">🎨 Sombreado</button>
                <button type="button" class="btn-shading" data-shading="wireframe" title="Ver estructura de malla poligonal">🕸️ Malla</button>
                <button type="button" class="btn-shading" data-shading="normals" title="Visualizar vectores normales">🧭 Normales</button>
                <button type="button" class="btn-shading" data-shading="vertex_colors" title="Colores de vértice PSX">🌈 Vértices</button>
                <button type="button" class="btn-shading" data-shading="unlit" title="Color puro sin sombreado">💡 Plana</button>
              </div>

              <!-- Generation State Badge -->
              <div class="generation-status-badge" id="viewport-status-badge">
                <span class="badge-dot dot-completed"></span>
                <span class="badge-text" id="status-badge-text">COMPLETADO</span>
              </div>
            </div>

            <!-- Floating Render Presentation Studio Bar (Active in Render Workspace) -->
            <div id="render-studio-controls" class="render-studio-controls" style="display: none;">
              <div class="render-panel-inner ps1-window">
                <div class="render-tool-item">
                  <span class="render-tool-label">🔄 TURNTABLE 360°:</span>
                  <button type="button" id="btn-render-turntable" class="btn-mini btn-outline" title="Iniciar / Pausar giro continuo 360°">
                    ▶ INICIAR
                  </button>
                  <select id="select-turntable-speed" class="form-select render-speed-select" title="Velocidad de giro 360°">
                    <option value="0.5">0.5x Lento</option>
                    <option value="1.0" selected>1.0x Normal</option>
                    <option value="2.0">2.0x Rápido</option>
                  </select>
                </div>

                <div class="render-tool-divider"></div>

                <div class="render-tool-item">
                  <span class="render-tool-label">🌌 ENTORNO DE FONDO:</span>
                  <div class="btn-group-mini">
                    <button type="button" class="btn-mini btn-outline active" data-bg="dark" id="btn-bg-dark" title="Espacio Oscuro Retro">🌌 Oscuro</button>
                    <button type="button" class="btn-mini btn-outline" data-bg="studio" id="btn-bg-studio" title="Estudio Neutro de Modelado">🏛️ Estudio</button>
                    <button type="button" class="btn-mini btn-outline" data-bg="transparent" id="btn-bg-trans" title="Transparente (ideal para recortar)">🏁 Transparente</button>
                  </div>
                </div>

                <div class="render-tool-divider"></div>

                <div class="render-tool-item">
                  <button type="button" id="btn-capture-render-hd" class="btn-mini btn-gold" title="Descargar render PNG en alta definición sin interfaz">
                    📷 CAPTURAR RENDER HD (.PNG)
                  </button>
                  <button type="button" id="btn-open-story-modal" class="btn-mini btn-magenta" title="Generar tarjeta gráfica para Historias de Instagram (9:16) con marca de agua y ficha técnica">
                    📱 HISTORIA IG (9:16)
                  </button>
                  <button type="button" id="btn-render-frame-cam" class="btn-mini btn-cyan" title="Reencuadrar modelo en el centro">
                    🎯 ENCUADRAR
                  </button>
                </div>
              </div>
            </div>

