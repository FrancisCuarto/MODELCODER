---
import Layout from '../layouts/Layout.astro';
import catalog from '../data/catalog.json';
---

<Layout title="ModelCoder Web Studio - Editor de Generadores 3D">
  <div class="studio-container">
    <!-- Studio Header Bar -->
    <div class="ps1-window studio-topbar">
      <div class="ps1-titlebar">
        <span>// MODELCODER_WEB_STUDIO // IN-BROWSER 3D PROCEDURAL IDE</span>
        <span class="ps1-telemetry-tag">ENGINE: THREE.JS PROCEDURAL CORE</span>
      </div>

      <div class="topbar-actions">
        <!-- Mode Switcher Tabs -->
        <div class="mode-switcher-group">
          <button id="mode-tab-ai" class="btn-mode-tab active" data-mode="ai" title="Creación de modelos mediante lenguaje natural">
            ⚡ MODO IA
          </button>
          <button id="mode-tab-visual" class="btn-mode-tab" data-mode="visual" title="Constructor visual paramétrico">
            🛠️ CONSTRUCTOR VISUAL
          </button>
          <button id="mode-tab-code" class="btn-mode-tab" data-mode="code" title="Editor de código procedural y especificaciones">
            💻 EDITOR DE CÓDIGO
          </button>
        </div>

        <!-- Action Buttons -->
        <div class="topbar-btn-group">
          <button id="run-compile-btn" class="btn btn-cyan" title="Compilar código actual y actualizar visor 3D">
            ⚡ COMPILAR & VER 3D
          </button>
          <button id="export-glb-btn" class="btn btn-gold" title="Exportar modelo exactamente visible en formato GLB verificado">
            💾 EXPORTAR GLB
          </button>
          <button id="export-zip-btn" class="btn btn-primary" title="Descargar paquete de código para Blender (.ZIP)">
            📦 PAQUETE (.ZIP)
          </button>
          <button id="open-docs-btn" class="btn btn-outline" title="Guía y Documentación de Modelado Procedural">
            📖 GUÍA
          </button>
          <button id="github-pr-btn" class="btn btn-green" title="Publicar o proponer tu modelo en la comunidad de GitHub">
            🚀 PUBLICAR
          </button>
        </div>
      </div>
    </div>

    <!-- Main Studio Split View (Left: Creation Modes, Right: Viewport & Stats) -->
    <div class="studio-workspace">
      <!-- Left Column: Creation Modes (AI / Visual / Code) -->
      <div class="creation-column">
        <!-- MODE A: AI COPILOT WINDOW -->
        <div id="ai-mode-container" class="mode-panel active">
          <div class="ps1-window">
            <div class="ps1-titlebar ai-titlebar">
              <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                <span class="ai-status-pulse"></span>
                <span>// MODELCODER_AI: CREACIÓN_POR_LENGUAJE_NATURAL</span>
                <span id="ai-engine-badge" class="ai-badge-gemini">🤖 MOTOR PROCEDURAL LOCAL</span>
              </div>
              <div class="ai-titlebar-tools">
                <button type="button" id="toggle-gemini-key-btn" class="ps1-ctrl-btn" title="Configurar API Key de Google Gemini">
                  🔑 CONECTAR GEMINI (GRATIS)
                </button>
              </div>
            </div>

            <div class="ai-copilot-body">
              <!-- API Key Drawer -->
              <div id="gemini-key-drawer" class="gemini-key-drawer" style="display: none;">
                <div class="ps1-inset key-inset">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; flex-wrap: wrap; gap: 0.3rem;">
                    <label for="gemini-api-key-input" class="field-label" style="color: var(--ps1-gold); font-size: 0.72rem; margin: 0;">
                      CLAVE DE GOOGLE GEMINI API (DESBLOQUEA RAZONAMIENTO ILIMITADO):
                    </label>
                    <a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener noreferrer" style="color: var(--ps1-cyan); font-size: 0.68rem; text-decoration: underline;">
                      ➜ Obtener clave gratis en Google AI Studio (100% gratuita)
                    </a>
                  </div>
                  <div style="display: flex; gap: 0.5rem;">
                    <input 
                      type="password" 
                      id="gemini-api-key-input" 
                      placeholder="Pega aquí tu clave: AIzaSy..." 
                      class="form-input" 
                      style="flex: 1; font-family: var(--font-mono); font-size: 0.75rem;"
                    />
                    <button type="button" id="save-gemini-key-btn" class="btn btn-gold" style="font-size: 0.7rem; padding: 0.35rem 0.8rem;">
                      Guardar Clave
                    </button>
                  </div>
                  <small style="color: var(--text-dim); font-size: 0.65rem; margin-top: 0.3rem; display: block;">
                    💡 Sin clave, el estudio utiliza el sintetizador procedural geométrico local con más de 25 categorías (autos, naves, robots, armas, muebles, etc.) sin límite ni costos.
                  </small>
                </div>
              </div>

              <!-- Prompt Input Row -->
              <div class="ai-prompt-row">
                <div class="prompt-input-wrap">
                  <span class="prompt-prefix">&gt; DESCRIBE TU MODELO:</span>
                  <input 
                    type="text" 
                    id="ai-prompt-input" 
                    placeholder="ej. auto deportivo rojo con ruedas / caza espacial con alas / robot mech / tarjeta de acceso" 
                    class="ai-prompt-input"
                  />
                </div>
                <button type="button" id="generate-ai-btn" class="btn btn-cyan ai-generate-btn">
                  ⚡ GENERAR GEOMETRÍA
                </button>
              </div>

              <!-- Quick Chips -->
              <div class="ai-chips-row">
                <span class="chips-label">PRUEBAS RÁPIDAS:</span>
                <button type="button" class="ai-chip" data-prompt="Auto deportivo retro con chasis bajo y cuatro ruedas con llantas metálicas">
                  🚗 Auto Sci-Fi
                </button>
                <button type="button" class="ai-chip" data-prompt="Nave espacial interceptora orbital con alas en cuña y propulsores dobles">
                  🚀 Caza Espacial
                </button>
                <button type="button" class="ai-chip" data-prompt="Robot bípedo de seguridad con torso acorazado y visor óptico">
                  🤖 Robot Mech
                </button>
                <button type="button" class="ai-chip" data-prompt="Tarjeta de acceso de seguridad con chip dorado y banda magnética">
                  💳 Tarjeta de Acceso
                </button>
                <button type="button" class="ai-chip" data-prompt="Blaster de plasma con cañón cilíndrico y celda de energía">
                  🔫 Blaster Láser
                </button>
                <button type="button" class="ai-chip" data-prompt="Consola de navegación espacial con dos pantallas CRT inclinadas">
                  🖥️ Consola CRT
                </button>
                <button type="button" class="ai-chip" data-prompt="Silla de mando ergonómica con respaldo y cuatro patas tubulares">
                  🪑 Silla de Mando
                </button>
                <button type="button" class="ai-chip" data-prompt="Contenedor de carga reforzado con cantoneras metálicas">
                  📦 Contenedor Carga
                </button>
              </div>

              <div id="ai-loading-status" class="ai-status-indicator" style="display: none;"></div>
            </div>
          </div>
        </div>

        <!-- MODE B: VISUAL BUILDER WINDOW -->
        <div id="visual-mode-container" class="mode-panel">
          <div class="ps1-window">
            <div class="ps1-titlebar">
              <span>// CONSTRUCTOR_VISUAL: COMPONENTES_GEOMÉTRICOS</span>
              <div class="visual-builder-actions">
                <button type="button" id="btn-add-box" class="btn-mini btn-cyan">+ CUBO</button>
                <button type="button" id="btn-add-cylinder" class="btn-mini btn-cyan">+ CILINDRO</button>
                <button type="button" id="btn-add-sphere" class="btn-mini btn-cyan">+ ESFERA</button>
                <button type="button" id="btn-add-wedge" class="btn-mini btn-cyan">+ CUÑA</button>
              </div>
            </div>

            <div class="visual-builder-body" id="visual-components-list">
              <!-- Dynamically populated component cards -->
            </div>
          </div>
        </div>

        <!-- MODE C: CODE EDITOR WINDOW -->
        <div id="code-mode-container" class="mode-panel">
          <div class="ps1-window editor-window">
            <!-- Tab Bar -->
            <div class="editor-tabs">
              <button class="editor-tab active" data-file="spec">
                model_spec.json <span class="tab-badge">GEOMETRÍA REAL</span>
              </button>
              <button class="editor-tab" data-file="script">
                procedural_script.js <span class="tab-badge">DSL SCRIPT</span>
              </button>
              <button class="editor-tab" data-file="generator_py">
                generator.py <span class="tab-badge">BLENDER 5.0</span>
              </button>
            </div>

            <!-- Editor Surface -->
            <div class="editor-surface">
              <div class="line-numbers" id="line-numbers">1</div>
              <textarea id="code-textarea" spellcheck="false" autocomplete="off"></textarea>
            </div>

            <!-- Editor Statusbar -->
            <div class="editor-statusbar">
              <div class="status-left">
                <span id="cursor-pos">LN 1, COL 1</span>
                <span class="status-sep">|</span>
                <span id="active-filename">model_spec.json</span>
              </div>
              <div class="status-right" id="linter-badge">
                <span class="status-dot"></span>
                <span id="linter-text">SINTAXIS: VÁLIDA // 0 ERRORES</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Live 3D Viewport & Geometric Stats -->
      <div class="preview-column">
        <!-- 3D Viewport Window -->
        <div class="ps1-window studio-viewport-window">
          <div class="ps1-titlebar">
            <span>// 3D_VIEWPORT: [<span id="viewport-model-name">MODELO ACTIVO</span>]</span>
            <div class="viewport-quick-tools">
              <button id="studio-reset-cam" class="ps1-ctrl-btn" title="Centrar cámara en el objeto">🎯 ENCUADRAR</button>
            </div>
          </div>

          <div class="ps1-inset studio-viewport-surface" id="three-viewport-container">
            <!-- Three.js Canvas Mount Point -->
            <div id="three-canvas-mount" class="three-canvas-mount"></div>

            <!-- Viewport Controls Overlay (Shading, Wireframe, Status) -->
            <div class="viewport-overlay-controls">
              <div class="shading-toggles" id="shading-toggles-group">
                <button type="button" class="btn-shading active" data-shading="shaded" title="Sombreado estándar retro PSX">🎨 Sombreado</button>
                <button type="button" class="btn-shading" data-shading="wireframe" title="Ver estructura de malla poligonal">🕸️ Malla</button>
                <button type="button" class="btn-shading" data-shading="normals" title="Visualizar vectores normales">🧭 Normales</button>
                <button type="button" class="btn-shading" data-shading="vertex_colors" title="Colores de vértice PSX">🌈 Vértices</button>
                <button type="button" class="btn-shading" data-shading="unlit" title="Color puro sin sombreado">💡 Plana</button>
              </div>

              <!-- Generation State Badge -->
              <div class="generation-status-badge" id="viewport-status-badge">
                <span class="badge-dot dot-completed"></span>
                <span class="badge-text" id="status-badge-text">COMPLETADO</span>
              </div>
            </div>

            <!-- Geometric Statistics HUD -->
            <div class="viewport-stats-hud" id="viewport-stats-hud">
              <div class="hud-row"><span class="hud-lbl">GENERACIÓN:</span> <span class="hud-val" id="hud-gen-id">GEN-INIT v1</span></div>
              <div class="hud-row"><span class="hud-lbl">TRIÁNGULOS:</span> <span class="hud-val" id="hud-tris">--</span></div>
              <div class="hud-row"><span class="hud-lbl">VÉRTICES:</span> <span class="hud-val" id="hud-verts">--</span></div>
              <div class="hud-row"><span class="hud-lbl">DIMENSIONES:</span> <span class="hud-val" id="hud-dims">--</span></div>
            </div>

            <!-- Diagnostic Error Banner (Only shown on compile/generation error) -->
            <div id="viewport-error-banner" class="viewport-error-banner" style="display: none;">
              <div class="error-banner-header">
                <span class="error-icon">⚠️</span>
                <strong id="error-banner-title">Error de Compilación</strong>
                <button type="button" id="btn-close-error" class="btn-mini-close">✕</button>
              </div>
              <div class="error-banner-body" id="error-banner-body"></div>
              <div class="error-banner-footer" id="error-banner-fallback-note">
                ℹ️ Mostrando el último modelo válido anterior como referencia.
              </div>
            </div>
          </div>
        </div>

        <!-- Parameters / Preset Fine-tuning Panel -->
        <div class="ps1-window inspector-window">
          <div class="ps1-titlebar">
            <span>// AJUSTES_RÁPIDOS_EN_VIVO</span>
            <span class="ps1-telemetry-tag">PARÁMETROS GEOMÉTRICOS</span>
          </div>

          <div class="inspector-body">
            <div class="quick-adjust-grid">
              <div class="param-row">
                <label class="param-label">Escala Global (Métrico):</label>
                <input type="range" id="param-global-scale" min="0.2" max="3.0" step="0.1" value="1.0" class="param-slider" />
                <span id="param-global-scale-val" class="param-val-disp">1.0x</span>
              </div>
              <div class="param-row">
                <label class="param-label">Rugosidad de Superficie:</label>
                <input type="range" id="param-roughness" min="0.0" max="1.0" step="0.05" value="0.75" class="param-slider" />
                <span id="param-roughness-val" class="param-val-disp">0.75</span>
              </div>
              <div class="param-row">
                <label class="param-label">Aspecto Metálico:</label>
                <input type="range" id="param-metalness" min="0.0" max="1.0" step="0.05" value="0.25" class="param-slider" />
                <span id="param-metalness-val" class="param-val-disp">0.25</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Documentation Modal -->
  <dialog id="docs-modal" class="ps1-window docs-modal">
    <div class="ps1-titlebar">
      <span>// GUÍA_DE_APRENDIZAJE // MODELADO_PROCEDURAL_3D</span>
      <button id="close-docs-btn" class="ps1-ctrl-btn">X</button>
    </div>
    <div class="docs-modal-body">
      <div class="docs-nav-tabs">
        <button class="doc-tab active" data-section="doc-quickstart">1. Inicio Rápido</button>
        <button class="doc-tab" data-section="doc-ai">2. Describir para IA</button>
        <button class="doc-tab" data-section="doc-geometry">3. Geometría Procedural</button>
        <button class="doc-tab" data-section="doc-transforms">4. Ejes y Dimensiones</button>
        <button class="doc-tab" data-section="doc-materials">5. Materiales y Luces</button>
        <button class="doc-tab" data-section="doc-errors">6. Corregir Errores</button>
        <button class="doc-tab" data-section="doc-advanced">7. Editor Avanzado</button>
        <button class="doc-tab" data-section="doc-export">8. Exportar a Blender/Godot</button>
        <button class="doc-tab" data-section="doc-community">9. Contribuciones</button>
      </div>

      <div class="docs-content-area">
        <section id="doc-quickstart" class="doc-section active">
          <h3>1. Tu Primer Modelo en Cinco Minutos</h3>
          <p>ModelCoder te permite crear geometría 3D real sin necesidad de software complejo. Sigue estos tres pasos:</p>
          <ol>
            <li>En <strong>Modo IA</strong>, escribe una descripción clara como <code>"cubo de 1 metro rojo"</code> o <code>"tarjeta de acceso con chip"</code> y presiona <strong>⚡ Generar Geometría</strong>.</li>
            <li>El visor mostrará inmediatamente el objeto tridimensional real. Puedes rotarlo arrastrando el ratón, hacer zoom con la rueda y cambiar a vista de <strong>Malla</strong> para ver su topología.</li>
            <li>Haz clic en <strong>💾 Exportar GLB</strong>. El modelo visible se verificará y descargará como archivo <code>.glb</code> estándar para tus proyectos.</li>
          </ol>
        </section>

        <section id="doc-ai" class="doc-section">
          <h3>2. Cómo Describir Objetos para la IA</h3>
          <p>Para obtener los mejores resultados, sé específico sobre las formas y dimensiones:</p>
          <ul>
            <li><strong>Menciona dimensiones:</strong> <code>"consola de 1.2m de ancho por 1 metro de alto"</code>.</li>
            <li><strong>Desglosa componentes:</strong> <code>"mesa con tablero cuadrado y cuatro patas cilíndricas"</code>.</li>
            <li><strong>Indica colores y materiales:</strong> <code>"cápsula azul oscuro con panel de control cyan y detalles dorados"</code>.</li>
            <li><strong>Estilo retro PSX:</strong> El motor está calibrado para modelos de bajo poligonaje (100 a 500 triángulos) ideales para juegos de estilo PS1 / PSX.</li>
          </ul>
        </section>

        <section id="doc-geometry" class="doc-section">
          <h3>3. Fundamentos de Geometría Procedural</h3>
          <p>En el modelado procedural, los objetos se definen mediante reglas matemáticas y parámetros en lugar de esculpirlos manualmente vértice a vértice.</p>
          <p>Las primitivas base admitidas son:</p>
          <ul>
            <li><code>box</code>: Prismas rectangulares (cubos, paneles, cajas, tableros).</li>
            <li><code>cylinder</code>: Tubos, columnas, botones, patas, cables, tanques.</li>
            <li><code>sphere</code>: Domos, sensores, balizas, articulaciones esféricas.</li>
            <li><code>wedge</code>: Cuñas prismáticas para rampas, biseles y teclados inclinados.</li>
            <li><code>capsule / torus</code>: Contenedores presurizados y anillos de sellado.</li>
          </ul>
        </section>

        <section id="doc-transforms" class="doc-section">
          <h3>4. Dimensiones, Ejes y Transformaciones</h3>
          <p>ModelCoder utiliza el sistema de coordenadas estándar métrico:</p>
          <ul>
            <li><strong>Eje X (Rojo / Ancho):</strong> De izquierda (-) a derecha (+).</li>
            <li><strong>Eje Y (Verde / Altura):</strong> De abajo (-) a arriba (+). El suelo se ubica en Y = 0.</li>
            <li><strong>Eje Z (Azul / Profundidad):</strong> De atrás (-) al frente (+).</li>
            <li>Las rotaciones se expresan en grados (0 a 360°).</li>
          </ul>
        </section>

        <section id="doc-materials" class="doc-section">
          <h3>5. Materiales, Colores de Vértice y Luces</h3>
          <p>El estudio utiliza <strong>Flat Shading</strong> con paletas de colores por vértice (Vertex Colors), fiel a la estética PlayStation 1:</p>
          <ul>
            <li>No requiere mapas de texturas pesados; los colores se asignan a nivel de vértice.</li>
            <li>El visor incluye modos para inspeccionar el sombreado estándar, la estructura de alambre (Wireframe), las normales y los colores planos sin iluminación.</li>
          </ul>
        </section>

        <section id="doc-errors" class="doc-section">
          <h3>6. Cómo Corregir Errores de Generación</h3>
          <p>Si la compilación de código o especificación falla:</p>
          <ul>
            <li>El visor no te mostrará un modelo falso ni de ejemplo: mantendrá el último modelo válido e indicará claramente el error en la barra roja de diagnóstico.</li>
            <li>Revisa el número de línea indicado en el reporte de error (por ejemplo, comas faltantes o llaves sin cerrar en JSON).</li>
            <li>Corrige la sintaxis en el editor y presiona <strong>⚡ COMPILAR & VER 3D</strong> para actualizar la geometría.</li>
          </ul>
        </section>

        <section id="doc-advanced" class="doc-section">
          <h3>7. Cómo Utilizar el Editor Avanzado</h3>
          <p>En la pestaña <strong>💻 Editor de Código</strong> puedes programar directamente:</p>
          <pre><code>// Ejemplo con el Builder Procedural:
builder.setName("Mi Torreta");
builder.addBox(&#123; size: [0.8, 0.2, 0.8], position: [0, 0.1, 0], color: "metal" &#125;);
builder.addCylinder(&#123; radius: 0.15, height: 1.0, segments: 8, position: [0, 0.6, 0], color: "hazard" &#125;);
builder.addSphere(&#123; radius: 0.3, segments: 8, position: [0, 1.2, 0], color: "accent" &#125;);
</code></pre>
          <p>Presiona <strong>⚡ COMPILAR & VER 3D</strong> para ver el resultado de tu código en tiempo real.</p>
        </section>

        <section id="doc-export" class="doc-section">
          <h3>8. Cómo Exportar Modelos a Blender y Godot</h3>
          <p>Tus modelos son 100% compatibles con motores modernos:</p>
          <ul>
            <li><strong>Exportación Directa (.GLB):</strong> Presiona <strong>💾 EXPORTAR GLB</strong>. El archivo incluye toda la geometría, materiales y colores de vértice listos para arrastrar a Godot 4, Unity o Unreal Engine.</li>
            <li><strong>Generador Nativo (.ZIP):</strong> Presiona <strong>📦 PAQUETE (.ZIP)</strong> para descargar el código Python de Blender 5.0 con colisiones automáticas <code>-convcolonly</code> para Godot.</li>
          </ul>
        </section>

        <section id="doc-community" class="doc-section">
          <h3>9. Cómo Enviar Contribuciones a la Comunidad</h3>
          <p>ModelCoder es un proyecto de código abierto. Para que tu modelo aparezca en el catálogo oficial:</p>
          <ol>
            <li>Haz clic en <strong>🚀 PUBLICAR</strong> en la barra superior.</li>
            <li>Usa la opción <strong>⭐ Propuesta en GitHub (1-Clic)</strong>. Se creará automáticamente un Issue con tu código formateado y especificación.</li>
            <li>El equipo revisará tu generador y lo integrará en la siguiente versión de la biblioteca.</li>
          </ol>
        </section>
      </div>
    </div>
  </dialog>

  <!-- GitHub Contribution Modal -->
  <dialog id="github-modal" class="ps1-window gh-modal">
    <div class="ps1-titlebar">
      <span>// PUBLICAR MODELO EN LA COMUNIDAD</span>
      <button id="close-modal-btn" class="ps1-ctrl-btn">X</button>
    </div>
    <div class="modal-body" style="padding: 1.25rem;">
      <h3 style="color: var(--ps1-gold); font-family: var(--font-pixel); font-size: 0.95rem; margin-bottom: 0.4rem;">
        PUBLICAR EN FrancisCuarto/MODELCODER
      </h3>
      <p style="font-size: 0.82rem; color: #b0c0d4; margin-bottom: 1.25rem; line-height: 1.5;">
        Tu modelo puede incorporarse al catálogo oficial abierto para que todos puedan usarlo en sus juegos:
      </p>

      <div class="ps1-inset" style="padding: 1rem; margin-bottom: 1rem; background: #080e1c; border-left: 3px solid var(--ps1-green);">
        <span style="font-family: var(--font-pixel); font-size: 0.8rem; color: var(--ps1-green); display: block; margin-bottom: 0.35rem;">
          ⭐ PROPUESTA EN GITHUB (1-CLIC)
        </span>
        <p style="font-size: 0.8rem; color: var(--text-dim); margin-bottom: 0.85rem; line-height: 1.45;">
          Abre automáticamente un Issue en GitHub con la especificación y código de tu modelo para su revisión e integración en el catálogo.
        </p>
        <button id="btn-quick-github-proposal" type="button" class="btn btn-green" style="width: 100%; font-size: 0.8rem; padding: 0.65rem;">
          🚀 ENVIAR PROPUESTA A GITHUB (1-CLIC)
        </button>
      </div>

      <div class="ps1-inset" style="padding: 1rem; background: #080e1c; border-left: 3px solid var(--ps1-cyan);">
        <span style="font-family: var(--font-pixel); font-size: 0.8rem; color: var(--ps1-cyan); display: block; margin-bottom: 0.35rem;">
          📦 DESCARGAR PAQUETE (.ZIP)
        </span>
        <p style="font-size: 0.8rem; color: var(--text-dim); margin-bottom: 0.85rem; line-height: 1.45;">
          Descarga el paquete completo con generator.py, config.py y manifest.json para abrir un Pull Request manual.
        </p>
        <button id="btn-modal-download-zip" type="button" class="btn btn-cyan" style="width: 100%; font-size: 0.8rem; padding: 0.65rem;">
          💾 DESCARGAR PAQUETE (.ZIP)
        </button>
      </div>
    </div>
  </dialog>
</Layout>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<script>
  import { ProceduralEngine } from '../lib/studio/procedural-engine';
  import { CodeSandbox } from '../lib/studio/code-sandbox';
  import { AIGenerator } from '../lib/studio/ai-generator';
  import { GLBExporterService } from '../lib/studio/glb-exporter';
  import { StudioViewport } from '../lib/studio/three-viewport';
  import type { ModelSpec, ComponentDef, GeometricStats, GenerationResult, ShadingMode } from '../lib/studio/types';

  // State Management
  let generationCounter = 1;
  let activeMode: 'ai' | 'visual' | 'code' = 'ai';
  let activeFile: 'spec' | 'script' | 'generator_py' = 'spec';

  // Default Initial Model (Genuine procedural crate specification)
  let currentSpec: ModelSpec = {
    id: 'below_nominal.furniture.crate',
    name: 'Cargo Crate',
    category: 'furniture',
    description: 'Contenedor de carga modular presurizado procedural.',
    units: 'meters',
    dimensions: { width: 1.0, depth: 1.0, height: 1.0 },
    palette: 'industrial_hazard',
    components: [
      {
        name: 'crate_hull',
        shape: 'box',
        size: [1.0, 0.85, 1.0],
        position: [0, 0.425, 0],
        color: '#4a5568',
        roughness: 0.7,
        metalness: 0.3
      },
      {
        name: 'reinforced_band',
        shape: 'box',
        size: [1.04, 0.12, 1.04],
        position: [0, 0.425, 0],
        color: '#2d3748',
        roughness: 0.8
      },
      {
        name: 'hazard_stripe',
        shape: 'box',
        size: [0.96, 0.08, 1.02],
        position: [0, 0.65, 0],
        color: '#d69e2e',
        roughness: 0.5
      },
      {
        name: 'id_stencil',
        shape: 'box',
        size: [0.4, 0.12, 0.02],
        position: [0, 0.425, 0.51],
        color: '#edf2f7',
        label: 'CARGO-77'
      }
    ]
  };

  // DOM Elements
  const threeMountEl = document.getElementById('three-canvas-mount') as HTMLElement;
  const viewportModelName = document.getElementById('viewport-model-name');
  const hudGenId = document.getElementById('hud-gen-id');
  const hudTris = document.getElementById('hud-tris');
  const hudVerts = document.getElementById('hud-verts');
  const hudDims = document.getElementById('hud-dims');
  const statusBadge = document.getElementById('viewport-status-badge');
  const statusBadgeText = document.getElementById('status-badge-text');
  const errorBanner = document.getElementById('viewport-error-banner');
  const errorBannerBody = document.getElementById('error-banner-body');
  const btnCloseError = document.getElementById('btn-close-error');

  const codeTextarea = document.getElementById('code-textarea') as HTMLTextAreaElement;
  const lineNumbers = document.getElementById('line-numbers');
  const cursorPos = document.getElementById('cursor-pos');
  const activeFilenameEl = document.getElementById('active-filename');
  const linterBadge = document.getElementById('linter-badge');
  const linterText = document.getElementById('linter-text');

  const runCompileBtn = document.getElementById('run-compile-btn');
  const exportGlbBtn = document.getElementById('export-glb-btn');
  const exportZipBtn = document.getElementById('export-zip-btn');
  const openDocsBtn = document.getElementById('open-docs-btn');
  const githubPrBtn = document.getElementById('github-pr-btn');
  const docsModal = document.getElementById('docs-modal') as HTMLDialogElement;
  const closeDocsBtn = document.getElementById('close-docs-btn');
  const githubModal = document.getElementById('github-modal') as HTMLDialogElement;
  const closeModalBtn = document.getElementById('close-modal-btn');

  // AI Elements
  const aiEngineBadge = document.getElementById('ai-engine-badge');
  const aiPromptInput = document.getElementById('ai-prompt-input') as HTMLInputElement;
  const generateAiBtn = document.getElementById('generate-ai-btn') as HTMLButtonElement;
  const aiLoadingStatus = document.getElementById('ai-loading-status');
  const geminiKeyDrawer = document.getElementById('gemini-key-drawer');
  const toggleGeminiKeyBtn = document.getElementById('toggle-gemini-key-btn');
  const saveGeminiKeyBtn = document.getElementById('save-gemini-key-btn');
  const geminiApiKeyInput = document.getElementById('gemini-api-key-input') as HTMLInputElement;
  const aiChips = document.querySelectorAll('.ai-chip');

  function updateAIEngineBadge(): void {
    const key = localStorage.getItem('modelcoder_gemini_key');
    if (aiEngineBadge) {
      if (key && key.trim().length > 10) {
        aiEngineBadge.textContent = '⚡ GEMINI 2.5 FLASH CONECTADO';
        aiEngineBadge.style.borderColor = 'var(--ps1-gold)';
        aiEngineBadge.style.color = 'var(--ps1-gold)';
      } else {
        aiEngineBadge.textContent = '🤖 MOTOR PROCEDURAL LOCAL';
        aiEngineBadge.style.borderColor = 'var(--ps1-cyan)';
        aiEngineBadge.style.color = 'var(--ps1-cyan)';
      }
    }
  }
  updateAIEngineBadge();

  // Visual Builder Elements
  const visualComponentsList = document.getElementById('visual-components-list');
  const btnAddBox = document.getElementById('btn-add-box');
  const btnAddCylinder = document.getElementById('btn-add-cylinder');
  const btnAddSphere = document.getElementById('btn-add-sphere');
  const btnAddWedge = document.getElementById('btn-add-wedge');

  // Global Scale & Surface sliders
  const paramGlobalScale = document.getElementById('param-global-scale') as HTMLInputElement;
  const paramGlobalScaleVal = document.getElementById('param-global-scale-val');
  const paramRoughness = document.getElementById('param-roughness') as HTMLInputElement;
  const paramRoughnessVal = document.getElementById('param-roughness-val');
  const paramMetalness = document.getElementById('param-metalness') as HTMLInputElement;
  const paramMetalnessVal = document.getElementById('param-metalness-val');

  // Initialize Three.js Viewport
  let viewport: StudioViewport;
  if (threeMountEl) {
    viewport = new StudioViewport(threeMountEl, handleViewportStatsUpdate);
    document.getElementById('studio-reset-cam')?.addEventListener('click', () => {
      viewport.resetCameraAndFrame();
    });
  }

  function handleViewportStatsUpdate(stats: GeometricStats | null, result: GenerationResult | null) {
    if (stats) {
      if (hudTris) hudTris.textContent = `${stats.triangles.toLocaleString()} tris`;
      if (hudVerts) hudVerts.textContent = `${stats.vertices.toLocaleString()} verts`;
      if (hudDims) hudDims.textContent = `X: ${stats.dimensions.x}m | Y: ${stats.dimensions.y}m | Z: ${stats.dimensions.z}m`;
    }

    if (result) {
      if (hudGenId) hudGenId.textContent = `${result.id} v${result.version}`;
      if (statusBadge && statusBadgeText) {
        if (result.success) {
          statusBadge.className = 'generation-status-badge status-completed';
          statusBadgeText.textContent = 'COMPLETADO';
          if (errorBanner) errorBanner.style.display = 'none';
        } else {
          statusBadge.className = 'generation-status-badge status-error';
          statusBadgeText.textContent = 'ERROR';
          if (errorBanner && errorBannerBody) {
            errorBanner.style.display = 'block';
            errorBannerBody.textContent = result.error || 'Error desconocido';
          }
        }
      }
    }
  }

  // Shading Modes
  const shadingBtns = document.querySelectorAll('.btn-shading');
  shadingBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      shadingBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const mode = (btn as HTMLElement).dataset.shading as ShadingMode;
      if (viewport && mode) {
        viewport.setShadingMode(mode);
      }
    });
  });

  // Render Spec into Viewport
  function renderCurrentSpec(mode: 'ai' | 'visual' | 'code' = 'visual'): void {
    if (!viewport) return;

    try {
      const reqId = `GEN-${Math.random().toString(36).substring(2, 7).toUpperCase()}`;
      generationCounter++;

      const { group, stats } = ProceduralEngine.buildModelFromSpec(currentSpec);
      viewport.displayGeneratedMesh(group, reqId, generationCounter, stats, mode);

      if (viewportModelName) {
        viewportModelName.textContent = currentSpec.name.toUpperCase();
      }

      // Sync editor & visual cards
      syncEditorFromSpec();
      renderVisualBuilderCards();
      setLinterValid();
    } catch (err: any) {
      const reqId = `GEN-${Math.random().toString(36).substring(2, 7).toUpperCase()}`;
      viewport.displayError(err.message, reqId, generationCounter, mode);
      setLinterError(err.message);
    }
  }

  // Mode Switcher Logic
  const modeTabs = document.querySelectorAll('.btn-mode-tab');
  const modePanels = document.querySelectorAll('.mode-panel');

  modeTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const mode = (tab as HTMLElement).dataset.mode as 'ai' | 'visual' | 'code';
      if (!mode) return;

      activeMode = mode;
      modeTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');

      modePanels.forEach((p) => p.classList.remove('active'));
      if (mode === 'ai') document.getElementById('ai-mode-container')?.classList.add('active');
      else if (mode === 'visual') document.getElementById('visual-mode-container')?.classList.add('active');
      else if (mode === 'code') document.getElementById('code-mode-container')?.classList.add('active');
    });
  });

  // MODE A: AI GENERATION
  generateAiBtn?.addEventListener('click', () => triggerAIGeneration());
  aiPromptInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') triggerAIGeneration();
  });

  aiChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const prompt = (chip as HTMLElement).dataset.prompt || '';
      if (aiPromptInput) aiPromptInput.value = prompt;
      triggerAIGeneration(prompt);
    });
  });

  async function triggerAIGeneration(overridePrompt?: string) {
    const prompt = (overridePrompt || aiPromptInput?.value || '').trim();
    if (!prompt) {
      alert('Escribe una descripción del modelo que deseas generar.');
      return;
    }

    if (generateAiBtn) {
      generateAiBtn.disabled = true;
      generateAiBtn.textContent = '⏳ GENERANDO GEOMETRÍA...';
    }

    if (aiLoadingStatus) {
      aiLoadingStatus.style.display = 'block';
      aiLoadingStatus.className = 'ai-status-indicator status-loading';
      aiLoadingStatus.textContent = '🧠 Computando componentes geométricos procedurales...';
    }

    if (statusBadge && statusBadgeText) {
      statusBadge.className = 'generation-status-badge status-generating';
      statusBadgeText.textContent = 'GENERANDO...';
    }

    const apiKey = localStorage.getItem('modelcoder_gemini_key') || undefined;

    try {
      const { spec, source } = await AIGenerator.generateModel(prompt, apiKey);
      currentSpec = spec;
      renderCurrentSpec('ai');

      if (aiLoadingStatus) {
        aiLoadingStatus.className = 'ai-status-indicator status-ok';
        let engineLabel = '🤖 MOTOR PROCEDURAL';
        if (source === 'gemini') engineLabel = '⚡ GOOGLE GEMINI';
        else if (source === 'local_memory') engineLabel = '💾 MEMORIA LOCAL APRENDIDA';
        else if (source === 'cloud_memory') engineLabel = '☁️ NUBE COMUNITARIA RECUPERADA';
        aiLoadingStatus.textContent = `✅ [ ${engineLabel} ] ${spec.name} (${spec.components.length} componentes) renderizado en el visor.`;
      }
    } catch (err: any) {
      if (aiLoadingStatus) {
        aiLoadingStatus.className = 'ai-status-indicator status-error';
        aiLoadingStatus.textContent = `⚠️ Error al generar: ${err.message}`;
      }
      if (viewport) {
        viewport.displayError(err.message, `GEN-ERR`, generationCounter, 'ai');
      }
    } finally {
      if (generateAiBtn) {
        generateAiBtn.disabled = false;
        generateAiBtn.textContent = '⚡ GENERAR GEOMETRÍA';
      }
    }
  }

  // API Key Storage
  toggleGeminiKeyBtn?.addEventListener('click', () => {
    if (geminiKeyDrawer) {
      geminiKeyDrawer.style.display = geminiKeyDrawer.style.display === 'none' ? 'block' : 'none';
    }
  });

  const savedKey = localStorage.getItem('modelcoder_gemini_key');
  if (savedKey && geminiApiKeyInput) {
    geminiApiKeyInput.value = savedKey;
  }

  saveGeminiKeyBtn?.addEventListener('click', () => {
    const key = geminiApiKeyInput?.value.trim() || '';
    if (key) {
      localStorage.setItem('modelcoder_gemini_key', key);
      updateAIEngineBadge();
      alert('Clave de Gemini guardada de forma segura en tu navegador. El estudio ahora usará Google Gemini para cualquier consulta.');
      if (geminiKeyDrawer) geminiKeyDrawer.style.display = 'none';
    } else {
      localStorage.removeItem('modelcoder_gemini_key');
      updateAIEngineBadge();
      alert('Clave eliminada. El estudio usará el generador procedural local.');
    }
  });

  // MODE B: VISUAL BUILDER
  function renderVisualBuilderCards(): void {
    if (!visualComponentsList) return;
    visualComponentsList.innerHTML = '';

    currentSpec.components.forEach((comp, idx) => {
      const card = document.createElement('div');
      card.className = 'comp-card ps1-inset';

      card.innerHTML = `
        <div class="comp-card-header">
          <span class="comp-badge">${comp.shape.toUpperCase()}</span>
          <input type="text" class="comp-name-input" value="${comp.name}" data-idx="${idx}" />
          <button type="button" class="btn-del-comp ps1-ctrl-btn" data-idx="${idx}" title="Eliminar componente">✕</button>
        </div>
        <div class="comp-card-body">
          <div class="comp-field-group">
            <label>Dimensiones [X, Y, Z]:</label>
            <div class="dim-inputs">
              <input type="number" step="0.05" class="dim-input" data-idx="${idx}" data-dim="0" value="${comp.size?.[0] ?? 1.0}" />
              <input type="number" step="0.05" class="dim-input" data-idx="${idx}" data-dim="1" value="${comp.size?.[1] ?? 1.0}" />
              <input type="number" step="0.05" class="dim-input" data-idx="${idx}" data-dim="2" value="${comp.size?.[2] ?? 1.0}" />
            </div>
          </div>
          <div class="comp-field-group">
            <label>Posición [X, Y, Z]:</label>
            <div class="dim-inputs">
              <input type="number" step="0.05" class="pos-input" data-idx="${idx}" data-pos="0" value="${comp.position?.[0] ?? 0.0}" />
              <input type="number" step="0.05" class="pos-input" data-idx="${idx}" data-pos="1" value="${comp.position?.[1] ?? 0.0}" />
              <input type="number" step="0.05" class="pos-input" data-idx="${idx}" data-pos="2" value="${comp.position?.[2] ?? 0.0}" />
            </div>
          </div>
          <div class="comp-field-row">
            <label>Color:</label>
            <input type="color" class="color-picker-input" data-idx="${idx}" value="${comp.color?.startsWith('#') ? comp.color : '#4a5568'}" />
          </div>
        </div>
      `;

      visualComponentsList.appendChild(card);
    });

    // Wire component events
    visualComponentsList.querySelectorAll('.comp-name-input').forEach((el) => {
      el.addEventListener('change', (e) => {
        const idx = parseInt((e.target as HTMLElement).dataset.idx || '0', 10);
        currentSpec.components[idx].name = (e.target as HTMLInputElement).value;
        syncEditorFromSpec();
      });
    });

    visualComponentsList.querySelectorAll('.dim-input').forEach((el) => {
      el.addEventListener('input', (e) => {
        const input = e.target as HTMLInputElement;
        const idx = parseInt(input.dataset.idx || '0', 10);
        const dim = parseInt(input.dataset.dim || '0', 10);
        if (!currentSpec.components[idx].size) currentSpec.components[idx].size = [1, 1, 1];
        currentSpec.components[idx].size![dim] = parseFloat(input.value) || 0.1;
        renderCurrentSpec('visual');
      });
    });

    visualComponentsList.querySelectorAll('.pos-input').forEach((el) => {
      el.addEventListener('input', (e) => {
        const input = e.target as HTMLInputElement;
        const idx = parseInt(input.dataset.idx || '0', 10);
        const pos = parseInt(input.dataset.pos || '0', 10);
        if (!currentSpec.components[idx].position) currentSpec.components[idx].position = [0, 0, 0];
        currentSpec.components[idx].position![pos] = parseFloat(input.value) || 0;
        renderCurrentSpec('visual');
      });
    });

    visualComponentsList.querySelectorAll('.color-picker-input').forEach((el) => {
      el.addEventListener('input', (e) => {
        const input = e.target as HTMLInputElement;
        const idx = parseInt(input.dataset.idx || '0', 10);
        currentSpec.components[idx].color = input.value;
        renderCurrentSpec('visual');
      });
    });

    visualComponentsList.querySelectorAll('.btn-del-comp').forEach((el) => {
      el.addEventListener('click', (e) => {
        const idx = parseInt((e.target as HTMLElement).dataset.idx || '0', 10);
        currentSpec.components.splice(idx, 1);
        renderCurrentSpec('visual');
      });
    });
  }

  // Add Component Buttons in Visual Mode
  btnAddBox?.addEventListener('click', () => {
    currentSpec.components.push({
      name: `box_${currentSpec.components.length + 1}`,
      shape: 'box',
      size: [0.8, 0.8, 0.8],
      position: [0, 0.4, 0],
      color: '#4a5568'
    });
    renderCurrentSpec('visual');
  });

  btnAddCylinder?.addEventListener('click', () => {
    currentSpec.components.push({
      name: `cylinder_${currentSpec.components.length + 1}`,
      shape: 'cylinder',
      size: [0.3, 0.3, 1.0, 8],
      position: [0, 0.5, 0],
      color: '#2d3748'
    });
    renderCurrentSpec('visual');
  });

  btnAddSphere?.addEventListener('click', () => {
    currentSpec.components.push({
      name: `sphere_${currentSpec.components.length + 1}`,
      shape: 'sphere',
      size: [0.4, 8, 6],
      position: [0, 0.4, 0],
      color: '#e53e3e'
    });
    renderCurrentSpec('visual');
  });

  btnAddWedge?.addEventListener('click', () => {
    currentSpec.components.push({
      name: `wedge_${currentSpec.components.length + 1}`,
      shape: 'wedge',
      size: [0.8, 0.6, 0.6],
      position: [0, 0.3, 0],
      color: '#d69e2e'
    });
    renderCurrentSpec('visual');
  });

  // MODE C: CODE EDITOR & COMPILATION
  function syncEditorFromSpec(): void {
    if (!codeTextarea) return;
    if (activeFile === 'spec') {
      codeTextarea.value = JSON.stringify(currentSpec, null, 2);
    } else if (activeFile === 'script') {
      codeTextarea.value = generateDslScriptFromSpec(currentSpec);
    } else if (activeFile === 'generator_py') {
      codeTextarea.value = generatePythonFromSpec(currentSpec);
    }
    updateLineNumbers();
  }

  function generateDslScriptFromSpec(spec: ModelSpec): string {
    let out = `// ModelCoder Procedural Builder\nbuilder.setName(${JSON.stringify(spec.name)});\n\n`;
    spec.components.forEach((c) => {
      const fn = c.shape === 'cylinder' ? 'addCylinder' : (c.shape === 'sphere' ? 'addSphere' : (c.shape === 'wedge' ? 'addWedge' : 'addBox'));
      out += `builder.${fn}({\n  name: ${JSON.stringify(c.name)},\n  size: ${JSON.stringify(c.size || [1, 1, 1])},\n  position: ${JSON.stringify(c.position || [0, 0, 0])},\n  color: ${JSON.stringify(c.color || '#4a5568')}\n});\n\n`;
    });
    return out;
  }

  function generatePythonFromSpec(spec: ModelSpec): string {
    const className = spec.name.replace(/[^a-zA-Z0-9]/g, '') + 'Generator';
    return `import bpy\nfrom ...core.base_generator import BaseAssetGenerator\nfrom ...core.mesh_builder import MeshBuilder\n\nclass ${className}(BaseAssetGenerator):\n    """Generador procedural 3D para ${spec.name}."""\n    def generate(self) -> bpy.types.Object:\n        obj, bm = self.create_mesh_object("${spec.id}")\n        # ${spec.components.length} componentes definidos\n        self.finalize_mesh(obj, bm)\n        return obj\n`;
  }

  // Compile Button Event
  runCompileBtn?.addEventListener('click', () => compileCode());

  function compileCode(): void {
    if (!codeTextarea) return;
    const code = codeTextarea.value;

    const { spec, error, errorLine } = CodeSandbox.executeCode(code);

    if (error) {
      setLinterError(error, errorLine);
      if (viewport) {
        viewport.displayError(error, `ERR-v${generationCounter}`, generationCounter, 'code');
      }
      return;
    }

    currentSpec = spec;
    renderCurrentSpec('code');
  }

  function setLinterValid(): void {
    if (linterBadge) linterBadge.className = 'status-right status-ok';
    if (linterText) linterText.textContent = 'SINTAXIS: VÁLIDA // 0 ERRORES';
  }

  function setLinterError(msg: string, line?: number): void {
    if (linterBadge) linterBadge.className = 'status-right status-err';
    if (linterText) linterText.textContent = `ERROR ${line ? `LN ${line}: ` : ''}${msg.substring(0, 40)}`;
  }

  // Editor Tabs
  const editorTabs = document.querySelectorAll('.editor-tab');
  editorTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      editorTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      activeFile = (tab as HTMLElement).dataset.file as any;
      if (activeFilenameEl) {
        activeFilenameEl.textContent = activeFile === 'spec' ? 'model_spec.json' : (activeFile === 'script' ? 'procedural_script.js' : 'generator.py');
      }
      syncEditorFromSpec();
    });
  });

  // Line Numbers and Cursor Tracking
  codeTextarea?.addEventListener('input', () => {
    updateLineNumbers();
  });

  codeTextarea?.addEventListener('keyup', () => updateCursorPos());
  codeTextarea?.addEventListener('click', () => updateCursorPos());

  function updateLineNumbers(): void {
    if (!codeTextarea || !lineNumbers) return;
    const lines = codeTextarea.value.split('\n').length;
    lineNumbers.innerHTML = Array.from({ length: lines }, (_, i) => i + 1).join('<br>');
  }

  function updateCursorPos(): void {
    if (!codeTextarea || !cursorPos) return;
    const textLines = codeTextarea.value.substring(0, codeTextarea.selectionStart).split('\n');
    cursorPos.textContent = `LN ${textLines.length}, COL ${textLines[textLines.length - 1].length + 1}`;
  }

  // EXPORT GLB WITH VERIFICATION
  exportGlbBtn?.addEventListener('click', async () => {
    if (!viewport) return;
    const rootObj = viewport.getVisibleObject();
    if (!rootObj) {
      alert('No hay ninguna geometría visible para exportar.');
      return;
    }

    exportGlbBtn.textContent = '⏳ VERIFICANDO GLB...';
    try {
      const filename = currentSpec.name.toLowerCase().replace(/[^a-z0-9]/g, '_') || 'modelcoder_asset';
      const result = await GLBExporterService.exportAndVerifyGLB(rootObj, filename);
      alert(`✅ [ EXPORTACIÓN VERIFICADA ]\nArchivo: ${filename}.glb\nTamaño: ${(result.sizeBytes / 1024).toFixed(1)} KB\nTriángulos: ${result.triangleCount}\nVértices: ${result.vertexCount}`);
    } catch (err: any) {
      alert(`⚠️ Fallo de exportación: ${err.message}`);
    } finally {
      exportGlbBtn.textContent = '💾 EXPORTAR GLB';
    }
  });

  // Export ZIP Package
  exportZipBtn?.addEventListener('click', async () => {
    exportZipBtn.textContent = '⏳ Empaquetando...';
    try {
      const JSZip = (window as any).JSZip;
      if (!JSZip) throw new Error('JSZip no disponible');

      const zip = new JSZip();
      const familyName = currentSpec.name.toLowerCase().replace(/[^a-z0-9]/g, '_') || 'custom_model';

      const folder = zip.folder(`procedural_assets/generators/${familyName}`);
      folder.file('__init__.py', `from .config import *\nfrom .generator import *\n`);
      folder.file('generator.py', generatePythonFromSpec(currentSpec));
      folder.file('model_spec.json', JSON.stringify(currentSpec, null, 2));
      folder.file('README.md', `# ${currentSpec.name}\n\nGenerador procedural de ModelCoder Studio.\n`);

      const content = await zip.generateAsync({ type: 'blob' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(content);
      a.download = `${familyName}_generator_package.zip`;
      a.click();
    } catch (e: any) {
      alert(`Error al generar ZIP: ${e.message}`);
    } finally {
      exportZipBtn.textContent = '📦 PAQUETE (.ZIP)';
    }
  });

  // Docs Modal
  openDocsBtn?.addEventListener('click', () => {
    if (docsModal) docsModal.showModal();
  });
  closeDocsBtn?.addEventListener('click', () => {
    if (docsModal) docsModal.close();
  });

  const docTabs = document.querySelectorAll('.doc-tab');
  const docSections = document.querySelectorAll('.doc-section');
  docTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const targetSec = (tab as HTMLElement).dataset.section;
      docTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      docSections.forEach((s) => s.classList.remove('active'));
      if (targetSec) document.getElementById(targetSec)?.classList.add('active');
    });
  });

  // GitHub Modal
  githubPrBtn?.addEventListener('click', () => {
    if (githubModal) githubModal.showModal();
  });
  closeModalBtn?.addEventListener('click', () => {
    if (githubModal) githubModal.close();
  });

  document.getElementById('btn-quick-github-proposal')?.addEventListener('click', () => {
    const title = encodeURIComponent(`[Nuevo Modelo]: ${currentSpec.name}`);
    const body = encodeURIComponent(
      `## Propuesta de Modelo Procedural 3D\n\n` +
      `- **Nombre**: ${currentSpec.name}\n` +
      `- **Categoría**: ${currentSpec.category}\n` +
      `- **Componentes**: ${currentSpec.components.length}\n\n` +
      `### Especificación JSON:\n\`\`\`json\n${JSON.stringify(currentSpec, null, 2)}\n\`\`\`\n`
    );
    window.open(`https://github.com/FrancisCuarto/MODELCODER/issues/new?title=${title}&body=${body}`, '_blank');
  });

  document.getElementById('btn-modal-download-zip')?.addEventListener('click', () => {
    exportZipBtn?.click();
  });

  btnCloseError?.addEventListener('click', () => {
    if (errorBanner) errorBanner.style.display = 'none';
  });

  // Initial Render on Page Load
  renderCurrentSpec('visual');
</script>

