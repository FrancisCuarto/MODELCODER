  function getDefaultSizeForShape(shape: ShapePrimitive): number[] {
    switch (shape) {
      case 'box': return [1.0, 1.0, 1.0];
      case 'cylinder': return [0.35, 0.35, 1.0, 8];
      case 'sphere': return [0.5, 8, 6];
      case 'wedge': return [1.0, 0.8, 0.8];
      case 'cone': return [0.4, 1.0, 8];
      case 'torus': return [0.5, 0.15, 6, 12];
      case 'capsule': return [0.25, 0.5, 4, 8];
      case 'plane': return [1.0, 1.0];
      default: return [1.0, 1.0, 1.0];
    }
  }

  function getShapeIcon(shape: ShapePrimitive): string {
    switch (shape) {
      case 'box': return '📦';
      case 'cylinder': return '🛢️';
      case 'sphere': return '🔮';
      case 'wedge': return '📐';
      case 'cone': return '🔺';
      case 'torus': return '🍩';
      case 'capsule': return '💊';
      case 'plane': return '📄';
      default: return '🔹';
    }
  }

  function updateEffectiveDimensions(comp: ComponentDef): void {
    const effDimsVal = document.getElementById('eff-dims-val');
    if (!effDimsVal) return;

    const s = comp.size || [1, 1, 1];
    const scl = comp.scale || [1, 1, 1];

    let w = 1.0;
    let h = 1.0;
    let d = 1.0;

    switch (comp.shape) {
      case 'box':
      case 'wedge':
        w = (s[0] ?? 1.0) * scl[0];
        h = (s[1] ?? 1.0) * scl[1];
        d = (s[2] ?? 1.0) * scl[2];
        break;
      case 'cylinder': {
        const maxR = Math.max(s[0] ?? 0.35, s[1] ?? 0.35);
        w = maxR * 2 * scl[0];
        h = (s[2] ?? 1.0) * scl[1];
        d = maxR * 2 * scl[2];
        break;
      }
      case 'sphere': {
        const r = s[0] ?? 0.5;
        w = r * 2 * scl[0];
        h = r * 2 * scl[1];
        d = r * 2 * scl[2];
        break;
      }
      case 'cone': {
        const r = s[0] ?? 0.4;
        w = r * 2 * scl[0];
        h = (s[1] ?? 1.0) * scl[1];
        d = r * 2 * scl[2];
        break;
      }
      case 'torus': {
        const R = s[0] ?? 0.5;
        const r = s[1] ?? 0.15;
        w = (R + r) * 2 * scl[0];
        h = r * 2 * scl[1];
        d = (R + r) * 2 * scl[2];
        break;
      }
      case 'capsule': {
        const r = s[0] ?? 0.25;
        const len = s[1] ?? 0.5;
        w = r * 2 * scl[0];
        h = (len + r * 2) * scl[1];
        d = r * 2 * scl[2];
        break;
      }
      case 'plane':
        w = (s[0] ?? 1.0) * scl[0];
        h = 0.01;
        d = (s[1] ?? 1.0) * scl[2];
        break;
    }

    effDimsVal.textContent = `Ancho: ${w.toFixed(2)}m | Alto: ${h.toFixed(2)}m | Prof: ${d.toFixed(2)}m`;
  }

  function updateTransformInspectorInputs(
    pos: [number, number, number],
    rot: [number, number, number],
    scale: [number, number, number]
  ): void {
    const inpPosX = document.getElementById('inp-pos-x') as HTMLInputElement | null;
    const inpPosY = document.getElementById('inp-pos-y') as HTMLInputElement | null;
    const inpPosZ = document.getElementById('inp-pos-z') as HTMLInputElement | null;

    const inpRotX = document.getElementById('inp-rot-x') as HTMLInputElement | null;
    const inpRotY = document.getElementById('inp-rot-y') as HTMLInputElement | null;
    const inpRotZ = document.getElementById('inp-rot-z') as HTMLInputElement | null;

    const inpSclX = document.getElementById('inp-scl-x') as HTMLInputElement | null;
    const inpSclY = document.getElementById('inp-scl-y') as HTMLInputElement | null;
    const inpSclZ = document.getElementById('inp-scl-z') as HTMLInputElement | null;

    if (inpPosX) inpPosX.value = `${pos[0]}`;
    if (inpPosY) inpPosY.value = `${pos[1]}`;
    if (inpPosZ) inpPosZ.value = `${pos[2]}`;

    if (inpRotX) inpRotX.value = `${rot[0]}`;
    if (inpRotY) inpRotY.value = `${rot[1]}`;
    if (inpRotZ) inpRotZ.value = `${rot[2]}`;

    if (inpSclX) inpSclX.value = `${scale[0]}`;
    if (inpSclY) inpSclY.value = `${scale[1]}`;
    if (inpSclZ) inpSclZ.value = `${scale[2]}`;
  }

  function updateSelectionPill(): void {
    if (!viewportSelectionPill || !viewportSelectionLabel) return;
    if (selectedComponentIndex !== null && currentSpec.components[selectedComponentIndex]) {
      const comp = currentSpec.components[selectedComponentIndex];
      viewportSelectionPill.style.display = 'flex';
      viewportSelectionLabel.textContent = `[${comp.shape.toUpperCase()}] ${comp.name}`;
    } else {
      viewportSelectionPill.style.display = 'none';
    }
  }

  function wireInspectorEventListeners(comp: ComponentDef): void {
    const idx = selectedComponentIndex!;

    // Name input
    document.getElementById('inp-comp-name')?.addEventListener('change', (e) => {
      comp.name = (e.target as HTMLInputElement).value.trim() || `pieza_${idx + 1}`;
      renderCurrentSpec('visual');
    });

    // Quick action buttons
    document.getElementById('btn-prop-vis')?.addEventListener('click', () => {
      toggleComponentVisibility(idx);
    });
    document.getElementById('btn-prop-dup')?.addEventListener('click', () => {
      duplicateComponent(idx);
    });
    document.getElementById('btn-prop-del')?.addEventListener('click', () => {
      deleteComponent(idx);
    });

    // Reset Transform
    document.getElementById('btn-reset-transform')?.addEventListener('click', () => {
      comp.position = [0, 0, 0];
      comp.rotation = [0, 0, 0];
      comp.scale = [1, 1, 1];
      renderCurrentSpec('visual');
    });

    // Position inputs
    const handlePosChange = () => {
      const x = parseFloat((document.getElementById('inp-pos-x') as HTMLInputElement)?.value) || 0;
      const y = parseFloat((document.getElementById('inp-pos-y') as HTMLInputElement)?.value) || 0;
      const z = parseFloat((document.getElementById('inp-pos-z') as HTMLInputElement)?.value) || 0;
      comp.position = [x, y, z];
      renderCurrentSpec('visual');
    };
    ['inp-pos-x', 'inp-pos-y', 'inp-pos-z'].forEach((id) => {
      document.getElementById(id)?.addEventListener('input', handlePosChange);
    });

    // Rotation inputs
    const handleRotChange = () => {
      const x = parseFloat((document.getElementById('inp-rot-x') as HTMLInputElement)?.value) || 0;
      const y = parseFloat((document.getElementById('inp-rot-y') as HTMLInputElement)?.value) || 0;
      const z = parseFloat((document.getElementById('inp-rot-z') as HTMLInputElement)?.value) || 0;
      comp.rotation = [x, y, z];
      renderCurrentSpec('visual');
    };
    ['inp-rot-x', 'inp-rot-y', 'inp-rot-z'].forEach((id) => {
      document.getElementById(id)?.addEventListener('input', handleRotChange);
    });

    // Scale Lock checkbox
    const chkScaleLock = document.getElementById('chk-scale-lock') as HTMLInputElement | null;
    chkScaleLock?.addEventListener('change', (e) => {
      isUniformScaleLocked = (e.target as HTMLInputElement).checked;
    });

    // Scale inputs
    const handleScaleInput = (axis: 0 | 1 | 2, e: Event) => {
      const val = Math.max(0.01, parseFloat((e.target as HTMLInputElement).value) || 1.0);
      if (!comp.scale) comp.scale = [1, 1, 1];

      if (isUniformScaleLocked) {
        const oldVal = comp.scale[axis] || 1.0;
        const ratio = val / oldVal;
        comp.scale[0] = parseFloat((comp.scale[0] * ratio).toFixed(3));
        comp.scale[1] = parseFloat((comp.scale[1] * ratio).toFixed(3));
        comp.scale[2] = parseFloat((comp.scale[2] * ratio).toFixed(3));
        (document.getElementById('inp-scl-x') as HTMLInputElement).value = `${comp.scale[0]}`;
        (document.getElementById('inp-scl-y') as HTMLInputElement).value = `${comp.scale[1]}`;
        (document.getElementById('inp-scl-z') as HTMLInputElement).value = `${comp.scale[2]}`;
      } else {
        comp.scale[axis] = val;
      }
      renderCurrentSpec('visual');
    };

    document.getElementById('inp-scl-x')?.addEventListener('input', (e) => handleScaleInput(0, e));
    document.getElementById('inp-scl-y')?.addEventListener('input', (e) => handleScaleInput(1, e));
    document.getElementById('inp-scl-z')?.addEventListener('input', (e) => handleScaleInput(2, e));

    // Shape-specific parameters
    document.querySelectorAll('.shape-num-inp').forEach((inp) => {
      inp.addEventListener('input', (e) => {
        const input = e.target as HTMLInputElement;
        const paramIdx = parseInt(input.dataset.param || '0', 10);
        const val = parseFloat(input.value) || 0.1;
        if (!comp.size) comp.size = getDefaultSizeForShape(comp.shape);
        comp.size[paramIdx] = val;
        renderCurrentSpec('visual');
      });
    });

    // Material Color
    const inpMatColor = document.getElementById('inp-mat-color') as HTMLInputElement | null;
    const inpMatColorHex = document.getElementById('inp-mat-color-hex') as HTMLInputElement | null;

    inpMatColor?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      comp.color = val;
      if (inpMatColorHex) inpMatColorHex.value = val;
      renderCurrentSpec('visual');
    });

    inpMatColorHex?.addEventListener('change', (e) => {
      const val = (e.target as HTMLInputElement).value.trim();
      comp.color = val;
      if (inpMatColor && val.startsWith('#')) inpMatColor.value = val;
      renderCurrentSpec('visual');
    });

    // Roughness & Metalness
    const inpRoughness = document.getElementById('inp-roughness') as HTMLInputElement | null;
    const dispRoughness = document.getElementById('disp-roughness');
    inpRoughness?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      comp.roughness = val;
      if (dispRoughness) dispRoughness.textContent = `${val}`;
      renderCurrentSpec('visual');
    });

    const inpMetalness = document.getElementById('inp-metalness') as HTMLInputElement | null;
    const dispMetalness = document.getElementById('disp-metalness');
    inpMetalness?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      comp.metalness = val;
      if (dispMetalness) dispMetalness.textContent = `${val}`;
      renderCurrentSpec('visual');
    });

    // Transparent & Opacity
    const chkTransparent = document.getElementById('chk-transparent') as HTMLInputElement | null;
    const inpOpacity = document.getElementById('inp-opacity') as HTMLInputElement | null;
    const dispOpacity = document.getElementById('disp-opacity');

    chkTransparent?.addEventListener('change', (e) => {
      comp.transparent = (e.target as HTMLInputElement).checked;
      renderCurrentSpec('visual');
    });

    inpOpacity?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      comp.opacity = val;
      if (val < 1.0) comp.transparent = true;
      if (dispOpacity) dispOpacity.textContent = `${val}`;
      renderCurrentSpec('visual');
    });

    // Texture Preset
    document.getElementById('sel-texture-preset')?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      if (val) {
        comp.texturePreset = val;
      } else {
        delete comp.texturePreset;
      }
      renderCurrentSpec('visual');
    });

    // UV Scale
    const inpUvU = document.getElementById('inp-uv-u') as HTMLInputElement | null;
    const inpUvV = document.getElementById('inp-uv-v') as HTMLInputElement | null;
    const handleUVChange = () => {
      const u = parseFloat(inpUvU?.value || '1.0') || 1.0;
      const v = parseFloat(inpUvV?.value || '1.0') || 1.0;
      comp.uvScale = [u, v];
      renderCurrentSpec('visual');
    };
    inpUvU?.addEventListener('input', handleUVChange);
    inpUvV?.addEventListener('input', handleUVChange);

    // Wireframe
    document.getElementById('chk-comp-wireframe')?.addEventListener('change', (e) => {
      comp.wireframe = (e.target as HTMLInputElement).checked;
      renderCurrentSpec('visual');
    });

    // Label / Decal
    document.getElementById('inp-comp-label')?.addEventListener('change', (e) => {
      const val = (e.target as HTMLInputElement).value.trim();
      if (val) {
        comp.label = val;
      } else {
        delete comp.label;
      }
      renderCurrentSpec('visual');
    });
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // --- GIZMO TOOLBAR CONTROLS ---
  function updateGizmoButtons(activeGizmoMode: TransformGizmoMode): void {
    [gizmoBtnSelect, gizmoBtnTranslate, gizmoBtnRotate, gizmoBtnScale].forEach((btn) => {
      btn?.classList.remove('active');
    });

    if (activeGizmoMode === 'none') gizmoBtnSelect?.classList.add('active');
    else if (activeGizmoMode === 'translate') gizmoBtnTranslate?.classList.add('active');
    else if (activeGizmoMode === 'rotate') gizmoBtnRotate?.classList.add('active');
    else if (activeGizmoMode === 'scale') gizmoBtnScale?.classList.add('active');
  }

  gizmoBtnSelect?.addEventListener('click', () => {
    viewport?.setGizmoMode('none');
    updateGizmoButtons('none');
  });
  gizmoBtnTranslate?.addEventListener('click', () => {
    viewport?.setGizmoMode('translate');
    updateGizmoButtons('translate');
  });
  gizmoBtnRotate?.addEventListener('click', () => {
    viewport?.setGizmoMode('rotate');
    updateGizmoButtons('rotate');
  });
  gizmoBtnScale?.addEventListener('click', () => {
    viewport?.setGizmoMode('scale');
    updateGizmoButtons('scale');
  });

  gizmoBtnSnap?.addEventListener('click', () => {
    isGridSnapEnabled = !isGridSnapEnabled;
    gizmoBtnSnap.classList.toggle('active', isGridSnapEnabled);
    viewport?.setSnap(isGridSnapEnabled, 0.1, 15);
  });

  // Camera Presets
  document.querySelectorAll('.btn-cam-preset').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const preset = (e.currentTarget as HTMLElement).dataset.preset as CameraViewPreset;
      if (viewport && preset) {
        viewport.setViewPreset(preset);
      }
    });
  });

  // Focus Selected Component
  btnFocusSelected?.addEventListener('click', () => {
    if (viewport && selectedComponentIndex !== null) {
      viewport.focusComponent(selectedComponentIndex);
    }
  });

  // Toggle Grid & Axes
  let isGridVisible = true;
  btnToggleGrid?.addEventListener('click', () => {
    isGridVisible = !isGridVisible;
    btnToggleGrid.classList.toggle('active', isGridVisible);
    viewport?.setGridVisible(isGridVisible);
  });

  let isAxesVisible = true;
  btnToggleAxes?.addEventListener('click', () => {
    isAxesVisible = !isAxesVisible;
    btnToggleAxes.classList.toggle('active', isAxesVisible);
    viewport?.setAxesVisible(isAxesVisible);
  });

  // --- KEYBOARD SHORTCUTS ---
  window.addEventListener('keydown', (e) => {
    const targetTag = (e.target as HTMLElement)?.tagName?.toLowerCase();
    const isInputActive = targetTag === 'input' || targetTag === 'textarea' || targetTag === 'select';

    // Undo / Redo (available everywhere)
    if ((e.ctrlKey || e.metaKey) && (e.key === 'z' || e.key === 'Z')) {
      e.preventDefault();
      if (e.shiftKey) redo();
      else undo();
      return;
    }
    if ((e.ctrlKey || e.metaKey) && (e.key === 'y' || e.key === 'Y')) {
      e.preventDefault();
      redo();
      return;
    }

    // Viewport & Editor shortcuts when not typing in text fields
    if (!isInputActive) {
      if (e.key === 'w' || e.key === 'W') {
        viewport?.setGizmoMode('translate');
        updateGizmoButtons('translate');
      } else if (e.key === 'e' || e.key === 'E') {
        viewport?.setGizmoMode('rotate');
        updateGizmoButtons('rotate');
      } else if (e.key === 'r' || e.key === 'R') {
        viewport?.setGizmoMode('scale');
        updateGizmoButtons('scale');
      } else if (e.key === 'q' || e.key === 'Q') {
        viewport?.setGizmoMode('none');
        updateGizmoButtons('none');
      } else if (e.key === 'f' || e.key === 'F') {
        if (selectedComponentIndex !== null) {
          viewport?.focusComponent(selectedComponentIndex);
        }
      } else if (e.key === 'Delete' || e.key === 'Backspace') {
        if (selectedComponentIndex !== null) {
          deleteComponent(selectedComponentIndex);
        }
      }
    }
  });

  // --- AI GENERATION COPILOT ---
  generateAiBtn?.addEventListener('click', () => triggerAIGeneration());
  aiPromptInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') triggerAIGeneration();
  });

  aiChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const prompt = (chip as HTMLElement).dataset.prompt || '';
      if (aiPromptInput) aiPromptInput.value = prompt;
      triggerAIGeneration(prompt);
    });
  });

  async function triggerAIGeneration(overridePrompt?: string) {
    const prompt = (overridePrompt || aiPromptInput?.value || '').trim();
    if (!prompt) {
      alert('Escribe una descripción del modelo que deseas generar.');
      return;
    }

    if (generateAiBtn) {
      generateAiBtn.disabled = true;
      generateAiBtn.textContent = '⏳ GENERANDO GEOMETRÍA...';
    }

    if (aiLoadingStatus) {
      aiLoadingStatus.style.display = 'block';
      aiLoadingStatus.className = 'ai-status-indicator status-loading';
      aiLoadingStatus.textContent = currentEngine === 'ai'
        ? '⚡ Gemini AI sintetizando geometría 3D única y original (sin plantillas)...'
        : '🧠 Computando componentes geométricos procedurales...';
    }

    if (statusBadge && statusBadgeText) {
      statusBadge.className = 'generation-status-badge status-generating';
      statusBadgeText.textContent = 'GENERANDO...';
    }

    const apiKey = localStorage.getItem('modelcoder_gemini_key') || undefined;

    try {
      const { spec, source } = await AIGenerator.generateModel(prompt, {
        engine: currentEngine,
        apiKey,
        forceFresh: currentEngine === 'ai'
      });
      currentSpec = spec;
      selectedComponentIndex = 0;
      renderCurrentSpec('ai');

      if (aiLoadingStatus) {
        aiLoadingStatus.className = 'ai-status-indicator status-ok';
        let engineLabel = '🤖 MOTOR PROCEDURAL';
        if (source === 'gemini') engineLabel = '⚡ IA GEMINI (DISEÑO 100% ÚNICO)';
        else if (source === 'local_memory') engineLabel = '💾 MEMORIA LOCAL APRENDIDA';
        else if (source === 'cloud_memory') engineLabel = '☁️ NUBE COMUNITARIA RECUPERADA';
        aiLoadingStatus.textContent = `✅ [ ${engineLabel} ] ${spec.name} (${spec.components.length} componentes) renderizado en el visor.`;
      }
    } catch (err: any) {
      if (aiLoadingStatus) {
        aiLoadingStatus.className = 'ai-status-indicator status-error';
        aiLoadingStatus.textContent = `⚠️ Error al generar: ${err.message}`;
      }
      if (err.message && err.message.includes('🔑 CONECTAR GEMINI')) {
        if (geminiKeyDrawer) geminiKeyDrawer.style.display = 'block';
        geminiApiKeyInput?.focus();
      }
      if (viewport) {
        viewport.displayError(err.message, `GEN-ERR`, generationCounter, 'ai');
      }
    } finally {
      if (generateAiBtn) {
        generateAiBtn.disabled = false;
        generateAiBtn.textContent = '⚡ GENERAR GEOMETRÍA';
      }
    }
  }

  // Gemini API Key Drawer
  toggleGeminiKeyBtn?.addEventListener('click', () => {
    if (geminiKeyDrawer) {
      geminiKeyDrawer.style.display = geminiKeyDrawer.style.display === 'none' ? 'block' : 'none';
    }
  });

  const savedKey = localStorage.getItem('modelcoder_gemini_key');
  if (savedKey && geminiApiKeyInput) {
    geminiApiKeyInput.value = savedKey;
  }

  saveGeminiKeyBtn?.addEventListener('click', () => {
    const key = geminiApiKeyInput?.value.trim() || '';
    if (key) {
      localStorage.setItem('modelcoder_gemini_key', key);
      setEngineMode('ai');
      alert('¡Clave de Google Gemini guardada exitosamente! El modo [⚡ IA GENERATIVA] está ahora activo.');
      if (geminiKeyDrawer) geminiKeyDrawer.style.display = 'none';
    } else {
      localStorage.removeItem('modelcoder_gemini_key');
      setEngineMode('local');
      alert('Clave eliminada. El estudio ha cambiado al [🤖 MOTOR PROCEDURAL LOCAL].');
    }
  });

  // --- CODE EDITOR & COMPILATION ---
  function syncEditorFromSpec(): void {
    if (!codeTextarea) return;
    if (activeFile === 'spec') {
      codeTextarea.value = JSON.stringify(currentSpec, null, 2);
    } else if (activeFile === 'script') {
      codeTextarea.value = generateDslScriptFromSpec(currentSpec);
    } else if (activeFile === 'generator_py') {
      codeTextarea.value = generatePythonFromSpec(currentSpec);
    }
    updateLineNumbers();
  }

  function generateDslScriptFromSpec(spec: ModelSpec): string {
    let out = `// ModelCoder Procedural Builder\nbuilder.setName(${JSON.stringify(spec.name)});\n\n`;
    spec.components.forEach((c) => {
      const fn = c.shape === 'cylinder' ? 'addCylinder' : (c.shape === 'sphere' ? 'addSphere' : (c.shape === 'wedge' ? 'addWedge' : 'addBox'));
      out += `builder.${fn}({\n  name: ${JSON.stringify(c.name)},\n  size: ${JSON.stringify(c.size || [1, 1, 1])},\n  position: ${JSON.stringify(c.position || [0, 0, 0])},\n  color: ${JSON.stringify(c.color || '#4a5568')}\n});\n\n`;
    });
    return out;
  }

  function generatePythonFromSpec(spec: ModelSpec): string {
    const className = spec.name.replace(/[^a-zA-Z0-9]/g, '') + 'Generator';
    return `import bpy\nfrom ...core.base_generator import BaseAssetGenerator\nfrom ...core.mesh_builder import MeshBuilder\n\nclass ${className}(BaseAssetGenerator):\n    """Generador procedural 3D para ${spec.name}."""\n    def generate(self) -> bpy.types.Object:\n        obj, bm = self.create_mesh_object("${spec.id}")\n        # ${spec.components.length} componentes definidos\n        self.finalize_mesh(obj, bm)\n        return obj\n`;
  }

  runCompileBtn?.addEventListener('click', () => compileCode());

  function compileCode(): void {
    if (!codeTextarea) return;
    const code = codeTextarea.value;
    const { spec, error, errorLine } = CodeSandbox.executeCode(code);

    if (error) {
      setLinterError(error, errorLine);
      if (viewport) {
        viewport.displayError(error, `ERR-v${generationCounter}`, generationCounter, 'code');
      }
      return;
    }

    currentSpec = spec;
    selectedComponentIndex = 0;
    renderCurrentSpec('code');
  }

  function setLinterValid(): void {
    if (linterBadge) linterBadge.className = 'status-right status-ok';
    if (linterText) linterText.textContent = 'SINTAXIS: VÁLIDA // 0 ERRORES';
  }

  function setLinterError(msg: string, line?: number): void {
    if (linterBadge) linterBadge.className = 'status-right status-err';
    if (linterText) linterText.textContent = `ERROR ${line ? `LN ${line}: ` : ''}${msg.substring(0, 40)}`;
  }

  const editorTabs = document.querySelectorAll('.editor-tab');
  editorTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      editorTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      activeFile = (tab as HTMLElement).dataset.file as any;
      if (activeFilenameEl) {
        activeFilenameEl.textContent = activeFile === 'spec' ? 'model_spec.json' : (activeFile === 'script' ? 'procedural_script.js' : 'generator.py');
      }
      syncEditorFromSpec();
    });
  });

  codeTextarea?.addEventListener('input', () => updateLineNumbers());
  codeTextarea?.addEventListener('keyup', () => updateCursorPos());
  codeTextarea?.addEventListener('click', () => updateCursorPos());

  function updateLineNumbers(): void {
    if (!codeTextarea || !lineNumbers) return;
    const lines = codeTextarea.value.split('\n').length;
    lineNumbers.innerHTML = Array.from({ length: lines }, (_, i) => i + 1).join('<br>');
  }

  function updateCursorPos(): void {
    if (!codeTextarea || !cursorPos) return;
    const textLines = codeTextarea.value.substring(0, codeTextarea.selectionStart).split('\n');
    cursorPos.textContent = `LN ${textLines.length}, COL ${textLines[textLines.length - 1].length + 1}`;
  }

  // --- SHADING MODES ---
  const shadingBtns = document.querySelectorAll('.btn-shading');
  shadingBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      shadingBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const mode = (btn as HTMLElement).dataset.shading as ShadingMode;
      if (viewport && mode) {
        viewport.setShadingMode(mode);
      }
    });
  });

  // --- GLB & ZIP EXPORT ---
  exportGlbBtn?.addEventListener('click', async () => {
    if (!viewport) return;
    const rootObj = viewport.getVisibleObject();
    if (!rootObj) {
      alert('No hay ninguna geometría visible para exportar.');
      return;
    }

    exportGlbBtn.textContent = '⏳ VERIFICANDO GLB...';
    try {
      const filename = currentSpec.name.toLowerCase().replace(/[^a-z0-9]/g, '_') || 'modelcoder_asset';
      const result = await GLBExporterService.exportAndVerifyGLB(rootObj, filename);
      alert(`✅ [ EXPORTACIÓN VERIFICADA ]\nArchivo: ${filename}.glb\nTamaño: ${(result.sizeBytes / 1024).toFixed(1)} KB\nTriángulos: ${result.triangleCount}\nVértices: ${result.vertexCount}`);
    } catch (err: any) {
      alert(`⚠️ Fallo de exportación: ${err.message}`);
    } finally {
      exportGlbBtn.textContent = '💾 EXPORTAR GLB';
    }
  });

  exportZipBtn?.addEventListener('click', async () => {
    exportZipBtn.textContent = '⏳ Empaquetando...';
    try {
      const JSZip = (window as any).JSZip;
      if (!JSZip) throw new Error('JSZip no disponible');

      const zip = new JSZip();
      const familyName = currentSpec.name.toLowerCase().replace(/[^a-z0-9]/g, '_') || 'custom_model';

      const folder = zip.folder(`procedural_assets/generators/${familyName}`);
      folder.file('__init__.py', `from .config import *\nfrom .generator import *\n`);
      folder.file('generator.py', generatePythonFromSpec(currentSpec));
      folder.file('model_spec.json', JSON.stringify(currentSpec, null, 2));
      folder.file('README.md', `# ${currentSpec.name}\n\nGenerador procedural de ModelCoder Studio.\n`);

      const content = await zip.generateAsync({ type: 'blob' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(content);
      a.download = `${familyName}_generator_package.zip`;
      a.click();
    } catch (e: any) {
      alert(`Error al generar ZIP: ${e.message}`);
    } finally {
      exportZipBtn.textContent = '📦 PAQUETE (.ZIP)';
    }
  });

  // Modals & Navigation
  openDocsBtn?.addEventListener('click', () => {
    if (docsModal) docsModal.showModal();
  });
  closeDocsBtn?.addEventListener('click', () => {
    if (docsModal) docsModal.close();
  });

  const docTabs = document.querySelectorAll('.doc-tab');
  const docSections = document.querySelectorAll('.doc-section');
  docTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const targetSec = (tab as HTMLElement).dataset.section;
      docTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      docSections.forEach((s) => s.classList.remove('active'));
      if (targetSec) document.getElementById(targetSec)?.classList.add('active');
    });
  });

  githubPrBtn?.addEventListener('click', () => {
    if (githubModal) githubModal.showModal();
  });
  closeModalBtn?.addEventListener('click', () => {
    if (githubModal) githubModal.close();
  });

  document.getElementById('btn-quick-github-proposal')?.addEventListener('click', () => {
    const title = encodeURIComponent(`[Nuevo Modelo]: ${currentSpec.name}`);
    const body = encodeURIComponent(
      `## Propuesta de Modelo Procedural 3D\n\n` +
      `- **Nombre**: ${currentSpec.name}\n` +
      `- **Categoría**: ${currentSpec.category}\n` +
      `- **Componentes**: ${currentSpec.components.length}\n\n` +
      `### Especificación JSON:\n\`\`\`json\n${JSON.stringify(currentSpec, null, 2)}\n\`\`\`\n`
    );
    window.open(`https://github.com/FrancisCuarto/MODELCODER/issues/new?title=${title}&body=${body}`, '_blank');
  });

  document.getElementById('btn-modal-download-zip')?.addEventListener('click', () => {
    exportZipBtn?.click();
  });

  btnCloseError?.addEventListener('click', () => {
    if (errorBanner) errorBanner.style.display = 'none';
  });

  // Initial Load
  setStudioMode('visual');
  renderCurrentSpec('visual', false);
</script>

