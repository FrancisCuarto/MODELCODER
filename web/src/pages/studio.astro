      'workspace-layout',
      'workspace-modeling',
      'workspace-shading',
      'workspace-render',
      'workspace-code',
      'workspace-ai',
      'mode-visual-active'
    );
    studioWorkspace?.classList.add(`workspace-${ws}`);

    // Hide all mode panels
    document.getElementById('outliner-mode-container')?.classList.remove('active');
    document.getElementById('ai-mode-container')?.classList.remove('active');
    document.getElementById('code-mode-container')?.classList.remove('active');

    // Toggle render studio toolbar
    if (renderStudioControls) {
      renderStudioControls.style.display = (ws === 'render') ? 'flex' : 'none';
    }

    if (ws === 'layout') {
      activeMode = 'visual';
      document.getElementById('outliner-mode-container')?.classList.add('active');
      studioWorkspace?.classList.add('mode-visual-active');
      if (quickAdjustWindow) quickAdjustWindow.style.display = 'none';
      if (viewport) {
        viewport.setGizmoMode('translate');
        updateGizmoButtons('translate');
      }
    } else if (ws === 'modeling') {
      activeMode = 'visual';
      document.getElementById('outliner-mode-container')?.classList.add('active');
      studioWorkspace?.classList.add('mode-visual-active');
      if (quickAdjustWindow) quickAdjustWindow.style.display = 'none';
      if (viewport) {
        viewport.setGizmoMode('translate');
        updateGizmoButtons('translate');
      }
    } else if (ws === 'shading') {
      activeMode = 'visual';
      studioWorkspace?.classList.add('mode-visual-active');
      if (quickAdjustWindow) quickAdjustWindow.style.display = 'none';
      if (viewport) {
        viewport.setGizmoMode('none');
        updateGizmoButtons('none');
      }
    } else if (ws === 'render') {
      activeMode = 'visual';
      if (quickAdjustWindow) quickAdjustWindow.style.display = 'none';
      if (viewport) {
        viewport.setGizmoMode('none');
        updateGizmoButtons('none');
      }
    } else if (ws === 'code') {
      activeMode = 'code';
      document.getElementById('code-mode-container')?.classList.add('active');
      if (quickAdjustWindow) quickAdjustWindow.style.display = 'none';
      if (viewport) viewport.setGizmoMode('none');
      syncEditorFromSpec();
    } else if (ws === 'ai') {
      activeMode = 'ai';
      document.getElementById('ai-mode-container')?.classList.add('active');
      if (quickAdjustWindow) quickAdjustWindow.style.display = 'block';
      if (viewport) viewport.setGizmoMode('none');
    }

    // Reset inline display style so CSS classes control visibility cleanly
    if (visualInspectorContainer) {
      visualInspectorContainer.style.display = '';
    }

    // Force Three.js viewport resize immediately and on next paint frame
    requestAnimationFrame(() => {
      window.dispatchEvent(new Event('resize'));
      if (viewport) viewport.resize();
    });
    setTimeout(() => {
      if (viewport) viewport.resize();
    }, 50);
  }

  // Backward-compatible alias
  function setStudioMode(mode: 'ai' | 'visual' | 'code'): void {
    if (mode === 'visual') setStudioWorkspace('layout');
    else if (mode === 'ai') setStudioWorkspace('ai');
    else if (mode === 'code') setStudioWorkspace('code');
  }

  // --- RENDER PRESENTATION STUDIO CONTROLS ---
  btnRenderTurntable?.addEventListener('click', () => {
    if (!viewport) return;
    const isRotating = viewport.isTurntableEnabled();
    const speed = parseFloat(selectTurntableSpeed?.value || '1.0');
    viewport.setTurntable(!isRotating, speed);
    if (btnRenderTurntable) {
      btnRenderTurntable.textContent = !isRotating ? '⏸ PAUSAR' : '▶ INICIAR';
      btnRenderTurntable.classList.toggle('active', !isRotating);
    }
  });

  selectTurntableSpeed?.addEventListener('change', () => {
    if (!viewport) return;
    const speed = parseFloat(selectTurntableSpeed.value || '1.0');
    if (viewport.isTurntableEnabled()) {
      viewport.setTurntable(true, speed);
    }
  });

  const bgButtons = [btnBgDark, btnBgStudio, btnBgTrans];
  function setBgMode(mode: 'dark' | 'studio' | 'transparent', activeBtn: HTMLElement | null) {
    if (!viewport) return;
    viewport.setBackgroundMode(mode);
    bgButtons.forEach((b) => b?.classList.remove('active'));
    activeBtn?.classList.add('active');
  }

  btnBgDark?.addEventListener('click', () => setBgMode('dark', btnBgDark));
  btnBgStudio?.addEventListener('click', () => setBgMode('studio', btnBgStudio));
  btnBgTrans?.addEventListener('click', () => setBgMode('transparent', btnBgTrans));

  btnCaptureRenderHd?.addEventListener('click', () => {
    if (!viewport) return;
    const name = (currentSpec?.name || 'model').toLowerCase().replace(/\s+/g, '_');
    viewport.captureRenderScreenshot(`${name}_render_hd.png`);
  });

  btnRenderFrameCam?.addEventListener('click', () => {
    if (!viewport) return;
    viewport.resetCameraAndFrame();
  });

  // --- FULLSCREEN BLENDER DCC MODE CONTROLLER ---
  function updateFullscreenBtn(isFs: boolean): void {
    if (!btnToggleFullscreen) return;
    const icon = btnToggleFullscreen.querySelector('.fs-icon');
    const text = btnToggleFullscreen.querySelector('.fs-text');
    if (isFs) {
      btnToggleFullscreen.classList.remove('ps1-ctrl-btn', 'btn-outline');
      btnToggleFullscreen.classList.add('btn-gold');
      if (icon) icon.textContent = '🗗';
      if (text) text.textContent = 'SALIR';
      btnToggleFullscreen.title = 'Salir de Pantalla Completa (ESC / F11)';
    } else {
      btnToggleFullscreen.classList.remove('btn-gold');
      btnToggleFullscreen.classList.add('ps1-ctrl-btn');
      if (icon) icon.textContent = '⛶';
      if (text) text.textContent = 'PANTALLA COMPLETA';
      btnToggleFullscreen.title = 'Alternar Pantalla Completa estilo Blender (F11 / ESC)';
    }
  }

  function toggleStudioFullscreen(): void {
    const isCurrentlyActive = document.body.classList.contains('studio-fullscreen-active');
    const newState = !isCurrentlyActive;

    document.body.classList.toggle('studio-fullscreen-active', newState);
    studioContainer?.classList.toggle('fullscreen-active', newState);
    updateFullscreenBtn(newState);

    if (newState) {
      if (document.documentElement.requestFullscreen && !document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      }
    } else {
      if (document.exitFullscreen && document.fullscreenElement) {
        document.exitFullscreen().catch(() => {});
      }
    }

    setTimeout(() => {
      window.dispatchEvent(new Event('resize'));
      if (viewport) viewport.resize();
    }, 80);
  }

  btnToggleFullscreen?.addEventListener('click', toggleStudioFullscreen);

  document.addEventListener('fullscreenchange', () => {
    if (!document.fullscreenElement && document.body.classList.contains('studio-fullscreen-active')) {
      document.body.classList.remove('studio-fullscreen-active');
      studioContainer?.classList.remove('fullscreen-active');
      updateFullscreenBtn(false);
      setTimeout(() => {
        window.dispatchEvent(new Event('resize'));
        if (viewport) viewport.resize();
      }, 80);
    }
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'F11') {
      e.preventDefault();
      toggleStudioFullscreen();
    } else if (e.key === 'Escape' && document.body.classList.contains('studio-fullscreen-active')) {
      toggleStudioFullscreen();
    }
  });

  // --- RENDER CURRENT SPEC & GEOMETRY ---
  function renderCurrentSpec(
    mode: 'ai' | 'visual' | 'code' = 'visual',
    recordHistory: boolean = true,
    rebuildInspector: boolean = true
  ): void {
    if (!currentSpec || !Array.isArray(currentSpec.components) || currentSpec.components.length === 0) {
      currentSpec = JSON.parse(JSON.stringify(DEFAULT_INITIAL_SPEC));
    }

    try {
      const reqId = `GEN-${Math.random().toString(36).substring(2, 7).toUpperCase()}`;
      generationCounter++;

      // Carga preventiva de texturas locales en entorno de escritorio
      if (isDesktopEnv && currentSpec.components) {
        for (const c of currentSpec.components) {
          if (c.texturePreset?.startsWith('local:') && !TextureLibrary.hasCustomTexture(c.texturePreset)) {
            ensureLocalTextureLoaded(c.texturePreset);
          }
        }
      }

      const { group, stats } = ProceduralEngine.buildModelFromSpec(currentSpec);
      if (viewport) {
        viewport.displayGeneratedMesh(group, reqId, generationCounter, stats, mode, currentSpec.animations);
      } else {
        handleViewportStatsUpdate(stats, {
          id: reqId,
          version: generationCounter,
          timestamp: Date.now(),
          success: true,
          mode,
          stats
        });
        ProceduralEngine.disposeHierarchy(group);
      }

      if (viewportModelName) {
        viewportModelName.textContent = (currentSpec.name || 'MODELO ACTIVO').toUpperCase();
      }

      // Sync active component selection with viewport
      if (selectedComponentIndex !== null && selectedComponentIndex < currentSpec.components.length) {
        viewport?.selectComponent(selectedComponentIndex);
      } else if (currentSpec.components.length > 0) {
        selectedComponentIndex = 0;
        viewport?.selectComponent(0);
      } else {
        selectedComponentIndex = null;
        viewport?.selectComponent(null);
      }

      // Sync outliner, inspector (only when selection/structure changes), code editor, and animation bar
      renderOutliner();
      if (rebuildInspector) {
        renderInspector();
      } else if (selectedComponentIndex !== null && currentSpec.components[selectedComponentIndex]) {
        updateEffectiveDimensions(currentSpec.components[selectedComponentIndex]);
      }
      updateSelectionPill();
      syncEditorFromSpec();
      setLinterValid();
      updateAnimationTimelineBar();

      if (recordHistory) {
        pushHistoryState(currentSpec);
      }
    } catch (err: any) {
      const reqId = `GEN-${Math.random().toString(36).substring(2, 7).toUpperCase()}`;
      const msg = err?.message || String(err);
      if (viewport) {
        viewport.displayError(msg, reqId, generationCounter, mode);
      }
      setLinterError(msg);
      renderOutliner();
      if (rebuildInspector) {
        renderInspector();
      }
    }
  }

  function getComponentDepth(compName: string, visited = new Set<string>()): number {
    if (visited.has(compName)) return 0;
    visited.add(compName);
    const comp = currentSpec.components.find((c) => c.name === compName);
    if (!comp || !comp.parentId) return 0;
    return 1 + getComponentDepth(comp.parentId, visited);
  }

  // --- OUTLINER COMPONENT TREE & DRAG-AND-DROP HIERARCHY ---
  function reparentComponent(childName: string, newParentName: string | undefined): void {
    if (!childName) return;
    if (childName === newParentName) return;

    const childComp = currentSpec.components.find((c) => c.name === childName);
    if (!childComp) return;

    if (newParentName && ProceduralEngine.wouldCreateCycle(currentSpec.components, childName, newParentName)) {
      showStudioToast(`⚠️ No se puede vincular "${childName}" a "${newParentName}": crearía una dependencia circular.`, true);
      renderOutliner();
      return;
    }

    const currentParent = childComp.parentId || undefined;
    if (currentParent === newParentName) return;

    const success = ProceduralEngine.reparentComponentPreservingWorldTransform(
      currentSpec.components,
      childName,
      newParentName
    );

    if (success) {
      if (newParentName) {
        showStudioToast(`🔗 "${childName}" ahora es hijo de "${newParentName}" (posición 3D preservada).`);
      } else {
        showStudioToast(`🔓 "${childName}" desvinculado a nivel raíz (posición 3D preservada).`);
      }
      renderCurrentSpec('visual');
    } else {
      showStudioToast(`⚠️ No se pudo actualizar la jerarquía de "${childName}".`, true);
    }
  }

  function renderOutliner(): void {
    if (!outlinerTreeList) return;
    if (outlinerCountEl) outlinerCountEl.textContent = `${currentSpec.components.length}`;

    outlinerTreeList.innerHTML = '';

    // Root Drop Zone (allows unparenting by dropping here)
    const rootDropzone = document.createElement('div');
    rootDropzone.className = 'outliner-root-dropzone';
    rootDropzone.id = 'outliner-root-dropzone';
    rootDropzone.title = 'Arrastra una pieza aquí para desvincularla a nivel raíz';
    rootDropzone.innerHTML = `<span>⬚ PIEZAS RAÍZ (ARRASTRA AQUÍ PARA DESVINCULAR)</span>`;

    rootDropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
      rootDropzone.classList.add('drag-over');
    });

    rootDropzone.addEventListener('dragleave', () => {
      rootDropzone.classList.remove('drag-over');
    });

    rootDropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      rootDropzone.classList.remove('drag-over');
      const draggedName = e.dataTransfer?.getData('text/plain');
      if (draggedName) {
        reparentComponent(draggedName, undefined);
      }
    });

    outlinerTreeList.appendChild(rootDropzone);

    currentSpec.components.forEach((comp, idx) => {
      const item = document.createElement('div');
      item.className = `outliner-item ${idx === selectedComponentIndex ? 'active' : ''} ${comp.visible === false ? 'is-hidden' : ''}`;
      item.dataset.idx = `${idx}`;
      item.dataset.compName = comp.name;
      item.draggable = true;

      const depth = getComponentDepth(comp.name);
      const isChild = !!comp.parentId;
      if (depth > 0) {
        item.style.paddingLeft = `${0.35 + depth * 0.85}rem`;
        item.style.borderLeft = `3px solid var(--ps1-cyan)`;
      }

      const shapeIcon = getShapeIcon(comp.shape);
      const isVisible = comp.visible !== false;

      item.innerHTML = `
        <div class="outliner-item-main" data-idx="${idx}" title="Seleccionar componente ${isChild ? `(Hijo de ${escapeHtml(comp.parentId!)})` : ''} • Arrastra sobre otra pieza para vincularla">
          <span class="outliner-drag-handle" title="Arrastra para cambiar jerarquía">⋮⋮</span>
          <span class="outliner-idx-tag">#${idx + 1}</span>
          ${isChild ? `<span class="outliner-hierarchy-glyph" title="Hijo de ${escapeHtml(comp.parentId!)}">↳</span>` : ''}
          <span class="outliner-shape-badge" title="Tipo: ${comp.shape}">${shapeIcon} ${comp.shape.toUpperCase()}</span>
          <span class="outliner-name-label">${escapeHtml(comp.name)}</span>
          ${comp.boolean?.enabled ? `<span class="outliner-bool-tag" title="Booleana: ${comp.boolean.operation || 'difference'} con ${escapeHtml(comp.boolean.targetComponent || '')}">✂️</span>` : ''}
          ${comp.array?.enabled ? `<span class="outliner-array-tag" title="Array: ×${comp.array.count || 2}">▦×${comp.array.count || 2}</span>` : ''}
          ${isChild ? `<span class="outliner-parent-tag" title="Vinculado al padre: ${escapeHtml(comp.parentId!)}">@${escapeHtml(comp.parentId!)}</span>` : ''}
        </div>
        <div class="outliner-item-actions">
          <button type="button" class="btn-outliner-vis ps1-ctrl-btn" data-idx="${idx}" title="${isVisible ? 'Ocultar pieza' : 'Mostrar pieza'}">
            ${isVisible ? '👁️' : '🚫'}
          </button>
          <button type="button" class="btn-outliner-dup ps1-ctrl-btn" data-idx="${idx}" title="Duplicar componente">
            📋
          </button>
          <button type="button" class="btn-outliner-del ps1-ctrl-btn" data-idx="${idx}" title="Eliminar componente (Ctrl+X)">
            🗑️
          </button>
        </div>
      `;

      // Drag & Drop event listeners
      item.addEventListener('dragstart', (e) => {
        if (e.dataTransfer) {
          e.dataTransfer.setData('text/plain', comp.name);
          e.dataTransfer.effectAllowed = 'move';
        }
        item.classList.add('is-dragging');
      });

      item.addEventListener('dragend', () => {
        item.classList.remove('is-dragging');
        outlinerTreeList.querySelectorAll('.outliner-item').forEach((el) => {
          el.classList.remove('drop-target-child');
        });
        rootDropzone.classList.remove('drag-over');
      });

      item.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
        const draggedName = e.dataTransfer?.getData('text/plain') || '';
        if (draggedName !== comp.name) {
          item.classList.add('drop-target-child');
        }
      });

      item.addEventListener('dragleave', () => {
        item.classList.remove('drop-target-child');
      });

      item.addEventListener('drop', (e) => {
        e.preventDefault();
        item.classList.remove('drop-target-child');
        const draggedName = e.dataTransfer?.getData('text/plain');
        if (draggedName && draggedName !== comp.name) {
          reparentComponent(draggedName, comp.name);
        }
      });

      outlinerTreeList.appendChild(item);
    });

    // Wire Outliner selection & actions
    outlinerTreeList.querySelectorAll('.outliner-item-main').forEach((el) => {
      el.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).dataset.idx || '0', 10);
        selectComponent(idx);
      });
    });

    outlinerTreeList.querySelectorAll('.btn-outliner-vis').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt((e.currentTarget as HTMLElement).dataset.idx || '0', 10);
        toggleComponentVisibility(idx);
      });
    });

    outlinerTreeList.querySelectorAll('.btn-outliner-dup').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt((e.currentTarget as HTMLElement).dataset.idx || '0', 10);
        duplicateComponent(idx);
      });
    });

    outlinerTreeList.querySelectorAll('.btn-outliner-del').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt((e.currentTarget as HTMLElement).dataset.idx || '0', 10);
        deleteComponent(idx);
      });
    });
  }

  function selectComponent(idx: number): void {
    if (idx < 0 || idx >= currentSpec.components.length) {
      selectedComponentIndex = null;
    } else {
      selectedComponentIndex = idx;
    }

    if (viewport) {
      viewport.selectComponent(selectedComponentIndex);
    }
    renderOutliner();
    renderInspector();
    updateSelectionPill();
  }

  function toggleComponentVisibility(idx: number): void {
    const comp = currentSpec.components[idx];
    if (!comp) return;
    comp.visible = comp.visible === false ? true : false;
    renderCurrentSpec('visual');
  }

  function duplicateComponent(idx: number): void {
    const orig = currentSpec.components[idx];
    if (!orig) return;

    const copy: ComponentDef = JSON.parse(JSON.stringify(orig));
    copy.name = `${orig.name}_copia`;
    if (!copy.position) copy.position = [0, 0, 0];
    copy.position[0] += 0.25;
    copy.position[2] += 0.25;

    currentSpec.components.splice(idx + 1, 0, copy);
    selectedComponentIndex = idx + 1;
    renderCurrentSpec('visual');
  }

  function mirrorComponent(idx: number, axis: 'x' | 'y' | 'z' = 'x'): void {
    const orig = currentSpec.components[idx];
    if (!orig) return;

    let baseName = orig.name;
    let mirroredName: string;
    if (axis === 'x' && baseName.includes('_izq')) {
      mirroredName = baseName.replace('_izq', '_der');
    } else if (axis === 'x' && baseName.includes('_der')) {
      mirroredName = baseName.replace('_der', '_izq');
    } else if (axis === 'x' && baseName.includes('_left')) {
      mirroredName = baseName.replace('_left', '_right');
    } else if (axis === 'x' && baseName.includes('_right')) {
      mirroredName = baseName.replace('_right', '_left');
    } else {
      mirroredName = `${baseName}_espejo_${axis}`;
    }

    // Ensure unique name
    if (currentSpec.components.some((c) => c.name === mirroredName)) {
      mirroredName = `${mirroredName}_${Date.now().toString().slice(-4)}`;
    }

    const mirrored = ProceduralEngine.createMirroredComponent(orig, axis, mirroredName);
    currentSpec.components.splice(idx + 1, 0, mirrored);
    selectedComponentIndex = idx + 1;
    renderCurrentSpec('visual');
  }

  function deleteComponent(idx: number): void {
    if (currentSpec.components.length <= 1) {
      alert('El modelo debe contener al menos un componente geométrico.');
      return;
    }
    const name = currentSpec.components[idx]?.name || 'pieza';
    if (!confirm(`¿Eliminar componente "${name}"?`)) return;

    currentSpec.components.splice(idx, 1);
    // Promote any child components of the deleted component to root level
    currentSpec.components.forEach((c) => {
      if (c.parentId === name) {
        delete c.parentId;
      }
    });

    if (selectedComponentIndex !== null) {
      if (selectedComponentIndex >= currentSpec.components.length) {
        selectedComponentIndex = currentSpec.components.length - 1;
      }
    }
    renderCurrentSpec('visual');
  }

  // --- ADD PRIMITIVE BUTTONS ---
  document.querySelectorAll('.btn-primitive').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const shape = (e.currentTarget as HTMLElement).dataset.shape as ShapePrimitive;
      if (!shape) return;
      addPrimitiveComponent(shape);
    });
  });

