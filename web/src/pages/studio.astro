  // Easing Profiles Handlers
  const applyEasingToCustomTrack = (profile: EasingProfileType) => {
    const dur = parseFloat(customAnimDurationInput?.value || '2.0') || 2.0;
    if (customKeyframeList.length < 2) {
      initDefaultCustomKeyframes();
    }
    const sorted = [...customKeyframeList].sort((a, b) => a.time - b.time);
    const startVal = sorted[0].val;
    const endVal = sorted[sorted.length - 1].val;

    const generated = AnimationEngine.applyEasingProfile(profile, dur, startVal, endVal);
    customKeyframeList = generated.map((g) => ({
      time: g.time,
      val: [g.value[0], g.value[1], g.value[2]]
    }));

    if (customAnimInterpSelect) {
      customAnimInterpSelect.value = generated[0]?.interpolation || 'linear';
    }

    renderCustomKeyframeTable();

    const labels: Record<EasingProfileType, string> = {
      'ease-in-out': '🌊 Perfil Suave (Ease-In-Out) aplicado',
      'bounce': '🏀 Perfil Rebote Mecánico con Overshoot (+18%) aplicado',
      'ease-out': '⚡ Perfil Impacto Seco (Ease-Out) aplicado',
      'linear': '📏 Perfil Lineal Constante aplicado',
      'step': '🤖 Perfil Robótico Discreto (Step) aplicado'
    };
    showStudioToast(labels[profile] || 'Curva aplicada');
  };

