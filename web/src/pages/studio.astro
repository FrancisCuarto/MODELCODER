                  <button type="button" class="mat-cat-pill" data-mat-cat="variants">🎨 Variantes</button>
                </div>
              </div>
              <div id="mat-browser-grid" class="mat-browser-grid" role="listbox" aria-label="Explorador visual de materiales">
                <!-- Populated dynamically with lazy WebP thumbnails -->
              </div>
            </div>
          </div>
        </div>
      </div>
    `;

    updateEffectiveDimensions(comp);
    wireInspectorEventListeners(comp);
  }

  function renderTextureSelectOptionsHTML(selectedPreset?: string): string {
    const categories = Object.keys(MATERIAL_CATEGORY_LABELS) as MaterialFamilyCategory[];
    let html = '';

    for (const cat of categories) {
      const meta = MATERIAL_CATEGORY_LABELS[cat];
      const profiles = TextureLibrary.getProfilesByCategory(cat);
      html += `<optgroup label="${meta.icon} ${meta.label} (${profiles.length})">`;
      for (const p of profiles) {
        const sel = selectedPreset === p.name ? 'selected' : '';
        html += `<option value="${p.name}" ${sel}>${p.label} (${p.name})</option>`;
      }
      html += `</optgroup>`;
    }

    const variants = Object.values(TextureLibrary.PARAMETRIC_VARIANTS);
    if (variants.length > 0) {
      html += `<optgroup label="🎨 Variantes Paramétricas Curadas (${variants.length})">`;
      for (const v of variants) {
        const sel = selectedPreset === v.id ? 'selected' : '';
        html += `<option value="${v.id}" ${sel}>${v.label} (${v.id})</option>`;
      }
      html += `</optgroup>`;
    }

    return html;
  }

