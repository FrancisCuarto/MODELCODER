<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<script>
  import { ProceduralEngine } from '../lib/studio/procedural-engine';
  import { CodeSandbox } from '../lib/studio/code-sandbox';
  import { AIGenerator } from '../lib/studio/ai-generator';
  import { GLBExporterService } from '../lib/studio/glb-exporter';
  import { StudioViewport } from '../lib/studio/three-viewport';
  import { TextureLibrary } from '../lib/studio/texture-library';
  import type { ModelSpec, ComponentDef, GeometricStats, GenerationResult, ShadingMode, ShapePrimitive, TransformGizmoMode, CameraViewPreset } from '../lib/studio/types';

  // State Management
  let generationCounter = 1;
  let activeMode: 'ai' | 'visual' | 'code' = 'visual';
  let activeFile: 'spec' | 'script' | 'generator_py' = 'spec';
  let selectedComponentIndex: number | null = 0;
  let isUniformScaleLocked = true;
  let isGridSnapEnabled = false;

  // History Stack (Undo / Redo)
  const historyStack: ModelSpec[] = [];
  let historyIndex = -1;

  // Default Initial Model (Authentic Industrial Cargo Crate)
  let currentSpec: ModelSpec = {
    id: 'below_nominal.furniture.crate',
    name: 'Cargo Crate',
    category: 'furniture',
    description: 'Contenedor de carga modular presurizado procedural.',
    units: 'meters',
    dimensions: { width: 1.0, depth: 1.0, height: 1.0 },
    palette: 'industrial_hazard',
    components: [
      {
        name: 'crate_hull',
        shape: 'box',
        size: [1.0, 0.85, 1.0],
        position: [0, 0.425, 0],
        rotation: [0, 0, 0],
        scale: [1, 1, 1],
        color: '#4a5568',
        texturePreset: 'worn_metal',
        roughness: 0.68,
        metalness: 0.35
      },
      {
        name: 'reinforced_band',
        shape: 'box',
        size: [1.04, 0.12, 1.04],
        position: [0, 0.425, 0],
        rotation: [0, 0, 0],
        scale: [1, 1, 1],
        color: '#2d3748',
        texturePreset: 'metal_dark_grime',
        roughness: 0.70,
        metalness: 0.38
      },
      {
        name: 'hazard_stripe',
        shape: 'box',
        size: [0.96, 0.08, 1.02],
        position: [0, 0.65, 0],
        rotation: [0, 0, 0],
        scale: [1, 1, 1],
        color: '#ffffff',
        texturePreset: 'hazard_stripes',
        roughness: 0.70,
        metalness: 0.05
      },
      {
        name: 'id_stencil',
        shape: 'box',
        size: [0.4, 0.12, 0.02],
        position: [0, 0.425, 0.51],
        rotation: [0, 0, 0],
        scale: [1, 1, 1],
        color: '#edf2f7',
        texturePreset: 'caution_label',
        label: 'CARGO-77'
      }
    ]
  };

  // Push Initial Spec to History
  pushHistoryState(currentSpec);

  // DOM Elements
  const studioWorkspace = document.getElementById('studio-workspace') as HTMLElement;
  const threeMountEl = document.getElementById('three-canvas-mount') as HTMLElement;
  const viewportModelName = document.getElementById('viewport-model-name');
  const hudGenId = document.getElementById('hud-gen-id');
  const hudTris = document.getElementById('hud-tris');
  const hudVerts = document.getElementById('hud-verts');
  const hudDims = document.getElementById('hud-dims');
  const statusBadge = document.getElementById('viewport-status-badge');
  const statusBadgeText = document.getElementById('status-badge-text');
  const errorBanner = document.getElementById('viewport-error-banner');
  const errorBannerBody = document.getElementById('error-banner-body');
  const btnCloseError = document.getElementById('btn-close-error');
  const viewportSelectionPill = document.getElementById('viewport-selection-pill');
  const viewportSelectionLabel = document.getElementById('viewport-selection-label');

  const codeTextarea = document.getElementById('code-textarea') as HTMLTextAreaElement;
  const lineNumbers = document.getElementById('line-numbers');
  const cursorPos = document.getElementById('cursor-pos');
  const activeFilenameEl = document.getElementById('active-filename');
  const linterBadge = document.getElementById('linter-badge');
  const linterText = document.getElementById('linter-text');

  const runCompileBtn = document.getElementById('run-compile-btn');
  const exportGlbBtn = document.getElementById('export-glb-btn');
  const exportZipBtn = document.getElementById('export-zip-btn');
  const openDocsBtn = document.getElementById('open-docs-btn');
  const githubPrBtn = document.getElementById('github-pr-btn');
  const docsModal = document.getElementById('docs-modal') as HTMLDialogElement;
  const closeDocsBtn = document.getElementById('close-docs-btn');
  const githubModal = document.getElementById('github-modal') as HTMLDialogElement;
  const closeModalBtn = document.getElementById('close-modal-btn');

  // AI Elements & Engine Selector
  const aiEngineBadge = document.getElementById('ai-engine-badge');
  const btnEngineAi = document.getElementById('btn-engine-ai') as HTMLButtonElement;
  const btnEngineLocal = document.getElementById('btn-engine-local') as HTMLButtonElement;
  const aiPromptInput = document.getElementById('ai-prompt-input') as HTMLInputElement;
  const generateAiBtn = document.getElementById('generate-ai-btn') as HTMLButtonElement;
  const aiLoadingStatus = document.getElementById('ai-loading-status');
  const geminiKeyDrawer = document.getElementById('gemini-key-drawer');
  const toggleGeminiKeyBtn = document.getElementById('toggle-gemini-key-btn');
  const saveGeminiKeyBtn = document.getElementById('save-gemini-key-btn');
  const geminiApiKeyInput = document.getElementById('gemini-api-key-input') as HTMLInputElement;
  const aiChips = document.querySelectorAll('.ai-chip');

  // Outliner & Inspector Containers
  const outlinerTreeList = document.getElementById('outliner-tree-list');
  const outlinerCountEl = document.getElementById('outliner-count');
  const inspectorContentMount = document.getElementById('inspector-content-mount');
  const inspectorCompBadge = document.getElementById('inspector-comp-badge');
  const quickAdjustWindow = document.getElementById('quick-adjust-window');
  const visualInspectorContainer = document.getElementById('visual-inspector-container');

  // Undo / Redo Buttons
  const btnTopbarUndo = document.getElementById('btn-topbar-undo') as HTMLButtonElement;
  const btnTopbarRedo = document.getElementById('btn-topbar-redo') as HTMLButtonElement;
  const btnOutlinerUndo = document.getElementById('btn-outliner-undo') as HTMLButtonElement;
  const btnOutlinerRedo = document.getElementById('btn-outliner-redo') as HTMLButtonElement;

  // Viewport Gizmo & View Buttons
  const gizmoBtnSelect = document.getElementById('gizmo-btn-select');
  const gizmoBtnTranslate = document.getElementById('gizmo-btn-translate');
  const gizmoBtnRotate = document.getElementById('gizmo-btn-rotate');
  const gizmoBtnScale = document.getElementById('gizmo-btn-scale');
  const gizmoBtnSnap = document.getElementById('gizmo-btn-snap');
  const btnFocusSelected = document.getElementById('btn-focus-selected');
  const btnToggleGrid = document.getElementById('btn-toggle-grid');
  const btnToggleAxes = document.getElementById('btn-toggle-axes');

  // Global Scale & Surface sliders (for quick adjust window)
  const paramGlobalScale = document.getElementById('param-global-scale') as HTMLInputElement;
  const paramGlobalScaleVal = document.getElementById('param-global-scale-val');
  const paramRoughness = document.getElementById('param-roughness') as HTMLInputElement;
  const paramRoughnessVal = document.getElementById('param-roughness-val');
  const paramMetalness = document.getElementById('param-metalness') as HTMLInputElement;
  const paramMetalnessVal = document.getElementById('param-metalness-val');

  // Initialize Three.js Viewport
  let viewport: StudioViewport;
  if (threeMountEl) {
    viewport = new StudioViewport(
      threeMountEl,
      handleViewportStatsUpdate,
      handleViewportComponentSelect,
      handleViewportGizmoTransform
    );
    document.getElementById('studio-reset-cam')?.addEventListener('click', () => {
      viewport.resetCameraAndFrame();
    });
  }

  function handleViewportStatsUpdate(stats: GeometricStats | null, result: GenerationResult | null) {
    if (stats) {
      if (hudTris) hudTris.textContent = `${stats.triangles.toLocaleString()} tris`;
      if (hudVerts) hudVerts.textContent = `${stats.vertices.toLocaleString()} verts`;
      if (hudDims) hudDims.textContent = `X: ${stats.dimensions.x}m | Y: ${stats.dimensions.y}m | Z: ${stats.dimensions.z}m`;
    }

    if (result) {
      if (hudGenId) hudGenId.textContent = `${result.id} v${result.version}`;
      if (statusBadge && statusBadgeText) {
        if (result.success) {
          statusBadge.className = 'generation-status-badge status-completed';
          statusBadgeText.textContent = 'COMPLETADO';
          if (errorBanner) errorBanner.style.display = 'none';
        } else {
          statusBadge.className = 'generation-status-badge status-error';
          statusBadgeText.textContent = 'ERROR';
          if (errorBanner && errorBannerBody) {
            errorBanner.style.display = 'block';
            errorBannerBody.textContent = result.error || 'Error desconocido';
          }
        }
      }
    }
  }

  function handleViewportComponentSelect(index: number | null): void {
    selectedComponentIndex = index;
    renderOutliner();
    renderInspector();
    updateSelectionPill();
  }

  function handleViewportGizmoTransform(
    index: number,
    pos: [number, number, number],
    rot: [number, number, number],
    scale: [number, number, number]
  ): void {
    const comp = currentSpec.components[index];
    if (!comp) return;

    comp.position = pos;
    comp.rotation = rot;
    comp.scale = scale;

    // Update inspector numeric inputs in real time without tearing down scene
    updateTransformInspectorInputs(pos, rot, scale);
    updateEffectiveDimensions(comp);
  }

  // --- HISTORY MANAGEMENT (UNDO / REDO) ---
  function pushHistoryState(spec: ModelSpec): void {
    const snapshot: ModelSpec = JSON.parse(JSON.stringify(spec));
    if (historyIndex < historyStack.length - 1) {
      historyStack.splice(historyIndex + 1);
    }
    historyStack.push(snapshot);
    if (historyStack.length > 50) {
      historyStack.shift();
    }
    historyIndex = historyStack.length - 1;
    updateHistoryButtons();
  }

  function undo(): void {
    if (historyIndex > 0) {
      historyIndex--;
      currentSpec = JSON.parse(JSON.stringify(historyStack[historyIndex]));
      if (selectedComponentIndex !== null && selectedComponentIndex >= currentSpec.components.length) {
        selectedComponentIndex = currentSpec.components.length - 1;
      }
      renderCurrentSpec('visual', false);
      updateHistoryButtons();
    }
  }

  function redo(): void {
    if (historyIndex < historyStack.length - 1) {
      historyIndex++;
      currentSpec = JSON.parse(JSON.stringify(historyStack[historyIndex]));
      if (selectedComponentIndex !== null && selectedComponentIndex >= currentSpec.components.length) {
        selectedComponentIndex = currentSpec.components.length - 1;
      }
      renderCurrentSpec('visual', false);
      updateHistoryButtons();
    }
  }

  function updateHistoryButtons(): void {
    const canUndo = historyIndex > 0;
    const canRedo = historyIndex < historyStack.length - 1;

    if (btnTopbarUndo) btnTopbarUndo.disabled = !canUndo;
    if (btnTopbarRedo) btnTopbarRedo.disabled = !canRedo;
    if (btnOutlinerUndo) btnOutlinerUndo.disabled = !canUndo;
    if (btnOutlinerRedo) btnOutlinerRedo.disabled = !canRedo;
  }

  btnTopbarUndo?.addEventListener('click', () => undo());
  btnTopbarRedo?.addEventListener('click', () => redo());
  btnOutlinerUndo?.addEventListener('click', () => undo());
  btnOutlinerRedo?.addEventListener('click', () => redo());

  // --- ENGINE SELECTION (AI vs LOCAL) ---
  let currentEngine: 'ai' | 'local' = (localStorage.getItem('modelcoder_selected_engine') as any) || 'local';

  function setEngineMode(engine: 'ai' | 'local'): void {
    currentEngine = engine;
    localStorage.setItem('modelcoder_selected_engine', engine);

    if (engine === 'ai') {
      btnEngineAi?.classList.add('active');
      btnEngineLocal?.classList.remove('active');
      if (aiPromptInput) {
        aiPromptInput.placeholder = '⚡ Describe lo que quieras: la IA inventará un diseño 3D 100% nuevo y original...';
      }
      const savedKey = localStorage.getItem('modelcoder_gemini_key');
      if (!savedKey || savedKey.trim().length <= 10) {
        if (geminiKeyDrawer) geminiKeyDrawer.style.display = 'block';
        geminiApiKeyInput?.focus();
      }
    } else {
      btnEngineLocal?.classList.add('active');
      btnEngineAi?.classList.remove('active');
      if (aiPromptInput) {
        aiPromptInput.placeholder = 'ej. auto deportivo rojo con ruedas / caza espacial con alas / robot mech / tarjeta de acceso';
      }
    }
    updateAIEngineBadge();
  }

  btnEngineAi?.addEventListener('click', () => setEngineMode('ai'));
  btnEngineLocal?.addEventListener('click', () => setEngineMode('local'));

  function updateAIEngineBadge(): void {
    const key = localStorage.getItem('modelcoder_gemini_key');
    if (aiEngineBadge) {
      if (currentEngine === 'ai') {
        if (key && key.trim().length > 10) {
          aiEngineBadge.textContent = '⚡ IA GEMINI (SIEMPRE NUEVO / SIN CACHÉ)';
          aiEngineBadge.style.borderColor = 'var(--ps1-gold)';
          aiEngineBadge.style.color = 'var(--ps1-gold)';
        } else {
          aiEngineBadge.textContent = '⚡ IA GEMINI (INGRESA TU CLAVE)';
          aiEngineBadge.style.borderColor = 'var(--ps1-gold)';
          aiEngineBadge.style.color = 'var(--ps1-gold)';
        }
      } else {
        aiEngineBadge.textContent = '🤖 MOTOR PROCEDURAL LOCAL';
        aiEngineBadge.style.borderColor = 'var(--ps1-cyan)';
        aiEngineBadge.style.color = 'var(--ps1-cyan)';
      }
    }
  }

  setEngineMode(currentEngine);

  // --- WORKSPACE MODE SWITCHER (AI / VISUAL / CODE) ---
  const modeTabs = document.querySelectorAll('.btn-mode-tab');
  const modePanels = document.querySelectorAll('.mode-panel');

  modeTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const mode = (tab as HTMLElement).dataset.mode as 'ai' | 'visual' | 'code';
      if (!mode) return;
      setStudioMode(mode);
    });
  });

  function setStudioMode(mode: 'ai' | 'visual' | 'code'): void {
    activeMode = mode;
    modeTabs.forEach((t) => t.classList.remove('active'));
    document.querySelector(`.btn-mode-tab[data-mode="${mode}"]`)?.classList.add('active');

    modePanels.forEach((p) => p.classList.remove('active'));

    if (mode === 'visual') {
      document.getElementById('outliner-mode-container')?.classList.add('active');
      studioWorkspace?.classList.add('mode-visual-active');
      if (visualInspectorContainer) visualInspectorContainer.style.display = 'block';
      if (quickAdjustWindow) quickAdjustWindow.style.display = 'none';
      if (viewport) {
        viewport.setGizmoMode('translate');
        updateGizmoButtons('translate');
      }
    } else if (mode === 'ai') {
      document.getElementById('ai-mode-container')?.classList.add('active');
      studioWorkspace?.classList.remove('mode-visual-active');
      if (visualInspectorContainer) visualInspectorContainer.style.display = 'none';
      if (quickAdjustWindow) quickAdjustWindow.style.display = 'block';
      if (viewport) viewport.setGizmoMode('none');
    } else if (mode === 'code') {
      document.getElementById('code-mode-container')?.classList.add('active');
      studioWorkspace?.classList.remove('mode-visual-active');
      if (visualInspectorContainer) visualInspectorContainer.style.display = 'none';
      if (quickAdjustWindow) quickAdjustWindow.style.display = 'none';
      if (viewport) viewport.setGizmoMode('none');
      syncEditorFromSpec();
    }

    // Force Three.js viewport resize
    setTimeout(() => {
      window.dispatchEvent(new Event('resize'));
    }, 50);
  }

  // --- RENDER CURRENT SPEC & GEOMETRY ---
  function renderCurrentSpec(mode: 'ai' | 'visual' | 'code' = 'visual', recordHistory: boolean = true): void {
    if (!viewport) return;

    try {
      const reqId = `GEN-${Math.random().toString(36).substring(2, 7).toUpperCase()}`;
      generationCounter++;

      const { group, stats } = ProceduralEngine.buildModelFromSpec(currentSpec);
      viewport.displayGeneratedMesh(group, reqId, generationCounter, stats, mode);

      if (viewportModelName) {
        viewportModelName.textContent = currentSpec.name.toUpperCase();
      }

      // Sync active component selection with viewport
      if (selectedComponentIndex !== null && selectedComponentIndex < currentSpec.components.length) {
        viewport.selectComponent(selectedComponentIndex);
      } else if (currentSpec.components.length > 0) {
        selectedComponentIndex = 0;
        viewport.selectComponent(0);
      } else {
        selectedComponentIndex = null;
        viewport.selectComponent(null);
      }

      // Sync outliner, inspector, code editor
      renderOutliner();
      renderInspector();
      updateSelectionPill();
      syncEditorFromSpec();
      setLinterValid();

      if (recordHistory) {
        pushHistoryState(currentSpec);
      }
    } catch (err: any) {
      const reqId = `GEN-${Math.random().toString(36).substring(2, 7).toUpperCase()}`;
      viewport.displayError(err.message, reqId, generationCounter, mode);
      setLinterError(err.message);
    }
  }

  // --- OUTLINER COMPONENT TREE ---
  function renderOutliner(): void {
    if (!outlinerTreeList) return;
    if (outlinerCountEl) outlinerCountEl.textContent = `${currentSpec.components.length}`;

    outlinerTreeList.innerHTML = '';

    currentSpec.components.forEach((comp, idx) => {
      const item = document.createElement('div');
      item.className = `outliner-item ${idx === selectedComponentIndex ? 'active' : ''} ${comp.visible === false ? 'is-hidden' : ''}`;
      item.dataset.idx = `${idx}`;

      const shapeIcon = getShapeIcon(comp.shape);
      const isVisible = comp.visible !== false;

      item.innerHTML = `
        <div class="outliner-item-main" data-idx="${idx}" title="Seleccionar componente">
          <span class="outliner-idx-tag">#${idx + 1}</span>
          <span class="outliner-shape-badge" title="Tipo: ${comp.shape}">${shapeIcon} ${comp.shape.toUpperCase()}</span>
          <span class="outliner-name-label">${escapeHtml(comp.name)}</span>
        </div>
        <div class="outliner-item-actions">
          <button type="button" class="btn-outliner-vis ps1-ctrl-btn" data-idx="${idx}" title="${isVisible ? 'Ocultar pieza' : 'Mostrar pieza'}">
            ${isVisible ? '👁️' : '🚫'}
          </button>
          <button type="button" class="btn-outliner-dup ps1-ctrl-btn" data-idx="${idx}" title="Duplicar componente">
            📋
          </button>
          <button type="button" class="btn-outliner-del ps1-ctrl-btn" data-idx="${idx}" title="Eliminar componente">
            🗑️
          </button>
        </div>
      `;

      outlinerTreeList.appendChild(item);
    });

    // Wire Outliner selection & actions
    outlinerTreeList.querySelectorAll('.outliner-item-main').forEach((el) => {
      el.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).dataset.idx || '0', 10);
        selectComponent(idx);
      });
    });

    outlinerTreeList.querySelectorAll('.btn-outliner-vis').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt((e.currentTarget as HTMLElement).dataset.idx || '0', 10);
        toggleComponentVisibility(idx);
      });
    });

    outlinerTreeList.querySelectorAll('.btn-outliner-dup').forEach((el) => {
      e.stopPropagation();
      const idx = parseInt((e.currentTarget as HTMLElement).dataset.idx || '0', 10);
      duplicateComponent(idx);
    });

    outlinerTreeList.querySelectorAll('.btn-outliner-del').forEach((el) => {
      e.stopPropagation();
      const idx = parseInt((e.currentTarget as HTMLElement).dataset.idx || '0', 10);
      deleteComponent(idx);
    });
  }

  function selectComponent(idx: number): void {
    if (idx < 0 || idx >= currentSpec.components.length) {
      selectedComponentIndex = null;
    } else {
      selectedComponentIndex = idx;
    }

    if (viewport) {
      viewport.selectComponent(selectedComponentIndex);
    }
    renderOutliner();
    renderInspector();
    updateSelectionPill();
  }

  function toggleComponentVisibility(idx: number): void {
    const comp = currentSpec.components[idx];
    if (!comp) return;
    comp.visible = comp.visible === false ? true : false;
    renderCurrentSpec('visual');
  }

  function duplicateComponent(idx: number): void {
    const orig = currentSpec.components[idx];
    if (!orig) return;

    const copy: ComponentDef = JSON.parse(JSON.stringify(orig));
    copy.name = `${orig.name}_copia`;
    if (!copy.position) copy.position = [0, 0, 0];
    copy.position[0] += 0.25;
    copy.position[2] += 0.25;

    currentSpec.components.splice(idx + 1, 0, copy);
    selectedComponentIndex = idx + 1;
    renderCurrentSpec('visual');
  }

  function deleteComponent(idx: number): void {
    if (currentSpec.components.length <= 1) {
      alert('El modelo debe contener al menos un componente geométrico.');
      return;
    }
    const name = currentSpec.components[idx]?.name || 'pieza';
    if (!confirm(`¿Eliminar componente "${name}"?`)) return;

    currentSpec.components.splice(idx, 1);
    if (selectedComponentIndex !== null) {
      if (selectedComponentIndex >= currentSpec.components.length) {
        selectedComponentIndex = currentSpec.components.length - 1;
      }
    }
    renderCurrentSpec('visual');
  }

  // --- ADD PRIMITIVE BUTTONS ---
  document.querySelectorAll('.btn-primitive').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const shape = (e.currentTarget as HTMLElement).dataset.shape as ShapePrimitive;
      if (!shape) return;
      addPrimitiveComponent(shape);
    });
  });

  function addPrimitiveComponent(shape: ShapePrimitive): void {
    const count = currentSpec.components.length + 1;
    let newComp: ComponentDef;

    switch (shape) {
      case 'box':
        newComp = {
          name: `cubo_${count}`,
          shape: 'box',
          size: [1.0, 1.0, 1.0],
          position: [0, 0.5, 0],
          rotation: [0, 0, 0],
          scale: [1, 1, 1],
          color: '#4a5568',
          roughness: 0.75,
          metalness: 0.25
        };
        break;
      case 'cylinder':
        newComp = {
          name: `cilindro_${count}`,
          shape: 'cylinder',
          size: [0.35, 0.35, 1.0, 8],
          position: [0, 0.5, 0],
          rotation: [0, 0, 0],
          scale: [1, 1, 1],
          color: '#2d3748',
          roughness: 0.70,
          metalness: 0.35
        };
        break;
      case 'sphere':
        newComp = {
          name: `esfera_${count}`,
          shape: 'sphere',
          size: [0.5, 8, 6],
          position: [0, 0.5, 0],
          rotation: [0, 0, 0],
          scale: [1, 1, 1],
          color: '#e53e3e',
          roughness: 0.60,
          metalness: 0.20
        };
        break;
      case 'wedge':
        newComp = {
          name: `cuña_${count}`,
          shape: 'wedge',
          size: [1.0, 0.8, 0.8],
          position: [0, 0.4, 0],
          rotation: [0, 0, 0],
          scale: [1, 1, 1],
          color: '#d69e2e',
          roughness: 0.75,
          metalness: 0.15
        };
        break;
      case 'cone':
        newComp = {
          name: `cono_${count}`,
          shape: 'cone',
          size: [0.4, 1.0, 8],
          position: [0, 0.5, 0],
          rotation: [0, 0, 0],
          scale: [1, 1, 1],
          color: '#dd6b20',
          roughness: 0.65,
          metalness: 0.25
        };
        break;
      case 'torus':
        newComp = {
          name: `toro_${count}`,
          shape: 'torus',
          size: [0.5, 0.15, 6, 12],
          position: [0, 0.2, 0],
          rotation: [0, 0, 0],
          scale: [1, 1, 1],
          color: '#319795',
          roughness: 0.60,
          metalness: 0.40
        };
        break;
      case 'capsule':
        newComp = {
          name: `capsula_${count}`,
          shape: 'capsule',
          size: [0.25, 0.5, 4, 8],
          position: [0, 0.5, 0],
          rotation: [0, 0, 0],
          scale: [1, 1, 1],
          color: '#3182ce',
          roughness: 0.65,
          metalness: 0.30
        };
        break;
      case 'plane':
        newComp = {
          name: `plano_${count}`,
          shape: 'plane',
          size: [1.0, 1.0],
          position: [0, 0.01, 0],
          rotation: [-90, 0, 0],
          scale: [1, 1, 1],
          color: '#718096',
          roughness: 0.90,
          metalness: 0.10
        };
        break;
    }

    currentSpec.components.push(newComp);
    selectedComponentIndex = currentSpec.components.length - 1;
    renderCurrentSpec('visual');
  }

  // --- PROPERTIES INSPECTOR PANEL ---
  function renderInspector(): void {
    if (!inspectorContentMount) return;

    if (selectedComponentIndex === null || !currentSpec.components[selectedComponentIndex]) {
