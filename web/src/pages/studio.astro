`,
      config: `from dataclasses import dataclass
from ...core.base_config import BaseAssetConfig

@dataclass
class MiPropConfig(BaseAssetConfig):
    width: float = 1.0
    length: float = 1.0
    height: float = 1.0
    wear_level: float = 0.5
    palette_name: str = "industrial_hazard"
`,
      manifest: `{
  "$schema": "https://raw.githubusercontent.com/FrancisCuarto/MODELCODER/main/schemas/generator-v1.json",
  "id": "below_nominal.furniture.mi_prop",
  "version": "1.0.0",
