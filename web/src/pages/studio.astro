  btnDownloadStoryVideo?.addEventListener('click', async () => {
    if (!storyPreviewCanvas || !viewport) return;
    const originalText = btnDownloadStoryVideo.textContent;
    btnDownloadStoryVideo.disabled = true;
    btnDownloadStoryVideo.textContent = '🔴 REEL 0%';

    const cleanName = (storyInputTitle?.value.trim() || currentSpec.name || 'modelo')
      .toLowerCase().replace(/[^a-z0-9]/g, '_');
    const suffix = activeSocialFormat === 'post' ? 'post_reel' : 'story_reel';
    const filename = `${cleanName}_${suffix}.webm`;

    showStudioToast(`🎬 Grabando Reel animado (${activeSocialFormat === 'post' ? '1:1' : '9:16'})...`);

    const activeObj = viewport.getVisibleObject();
    const clipInfo = viewport.getActiveClipInfo();
    const hasAnimation = Boolean(clipInfo && clipInfo.duration > 0 && clipInfo.name);
    const targetDuration = hasAnimation ? Math.max(1.0, clipInfo!.duration) : 3.0; // Duración del clip o 3s de rotación 360°
    const initialRotY = activeObj ? activeObj.rotation.y : 0;
    const initialAnimTime = clipInfo ? clipInfo.time : 0;

    try {
      const fps = 30;
      const stream = (storyPreviewCanvas as any).captureStream(fps);

      let mimeType = 'video/webm;codecs=vp9';
      if (!MediaRecorder.isTypeSupported(mimeType)) mimeType = 'video/webm;codecs=vp8';
      if (!MediaRecorder.isTypeSupported(mimeType)) mimeType = 'video/webm';

      const recorder = new MediaRecorder(stream, { mimeType, videoBitsPerSecond: 6_000_000 });
      const chunks: BlobPart[] = [];
      recorder.ondataavailable = (e) => {
        if (e.data && e.data.size > 0) chunks.push(e.data);
      };

      await new Promise<void>((resolve, reject) => {
        recorder.onstop = () => resolve();
        recorder.onerror = (e) => reject(e);

        recorder.start();
        const startTime = performance.now();
        const totalMs = targetDuration * 1000;

        const intervalId = setInterval(async () => {
          const elapsed = performance.now() - startTime;
          const prog = Math.min(1.0, elapsed / totalMs);
          btnDownloadStoryVideo.textContent = `🔴 ${Math.round(prog * 100)}%`;

          // Avanzar la animación o rotar en 360° en cada frame
          if (hasAnimation) {
            viewport.seekAnimation(prog * targetDuration);
          } else if (activeObj) {
            activeObj.rotation.y = initialRotY + prog * Math.PI * 2;
          }

          cachedModelRenderCanvas = await viewport.captureStoryRender({
            width: 1080,
            height: 1080,
            autoFrame: false
          });
          redrawStoryPreview();

          if (elapsed >= totalMs) {
            clearInterval(intervalId);
            if (recorder.state === 'recording') recorder.stop();
          }
        }, 33);
      });

      const blob = new Blob(chunks, { type: mimeType });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      a.click();
      setTimeout(() => URL.revokeObjectURL(url), 2000);

      showStudioToast(`✅ Video Reel descargado: ${filename}`);
    } catch (e: any) {
      console.warn('[ModelCoder] Error grabando reel:', e);
      showStudioToast(`⚠️ No se pudo grabar el reel: ${e?.message || 'Error en MediaRecorder'}`, true);
    } finally {
      // Restaurar estado inicial del modelo
      if (hasAnimation) {
        viewport.seekAnimation(initialAnimTime);
      } else if (activeObj) {
        activeObj.rotation.y = initialRotY;
      }
      btnDownloadStoryVideo.disabled = false;
      btnDownloadStoryVideo.textContent = originalText;
    }
  });

