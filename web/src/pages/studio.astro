              <button type="button" class="btn-mini btn-outline btn-piv-preset" data-preset="right" title="Bisagra derecha">Der. →</button>
              <button type="button" class="btn-mini btn-outline btn-piv-preset" data-preset="back" title="Bisagra trasera (tapa / cofre)">Atrás ↶</button>
            </div>
          </div>

          <!-- Dimensiones Efectivas Resultantes -->
          <div class="effective-dims-box">
            <span class="eff-label">DIMENSIONES REALES EFECTIVAS:</span>
            <span id="eff-dims-val" class="eff-val">Calculando...</span>
          </div>

          <!-- ALINEACIÓN Y PRECISIÓN -->
          <div class="prop-field-block alignment-tools-block">
            <div class="field-label-row">
              <label class="field-label">ALINEACIÓN RÁPIDA Y PRECISIÓN:</label>
              <span class="field-unit-tag">Auto-Align</span>
            </div>
            <div class="alignment-actions-grid">
              <button type="button" id="btn-align-ground" class="btn-mini btn-outline btn-align" title="Asentar al suelo: mueve la pieza para que su base toque Y = 0.00 exactamente">
                ⬇ Suelo (Y=0)
              </button>
              <button type="button" id="btn-center-origin" class="btn-mini btn-outline btn-align" title="Centrar en el eje central de la escena (X=0, Z=0)">
                🎯 Centrar X/Z
              </button>
              <button type="button" id="btn-insp-magnet" class="btn-mini btn-outline btn-align" title="Activar Imán de caras: haz clic en una superficie para pegar la pieza">
                🧲 Imán Cara
              </button>
            </div>

            ${comp.parentId ? `
            <div class="parent-align-wrap">
              <div class="parent-align-title">Pegar a cara del Padre (<span class="parent-badge-name">${comp.parentId}</span>):</div>
              <div class="parent-faces-grid">
                <button type="button" class="btn-mini btn-outline btn-parent-face" data-face="+y" title="Pegar encima del techo del padre (+Y)">Arriba ↑</button>
                <button type="button" class="btn-mini btn-outline btn-parent-face" data-face="-y" title="Pegar debajo de la base del padre (-Y)">Abajo ↓</button>
                <button type="button" class="btn-mini btn-outline btn-parent-face" data-face="+x" title="Pegar a la derecha del padre (+X)">Der. →</button>
                <button type="button" class="btn-mini btn-outline btn-parent-face" data-face="-x" title="Pegar a la izquierda del padre (-X)">Izq. ←</button>
                <button type="button" class="btn-mini btn-outline btn-parent-face" data-face="+z" title="Pegar al frente del padre (+Z)">Frente ⊙</button>
                <button type="button" class="btn-mini btn-outline btn-parent-face" data-face="-z" title="Pegar detrás del padre (-Z)">Atrás ⊗</button>
              </div>
            </div>
            ` : ''}
          </div>
        </div>
      </div>

      <!-- SECTION 2: GEOMETRÍA ESPECÍFICA DE LA FORMA -->
      <div class="prop-section collapsible-section ps1-inset ${isOpen('geometry') ? 'is-open' : 'is-collapsed'}" data-sec-id="geometry">
