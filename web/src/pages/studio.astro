  animCurveCanvas?.addEventListener('click', (e) => {
    if (!animCurveCanvas) return;
    const rect = animCurveCanvas.getBoundingClientRect();
    const clickX = e.clientX - rect.left;
    const padLeft = 40;
    const padRight = 20;
    const pw = rect.width - padLeft - padRight;
    const totalDur = parseFloat(customAnimDurationInput?.value || '2.0') || 2.0;
    const maxKfT = Math.max(...customKeyframeList.map((k) => k.time), 0.1);
    const maxTime = Math.max(totalDur, maxKfT);

    if (clickX >= padLeft && clickX <= padLeft + pw) {
      const clickedTime = Math.max(0, Math.min(maxTime, ((clickX - padLeft) / pw) * maxTime));
      const roundedT = Number(clickedTime.toFixed(2));
      if (animTimeSlider) {
        animTimeSlider.value = String(roundedT);
      }
      viewport?.seekAnimation(roundedT);
      renderAnimationCurveCanvas();
      showStudioToast(`⏱️ Fotograma seleccionado: ${roundedT}s`);
    }
  });

  btnConfirmAddAnim?.addEventListener('click', () => {
    const targetComp = animTargetCompSelect?.value;
    if (!targetComp) {
      showStudioToast('⚠️ Selecciona un componente objetivo para animar.', true);
      return;
    }

    if (activeAnimModalTab === 'custom') {
      const clipName = customAnimNameInput?.value.trim() || `Anim_${targetComp}`;
      const prop = (customAnimPropSelect?.value as AnimationTrackProperty) || 'rotation';
      const duration = Math.max(0.1, parseFloat(customAnimDurationInput?.value || '2.0') || 2.0);
      const loop = (customAnimLoopSelect?.value as 'repeat' | 'pingpong' | 'once') || 'repeat';
      const interp = (customAnimInterpSelect?.value as AnimationInterpolation) || 'linear';

      if (customKeyframeList.length < 2) {
        showStudioToast('⚠️ Debes definir al menos 2 keyframes para la animación.', true);
        return;
      }

      const sortedKfs = [...customKeyframeList].sort((a, b) => a.time - b.time);
      const maxKfTime = sortedKfs[sortedKfs.length - 1].time;
      const finalDuration = Math.max(duration, maxKfTime);

      const customTrack: AnimationTrackDef = {
        targetComponent: targetComp,
        targetName: targetComp,
        property: prop,
        keyframes: sortedKfs.map((k) => ({
          time: k.time,
          value: [k.val[0], k.val[1], k.val[2]] as [number, number, number],
          interpolation: interp
        }))
      };

      const customClip: AnimationClipDef = {
        id: `custom_${Date.now()}_${Math.floor(Math.random() * 1000)}`,
        name: clipName,
        duration: finalDuration,
        loop,
        tracks: [customTrack]
      };

      currentSpec.animations = currentSpec.animations || [];
      if (editingAnimOriginalName) {
        const editIdx = currentSpec.animations.findIndex((a) => a.name === editingAnimOriginalName);
        if (editIdx >= 0) {
          currentSpec.animations[editIdx] = customClip;
        } else {
          currentSpec.animations.push(customClip);
        }
        editingAnimOriginalName = null;
      } else {
        const existingIdx = currentSpec.animations.findIndex((a) => a.name === customClip.name);
        if (existingIdx >= 0) {
          currentSpec.animations[existingIdx] = customClip;
        } else {
          currentSpec.animations.push(customClip);
        }
      }

      modalAnimPreset?.close();
      renderCurrentSpec('visual', true, true);
      if (animClipSelect) animClipSelect.value = customClip.name;
      viewport?.playAnimation(customClip.name);
      showStudioToast(`🎨 Pista guardada: ${customClip.name} (${sortedKfs.length} keyframes)`);
      return;
    }

    // Default: Presets logic
    const name = animClipNameInput?.value.trim() || `Anim_${targetComp}`;
    const axis = (animAxisSelect?.value as 'x' | 'y' | 'z') || 'y';
    const magnitude = parseFloat(animMagnitudeInput?.value || '1.0');
    const duration = parseFloat(animDurationInput?.value || '1.6');
    const loop = (animLoopSelect?.value as 'repeat' | 'pingpong' | 'once') || 'pingpong';

    const comp = currentSpec.components.find((c) => c.name === targetComp);
    const initialPos = comp?.position || [0, 0, 0];
    const initialRot = comp?.rotation || [0, 0, 0];

    const clip = AnimationEngine.createPresetClip(selectedPresetType, {
      targetComponent: targetComp,
      name,
      axis,
      distance: magnitude,
      openAngleDeg: magnitude,
      pressDepth: magnitude,
      extendDistance: magnitude,
      amplitude: magnitude,
      duration,
      loop,
      initialPos,
      initialRot
    });

    currentSpec.animations = currentSpec.animations || [];
    const existingIdx = currentSpec.animations.findIndex((a) => a.name === clip.name);
    if (existingIdx >= 0) {
      currentSpec.animations[existingIdx] = clip;
    } else {
      currentSpec.animations.push(clip);
    }

    modalAnimPreset?.close();
    renderCurrentSpec('visual', true, true);
    if (animClipSelect) animClipSelect.value = clip.name;
    viewport?.playAnimation(clip.name);
    showStudioToast(`⚡ Animación creada: ${clip.name} · Exportable a GLB`);
  });

