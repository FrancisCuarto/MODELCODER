  // --- GLB & ZIP EXPORT (Standard & Godot 4 Collisions) ---
  async function triggerExportGLB(options?: { godotColliders?: 'convex' | 'trimesh' | 'box' }) {
    if (!viewport) return;
    const rootObj = viewport.getVisibleObject();
    if (!rootObj) {
      showStudioToast('⚠️ No hay ninguna geometría visible para exportar.', true);
      return;
    }

    const isGodot = !!options?.godotColliders;
    if (isGodot && exportGodotBtn) exportGodotBtn.textContent = '⏳ VERIFICANDO...';
    if (!isGodot && exportGlbBtn) exportGlbBtn.textContent = '⏳ VERIFICANDO...';

    try {
      const baseName = currentSpec.name.toLowerCase().replace(/[^a-z0-9]/g, '_') || 'modelcoder_asset';
      const filename = isGodot ? `${baseName}_godot` : baseName;
      let compiledAnims: any[] | undefined = undefined;
      if (currentSpec.animations && currentSpec.animations.length > 0) {
        compiledAnims = AnimationEngine.compileClipsToThree(currentSpec.animations, rootObj);
      }
      const result = await viewport.executeWithOriginalMaterials((cleanRoot) =>
        GLBExporterService.exportAndVerifyGLB(
          cleanRoot,
          filename,
          {
            animations: compiledAnims && compiledAnims.length > 0 ? compiledAnims : undefined,
            godotColliders: options?.godotColliders
          }
        )
      );
      const animInfo = result.animationCount ? ` · 🎬 ${result.animationCount} anim${result.animationCount > 1 ? 's' : ''}` : '';
      const colInfo = isGodot ? ' · 🤖 StaticBody3D (-convcol)' : '';
      showStudioToast(`✅ Exportado: ${filename}.glb (${(result.sizeBytes / 1024).toFixed(1)} KB · ${result.triangleCount} tris${colInfo}${animInfo})`);
    } catch (err: any) {
      showStudioToast(`⚠️ Fallo de exportación: ${err.message}`, true);
    } finally {
      if (exportGlbBtn) exportGlbBtn.textContent = '💾 EXPORTAR GLB';
      if (exportGodotBtn) exportGodotBtn.textContent = '🤖 GLB GODOT';
    }
  }

  exportGlbBtn?.addEventListener('click', () => triggerExportGLB());
  exportGodotBtn?.addEventListener('click', () => triggerExportGLB({ godotColliders: 'convex' }));
  btnExportGodotGlb?.addEventListener('click', () => triggerExportGLB({ godotColliders: 'convex' }));

  btnExportGodotTscn?.addEventListener('click', () => {
    const cleanName = (currentSpec.name || 'model').toLowerCase().replace(/[^a-z0-9]/g, '_');
    const tscnContent = generateGodotScene(currentSpec, `${cleanName}.glb`);
    const blob = new Blob([tscnContent], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${cleanName}.tscn`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(url), 2000);
    showStudioToast(`🎬 Escena Godot 4 descargada: ${cleanName}.tscn`);
  });

  exportZipBtn?.addEventListener('click', async () => {
    exportZipBtn.textContent = '⏳ Empaquetando...';
    try {
      const JSZip = (window as any).JSZip;
      if (!JSZip) throw new Error('JSZip no disponible');

      const zip = new JSZip();
      const familyName = currentSpec.name.toLowerCase().replace(/[^a-z0-9]/g, '_') || 'custom_model';

      const folder = zip.folder(`procedural_assets/generators/${familyName}`);
      folder.file('__init__.py', `from .config import *\nfrom .generator import *\n`);
      folder.file('generator.py', generatePythonFromSpec(currentSpec));
      folder.file('model_spec.json', JSON.stringify(currentSpec, null, 2));
      folder.file('README.md', `# ${currentSpec.name}\n\nGenerador procedural de ModelCoder Studio.\n`);

      const content = await zip.generateAsync({ type: 'blob' });
      const zipUrl = URL.createObjectURL(content);
      const a = document.createElement('a');
      a.href = zipUrl;
      a.download = `${familyName}_generator_package.zip`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(zipUrl), 1500);
      showStudioToast(`📦 Paquete descargado: ${familyName}_generator_package.zip`);
    } catch (e: any) {
      showStudioToast(`⚠️ Error al generar ZIP: ${e.message}`, true);
