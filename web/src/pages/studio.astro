  btnWelcomeNewBlank?.addEventListener('click', () => {
    currentSpec = JSON.parse(JSON.stringify(BLANK_NEW_SPEC));
    currentSpec.id = `custom.model.${Date.now()}`;
    pushHistoryState(currentSpec);
    renderCurrentSpec('visual', false);
    modalWelcomeDesktop?.close();
    showStudioToast('✨ Nuevo proyecto en blanco listo para modelar.');
  });

  btnWelcomeOpenTemplates?.addEventListener('click', () => {
    modalWelcomeDesktop?.close();
    modalCatalogTemplates?.showModal();
    renderCatalogTemplatesList();
  });

  btnWelcomeViewAllProjects?.addEventListener('click', () => {
    modalWelcomeDesktop?.close();
    modalMyProjects?.showModal();
    renderProjectsList();
  });

  btnMenuWelcomeSplash?.addEventListener('click', () => {
    topbarMoreMenu?.classList.add('hidden');
    openWelcomeModal();
  });

  welcomeImportJson?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    try {
      const text = await file.text();
      const imported = JSON.parse(text);
      if (imported && Array.isArray(imported.components)) {
        currentSpec = imported;
        pushHistoryState(currentSpec);
        renderCurrentSpec('visual', false);
        modalWelcomeDesktop?.close();
        showStudioToast(`📂 Proyecto '${imported.name || file.name}' importado.`);
      } else {
        showStudioToast('❌ El archivo no contiene un ModelSpec válido.', true);
      }
    } catch (err: any) {
      showStudioToast(`❌ Error al importar JSON: ${err?.message || 'Error'}`, true);
    }
  });

  if (chkShowWelcomeStartup) {
    const savedPref = localStorage.getItem('modelcoder_show_welcome_startup');
    chkShowWelcomeStartup.checked = savedPref !== 'false';
    chkShowWelcomeStartup.addEventListener('change', () => {
      localStorage.setItem('modelcoder_show_welcome_startup', chkShowWelcomeStartup.checked ? 'true' : 'false');
    });
  }

  // Apertura automática del modal de bienvenida en entorno de escritorio
  const hasUrlTarget = window.location.search.includes('model=') || window.location.search.includes('draft=') || window.location.hash.length > 20;
  if (isDesktopEnv && !hasUrlTarget) {
    const shouldShow = localStorage.getItem('modelcoder_show_welcome_startup') !== 'false';
    if (shouldShow) {
      setTimeout(() => {
        openWelcomeModal();
      }, 180);
    }
  }

  // Initial Load
  pushHistoryState(currentSpec);
  setStudioWorkspace('layout');
  renderCurrentSpec('visual', false);
  handleInitialUrlSpec();

  if (isDesktopEnv) {
    refreshLocalTextures().then(() => {
      const countEl = document.getElementById('local-mat-count');
      if (countEl) countEl.textContent = String(localTexturesList.length);
    });
  }
</script>
</Layout>

