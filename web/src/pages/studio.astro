  // --- ANIMATION SYSTEM (GLTF / GLB EXPORTABLE ANIMATION TRACKS) ---

  let selectedPresetType: AnimationPresetType = 'sliding_door';

  function updateAnimationTimelineBar(): void {
    if (!animClipSelect) return;

    const anims = currentSpec.animations || [];
    animClipSelect.innerHTML = '';

    if (anims.length === 0) {
      const opt = document.createElement('option');
      opt.value = '';
      opt.textContent = '(Sin animaciones)';
      animClipSelect.appendChild(opt);
      if (btnAnimPlay) { btnAnimPlay.disabled = true; btnAnimPlay.textContent = '▶ PLAY'; }
      if (btnAnimStop) btnAnimStop.disabled = true;
      if (btnAnimLoopToggle) btnAnimLoopToggle.disabled = true;
      if (animTimeSlider) { animTimeSlider.disabled = true; animTimeSlider.value = '0'; }
      if (animTimeDisplay) animTimeDisplay.textContent = '0.00s / 0.00s';
      if (btnExportVideo) btnExportVideo.disabled = false;
      if (btnAnimDelete) btnAnimDelete.style.display = 'none';
      if (btnTimelineEditAnim) btnTimelineEditAnim.style.display = 'none';
      if (btnCaptureTimelinePose) btnCaptureTimelinePose.disabled = true;
      return;
    }

    anims.forEach((clip) => {
      const opt = document.createElement('option');
      opt.value = clip.name;
      const targetName = clip.tracks[0]?.targetComponent || 'pieza';
      opt.textContent = `🎬 ${clip.name} (${targetName} · ${clip.duration.toFixed(1)}s)`;
      animClipSelect.appendChild(opt);
    });

    if (btnAnimPlay) btnAnimPlay.disabled = false;
    if (btnAnimStop) btnAnimStop.disabled = false;
    if (btnAnimLoopToggle) btnAnimLoopToggle.disabled = false;
    if (animTimeSlider) animTimeSlider.disabled = false;
    if (btnExportVideo) btnExportVideo.disabled = false;
    if (btnAnimDelete) btnAnimDelete.style.display = 'inline-block';
    if (btnTimelineEditAnim) btnTimelineEditAnim.style.display = 'inline-block';
    if (btnCaptureTimelinePose) btnCaptureTimelinePose.disabled = false;

    const info = viewport?.getActiveClipInfo();
    if (info && info.name) {
      animClipSelect.value = info.name;
      if (animTimeSlider) {
        animTimeSlider.max = String(info.duration);
        animTimeSlider.value = String(info.time);
      }
      if (animTimeDisplay) {
        animTimeDisplay.textContent = `${info.time.toFixed(2)}s / ${info.duration.toFixed(2)}s`;
      }
      if (btnAnimPlay) {
        btnAnimPlay.textContent = info.isPlaying ? '⏸ PAUSA' : '▶ PLAY';
      }
    } else {
      const first = anims[0];
      if (animTimeSlider) {
        animTimeSlider.max = String(first.duration);
        animTimeSlider.value = '0';
      }
      if (animTimeDisplay) {
        animTimeDisplay.textContent = `0.00s / ${first.duration.toFixed(2)}s`;
      }
    }
  }

  function renderPresetCards(): void {
    if (!animPresetsGrid) return;
    const presets = AnimationEngine.getAvailablePresets();
    animPresetsGrid.innerHTML = '';

    presets.forEach((p) => {
      const card = document.createElement('div');
      card.className = `anim-preset-card ${p.type === selectedPresetType ? 'active' : ''}`;
      card.dataset.preset = p.type;
      card.innerHTML = `
        <div class="anim-preset-icon">${p.icon}</div>
        <div class="anim-preset-title">${p.label}</div>
        <div class="anim-preset-desc">${p.description}</div>
      `;
      card.addEventListener('click', () => {
        selectedPresetType = p.type;
        renderPresetCards();
        updatePresetConfigForm();
      });
      animPresetsGrid.appendChild(card);
    });
  }

  function updatePresetConfigForm(): void {
    const target = animTargetCompSelect?.value || 'pieza';
    if (!animClipNameInput || !animParamMagnitudeLabel || !animMagnitudeInput || !animDurationInput || !animLoopSelect) return;

    switch (selectedPresetType) {
      case 'sliding_door':
        animClipNameInput.value = `Abrir_${target}`;
        animParamMagnitudeLabel.textContent = 'Distancia de apertura (m):';
        animMagnitudeInput.value = '1.0';
        animDurationInput.value = '1.6';
        animLoopSelect.value = 'pingpong';
        break;
      case 'hinge_lid':
        animClipNameInput.value = `Tapa_${target}`;
        animParamMagnitudeLabel.textContent = 'Ángulo de apertura (grados °):';
        animMagnitudeInput.value = '90';
        animDurationInput.value = '1.8';
        animLoopSelect.value = 'pingpong';
        break;
      case 'button_press':
        animClipNameInput.value = `Pulsar_${target}`;
        animParamMagnitudeLabel.textContent = 'Profundidad de pulsación (m):';
        animMagnitudeInput.value = '-0.1';
        animDurationInput.value = '0.8';
        animLoopSelect.value = 'pingpong';
        break;
      case 'spin_continuous':
        animClipNameInput.value = `Giro_${target}`;
        animParamMagnitudeLabel.textContent = 'Rotación completa (360°):';
        animMagnitudeInput.value = '360';
        animDurationInput.value = '2.0';
        animLoopSelect.value = 'repeat';
        break;
      case 'mechanical_deploy':
        animClipNameInput.value = `Despliegue_${target}`;
        animParamMagnitudeLabel.textContent = 'Distancia de extensión (m):';
        animMagnitudeInput.value = '0.8';
        animDurationInput.value = '2.2';
        animLoopSelect.value = 'pingpong';
        break;
      case 'idle_hover':
        animClipNameInput.value = `Hover_${target}`;
        animParamMagnitudeLabel.textContent = 'Amplitud de flotación (m):';
        animMagnitudeInput.value = '0.15';
        animDurationInput.value = '2.5';
        animLoopSelect.value = 'repeat';
        break;
    }
  }

  let activeAnimModalTab: 'preset' | 'custom' = 'preset';
  let editingAnimOriginalName: string | null = null;

  interface CustomKfRow {
    time: number;
    val: [number, number, number];
  }
  let customKeyframeList: CustomKfRow[] = [];

  function switchAnimModalTab(tab: 'preset' | 'custom'): void {
    activeAnimModalTab = tab;
    if (tab === 'preset') {
      tabBtnAnimPreset?.classList.remove('btn-outline');
      tabBtnAnimPreset?.classList.add('btn-gold');
      tabBtnAnimCustom?.classList.remove('btn-gold');
      tabBtnAnimCustom?.classList.add('btn-outline');
      if (animSectionPresets) animSectionPresets.style.display = 'block';
      if (animSectionCustom) animSectionCustom.style.display = 'none';
      if (btnConfirmAddAnim) btnConfirmAddAnim.textContent = '⚡ AÑADIR ANIMACIÓN PRESET';
    } else {
      tabBtnAnimCustom?.classList.remove('btn-outline');
      tabBtnAnimCustom?.classList.add('btn-gold');
      tabBtnAnimPreset?.classList.remove('btn-gold');
      tabBtnAnimPreset?.classList.add('btn-outline');
      if (animSectionPresets) animSectionPresets.style.display = 'none';
      if (animSectionCustom) animSectionCustom.style.display = 'block';
      if (btnConfirmAddAnim) {
        btnConfirmAddAnim.textContent = editingAnimOriginalName ? '💾 GUARDAR CAMBIOS EN LA PISTA' : '🎨 AÑADIR ANIMACIÓN PERSONALIZADA';
      }
      if (customKeyframeList.length === 0) {
        initDefaultCustomKeyframes();
      }
      renderCustomKeyframeTable();
      renderAnimationCurveCanvas();
    }
  }

  function getActiveTargetComponentTransform(): { pos: [number, number, number]; rot: [number, number, number]; scale: [number, number, number] } {
    const targetName = animTargetCompSelect?.value;
    const comp = currentSpec.components.find((c) => c.name === targetName);
    return {
      pos: comp?.position ? [comp.position[0], comp.position[1], comp.position[2]] : [0, 0, 0],
      rot: comp?.rotation ? [comp.rotation[0], comp.rotation[1], comp.rotation[2]] : [0, 0, 0],
      scale: comp?.scale ? [comp.scale[0], comp.scale[1], comp.scale[2]] : [1, 1, 1]
    };
  }

  function initDefaultCustomKeyframes(): void {
    const prop = (customAnimPropSelect?.value as AnimationTrackProperty) || 'rotation';
    const totalDur = parseFloat(customAnimDurationInput?.value || '2.0') || 2.0;
    const xform = getActiveTargetComponentTransform();
    const baseVal: [number, number, number] = prop === 'rotation' ? [...xform.rot] : prop === 'scale' ? [...xform.scale] : [...xform.pos];

    let endVal: [number, number, number];
    if (prop === 'rotation') {
      endVal = [baseVal[0], Number((baseVal[1] + 90).toFixed(2)), baseVal[2]];
    } else if (prop === 'position') {
      endVal = [baseVal[0], Number((baseVal[1] + 0.5).toFixed(2)), baseVal[2]];
    } else {
      endVal = [Number((baseVal[0] * 1.25).toFixed(2)), Number((baseVal[1] * 1.25).toFixed(2)), Number((baseVal[2] * 1.25).toFixed(2))];
    }

    customKeyframeList = [
      { time: 0.0, val: baseVal },
      { time: Number(totalDur.toFixed(2)), val: endVal }
    ];
  }

  function updateCustomPropHeaders(): void {
    const prop = customAnimPropSelect?.value || 'rotation';
    if (thValX) thValX.textContent = prop === 'rotation' ? 'ROT X (°)' : prop === 'scale' ? 'ESCALA X' : 'POS X (m)';
    if (thValY) thValY.textContent = prop === 'rotation' ? 'ROT Y (°)' : prop === 'scale' ? 'ESCALA Y' : 'POS Y (m)';
    if (thValZ) thValZ.textContent = prop === 'rotation' ? 'ROT Z (°)' : prop === 'scale' ? 'ESCALA Z' : 'POS Z (m)';
  }

  function renderAnimationCurveCanvas(): void {
    if (!animCurveCanvas) return;
    const ctx = animCurveCanvas.getContext('2d');
    if (!ctx) return;

    const rect = animCurveCanvas.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    const cssWidth = rect.width > 50 ? rect.width : 540;
    const cssHeight = 120;

    animCurveCanvas.width = Math.round(cssWidth * dpr);
    animCurveCanvas.height = Math.round(cssHeight * dpr);

    ctx.save();
    ctx.scale(dpr, dpr);

    // Background
    ctx.fillStyle = '#060a12';
    ctx.fillRect(0, 0, cssWidth, cssHeight);

    if (customKeyframeList.length === 0) {
      ctx.fillStyle = '#64748b';
      ctx.font = '11px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('Sin keyframes definidos', cssWidth / 2, cssHeight / 2);
      ctx.restore();
      return;
    }

    const padLeft = 40;
    const padRight = 20;
    const padTop = 14;
    const padBottom = 22;
    const pw = Math.max(10, cssWidth - padLeft - padRight);
    const ph = Math.max(10, cssHeight - padTop - padBottom);

    const totalDur = parseFloat(customAnimDurationInput?.value || '2.0') || 2.0;
    const maxKfT = Math.max(...customKeyframeList.map((k) => k.time), 0.1);
    const maxTime = Math.max(totalDur, maxKfT);

    let minVal = Infinity;
    let maxVal = -Infinity;
    customKeyframeList.forEach((kf) => {
      kf.val.forEach((v) => {
        if (v < minVal) minVal = v;
        if (v > maxVal) maxVal = v;
      });
    });

    if (!isFinite(minVal) || !isFinite(maxVal) || minVal === maxVal) {
      minVal -= 1;
      maxVal += 1;
    }
    const span = maxVal - minVal;
    const vPad = Math.max(span * 0.14, 0.4);
    minVal -= vPad;
    maxVal += vPad;

    const toX = (t: number) => padLeft + (Math.max(0, t) / maxTime) * pw;
    const toY = (v: number) => padTop + ph - ((v - minVal) / (maxVal - minVal)) * ph;

    // Grid: zero reference line
    if (minVal <= 0 && maxVal >= 0) {
      const y0 = toY(0);
      ctx.strokeStyle = '#223249';
      ctx.lineWidth = 1;
      ctx.setLineDash([4, 4]);
      ctx.beginPath();
      ctx.moveTo(padLeft, y0);
      ctx.lineTo(padLeft + pw, y0);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = '#64748b';
      ctx.font = '9px monospace';
      ctx.textAlign = 'right';
      ctx.fillText('0', padLeft - 6, y0 + 3);
    }

    // Vertical time grid lines & labels
    const timeStep = maxTime <= 2.5 ? 0.5 : maxTime <= 6 ? 1.0 : 2.0;
    ctx.strokeStyle = '#121b2b';
    ctx.lineWidth = 1;
    ctx.fillStyle = '#64748b';
    ctx.font = '9px monospace';
    ctx.textAlign = 'center';

    for (let t = 0; t <= maxTime + 0.001; t += timeStep) {
      const gx = toX(t);
      ctx.beginPath();
      ctx.moveTo(gx, padTop);
      ctx.lineTo(gx, padTop + ph);
      ctx.stroke();
      ctx.fillText(`${t.toFixed(1)}s`, gx, padTop + ph + 14);
    }

    // Min and Max telemetry labels
    ctx.textAlign = 'right';
    ctx.fillStyle = '#475569';
    ctx.fillText(maxVal.toFixed(1), padLeft - 6, padTop + 8);
    ctx.fillText(minVal.toFixed(1), padLeft - 6, padTop + ph);

    // Sorted keyframes
    const sorted = [...customKeyframeList].sort((a, b) => a.time - b.time);
    const interp = (customAnimInterpSelect?.value as AnimationInterpolation) || 'linear';

    const channels: Array<{ idx: number; color: string; label: string }> = [
      { idx: 0, color: '#f87171', label: 'X' },
      { idx: 1, color: '#4ade80', label: 'Y' },
      { idx: 2, color: '#60a5fa', label: 'Z' }
    ];

    // Draw curves for each channel
    channels.forEach((ch) => {
      ctx.strokeStyle = ch.color;
      ctx.lineWidth = 2;
      ctx.beginPath();

      if (interp === 'step') {
        for (let i = 0; i < sorted.length; i++) {
          const px = toX(sorted[i].time);
          const py = toY(sorted[i].val[ch.idx]);
          if (i === 0) {
            ctx.moveTo(px, py);
          } else {
            const prevY = toY(sorted[i - 1].val[ch.idx]);
            ctx.lineTo(px, prevY);
            ctx.lineTo(px, py);
          }
        }
      } else if (interp === 'cubic' && sorted.length > 2) {
        ctx.moveTo(toX(sorted[0].time), toY(sorted[0].val[ch.idx]));
        for (let i = 0; i < sorted.length - 1; i++) {
          const p0 = sorted[Math.max(0, i - 1)];
          const p1 = sorted[i];
          const p2 = sorted[i + 1];
          const p3 = sorted[Math.min(sorted.length - 1, i + 2)];

          const x1 = toX(p1.time);
          const y1 = toY(p1.val[ch.idx]);
          const x2 = toX(p2.time);
          const y2 = toY(p2.val[ch.idx]);

          const cp1x = x1 + (toX(p2.time) - toX(p0.time)) / 6;
          const cp1y = y1 + (toY(p2.val[ch.idx]) - toY(p0.val[ch.idx])) / 6;
          const cp2x = x2 - (toX(p3.time) - toX(p1.time)) / 6;
          const cp2y = y2 - (toY(p3.val[ch.idx]) - toY(p1.val[ch.idx])) / 6;

          ctx.bezierCurveTo(cp1x, cp1y, cp2x, cp2y, x2, y2);
        }
      } else {
        // Linear
        for (let i = 0; i < sorted.length; i++) {
          const px = toX(sorted[i].time);
          const py = toY(sorted[i].val[ch.idx]);
          if (i === 0) ctx.moveTo(px, py);
          else ctx.lineTo(px, py);
        }
      }
      ctx.stroke();

      // Keyframe dots
      sorted.forEach((kf) => {
        const kx = toX(kf.time);
        const ky = toY(kf.val[ch.idx]);
        ctx.fillStyle = ch.color;
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(kx, ky, 3.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
      });
    });

    // Playhead line
    const activeTime = parseFloat(animTimeSlider?.value || '0') || 0;
    if (activeTime >= 0 && activeTime <= maxTime) {
      const hx = toX(activeTime);
      ctx.strokeStyle = '#fbbf24';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(hx, padTop);
      ctx.lineTo(hx, padTop + ph);
      ctx.stroke();

      // Arrow tip
      ctx.fillStyle = '#fbbf24';
      ctx.beginPath();
      ctx.moveTo(hx - 4, padTop);
      ctx.lineTo(hx + 4, padTop);
      ctx.lineTo(hx, padTop + 6);
      ctx.closePath();
      ctx.fill();
    }

    ctx.restore();

    if (animCurveTelemetry) {
      const prop = customAnimPropSelect?.value || 'rotation';
      const unit = prop === 'rotation' ? '°' : prop === 'scale' ? 'x' : 'm';
      animCurveTelemetry.textContent = `Rango vertical: [${minVal.toFixed(1)}${unit} .. ${maxVal.toFixed(1)}${unit}] · Duración: ${maxTime.toFixed(2)}s · ${sorted.length} keyframes`;
    }
  }

  function renderCustomKeyframeTable(): void {
    if (!customKfTableBody) return;
    updateCustomPropHeaders();
    customKfTableBody.innerHTML = '';

    customKeyframeList.sort((a, b) => a.time - b.time);

    customKeyframeList.forEach((kf, idx) => {
      const tr = document.createElement('tr');
      tr.className = 'kf-row';
      tr.style.borderBottom = '1px solid #1a2538';

      tr.innerHTML = `
        <td style="padding: 0.25rem 0.35rem;">
          <input type="number" step="0.05" min="0" max="60" class="kf-input kf-time-input" value="${Number(kf.time.toFixed(2))}" />
        </td>
        <td style="padding: 0.25rem 0.35rem;">
          <input type="number" step="0.05" class="kf-input kf-val-x" value="${Number(kf.val[0].toFixed(2))}" />
        </td>
        <td style="padding: 0.25rem 0.35rem;">
          <input type="number" step="0.05" class="kf-input kf-val-y" value="${Number(kf.val[1].toFixed(2))}" />
        </td>
        <td style="padding: 0.25rem 0.35rem;">
          <input type="number" step="0.05" class="kf-input kf-val-z" value="${Number(kf.val[2].toFixed(2))}" />
        </td>
        <td style="padding: 0.25rem 0.35rem; text-align: right; white-space: nowrap;">
          <button type="button" class="btn btn-mini btn-outline btn-kf-capture" data-index="${idx}" title="Capturar transform actual del visor 3D para este fotograma" style="padding: 0.2rem 0.4rem; font-size: 0.65rem;">
            📍
          </button>
          <button type="button" class="btn btn-mini btn-outline btn-kf-delete" data-index="${idx}" title="Eliminar este fotograma" ${customKeyframeList.length <= 2 ? 'disabled' : ''} style="padding: 0.2rem 0.4rem; font-size: 0.65rem; color: #ff5555;">
            🗑️
          </button>
        </td>
      `;

      const timeInp = tr.querySelector('.kf-time-input') as HTMLInputElement;
      const xInp = tr.querySelector('.kf-val-x') as HTMLInputElement;
      const yInp = tr.querySelector('.kf-val-y') as HTMLInputElement;
      const zInp = tr.querySelector('.kf-val-z') as HTMLInputElement;

      const updateValues = () => {
        kf.time = Math.max(0, parseFloat(timeInp.value) || 0);
        kf.val = [
          parseFloat(xInp.value) || 0,
          parseFloat(yInp.value) || 0,
          parseFloat(zInp.value) || 0
        ];
        renderAnimationCurveCanvas();
      };

      [timeInp, xInp, yInp, zInp].forEach((inp) => inp.addEventListener('input', updateValues));

      tr.querySelector('.btn-kf-capture')?.addEventListener('click', () => {
        const prop = (customAnimPropSelect?.value as AnimationTrackProperty) || 'rotation';
        const xform = getActiveTargetComponentTransform();
        const currentVals = prop === 'rotation' ? xform.rot : prop === 'scale' ? xform.scale : xform.pos;
        kf.val = [currentVals[0], currentVals[1], currentVals[2]];
        xInp.value = String(Number(kf.val[0].toFixed(2)));
        yInp.value = String(Number(kf.val[1].toFixed(2)));
        zInp.value = String(Number(kf.val[2].toFixed(2)));
        renderAnimationCurveCanvas();
        showStudioToast(`📍 Pose capturada para keyframe (${kf.time}s): [${kf.val.map((v) => v.toFixed(2)).join(', ')}]`);
      });

      tr.querySelector('.btn-kf-delete')?.addEventListener('click', () => {
        if (customKeyframeList.length <= 2) {
          showStudioToast('⚠️ Una pista debe contener al menos 2 keyframes (inicio y fin).', true);
          return;
        }
        customKeyframeList.splice(idx, 1);
        renderCustomKeyframeTable();
      });

      customKfTableBody.appendChild(tr);
    });

    renderAnimationCurveCanvas();
  }

  function openAnimationPresetModal(preselectedComponent?: string, preselectedPreset?: AnimationPresetType, startTab?: 'preset' | 'custom'): void {
    if (!modalAnimPreset) return;

    if (animTargetCompSelect) {
      animTargetCompSelect.innerHTML = '';
      currentSpec.components.forEach((c) => {
        const opt = document.createElement('option');
        opt.value = c.name;
        opt.textContent = `${c.name} (${c.shape})`;
        animTargetCompSelect.appendChild(opt);
      });

      const currentCompName = preselectedComponent || (selectedComponentIndex !== null ? currentSpec.components[selectedComponentIndex]?.name : null);
      if (currentCompName && currentSpec.components.some((c) => c.name === currentCompName)) {
        animTargetCompSelect.value = currentCompName;
      }
    }

    if (preselectedPreset) {
      selectedPresetType = preselectedPreset;
    }

    if (!editingAnimOriginalName) {
      const currentTarget = animTargetCompSelect?.value || 'Pieza';
      if (customAnimNameInput) {
        customAnimNameInput.value = `Anim_${currentTarget}`;
      }
      initDefaultCustomKeyframes();
    }

    renderPresetCards();
    updatePresetConfigForm();

    switchAnimModalTab(startTab || (preselectedPreset ? 'preset' : activeAnimModalTab));
    renderAnimationCurveCanvas();
    modalAnimPreset.showModal();
  }

  function editExistingAnimation(animName: string): void {
    if (!animName || !currentSpec.animations) return;
    const clip = currentSpec.animations.find((a) => a.name === animName);
    if (!clip || !clip.tracks || clip.tracks.length === 0) {
      showStudioToast('⚠️ No se encontró la pista de animación para editar.', true);
      return;
    }

    editingAnimOriginalName = clip.name;
    const track = clip.tracks[0];
    const targetComp = track.targetComponent || (track as any).targetName;

    // Set custom form fields
    if (customAnimNameInput) customAnimNameInput.value = clip.name;
    if (customAnimDurationInput) customAnimDurationInput.value = String(clip.duration);
    if (customAnimLoopSelect) customAnimLoopSelect.value = clip.loop || 'repeat';
    if (customAnimPropSelect) customAnimPropSelect.value = track.property || 'rotation';
    if (customAnimInterpSelect) customAnimInterpSelect.value = track.keyframes[0]?.interpolation || 'linear';

    customKeyframeList = track.keyframes.map((k) => ({
      time: Number(k.time.toFixed(2)),
      val: [Number(k.value[0].toFixed(2)), Number(k.value[1].toFixed(2)), Number(k.value[2].toFixed(2))]
    }));

    openAnimationPresetModal(targetComp, undefined, 'custom');
    if (btnConfirmAddAnim) {
      btnConfirmAddAnim.textContent = '💾 GUARDAR CAMBIOS EN LA PISTA';
    }
    renderCustomKeyframeTable();
    renderAnimationCurveCanvas();
    showStudioToast(`✏️ Editando pista: ${clip.name}`);
  }

  // Animation timeline buttons
  btnAnimPlay?.addEventListener('click', () => {
    const info = viewport?.getActiveClipInfo();
    if (!info) return;
    if (info.isPlaying) {
      viewport?.pauseAnimation();
      if (btnAnimPlay) btnAnimPlay.textContent = '▶ PLAY';
    } else {
      viewport?.playAnimation(animClipSelect?.value || undefined);
      if (btnAnimPlay) btnAnimPlay.textContent = '⏸ PAUSA';
    }
  });

  btnAnimStop?.addEventListener('click', () => {
    viewport?.stopAnimation();
    if (btnAnimPlay) btnAnimPlay.textContent = '▶ PLAY';
    if (animTimeSlider) animTimeSlider.value = '0';
    renderAnimationCurveCanvas();
  });

  btnAnimLoopToggle?.addEventListener('click', () => {
    currentPlaybackLoopMode = currentPlaybackLoopMode === 'repeat' ? 'once' : 'repeat';
    viewport?.setPlaybackLoopMode(currentPlaybackLoopMode);
    if (currentPlaybackLoopMode === 'once') {
      btnAnimLoopToggle.textContent = '🔂 1 VEZ';
      btnAnimLoopToggle.title = 'Modo actual: Reproducir 1 vez y detenerse. Haz clic para cambiar a bucle continuo.';
      btnAnimLoopToggle.classList.add('btn-cyan');
      btnAnimLoopToggle.classList.remove('ps1-ctrl-btn');
      showStudioToast('🔂 Modo 1 VEZ: la animación se reproducirá una sola vez y se detendrá.');
    } else {
      btnAnimLoopToggle.textContent = '🔁 BUCLE';
      btnAnimLoopToggle.title = 'Modo actual: Bucle continuo. Haz clic para cambiar a reproducir 1 sola vez.';
      btnAnimLoopToggle.classList.remove('btn-cyan');
      btnAnimLoopToggle.classList.add('ps1-ctrl-btn');
      showStudioToast('🔁 Modo BUCLE: la animación se repetirá continuamente.');
    }
  });

  animTimeSlider?.addEventListener('input', () => {
    const t = parseFloat(animTimeSlider.value) || 0;
    viewport?.seekAnimation(t);
    renderAnimationCurveCanvas();
  });

  btnTimelineEditAnim?.addEventListener('click', () => {
    const activeName = animClipSelect?.value;
    if (activeName) {
      editExistingAnimation(activeName);
    }
  });

  btnCaptureTimelinePose?.addEventListener('click', () => {
    const activeClipName = animClipSelect?.value;
    if (!activeClipName || !currentSpec.animations) {
      showStudioToast('⚠️ No hay ninguna pista de animación activa para registrar la pose.', true);
      return;
    }

    const clip = currentSpec.animations.find((a) => a.name === activeClipName);
    if (!clip || !clip.tracks || clip.tracks.length === 0) return;

    const track = clip.tracks[0];
    const targetCompName = (selectedComponentIndex !== null && currentSpec.components[selectedComponentIndex]?.name)
      || track.targetComponent;

    const comp = currentSpec.components.find((c) => c.name === targetCompName);
    if (!comp) {
      showStudioToast('⚠️ Componente no encontrado en el modelo.', true);
      return;
    }

    const currentTime = Math.max(0, parseFloat(animTimeSlider?.value || '0') || (viewport?.getActiveClipInfo()?.time || 0));
    const roundedTime = Number(currentTime.toFixed(2));

    const prop = track.property || 'rotation';
    let capturedVal: [number, number, number];
    if (prop === 'rotation') {
      capturedVal = comp.rotation ? [comp.rotation[0], comp.rotation[1], comp.rotation[2]] : [0, 0, 0];
    } else if (prop === 'scale') {
      capturedVal = comp.scale ? [comp.scale[0], comp.scale[1], comp.scale[2]] : [1, 1, 1];
    } else {
      capturedVal = comp.position ? [comp.position[0], comp.position[1], comp.position[2]] : [0, 0, 0];
    }

    const existingKfIdx = track.keyframes.findIndex((k) => Math.abs(k.time - roundedTime) < 0.05);
    if (existingKfIdx >= 0) {
      track.keyframes[existingKfIdx].value = [capturedVal[0], capturedVal[1], capturedVal[2]];
    } else {
      track.keyframes.push({
        time: roundedTime,
        value: [capturedVal[0], capturedVal[1], capturedVal[2]],
        interpolation: track.keyframes[0]?.interpolation || 'linear'
      });
      track.keyframes.sort((a, b) => a.time - b.time);
    }

    const maxT = Math.max(...track.keyframes.map((k) => k.time));
    if (maxT > clip.duration) {
      clip.duration = Number(maxT.toFixed(2));
    }

    renderCurrentSpec('visual', true, true);
    if (animClipSelect) animClipSelect.value = clip.name;
    viewport?.seekAnimation(roundedTime);
    showStudioToast(`📸 Pose capturada en t=${roundedTime}s: [${capturedVal.map((v) => v.toFixed(2)).join(', ')}]`);
  });

