          { "key": "palette_name", "label": "Paleta de Sector", "type": "enum", "default": "industrial_hazard", "options": [{"value":"industrial_hazard","label":"Industrial Hazard"},{"value":"derelict_decay","label":"Derelict Decay"}], "group": "Materiales" }
        ],
