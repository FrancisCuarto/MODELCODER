  // --- CODE EDITOR & COMPILATION ---
  function syncEditorFromSpec(): void {
    if (!codeTextarea) return;
    if (activeFile === 'spec') {
      codeTextarea.value = JSON.stringify(currentSpec, null, 2);
    } else if (activeFile === 'script') {
      codeTextarea.value = generateDslScriptFromSpec(currentSpec);
    } else if (activeFile === 'generator_py') {
      codeTextarea.value = generatePythonFromSpec(currentSpec);
    }
    updateLineNumbers();
  }

  function generateDslScriptFromSpec(spec: ModelSpec): string {
    let out = `// ModelCoder Procedural Builder\nbuilder.setName(${JSON.stringify(spec.name)});\n\n`;
    spec.components.forEach((c) => {
      const fn = c.shape === 'cylinder' ? 'addCylinder' : (c.shape === 'sphere' ? 'addSphere' : (c.shape === 'wedge' ? 'addWedge' : 'addBox'));
      out += `builder.${fn}({\n  name: ${JSON.stringify(c.name)},\n  size: ${JSON.stringify(c.size || [1, 1, 1])},\n  position: ${JSON.stringify(c.position || [0, 0, 0])},\n  color: ${JSON.stringify(c.color || '#4a5568')}\n});\n\n`;
    });
    return out;
  }

  function generatePythonFromSpec(spec: ModelSpec): string {
    const className = spec.name.replace(/[^a-zA-Z0-9]/g, '') + 'Generator';
    return `import bpy\nfrom ...core.base_generator import BaseAssetGenerator\nfrom ...core.mesh_builder import MeshBuilder\n\nclass ${className}(BaseAssetGenerator):\n    """Generador procedural 3D para ${spec.name}."""\n    def generate(self) -> bpy.types.Object:\n        obj, bm = self.create_mesh_object("${spec.id}")\n        # ${spec.components.length} componentes definidos\n        self.finalize_mesh(obj, bm)\n        return obj\n`;
  }

  runCompileBtn?.addEventListener('click', () => compileCode());

  function compileCode(): void {
    if (!codeTextarea) return;
    const code = codeTextarea.value;
    const { spec, error, errorLine } = CodeSandbox.executeCode(code);

    if (error) {
      setLinterError(error, errorLine);
      if (viewport) {
        viewport.displayError(error, `ERR-v${generationCounter}`, generationCounter, 'code');
      }
      return;
    }

    currentSpec = spec;
    selectedComponentIndex = 0;
    renderCurrentSpec('code');
  }

