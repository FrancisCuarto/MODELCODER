  });

  // Check if a model was sent to Studio to edit (from Collaborators or Home)
  const savedSpecStr = typeof window !== 'undefined' ? localStorage.getItem('modelcoder_spec') : null;
  if (savedSpecStr) {
    try {
      const loadedSpec = JSON.parse(savedSpecStr);
      if (loadedSpec && Array.isArray(loadedSpec.components) && loadedSpec.components.length > 0) {
        currentSpec = loadedSpec;
      }
    } catch (err) {
      console.warn('[ModelCoder] Could not parse stored spec:', err);
    }
    localStorage.removeItem('modelcoder_spec');
  }

  // --- HUD TOAST NOTIFICATIONS ---
  function showStudioToast(msg: string, isError = false): void {
    let toast = document.getElementById('studio-hud-toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'studio-hud-toast';
      toast.className = 'studio-hud-toast';
      document.body.appendChild(toast);
    }
    toast.textContent = msg;
    toast.style.borderColor = isError ? '#ef4444' : 'var(--ps1-gold)';
    toast.style.color = isError ? '#ef4444' : 'var(--ps1-gold)';
    toast.classList.add('visible');
    setTimeout(() => {
      toast?.classList.remove('visible');
    }, 3200);
  }

  // --- DRAFTS BADGE SYNCHRONIZATION ---
  function updateDraftsBadge(): void {
    const badge = document.getElementById('studio-drafts-badge');
    if (badge) {
      const drafts = getProjectDrafts();
      badge.textContent = `${drafts.length}`;
    }
  }
  updateDraftsBadge();
  window.addEventListener('modelcoder:inventory_updated', updateDraftsBadge);

  // --- DEBOUNCED AUTO-SAVE ---
  let autoSaveTimer: any = null;
  function triggerAutoSave(): void {
    if (autoSaveTimer) clearTimeout(autoSaveTimer);
    autoSaveTimer = setTimeout(() => {
      try {
        const thumb = viewport ? viewport.getThumbnailDataURL() : undefined;
        saveAutoDraft(currentSpec, thumb);
      } catch (e) {
        console.warn('[ModelCoder] Auto-save skipped:', e);
      }
    }, 3500);
  }

  // --- MODAL: GUARDAR PROYECTO O BORRADOR ---
  const modalSaveProject = document.getElementById('modal-save-project') as HTMLDialogElement | null;
  const btnSaveProject = document.getElementById('btn-save-project');
  const closeSaveProjectBtn = document.getElementById('close-save-project-btn');
  const btnCancelSaveProject = document.getElementById('btn-cancel-save-project');
  const btnConfirmSaveProject = document.getElementById('btn-confirm-save-project');
  const inputSaveName = document.getElementById('save-project-name') as HTMLInputElement | null;
  const selectSaveCat = document.getElementById('save-project-category') as HTMLSelectElement | null;
  const textareaSaveDesc = document.getElementById('save-project-desc') as HTMLTextAreaElement | null;
  const imgSaveThumb = document.getElementById('save-project-thumbnail') as HTMLImageElement | null;
  const placeholderSaveThumb = document.getElementById('save-project-thumb-placeholder');
  const compsSaveCount = document.getElementById('save-project-comps');
  const trisSaveCount = document.getElementById('save-project-tris');

  let currentCapturedThumbnail = '';

  function openSaveProjectModal(): void {
    if (!modalSaveProject) return;
    try {
      currentCapturedThumbnail = viewport ? viewport.getThumbnailDataURL() : '';
      if (imgSaveThumb) {
        if (currentCapturedThumbnail) {
          imgSaveThumb.src = currentCapturedThumbnail;
          imgSaveThumb.style.display = 'block';
          if (placeholderSaveThumb) placeholderSaveThumb.style.display = 'none';
        } else {
          imgSaveThumb.style.display = 'none';
          if (placeholderSaveThumb) placeholderSaveThumb.style.display = 'block';
        }
      }
    } catch (e) {
      console.warn('[ModelCoder] Could not capture thumbnail:', e);
    }

    if (inputSaveName) inputSaveName.value = currentSpec.name || 'Mi Modelo Procedural';
    if (selectSaveCat) selectSaveCat.value = currentSpec.category || 'furniture';
    if (textareaSaveDesc) textareaSaveDesc.value = currentSpec.description || '';
    if (compsSaveCount) compsSaveCount.textContent = `${currentSpec.components?.length || 0}`;
    if (trisSaveCount) trisSaveCount.textContent = `${lastGeometricStats?.triangles || 0}`;

    modalSaveProject.showModal();
  }

  btnSaveProject?.addEventListener('click', openSaveProjectModal);
  closeSaveProjectBtn?.addEventListener('click', () => modalSaveProject?.close());
  btnCancelSaveProject?.addEventListener('click', () => modalSaveProject?.close());

  btnConfirmSaveProject?.addEventListener('click', () => {
    try {
      const name = inputSaveName?.value?.trim() || currentSpec.name || 'Sin Nombre';
      const cat = selectSaveCat?.value || currentSpec.category || 'furniture';
      const desc = textareaSaveDesc?.value?.trim() || currentSpec.description || '';

      currentSpec.name = name;
      currentSpec.category = cat;
      currentSpec.description = desc;

      saveProjectDraft({
        spec: currentSpec,
        name,
        category: cat,
        description: desc,
        thumbnail: currentCapturedThumbnail,
        tri_count: lastGeometricStats?.triangles || 0,
      });

      clearAutoDraft();
      updateDraftsBadge();
      modalSaveProject?.close();
      showStudioToast(`💾 ¡Proyecto '${name}' guardado correctamente!`);
    } catch (err: any) {
      console.error('[ModelCoder] Error guardando proyecto:', err);
      showStudioToast(`❌ Error al guardar: ${err?.message || 'Error inesperado'}`, true);
    }
  });

  const btnSaveProjectAsFile = document.getElementById('btn-save-project-as-file');
  btnSaveProjectAsFile?.addEventListener('click', async () => {
    try {
      const name = inputSaveName?.value?.trim() || currentSpec.name || 'Sin Nombre';
      const cat = selectSaveCat?.value || currentSpec.category || 'furniture';
      const desc = textareaSaveDesc?.value?.trim() || currentSpec.description || '';

      currentSpec.name = name;
      currentSpec.category = cat;
      currentSpec.description = desc;

      saveProjectDraft({
        spec: currentSpec,
        name,
        category: cat,
        description: desc,
        thumbnail: currentCapturedThumbnail,
        tri_count: lastGeometricStats?.triangles || 0,
      });

      const res = await saveProjectToFilePicker(currentSpec);
      if (res.success) {
        clearAutoDraft();
        updateDraftsBadge();
        modalSaveProject?.close();
        if (res.filePath) {
          showStudioToast(`📂 Guardado en: ${res.filePath}`);
        } else {
          showStudioToast(`💾 ¡Proyecto guardado como archivo JSON!`);
        }
      }
    } catch (err: any) {
      console.error('[ModelCoder] Error al elegir dónde guardar archivo:', err);
      showStudioToast(`❌ Error al guardar archivo: ${err?.message || 'Error inesperado'}`, true);
    }
  });

  // --- MODAL: GESTOR DE PROYECTOS Y BORRADORES ---
  const modalMyProjects = document.getElementById('modal-my-projects') as HTMLDialogElement | null;
  const btnMyProjects = document.getElementById('btn-my-projects');
  const closeMyProjectsBtn = document.getElementById('close-my-projects-btn');
  const filterProjectsInput = document.getElementById('filter-projects-input') as HTMLInputElement | null;
  const projectsListContainer = document.getElementById('projects-list-container');
  const inputImportProjectJson = document.getElementById('input-import-project-json') as HTMLInputElement | null;

  function renderProjectsList(filter = ''): void {
    if (!projectsListContainer) return;
    const drafts = getProjectDrafts();
    const query = filter.toLowerCase().trim();
    const filtered = query
      ? drafts.filter(d => d.name.toLowerCase().includes(query) || d.category.toLowerCase().includes(query))
      : drafts;

    if (filtered.length === 0) {
      projectsListContainer.innerHTML = `
        <div class="ps1-inset" style="padding: 2.5rem 1rem; text-align: center; color: var(--text-dim); background: #070d18;">
          <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">📂</div>
          <p style="font-family: var(--font-pixel); font-size: 0.8rem; color: var(--ps1-gold); margin-bottom: 0.4rem;">
            ${query ? 'NO SE ENCONTRARON PROYECTOS CON ESE NOMBRE' : 'NO TIENES PROYECTOS GUARDADOS AÚN'}
          </p>
          <span style="font-size: 0.75rem;">
            ${query ? 'Prueba con otro término de búsqueda.' : 'Guarda tu avance actual con 💾 GUARDAR (o Ctrl+S) para retomarlo en cualquier momento sin perder piezas ni materiales.'}
          </span>
        </div>
      `;
      return;
    }

    projectsListContainer.innerHTML = '';
    filtered.forEach(draft => {
      const card = document.createElement('div');
      card.className = 'project-draft-card ps1-inset';
      const dateStr = new Date(draft.updated_at).toLocaleString();

      card.innerHTML = `
        <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
          <div style="width: 72px; height: 72px; background: #060911; border: 1px solid var(--ps1-steel); display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; border-radius: 2px;">
            ${draft.thumbnail
              ? `<img src="${draft.thumbnail}" alt="${draft.name}" style="width: 100%; height: 100%; object-fit: contain;" />`
              : `<span style="font-size: 1.5rem;">📦</span>`
            }
          </div>
          <div style="flex-grow: 1; min-width: 180px;">
            <div style="display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.2rem; flex-wrap: wrap;">
              <strong style="font-family: var(--font-pixel); font-size: 0.8rem; color: var(--ps1-gold);">${draft.name}</strong>
              <span class="category-badge category-${draft.category}" style="font-size: 0.65rem;">${draft.category}</span>
            </div>
            <p style="font-size: 0.74rem; color: var(--text-dim); margin: 0 0 0.35rem 0; line-height: 1.3;">
              ${draft.description || 'Sin notas.'}
            </p>
            <div style="display: flex; gap: 0.5rem; font-size: 0.68rem; color: var(--ps1-cyan); flex-wrap: wrap;">
              <span>📐 ${draft.components_count} piezas</span>
              <span>&bull;</span>
              <span>🔺 ~${draft.tri_count} tris</span>
              <span>&bull;</span>
              <span style="color: var(--text-dim);">🕒 ${dateStr}</span>
            </div>
          </div>
          <div style="display: flex; gap: 0.35rem; flex-wrap: wrap; align-items: center; justify-content: flex-end;">
            <button class="btn-mini btn-gold btn-resume-draft" data-id="${draft.id}" title="Cargar este modelo en el editor 3D">
              ⚡ RETOMAR
            </button>
            <button class="btn-mini btn-outline btn-duplicate-draft" data-id="${draft.id}" title="Duplicar proyecto">
              📋 DUPLICAR
            </button>
            <button class="btn-mini btn-outline btn-export-json" data-id="${draft.id}" title="Descargar archivo JSON">
              💾 JSON
            </button>
            <button class="btn-mini btn-danger btn-delete-draft" data-id="${draft.id}" title="Eliminar proyecto">
              🗑️
            </button>
          </div>
        </div>
      `;

      projectsListContainer.appendChild(card);
    });

    projectsListContainer.querySelectorAll('.btn-resume-draft').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        if (!id) return;
        const draft = getProjectDraft(id);
        if (draft && draft.spec) {
          currentSpec = JSON.parse(JSON.stringify(draft.spec));
          pushHistoryState(currentSpec);
          renderCurrentSpec('visual', false);
          modalMyProjects?.close();
          showStudioToast(`⚡ Proyecto '${draft.name}' cargado.`);
        }
      });
    });

    projectsListContainer.querySelectorAll('.btn-duplicate-draft').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        if (!id) return;
        duplicateProjectDraft(id);
        updateDraftsBadge();
        renderProjectsList(filterProjectsInput?.value || '');
        showStudioToast('📋 Proyecto duplicado.');
      });
    });

    projectsListContainer.querySelectorAll('.btn-export-json').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        if (!id) return;
        const draft = getProjectDraft(id);
        if (draft) {
          const res = await saveProjectToFilePicker(draft);
          if (res.success && res.filePath) {
            showStudioToast(`📂 Guardado en: ${res.filePath}`);
          }
        } else {
          exportProjectAsJSON(id);
        }
      });
    });

    projectsListContainer.querySelectorAll('.btn-delete-draft').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        if (!id) return;
        if (confirm('¿Seguro que deseas eliminar este proyecto de tus borradores?')) {
          deleteProjectDraft(id);
          updateDraftsBadge();
          renderProjectsList(filterProjectsInput?.value || '');
          showStudioToast('🗑️ Proyecto eliminado.');
        }
      });
    });
  }

  btnMyProjects?.addEventListener('click', () => {
    if (!modalMyProjects) return;
    renderProjectsList();
    modalMyProjects.showModal();
  });
  closeMyProjectsBtn?.addEventListener('click', () => modalMyProjects?.close());

  filterProjectsInput?.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value;
    renderProjectsList(q);
  });

  inputImportProjectJson?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    try {
      const text = await file.text();
      const imported = importProjectFromJSON(text);
      if (imported) {
        updateDraftsBadge();
        renderProjectsList(filterProjectsInput?.value || '');
        showStudioToast(`📂 Proyecto '${imported.name}' importado.`);
      } else {
        alert('El archivo JSON no tiene un formato válido de ModelSpec.');
      }
    } catch (err: any) {
      alert(`Error al importar JSON: ${err.message || err}`);
    }
    (e.target as HTMLInputElement).value = '';
  });

  // --- AUTO-DRAFT DETECTION & RESTORE ---
  const autoDraftBanner = document.getElementById('studio-autodraft-banner');
  const btnAutodraftRestore = document.getElementById('btn-autodraft-restore');
  const btnAutodraftDiscard = document.getElementById('btn-autodraft-discard');

  btnAutodraftRestore?.addEventListener('click', () => {
    const autoDraft = getAutoDraft();
    if (autoDraft && autoDraft.spec) {
      currentSpec = JSON.parse(JSON.stringify(autoDraft.spec));
      pushHistoryState(currentSpec);
      renderCurrentSpec('visual', false);
      if (autoDraftBanner) autoDraftBanner.style.display = 'none';
      showStudioToast('⚡ Sesión de trabajo restaurada.');
    }
  });

  document.getElementById('btn-studio-switch-inv')?.addEventListener('click', () => {
    modalMyProjects?.close();
    document.getElementById('btn-open-global-inventory')?.click();
  });

  btnAutodraftDiscard?.addEventListener('click', () => {
    clearAutoDraft();
    if (autoDraftBanner) autoDraftBanner.style.display = 'none';
  });

  // Check URL parameter ?draft=<id>
  const draftIdParam = typeof window !== 'undefined' ? new URLSearchParams(window.location.search).get('draft') : null;
  if (draftIdParam) {
    const loadedDraft = getProjectDraft(draftIdParam);
    if (loadedDraft && loadedDraft.spec && Array.isArray(loadedDraft.spec.components) && loadedDraft.spec.components.length > 0) {
      currentSpec = JSON.parse(JSON.stringify(loadedDraft.spec));
      pushHistoryState(currentSpec);
      renderCurrentSpec('visual', false);
      showStudioToast(`⚡ Retomando proyecto: ${loadedDraft.name}`);
    }
  }

  // If no explicit draft or stored spec, check if there is an uncommitted auto-draft
  if (!draftIdParam && !savedSpecStr) {
    const autoDraft = getAutoDraft();
    if (autoDraft && autoDraft.spec && Array.isArray(autoDraft.spec.components) && autoDraft.spec.components.length > 0) {
      const nameEl = document.getElementById('autodraft-name');
      const timeEl = document.getElementById('autodraft-time');
      if (autoDraftBanner && nameEl && timeEl) {
        nameEl.textContent = autoDraft.name || autoDraft.spec.name || 'Borrador sin título';
        const d = new Date(autoDraft.updated_at);
        timeEl.textContent = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        autoDraftBanner.style.display = 'flex';
      }
    }
  }

  // --- KEYBOARD SHORTCUT: CTRL + S ---
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
      e.preventDefault();
      openSaveProjectModal();
    }
  });

  // --- MODAL: GENERADOR DE HISTORIAS DE INSTAGRAM (9:16) ---
  const modalIgStory = document.getElementById('modal-ig-story') as HTMLDialogElement | null;
  const btnHeaderStory = document.getElementById('btn-header-story');
  const btnOpenStoryModal = document.getElementById('btn-open-story-modal');
  const closeStoryModalBtn = document.getElementById('close-story-modal-btn');

  const storyPreviewCanvas = document.getElementById('story-preview-canvas') as HTMLCanvasElement | null;
  const storyLoadingOverlay = document.getElementById('story-loading-overlay') as HTMLElement | null;
  const storyPreviewStatus = document.getElementById('story-preview-status');

  const storyInputTitle = document.getElementById('story-input-title') as HTMLInputElement | null;
  const storyInputAuthor = document.getElementById('story-input-author') as HTMLInputElement | null;
  const storyInputDesc = document.getElementById('story-input-desc') as HTMLTextAreaElement | null;
  const storyDescCounter = document.getElementById('story-desc-counter');

  const btnStoryRecaptureCurrent = document.getElementById('btn-story-recapture-current');
  const btnStoryRecaptureAuto = document.getElementById('btn-story-recapture-auto');

  const storyToggleWatermark = document.getElementById('story-toggle-watermark') as HTMLInputElement | null;
  const storyToggleDesc = document.getElementById('story-toggle-desc') as HTMLInputElement | null;
  const storyToggleStats = document.getElementById('story-toggle-stats') as HTMLInputElement | null;
  const storyToggleFrame = document.getElementById('story-toggle-frame') as HTMLInputElement | null;

  const btnDownloadStory = document.getElementById('btn-download-story');
  const btnCopyStoryClipboard = document.getElementById('btn-copy-story-clipboard');
  const btnDownloadStoryVideo = document.getElementById('btn-download-story-video') as HTMLButtonElement | null;
  const btnShareStory = document.getElementById('btn-share-story');

  const btnFormatStory = document.getElementById('btn-format-story');
  const btnFormatPost = document.getElementById('btn-format-post');
  const storyRatioBadge = document.getElementById('story-ratio-badge');
  const storyPreviewFrame = document.getElementById('story-preview-frame');
  const storyPreviewHints = document.getElementById('story-preview-hints');

  let activeSocialFormat: SocialFormat = 'story';
  let activeStoryTheme: StoryTheme = 'cyber_dark';
  let cachedModelRenderCanvas: HTMLCanvasElement | null = null;
  let isStoryRendering = false;

  function setSocialFormat(format: SocialFormat): void {
    activeSocialFormat = format;
    btnFormatStory?.classList.toggle('active', format === 'story');
    btnFormatPost?.classList.toggle('active', format === 'post');

    if (storyPreviewCanvas) {
      storyPreviewCanvas.width = 1080;
      storyPreviewCanvas.height = format === 'post' ? 1080 : 1920;
    }

    if (storyPreviewFrame) {
      storyPreviewFrame.classList.toggle('format-post', format === 'post');
    }

    if (storyRatioBadge) {
      storyRatioBadge.textContent = format === 'post' ? '⏹️ 1:1 CUADRADO (1080 × 1080)' : '📱 9:16 VERTICAL (1080 × 1920)';
    }

    if (storyPreviewStatus) {
      storyPreviewStatus.textContent = format === 'post' ? 'HD 1080×1080' : 'HD 1080×1920';
    }

    if (storyPreviewHints) {
      storyPreviewHints.innerHTML = format === 'post'
        ? '<span>💡 Formato ideal para Feed de Instagram, Twitter/X, LinkedIn y portafolios.</span>'
        : '<span>💡 Listo para Instagram Stories, WhatsApp Status, TikTok y Reels.</span>';
    }

    if (btnDownloadStory) {
      btnDownloadStory.textContent = format === 'post'
        ? '📥 DESCARGAR POST (1080×1080 PNG)'
        : '📥 DESCARGAR HISTORIA (1080×1920 PNG)';
    }

    redrawStoryPreview();
  }

  btnFormatStory?.addEventListener('click', () => setSocialFormat('story'));
  btnFormatPost?.addEventListener('click', () => setSocialFormat('post'));

  async function captureAndRefreshStory(autoFrame: boolean = false): Promise<void> {
    if (!viewport || !storyPreviewCanvas || isStoryRendering) return;
    try {
      isStoryRendering = true;
      if (storyLoadingOverlay) storyLoadingOverlay.style.display = 'flex';
      if (storyPreviewStatus) storyPreviewStatus.textContent = 'RENDERIZANDO...';

      // Capture high-res offscreen render of the 3D model
      cachedModelRenderCanvas = await viewport.captureStoryRender({
        width: 1080,
        height: 1080,
        autoFrame
      });

      redrawStoryPreview();
      if (storyPreviewStatus) storyPreviewStatus.textContent = activeSocialFormat === 'post' ? 'HD 1080×1080' : 'HD 1080×1920';
    } catch (err: any) {
      console.warn('[ModelCoder] Error capturando render para historia:', err);
      if (storyPreviewStatus) storyPreviewStatus.textContent = 'ERROR RENDER';
      showStudioToast('⚠️ No se pudo generar la captura 3D de la historia.', true);
    } finally {
      isStoryRendering = false;
      if (storyLoadingOverlay) storyLoadingOverlay.style.display = 'none';
    }
  }

  function getStoryOptions(): StoryOptions {
    const rawTitle = storyInputTitle?.value.trim() || currentSpec.name || 'MODELO 3D';
    const rawDesc = storyInputDesc?.value.trim() || currentSpec.description || '';
    const rawAuthor = storyInputAuthor?.value.trim() || '';

    // Summarize materials
    const compMaterials = (currentSpec.components || [])
      .map(c => c.texturePreset || c.material?.type || 'pbr')
      .filter((v, i, a) => a.indexOf(v) === i)
      .slice(0, 2)
      .map(p => p.toUpperCase().replace(/_/g, ' '))
      .join(' · ');

    const hudGenId = document.getElementById('hud-gen-id')?.textContent?.trim() || 'GEN-3D';

    return {
      format: activeSocialFormat,
      title: rawTitle,
      description: rawDesc,
      author: rawAuthor,
      theme: activeStoryTheme,
      showWatermark: storyToggleWatermark ? storyToggleWatermark.checked : true,
      showDescription: storyToggleDesc ? storyToggleDesc.checked : true,
      showStats: storyToggleStats ? storyToggleStats.checked : true,
      showTechFrame: storyToggleFrame ? storyToggleFrame.checked : true,
      stats: {
        triangles: lastGeometricStats?.triangles || (document.getElementById('hud-tris')?.textContent?.replace(/\D/g, '') || '0'),
        vertices: lastGeometricStats?.vertices || (document.getElementById('hud-verts')?.textContent?.replace(/\D/g, '') || '0'),
        componentCount: currentSpec.components?.length || 1,
        materialsSummary: compMaterials || 'PBR TEXTURED',
        generationId: hudGenId
      }
    };
  }

  function redrawStoryPreview(): void {
    if (!storyPreviewCanvas) return;
    const options = getStoryOptions();
    drawStoryCard(cachedModelRenderCanvas, options, storyPreviewCanvas);
  }

  async function openStoryModal(): Promise<void> {
    if (!modalIgStory) return;

    // Pre-populate fields from currentSpec
    if (storyInputTitle) {
      storyInputTitle.value = currentSpec.name || 'Modelo 3D';
    }
    if (storyInputDesc) {
      storyInputDesc.value = currentSpec.description || '';
      if (storyDescCounter) {
        storyDescCounter.textContent = `${storyInputDesc.value.length} / 180`;
      }
    }

    modalIgStory.showModal();
    // Default: capture using current camera angle
    await captureAndRefreshStory(false);
  }

  btnHeaderStory?.addEventListener('click', openStoryModal);
  btnOpenStoryModal?.addEventListener('click', openStoryModal);
  closeStoryModalBtn?.addEventListener('click', () => modalIgStory?.close());

  // Theme buttons
  document.querySelectorAll('.story-theme-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.story-theme-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeStoryTheme = (btn.getAttribute('data-theme') as StoryTheme) || 'cyber_dark';
      redrawStoryPreview();
    });
  });

  // Inputs
  storyInputTitle?.addEventListener('input', () => redrawStoryPreview());
  storyInputAuthor?.addEventListener('input', () => redrawStoryPreview());
  storyInputDesc?.addEventListener('input', () => {
    if (storyDescCounter && storyInputDesc) {
      storyDescCounter.textContent = `${storyInputDesc.value.length} / 180`;
    }
    redrawStoryPreview();
  });

  // Toggles
  storyToggleWatermark?.addEventListener('change', () => redrawStoryPreview());
  storyToggleDesc?.addEventListener('change', () => redrawStoryPreview());
  storyToggleStats?.addEventListener('change', () => redrawStoryPreview());
  storyToggleFrame?.addEventListener('change', () => redrawStoryPreview());

  // Camera angles
  btnStoryRecaptureCurrent?.addEventListener('click', async () => {
    btnStoryRecaptureCurrent.classList.add('active');
    btnStoryRecaptureAuto?.classList.remove('active');
    await captureAndRefreshStory(false);
  });
  btnStoryRecaptureAuto?.addEventListener('click', async () => {
    btnStoryRecaptureAuto.classList.add('active');
    btnStoryRecaptureCurrent?.classList.remove('active');
    await captureAndRefreshStory(true);
