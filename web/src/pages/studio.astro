    flex-direction: column;
    height: 100%;
  }

  .viewport-main-titlebar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 0.35rem 0.6rem;
  }

  .viewport-title-left {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .viewport-tag {
    font-size: 0.68rem;
    color: var(--ps1-cyan);
    font-family: var(--font-pixel);
  }

  .viewport-model-title {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: bold;
    color: var(--text-bright);
  }

  /* Precision Snapping & Face Magnet */
  .snap-select {
    background: #060a14;
    border: 1px solid #1e293b;
    color: #94a3b8;
    font-family: var(--font-pixel);
    font-size: 0.6rem;
    padding: 0.2rem 0.3rem;
    cursor: pointer;
    outline: none;
    border-radius: 2px;
  }
  .snap-select:hover, .snap-select:focus {
    border-color: var(--ps1-cyan);
    color: #fff;
  }
  .btn-gizmo#gizmo-btn-magnet.active {
    background: #00ffcc;
    color: #000;
    font-weight: bold;
    border-color: #00ffcc;
  }

  .face-magnet-banner {
    position: absolute;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(10, 16, 28, 0.95);
    border: 1px solid #00ffcc;
    box-shadow: 0 4px 20px rgba(0, 255, 204, 0.25);
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    z-index: 50;
    font-family: var(--font-pixel);
    font-size: 0.75rem;
    color: #e2e8f0;
    pointer-events: auto;
    border-radius: 2px;
  }
  .face-magnet-banner.hidden {
    display: none;
  }
  .face-magnet-banner .magnet-icon {
    font-size: 1.1rem;
    animation: pulse 1.5s infinite ease-in-out;
  }
  .btn-cancel-magnet-pill {
    background: #ef4444;
    color: #fff;
    border: none;
    font-size: 0.65rem;
    font-family: var(--font-pixel);
    padding: 0.2rem 0.5rem;
    cursor: pointer;
    border-radius: 2px;
  }
  .btn-cancel-magnet-pill:hover {
    background: #dc2626;
  }

  .alignment-tools-block {
    margin-top: 0.6rem;
    padding: 0.5rem;
    background: #060a14;
    border: 1px dashed #23314d;
  }
  .alignment-actions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35rem;
    margin-top: 0.35rem;
  }
  .btn-align {
    font-size: 0.65rem;
    padding: 0.25rem 0.2rem;
    background: #091122;
    border: 1px solid #1e293b;
    color: #cbd5e1;
    cursor: pointer;
    text-align: center;
    white-space: nowrap;
    transition: all 0.12s ease;
  }
  .btn-align:hover {
    border-color: var(--ps1-cyan);
    color: var(--ps1-cyan);
    background: #0e1e3b;
  }
  .btn-align.active {
    background: #00ffcc;
    color: #000;
    font-weight: bold;
    border-color: #00ffcc;
  }

  .parent-align-wrap {
    margin-top: 0.5rem;
    padding-top: 0.4rem;
    border-top: 1px solid #1a253a;
  }
  .parent-align-title {
    font-size: 0.62rem;
    color: #94a3b8;
    margin-bottom: 0.3rem;
  }
  .parent-badge-name {
    color: var(--ps1-gold);
    font-weight: bold;
  }
  .parent-faces-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.25rem;
  }
  .btn-parent-face {
    font-size: 0.62rem;
    padding: 0.18rem 0.2rem;
    background: #0b1528;
    border: 1px solid #1e293b;
    color: #94a3b8;
    cursor: pointer;
    text-align: center;
    transition: all 0.12s ease;
  }
  .btn-parent-face:hover {
    border-color: var(--ps1-gold);
    color: var(--ps1-gold);
    background: #15243d;
  }

  /* Boolean & Array Blocks */
  .bool-header-row {
    margin-bottom: 0.5rem;
  }
  .bool-toggle-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-pixel);
    font-size: 0.68rem;
    color: var(--ps1-cyan);
    cursor: pointer;
  }
  .bool-ops-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.3rem;
    margin-top: 0.25rem;
  }
  .btn-bool-op, .btn-array-type {
    font-size: 0.62rem;
    padding: 0.25rem 0.2rem;
    background: #091122;
    border: 1px solid #1e293b;
    color: #94a3b8;
    cursor: pointer;
    text-align: center;
    white-space: nowrap;
    transition: all 0.12s ease;
  }
  .btn-bool-op:hover, .btn-array-type:hover {
    border-color: var(--ps1-cyan);
    color: #fff;
  }
  .btn-bool-op.active, .btn-array-type.active {
    background: var(--ps1-cyan);
    color: #000;
    font-weight: bold;
    border-color: var(--ps1-cyan);
  }
  .bool-target-select {
    width: 100%;
    margin-top: 0.25rem;
  }
  .btn-bake-bool {
    background: #0f1c33;
    border: 1px solid var(--ps1-gold);
    color: var(--ps1-gold);
    font-family: var(--font-pixel);
    font-size: 0.65rem;
    padding: 0.35rem 0.5rem;
    cursor: pointer;
    width: 100%;
    transition: all 0.15s ease;
  }
  .btn-bake-bool:hover {
    background: var(--ps1-gold);
    color: #000;
    font-weight: bold;
  }
  .disabled-wrap {
    opacity: 0.45;
    pointer-events: none;
  }
  .outliner-bool-tag {
    font-size: 0.55rem;
    background: rgba(0, 255, 204, 0.2);
    border: 1px solid var(--ps1-cyan);
    color: var(--ps1-cyan);
    padding: 0 0.25rem;
    border-radius: 2px;
    margin-left: 0.25rem;
  }
  .outliner-array-tag {
    font-size: 0.55rem;
    background: rgba(255, 215, 0, 0.2);
    border: 1px solid var(--ps1-gold);
    color: var(--ps1-gold);
    padding: 0 0.25rem;
    border-radius: 2px;
    margin-left: 0.25rem;
  }

  /* Gizmo Toolbar */
  .gizmo-toolbar {
    display: flex;
    gap: 0.25rem;
    background: #080d18;
    border: 1px solid #1a253a;
    padding: 0.15rem;
  }

  .btn-gizmo {
    background: transparent;
    border: 1px solid transparent;
    color: #94a3b8;
    font-family: var(--font-pixel);
    font-size: 0.62rem;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    transition: all 0.12s ease;
  }

  .btn-gizmo:hover {
    color: var(--text-bright);
    border-color: #2e3c54;
  }

  .btn-gizmo.active {
    background: var(--ps1-cyan);
    color: #000;
    font-weight: bold;
    border-color: var(--ps1-cyan);
  }

  .btn-gizmo#gizmo-btn-snap.active {
    background: var(--ps1-gold);
    color: #000;
  }

  .viewport-camera-tools {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .camera-presets-group {
    display: flex;
    gap: 0.2rem;
  }

  .btn-cam-preset {
    font-size: 0.62rem;
    padding: 0.2rem 0.4rem;
  }

  .studio-viewport-surface {
    position: relative;
    width: 100%;
    height: 520px;
    overflow: hidden;
    background: #060910;
  }

  .three-canvas-mount {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    overflow: hidden !important;
    display: block;
  }

  .three-canvas-mount canvas {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
  }

  .viewport-overlay-controls {
    position: absolute;
    top: 8px;
    left: 8px;
    right: 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
  }

  .shading-toggles {
    display: flex;
    gap: 0.25rem;
    pointer-events: auto;
    background: rgba(6, 9, 16, 0.75);
    backdrop-filter: blur(4px);
    padding: 0.2rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .btn-shading {
    background: transparent;
    border: 1px solid transparent;
    color: #94a3b8;
    font-family: var(--font-pixel);
    font-size: 0.62rem;
    padding: 0.25rem 0.45rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-shading:hover {
    color: var(--text-bright);
  }

  .btn-shading.active {
    background: var(--ps1-cyan);
    color: #000;
    font-weight: bold;
  }

  .generation-status-badge {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(6, 9, 16, 0.85);
    border: 1px solid var(--border-color);
    padding: 0.25rem 0.6rem;
    font-family: var(--font-pixel);
    font-size: 0.65rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot-completed { background: #10b981; box-shadow: 0 0 6px #10b981; }
  .dot-generating { background: var(--ps1-cyan); box-shadow: 0 0 6px var(--ps1-cyan); animation: pulse 1s infinite alternate; }
  .dot-error { background: #ef4444; box-shadow: 0 0 6px #ef4444; }

  .viewport-stats-hud {
    position: absolute;
    bottom: 8px;
    left: 8px;
    background: rgba(4, 6, 12, 0.85);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(0, 240, 255, 0.3);
    padding: 0.4rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    pointer-events: none;
  }

  .hud-lbl { color: #64748b; margin-right: 0.3rem; }
  .hud-val { color: var(--ps1-cyan); font-weight: bold; }

  .viewport-selection-pill {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: rgba(14, 28, 48, 0.88);
    backdrop-filter: blur(4px);
    border: 1px solid var(--ps1-cyan);
    padding: 0.3rem 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #e2e8f0;
    pointer-events: none;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ps1-cyan);
    box-shadow: 0 0 5px var(--ps1-cyan);
  }

  .viewport-error-banner {
    position: absolute;
    bottom: 8px;
    right: 8px;
    left: 8px;
    background: rgba(40, 8, 8, 0.95);
    border: 1px solid #ef4444;
    padding: 0.6rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    z-index: 20;
  }

  .error-banner-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #fca5a5;
    font-family: var(--font-pixel);
    font-size: 0.75rem;
    margin-bottom: 0.3rem;
  }

  .btn-mini-close {
    margin-left: auto;
    background: transparent;
    border: none;
    color: #fca5a5;
    cursor: pointer;
    font-weight: bold;
  }

  .error-banner-body { color: #fee2e2; margin-bottom: 0.25rem; }
  .error-banner-footer { color: #94a3b8; font-size: 0.65rem; }

  /* Properties Inspector Panel */
  .inspector-column {
    display: flex;
    flex-direction: column;
  }

  .inspector-window {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .inspector-scroll-body {
    flex: 1;
    overflow-y: auto;
    padding: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: #060912;
    max-height: calc(100vh - 200px);
  }

  .inspector-empty-state {
    padding: 2.5rem 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .empty-icon {
    font-size: 2rem;
    opacity: 0.7;
  }

  .empty-title {
    font-family: var(--font-pixel);
    font-size: 0.8rem;
    color: var(--ps1-cyan);
    margin: 0;
  }

  .empty-desc {
    font-size: 0.72rem;
    color: var(--text-dim);
    line-height: 1.4;
  }

  .prop-card-header {
    background: #090e1a;
    border: 1px solid #1a253a;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .comp-name-editor {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    font-weight: bold;
    color: var(--ps1-cyan);
    background: #040710;
  }

  .prop-parent-row {
    margin-top: 0.35rem;
  }

  .comp-parent-selector {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: #e2e8f0;
    background: #040710;
    border: 1px solid #1e293b;
    padding: 0.25rem 0.4rem;
    width: 100%;
  }

  .comp-parent-selector:focus {
    border-color: var(--ps1-cyan);
    outline: none;
  }

  .prop-quick-btns {
    display: flex;
    gap: 0.3rem;
  }

  .prop-section {
    background: #080c16;
    border: 1px solid #192336;
    padding: 0.55rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .section-titlebar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.35rem;
    margin-bottom: 0.2rem;
  }

  .section-badge {
    background: var(--ps1-cyan);
    color: #000;
    font-family: var(--font-pixel);
    font-size: 0.6rem;
    padding: 0.1rem 0.35rem;
    font-weight: bold;
  }

  .section-heading {
    font-family: var(--font-pixel);
    font-size: 0.68rem;
    color: var(--text-bright);
    letter-spacing: 0.5px;
    flex: 1;
  }

  .btn-mini-link {
    background: transparent;
    border: none;
    color: var(--ps1-gold);
    font-family: var(--font-pixel);
    font-size: 0.62rem;
    cursor: pointer;
    padding: 0;
  }

  .btn-mini-link:hover {
    text-decoration: underline;
  }

  .prop-field-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .field-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .field-label {
    font-size: 0.65rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .field-unit-tag {
    font-size: 0.62rem;
    color: #64748b;
    font-family: var(--font-mono);
  }

  .lock-proportions-toggle {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.62rem;
    color: var(--ps1-gold);
    font-family: var(--font-mono);
    cursor: pointer;
  }

  .coord-3-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35rem;
  }

  .coord-2-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.35rem;
  }

  .coord-input-wrap {
    display: flex;
    align-items: center;
    background: #04060c;
    border: 1px solid #23314d;
    padding: 0 0.3rem;
  }

  .pivot-presets-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.35rem;
  }

  .btn-piv-preset {
    font-size: 0.65rem;
    padding: 0.12rem 0.35rem;
    background: #080f1e;
    border: 1px solid #1e293b;
    color: #94a3b8;
    cursor: pointer;
    transition: all 0.12s ease;
  }

  .btn-piv-preset:hover {
    border-color: var(--ps1-cyan);
    color: var(--ps1-cyan);
    background: #0d1b33;
  }

  .axis-tag {
    font-size: 0.65rem;
    font-weight: bold;
    font-family: var(--font-mono);
    margin-right: 0.25rem;
  }

  .axis-x { color: #ef4444; }
  .axis-y { color: #10b981; }
  .axis-z { color: #3b82f6; }

  .coord-num-inp {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-bright);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.25rem 0;
    outline: none;
    width: 100%;
  }

  .effective-dims-box {
    background: #04060c;
    border-left: 2px solid var(--ps1-cyan);
    padding: 0.35rem 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .eff-label {
    font-size: 0.58rem;
    color: #64748b;
    font-family: var(--font-pixel);
  }

  .eff-val {
    font-size: 0.68rem;
    color: var(--ps1-cyan);
    font-family: var(--font-mono);
    font-weight: bold;
  }

  /* Shape Specific Grids */
  .shape-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.4rem;
  }

  .shape-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.4rem;
  }

  .shape-field {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .unit-input-wrap {
    display: flex;
    align-items: center;
    background: #04060c;
    border: 1px solid #23314d;
    padding: 0 0.35rem;
  }

  .shape-num-inp {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-bright);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.25rem 0;
    outline: none;
    width: 100%;
  }

  .unit-sym {
    font-size: 0.65rem;
    color: #64748b;
    font-family: var(--font-mono);
  }

  /* Material & Color Controls */
  .prop-field-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .color-picker-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .color-swatch-input {
    width: 28px;
    height: 24px;
    border: 1px solid #2d3748;
    background: transparent;
    cursor: pointer;
    padding: 0;
  }

  .color-hex-input {
    width: 80px;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    padding: 0.2rem 0.4rem;
  }

  .texture-dropdown {
    font-size: 0.72rem;
    padding: 0.3rem 0.5rem;
    font-family: var(--font-mono);
  }

  .checkbox-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.68rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    cursor: pointer;
  }

  /* Code Editor Surface */
  .editor-window {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .editor-tabs {
    display: flex;
    background: #060910;
    border-bottom: 1px solid var(--border-color);
  }

  .editor-tab {
    background: transparent;
    border: none;
    border-right: 1px solid var(--border-color);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.45rem 0.85rem;
    cursor: pointer;
  }

  .editor-tab.active {
    background: #0d1424;
    color: var(--ps1-cyan);
    border-bottom: 2px solid var(--ps1-cyan);
  }

  .tab-badge {
    font-size: 0.6rem;
    padding: 0.1rem 0.3rem;
    background: #1e293b;
    color: #94a3b8;
    margin-left: 0.3rem;
  }

  .editor-surface {
    flex: 1;
    display: flex;
    background: #05070e;
    min-height: 480px;
    position: relative;
  }

  .line-numbers {
    width: 40px;
    background: #030408;
    color: #475569;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    padding: 0.5rem 0.3rem;
    text-align: right;
    user-select: none;
  }

  #code-textarea {
    flex: 1;
    background: transparent;
    border: none;
    color: #e2e8f0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.4;
    padding: 0.5rem;
    resize: none;
    outline: none;
    white-space: pre;
    overflow-x: auto;
  }

  .editor-statusbar {
    display: flex;
    justify-content: space-between;
    background: #030408;
    border-top: 1px solid var(--border-color);
    padding: 0.25rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: #64748b;
  }

  /* AI Copilot Styling */
  .ai-copilot-body {
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .engine-selector-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: #090e18;
    border: 1px solid #1a253a;
    padding: 0.45rem 0.65rem;
    flex-wrap: wrap;
  }

  .selector-heading {
    font-family: var(--font-pixel);
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .engine-toggle-buttons {
    display: flex;
    gap: 0.4rem;
    flex: 1;
    flex-wrap: wrap;
  }

  .btn-engine-toggle {
    background: #0d1424;
    border: 1px solid #23314d;
    color: #94a3b8;
    font-family: var(--font-pixel);
    font-size: 0.72rem;
    padding: 0.35rem 0.75rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: all 0.15s ease;
  }

  .btn-engine-toggle:hover {
    border-color: var(--ps1-cyan);
    color: var(--text-bright);
  }

  .btn-engine-toggle.active {
    background: #0e2a38;
    border-color: var(--ps1-cyan);
    color: var(--ps1-cyan);
    box-shadow: 0 0 8px rgba(0, 240, 255, 0.25);
    font-weight: bold;
  }

  .badge-unique {
    font-size: 0.58rem;
    padding: 0.1rem 0.35rem;
    background: #e11d48;
    color: #fff;
    border-radius: 2px;
    font-weight: 800;
  }

  .ai-prompt-row {
    display: flex;
    gap: 0.5rem;
    align-items: stretch;
  }

  .prompt-input-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    background: #080c14;
    border: 1px solid var(--border-color);
    padding: 0 0.6rem;
  }

  .prompt-prefix {
    font-family: var(--font-pixel);
    font-size: 0.7rem;
    color: var(--ps1-cyan);
    margin-right: 0.5rem;
    white-space: nowrap;
  }

  .ai-prompt-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-bright);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.6rem 0;
    outline: none;
  }

  .ai-generate-btn {
    font-family: var(--font-pixel);
    font-size: 0.8rem;
    padding: 0 1.25rem;
    white-space: nowrap;
  }

  .ai-chips-row {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .chips-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-family: var(--font-pixel);
  }

  .ai-chip {
    background: #0e1526;
    border: 1px solid #1e293b;
    color: #94a3b8;
    font-size: 0.72rem;
    padding: 0.25rem 0.55rem;
    cursor: pointer;
    font-family: var(--font-mono);
    transition: all 0.15s ease;
  }

  .ai-chip:hover {
    border-color: var(--ps1-cyan);
    color: var(--ps1-cyan);
    background: #141e34;
  }

  .ai-status-indicator {
    padding: 0.6rem 0.8rem;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    border-left: 3px solid var(--ps1-cyan);
    background: #080d18;
  }

  .ai-status-indicator.status-loading { border-color: var(--ps1-gold); color: var(--ps1-gold); }
  .ai-status-indicator.status-ok { border-color: var(--ps1-green); color: var(--ps1-green); }
  .ai-status-indicator.status-error { border-color: #ef4444; color: #ef4444; }

  /* Quick Adjust Panel */
  .quick-adjust-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.6rem;
  }

  .param-row {
    display: grid;
    grid-template-columns: 140px 1fr 50px;
    align-items: center;
    gap: 0.6rem;
  }

  .param-label {
    font-size: 0.7rem;
    color: #cbd5e1;
    font-family: var(--font-mono);
  }

  .param-val-disp {
    font-size: 0.7rem;
    color: var(--ps1-cyan);
    font-family: var(--font-mono);
    text-align: right;
  }

  /* Docs Modal */
  .docs-modal {
    width: 900px;
    max-width: 95vw;
    height: 600px;
    background: #080c16;
    border: 2px solid var(--ps1-cyan);
    color: #e2e8f0;
    padding: 0;
  }

  .docs-modal-body {
    display: grid;
    grid-template-columns: 240px 1fr;
    height: calc(100% - 35px);
  }

  .docs-nav-tabs {
    background: #04060c;
    border-right: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .doc-tab {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: #94a3b8;
    text-align: left;
    padding: 0.6rem 0.8rem;
    font-size: 0.72rem;
    font-family: var(--font-pixel);
    cursor: pointer;
  }

  .doc-tab.active {
    background: #0d1527;
    color: var(--ps1-cyan);
    border-left: 3px solid var(--ps1-cyan);
  }

  .docs-content-area {
    padding: 1.25rem;
    overflow-y: auto;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .doc-section { display: none; }
  .doc-section.active { display: block; }
  .doc-section h3 {
    font-family: var(--font-pixel);
    color: var(--ps1-cyan);
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }

  .doc-section pre {
    background: #020408;
    padding: 0.75rem;
    border: 1px solid #1e293b;
    overflow-x: auto;
    font-size: 0.75rem;
  }

  /* PBR Material Browser in Studio Inspector */
  .mat-browser-panel {
    margin-top: 0.45rem;
    padding: 0.45rem;
    background: #050811;
    border: 1px solid #1e293b;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .mat-browser-toolbar {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .mat-search-inp {
    font-size: 0.72rem;
    padding: 0.3rem 0.45rem;
    background: #090e1a;
  }

  .mat-cat-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .mat-cat-pill {
    background: #0b1324;
    border: 1px solid #1e293b;
    color: #94a3b8;
    font-family: var(--font-mono);
    font-size: 0.63rem;
    padding: 0.18rem 0.4rem;
    cursor: pointer;
    border-radius: 2px;
    transition: all 0.12s ease;
  }

  .mat-cat-pill:hover {
    border-color: var(--ps1-cyan);
    color: #e2e8f0;
  }

  .mat-cat-pill.active {
    background: rgba(0, 240, 255, 0.14);
    border-color: var(--ps1-cyan);
    color: var(--ps1-cyan);
    font-weight: 700;
  }

  .mat-browser-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.32rem;
    max-height: 210px;
    overflow-y: auto;
    padding-right: 0.15rem;
  }

  .mat-card-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem;
    background: #0a101d;
    border: 1px solid #1e293b;
    color: #cbd5e1;
    text-align: left;
    cursor: pointer;
    border-radius: 2px;
    transition: border-color 0.12s ease, background 0.12s ease;
  }

  .mat-card-btn:hover {
    background: #111b30;
    border-color: #38bdf8;
  }

  .mat-card-btn.active {
    background: rgba(255, 176, 0, 0.14);
    border-color: var(--ps1-gold);
    box-shadow: inset 0 0 0 1px rgba(255, 176, 0, 0.4);
  }

  .mat-card-thumb {
    width: 30px;
    height: 30px;
    border-radius: 2px;
    border: 1px solid #334155;
    flex-shrink: 0;
    image-rendering: pixelated;
    background: #020408;
  }

  .mat-card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    min-width: 0;
    flex: 1;
  }

  .mat-card-title {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    line-height: 1.15;
    color: #e2e8f0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mat-card-badges {
    display: flex;
    gap: 0.2rem;
    flex-wrap: wrap;
  }

  .mat-pbr-badge {
    font-family: var(--font-mono);
    font-size: 0.52rem;
    padding: 0.04rem 0.22rem;
    border-radius: 2px;
    background: #1e293b;
    color: #94a3b8;
    letter-spacing: 0.02em;
  }

  .mat-pbr-badge.badge-norm { color: #60a5fa; background: rgba(59, 130, 246, 0.15); }
  .mat-pbr-badge.badge-metal { color: #fbbf24; background: rgba(251, 191, 36, 0.15); }
  .mat-pbr-badge.badge-emissive { color: #34d399; background: rgba(52, 211, 153, 0.15); }
  .mat-pbr-badge.badge-alpha { color: #38bdf8; background: rgba(56, 189, 248, 0.15); }
  .mat-pbr-badge.badge-var { color: #c084fc; background: rgba(192, 132, 252, 0.15); }

  .mat-empty-msg {
    grid-column: 1 / -1;
    text-align: center;
    font-size: 0.7rem;
    color: #64748b;
    padding: 0.75rem 0.25rem;
  }

  .uv-rot-presets {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .uv-rot-btn {
    background: #0b1324;
    border: 1px solid #1e293b;
    color: #94a3b8;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    padding: 0.1rem 0.3rem;
    cursor: pointer;
    border-radius: 2px;
  }

  .uv-rot-btn:hover {
    border-color: var(--ps1-cyan);
    color: var(--ps1-cyan);
  }

  /* Collapsible Inspector Tabs & Sections */
  .inspector-tabs-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.35rem;
    background: #070b15;
    border: 1px solid #1a253a;
  }

  .insp-tab-pill {
    flex: 1 1 auto;
    background: #0b1222;
    border: 1px solid #1e293b;
    color: #94a3b8;
    font-family: var(--font-pixel);
    font-size: 0.58rem;
    padding: 0.22rem 0.38rem;
    cursor: pointer;
    border-radius: 2px;
    text-align: center;
    transition: all 0.12s ease;
    white-space: nowrap;
  }

  .insp-tab-pill:hover {
    border-color: var(--ps1-cyan);
    color: #f8fafc;
  }

  .insp-tab-pill.active {
    background: rgba(0, 240, 255, 0.14);
    border-color: var(--ps1-cyan);
    color: var(--ps1-cyan);
    font-weight: bold;
  }

  .insp-tab-pill.insp-tab-all {
    background: #141c2f;
    border-color: #334155;
    color: var(--ps1-gold);
  }

  .insp-tab-pill.insp-tab-all:hover {
    border-color: var(--ps1-gold);
    background: rgba(255, 176, 0, 0.15);
  }

  .section-toggle-header {
    cursor: pointer;
    user-select: none;
    padding: 0.25rem 0.2rem;
    border-radius: 2px;
    transition: background 0.12s ease;
  }

  .section-toggle-header:hover {
    background: rgba(0, 240, 255, 0.06);
  }

  .sec-chevron {
    font-size: 0.62rem;
    color: var(--ps1-cyan);
    font-family: var(--font-mono);
    margin-left: 0.25rem;
    transition: transform 0.15s ease;
  }

  .sec-active-tex-pill {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    color: var(--ps1-gold);
    background: rgba(255, 176, 0, 0.12);
    border: 1px solid rgba(255, 176, 0, 0.35);
    padding: 0.06rem 0.32rem;
    border-radius: 2px;
    max-width: 110px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .collapsible-section > .section-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.2rem;
  }

  .collapsible-section.is-collapsed > .section-body {
    display: none;
  }

  .collapsible-section.is-collapsed > .section-titlebar {
    border-bottom: none;
    padding-bottom: 0.1rem;
    margin-bottom: 0;
  }

  /* UV Adapt Buttons */
  .uv-adapt-actions {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .btn-adapt-uv {
    flex: 1;
    font-family: var(--font-pixel);
    font-size: 0.62rem;
    padding: 0.38rem 0.5rem;
    cursor: pointer;
    border-radius: 2px;
    transition: all 0.14s ease;
    text-align: center;
    white-space: nowrap;
  }

  .btn-adapt-primary {
    background: rgba(0, 240, 255, 0.14);
    border: 1px solid var(--ps1-cyan);
    color: var(--ps1-cyan);
    font-weight: bold;
    box-shadow: 0 0 8px rgba(0, 240, 255, 0.15);
  }

  .btn-adapt-primary:hover {
    background: rgba(0, 240, 255, 0.25);
    color: #fff;
  }

  .btn-adapt-secondary {
    flex: 0 0 auto;
    background: #0c1426;
    border: 1px solid #2b3b59;
    color: #cbd5e1;
  }

  .btn-adapt-secondary:hover {
    border-color: var(--ps1-gold);
    color: var(--ps1-gold);
  }

  /* Instagram Story Modal (9:16) Styles */
  .ig-story-modal {
    background: #080c16;
    border: 2px solid var(--ps1-cyan);
    box-shadow: 0 0 25px rgba(0, 240, 255, 0.25);
    color: #e2e8f0;
    padding: 0;
  }

  .story-modal-grid {
    display: grid;
    grid-template-columns: 290px 1fr;
    gap: 1.5rem;
    align-items: start;
  }
  @media (max-width: 800px) {
    .story-modal-grid {
      grid-template-columns: 1fr;
    }
  }

  .story-preview-column {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .story-preview-header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.4rem;
    font-size: 0.68rem;
    font-family: var(--font-mono);
  }
  .story-ratio-badge {
    color: var(--ps1-cyan);
    font-weight: 700;
  }
  .story-status-badge {
    color: var(--ps1-gold);
    font-weight: 700;
  }
  .story-preview-frame {
    position: relative;
    width: 270px;
    height: 480px;
    background: #04060b;
    border: 2px solid var(--ps1-steel);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.8), 0 0 15px rgba(0, 240, 255, 0.15);
    transition: width 0.25s ease, height 0.25s ease;
  }
  .story-preview-frame.format-post {
    width: 340px;
    height: 340px;
  }
  @media (max-width: 800px) {
    .story-preview-frame.format-post {
      width: 270px;
      height: 270px;
    }
  }
  .story-canvas-render {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .story-loading-overlay {
    position: absolute;
    inset: 0;
    background: rgba(4, 6, 11, 0.85);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-pixel);
    font-size: 0.7rem;
    color: var(--ps1-cyan);
    z-index: 10;
  }
  .story-spinner {
    font-size: 1.5rem;
    animation: storySpin 1s infinite linear;
  }
  @keyframes storySpin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  .story-preview-hints {
    margin-top: 0.6rem;
    font-size: 0.72rem;
    color: var(--text-dim);
    text-align: center;
  }

  .story-options-column {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .story-form-group {
    display: flex;
    flex-direction: column;
  }
  .story-label {
    font-family: var(--font-pixel);
    font-size: 0.72rem;
    color: var(--ps1-gold);
    margin-bottom: 0.25rem;
    letter-spacing: 0.5px;
  }
  .story-format-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.55rem 0.65rem;
    background: #0f141f;
    border: 1px solid var(--ps1-steel);
    border-radius: 4px;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .story-format-btn:hover {
    border-color: var(--ps1-cyan);
    background: #141b2b;
  }
  .story-format-btn.active {
    border-color: var(--ps1-cyan);
    background: rgba(0, 240, 255, 0.15);
    box-shadow: 0 0 12px rgba(0, 240, 255, 0.3);
    color: var(--ps1-cyan);
    font-weight: 700;
  }
  .story-theme-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 0.45rem;
  }
  .story-theme-btn {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.6rem;
    background: #0f141f;
    border: 1px solid var(--ps1-steel);
    border-radius: 4px;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .story-theme-btn:hover {
    border-color: var(--ps1-cyan);
    background: #141b2b;
  }
  .story-theme-btn.active {
    border-color: var(--ps1-cyan);
    background: rgba(0, 240, 255, 0.12);
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.25);
    color: var(--ps1-cyan);
    font-weight: 700;
  }
  .theme-swatch {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    flex-shrink: 0;
  }
  .story-checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.74rem;
    color: var(--text-primary);
    cursor: pointer;
  }
  .story-checkbox-label input[type="checkbox"] {
    accent-color: var(--ps1-cyan);
    width: 15px;
    height: 15px;
    cursor: pointer;
  }
  .story-actions-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }
  .btn-story-main {
    padding: 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  .btn-magenta {
    background: linear-gradient(135deg, #d946ef 0%, #ec4899 50%, #f43f5e 100%);
    color: #ffffff;
    border: 1px solid #f472b6;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    box-shadow: 0 0 10px rgba(236, 72, 153, 0.25);
  }
  .btn-magenta:hover {
    background: linear-gradient(135deg, #e879f9 0%, #f472b6 50%, #fb7185 100%);
    border-color: #fbcfe8;
    box-shadow: 0 0 16px rgba(236, 72, 153, 0.5);
  }
  .btn-mini.btn-magenta {
    background: linear-gradient(135deg, #d946ef 0%, #ec4899 100%);
    color: #ffffff;
    border: 1px solid #f472b6;
    padding: 0.25rem 0.5rem;
    font-size: 0.7rem;
    border-radius: 3px;
  }
  .btn-mini.btn-magenta:hover {
    border-color: #fbcfe8;
    box-shadow: 0 0 8px rgba(236, 72, 153, 0.4);
  }

  /* Animation Timeline Studio Bar */
  .animation-studio-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.6rem;
    background: #080d18;
    border-top: 1px solid #1a253a;
    flex-wrap: wrap;
    z-index: 10;
  }

  .anim-bar-left, .anim-bar-center, .anim-bar-right {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .anim-bar-center {
    flex: 1;
    min-width: 220px;
  }

  .anim-title-tag {
    font-size: 0.68rem;
    font-family: var(--font-pixel);
    color: var(--ps1-gold);
    white-space: nowrap;
  }

  .anim-clip-select {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    background: #0e1726;
    color: var(--text-bright);
    border: 1px solid #233554;
    padding: 0.2rem 0.4rem;
    max-width: 220px;
    border-radius: 2px;
  }

  .anim-scrubber-wrap {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .anim-scrubber-slider {
    width: 100%;
    accent-color: var(--ps1-cyan);
    cursor: pointer;
  }

  .anim-time-display {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ps1-cyan);
    white-space: nowrap;
