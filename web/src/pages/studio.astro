  const TEMPLATES: Record<string, { model: string; generator: string; config: string; manifest: string; readme: string }> = {
    crate: {
      model: '/models/crate.glb',
      generator: `import bpy
from ...core.base_generator import BaseAssetGenerator
from ...materials.palette import get_or_create_material
from .config import CrateConfig

class CrateGenerator(BaseAssetGenerator):
    """Generates procedural sci-fi cargo crates for Below Nominal."""
    def generate(self) -> bpy.types.Object:
        cfg = self.config
        mesh = bpy.data.meshes.new(f"{cfg.name}_mesh")
        obj = bpy.data.objects.new(cfg.name, mesh)
        bpy.context.collection.objects.link(obj)

        # Procedural casing and reinforced corner brackets
        mat_casing = get_or_create_material("casing", palette_name=cfg.palette_name)
        obj.data.materials.append(mat_casing)

        self.compact_materials(obj)
        return obj
`,
