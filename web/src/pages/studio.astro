  function applyGeneratedData(data: { family: string; name?: string; generator: string; config: string; manifest: any; readme: string }) {
    activeTemplate = 'custom';
    if (templateSelect) templateSelect.value = 'custom';
    
    fileContents['generator'] = data.generator;
    fileContents['config'] = data.config;
    fileContents['manifest'] = typeof data.manifest === 'string' ? data.manifest : JSON.stringify(data.manifest, null, 2);
    fileContents['readme'] = data.readme;

    if (codeTextarea) {
      codeTextarea.value = fileContents[currentFile];
    }
    updateLineNumbers();
    scanSecurityAST();
    rebuildParamFormFromManifest();

    if (viewportModelName) {
      viewportModelName.textContent = (data.name || data.family).toUpperCase();
    }

    if (aiLoadingStatus) {
      aiLoadingStatus.style.display = 'block';
      aiLoadingStatus.className = 'ai-status-indicator status-ok';
      aiLoadingStatus.innerHTML = `✅ [ GENERACIÓN EXITOSA ] Generador de <strong>"${data.name || data.family}"</strong> cargado con 4 archivos en el Studio.`;
    }
  }

  // Handle Quick Chips
  aiChips.forEach((chipEl) => {
    chipEl.addEventListener('click', () => {
      const chip = chipEl as HTMLElement;
      const presetKey = chip.dataset.preset;
      const promptText = chip.dataset.prompt || '';
      if (aiPromptInput) aiPromptInput.value = promptText;

      const userKey = localStorage.getItem('modelcoder_gemini_key');
      if (!userKey && presetKey && AI_FALLBACK_PRESETS[presetKey]) {
        // Instant curated fallback
        applyGeneratedData(AI_FALLBACK_PRESETS[presetKey]);
      } else {
        // Trigger live generation
        triggerAiGeneration(promptText);
      }
    });
  });

  generateAiBtn?.addEventListener('click', () => {
    const promptText = aiPromptInput?.value.trim() || '';
    if (!promptText) {
      alert('Por favor escribe una descripción del modelo 3D que quieres generar.');
      return;
    }
    triggerAiGeneration(promptText);
  });

  async function triggerAiGeneration(userPrompt: string) {
    const apiKey = localStorage.getItem('modelcoder_gemini_key');
    if (!apiKey) {
      if (geminiKeyDrawer) geminiKeyDrawer.style.display = 'block';
      if (aiLoadingStatus) {
        aiLoadingStatus.style.display = 'block';
        aiLoadingStatus.className = 'ai-status-indicator status-info';
        aiLoadingStatus.innerHTML = `ℹ️ Para generar modelos libres con cualquier prompt, por favor pega tu clave de Gemini arriba (es gratuita). O haz clic en una de las sugerencias preconfiguradas.`;
      }
      return;
    }

    generateAiBtn.disabled = true;
    generateAiBtn.textContent = '⏳ COMPUTANDO CON IA...';
    if (aiLoadingStatus) {
      aiLoadingStatus.style.display = 'block';
      aiLoadingStatus.className = 'ai-status-indicator status-loading';
      aiLoadingStatus.innerHTML = `🧠 <strong>[ GEMINI 2.5 FLASH PROCESANDO ]</strong><br>Diseñando geometría procedural, dataclass de configuración y contrato JSON...`;
    }

    const SYSTEM_PROMPT = `Eres el generador oficial de código procedural 3D de ModelCoder para Blender 5.0 y el juego retro Below Nominal (PlayStation 1 / PSX low-poly).
Diseña un paquete de 4 archivos completo en un único JSON:
{
  "family": "nombre_en_snake_case",
  "name": "Nombre Humano",
  "generator": "código python completo heredando de BaseAssetGenerator",
  "config": "código python completo heredando de BaseAssetConfig con dataclass",
  "manifest": { ...objeto json válido cumpliendo schemas/generator-v1.json... },
  "readme": "documentación markdown"
}

REGLAS TÉCNICAS:
- generator.py debe importar 'from ...core.base_generator import BaseAssetGenerator' y 'from ...materials.palette import get_or_create_material'.
- Debe tener 'def generate(self) -> bpy.types.Object:' y llamar a 'self.compact_materials(obj)'.
- Presupuesto low-poly: 80 a 500 triángulos.
- En config.py incluir 'palette_name: str = "industrial_hazard"'.
- En manifest.json incluir parámetros lógicos con min, max, default y group.
Responde ÚNICAMENTE con el objeto JSON estructurado.`;

    try {
      const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`;
      const payload = {
        contents: [
          {
            parts: [
              { text: `${SYSTEM_PROMPT}\n\nPetición del usuario: "${userPrompt}"` }
            ]
          }
        ],
        generationConfig: {
          responseMimeType: "application/json",
          temperature: 0.2
        }
      };

      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!res.ok) {
        const errData = await res.json().catch(() => ({}));
        throw new Error(errData?.error?.message || `Error HTTP ${res.status}`);
      }

      const resJson = await res.json();
      const rawText = resJson?.candidates?.[0]?.content?.parts?.[0]?.text;
      if (!rawText) throw new Error('Respuesta vacía de Gemini.');

      const parsed = JSON.parse(rawText);
      applyGeneratedData(parsed);

    } catch (err: any) {
      if (aiLoadingStatus) {
        aiLoadingStatus.className = 'ai-status-indicator status-error';
        aiLoadingStatus.innerHTML = `⚠️ <strong>[ ERROR EN GENERACIÓN ]</strong> ${err.message || err}<br><small>Verifica tu clave de API en Google AI Studio.</small>`;
      }
    } finally {
      generateAiBtn.disabled = false;
      generateAiBtn.textContent = '⚡ GENERAR CON IA';
    }
  }

  // Init
  loadTemplate('crate');
</script>

