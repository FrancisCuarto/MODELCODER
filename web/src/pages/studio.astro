    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #0b1120;
    border: 1px solid #1e293b;
    padding: 0.35rem 0.5rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .outliner-item:hover {
    border-color: #3b82f6;
    background: #10192e;
  }

  .outliner-item.active {
    border-color: var(--ps1-cyan);
    background: #0f2338;
    box-shadow: 0 0 8px rgba(0, 240, 255, 0.2);
  }

  .outliner-item.is-hidden {
    opacity: 0.45;
  }

  .outliner-item-main {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    overflow: hidden;
  }

  .outliner-idx-tag {
    font-size: 0.62rem;
    color: #64748b;
    font-family: var(--font-mono);
  }

  .outliner-shape-badge {
    font-family: var(--font-pixel);
    font-size: 0.62rem;
    color: var(--ps1-cyan);
    background: #071322;
    padding: 0.1rem 0.3rem;
    border: 1px solid rgba(0, 240, 255, 0.2);
  }

  .outliner-name-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-bright);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .outliner-item-actions {
    display: flex;
    gap: 0.2rem;
  }

  .outliner-footer {
    padding: 0.4rem 0.6rem;
    background: #04060c;
    border-top: 1px solid var(--border-color);
  }

  .outliner-hint {
    font-size: 0.62rem;
    color: #64748b;
    font-family: var(--font-mono);
  }

  /* Viewport Column */
  .viewport-column {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .studio-viewport-window {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .viewport-main-titlebar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 0.35rem 0.6rem;
  }

  .viewport-title-left {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .viewport-tag {
    font-size: 0.68rem;
    color: var(--ps1-cyan);
    font-family: var(--font-pixel);
  }

  .viewport-model-title {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: bold;
    color: var(--text-bright);
  }

  /* Gizmo Toolbar */
  .gizmo-toolbar {
    display: flex;
    gap: 0.25rem;
    background: #080d18;
    border: 1px solid #1a253a;
    padding: 0.15rem;
  }

  .btn-gizmo {
    background: transparent;
    border: 1px solid transparent;
    color: #94a3b8;
    font-family: var(--font-pixel);
    font-size: 0.62rem;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    transition: all 0.12s ease;
  }

  .btn-gizmo:hover {
    color: var(--text-bright);
    border-color: #2e3c54;
  }

  .btn-gizmo.active {
    background: var(--ps1-cyan);
    color: #000;
    font-weight: bold;
    border-color: var(--ps1-cyan);
  }

  .btn-gizmo#gizmo-btn-snap.active {
    background: var(--ps1-gold);
    color: #000;
  }

  .viewport-camera-tools {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .camera-presets-group {
    display: flex;
    gap: 0.2rem;
  }

  .btn-cam-preset {
    font-size: 0.62rem;
    padding: 0.2rem 0.4rem;
  }

  .studio-viewport-surface {
    position: relative;
    width: 100%;
    height: 520px;
    overflow: hidden;
    background: #060910;
  }

  .three-canvas-mount {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    overflow: hidden !important;
    display: block;
  }

  .three-canvas-mount canvas {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
  }

  .viewport-overlay-controls {
    position: absolute;
    top: 8px;
    left: 8px;
    right: 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
  }

  .shading-toggles {
    display: flex;
    gap: 0.25rem;
    pointer-events: auto;
    background: rgba(6, 9, 16, 0.75);
    backdrop-filter: blur(4px);
    padding: 0.2rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .btn-shading {
    background: transparent;
    border: 1px solid transparent;
    color: #94a3b8;
    font-family: var(--font-pixel);
    font-size: 0.62rem;
    padding: 0.25rem 0.45rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-shading:hover {
    color: var(--text-bright);
  }

  .btn-shading.active {
    background: var(--ps1-cyan);
    color: #000;
    font-weight: bold;
  }

  .generation-status-badge {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(6, 9, 16, 0.85);
    border: 1px solid var(--border-color);
    padding: 0.25rem 0.6rem;
    font-family: var(--font-pixel);
    font-size: 0.65rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot-completed { background: #10b981; box-shadow: 0 0 6px #10b981; }
  .dot-generating { background: var(--ps1-cyan); box-shadow: 0 0 6px var(--ps1-cyan); animation: pulse 1s infinite alternate; }
  .dot-error { background: #ef4444; box-shadow: 0 0 6px #ef4444; }

  .viewport-stats-hud {
    position: absolute;
    bottom: 8px;
    left: 8px;
    background: rgba(4, 6, 12, 0.85);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(0, 240, 255, 0.3);
    padding: 0.4rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    pointer-events: none;
  }

  .hud-lbl { color: #64748b; margin-right: 0.3rem; }
  .hud-val { color: var(--ps1-cyan); font-weight: bold; }

  .viewport-selection-pill {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: rgba(14, 28, 48, 0.88);
    backdrop-filter: blur(4px);
    border: 1px solid var(--ps1-cyan);
    padding: 0.3rem 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #e2e8f0;
    pointer-events: none;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ps1-cyan);
    box-shadow: 0 0 5px var(--ps1-cyan);
  }

  .viewport-error-banner {
    position: absolute;
    bottom: 8px;
    right: 8px;
    left: 8px;
    background: rgba(40, 8, 8, 0.95);
    border: 1px solid #ef4444;
    padding: 0.6rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    z-index: 20;
  }

  .error-banner-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #fca5a5;
    font-family: var(--font-pixel);
    font-size: 0.75rem;
    margin-bottom: 0.3rem;
  }

  .btn-mini-close {
    margin-left: auto;
    background: transparent;
    border: none;
    color: #fca5a5;
    cursor: pointer;
    font-weight: bold;
  }

  .error-banner-body { color: #fee2e2; margin-bottom: 0.25rem; }
  .error-banner-footer { color: #94a3b8; font-size: 0.65rem; }

  /* Properties Inspector Panel */
  .inspector-column {
    display: flex;
    flex-direction: column;
  }

  .inspector-window {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .inspector-scroll-body {
    flex: 1;
    overflow-y: auto;
    padding: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: #060912;
    max-height: calc(100vh - 200px);
  }

  .inspector-empty-state {
    padding: 2.5rem 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .empty-icon {
    font-size: 2rem;
    opacity: 0.7;
  }

  .empty-title {
    font-family: var(--font-pixel);
    font-size: 0.8rem;
    color: var(--ps1-cyan);
    margin: 0;
  }

  .empty-desc {
    font-size: 0.72rem;
    color: var(--text-dim);
    line-height: 1.4;
  }

  .prop-card-header {
    background: #090e1a;
    border: 1px solid #1a253a;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .comp-name-editor {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    font-weight: bold;
    color: var(--ps1-cyan);
    background: #040710;
  }

  .prop-quick-btns {
    display: flex;
    gap: 0.3rem;
  }

  .prop-section {
    background: #080c16;
    border: 1px solid #192336;
    padding: 0.55rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .section-titlebar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.35rem;
    margin-bottom: 0.2rem;
  }

  .section-badge {
    background: var(--ps1-cyan);
    color: #000;
    font-family: var(--font-pixel);
    font-size: 0.6rem;
    padding: 0.1rem 0.35rem;
    font-weight: bold;
  }

  .section-heading {
    font-family: var(--font-pixel);
    font-size: 0.68rem;
    color: var(--text-bright);
    letter-spacing: 0.5px;
    flex: 1;
  }

  .btn-mini-link {
    background: transparent;
    border: none;
    color: var(--ps1-gold);
    font-family: var(--font-pixel);
    font-size: 0.62rem;
    cursor: pointer;
    padding: 0;
  }

  .btn-mini-link:hover {
    text-decoration: underline;
  }

  .prop-field-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .field-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .field-label {
    font-size: 0.65rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .field-unit-tag {
    font-size: 0.62rem;
    color: #64748b;
    font-family: var(--font-mono);
  }

  .lock-proportions-toggle {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.62rem;
    color: var(--ps1-gold);
    font-family: var(--font-mono);
    cursor: pointer;
  }

  .coord-3-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35rem;
  }

  .coord-2-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.35rem;
  }

  .coord-input-wrap {
    display: flex;
    align-items: center;
    background: #04060c;
    border: 1px solid #23314d;
    padding: 0 0.3rem;
  }

  .axis-tag {
    font-size: 0.65rem;
    font-weight: bold;
    font-family: var(--font-mono);
    margin-right: 0.25rem;
  }

  .axis-x { color: #ef4444; }
  .axis-y { color: #10b981; }
  .axis-z { color: #3b82f6; }

  .coord-num-inp {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-bright);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.25rem 0;
    outline: none;
    width: 100%;
  }

  .effective-dims-box {
    background: #04060c;
    border-left: 2px solid var(--ps1-cyan);
    padding: 0.35rem 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .eff-label {
    font-size: 0.58rem;
    color: #64748b;
    font-family: var(--font-pixel);
  }

  .eff-val {
    font-size: 0.68rem;
    color: var(--ps1-cyan);
    font-family: var(--font-mono);
    font-weight: bold;
  }

  /* Shape Specific Grids */
  .shape-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.4rem;
  }

  .shape-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.4rem;
  }

  .shape-field {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .unit-input-wrap {
    display: flex;
    align-items: center;
    background: #04060c;
    border: 1px solid #23314d;
    padding: 0 0.35rem;
  }

  .shape-num-inp {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-bright);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.25rem 0;
    outline: none;
    width: 100%;
  }

  .unit-sym {
    font-size: 0.65rem;
    color: #64748b;
    font-family: var(--font-mono);
  }

  /* Material & Color Controls */
  .prop-field-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .color-picker-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .color-swatch-input {
    width: 28px;
    height: 24px;
    border: 1px solid #2d3748;
    background: transparent;
    cursor: pointer;
    padding: 0;
  }

  .color-hex-input {
    width: 80px;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    padding: 0.2rem 0.4rem;
  }

  .texture-dropdown {
    font-size: 0.72rem;
    padding: 0.3rem 0.5rem;
    font-family: var(--font-mono);
  }

  .checkbox-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.68rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    cursor: pointer;
  }

  /* Code Editor Surface */
  .editor-window {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .editor-tabs {
    display: flex;
    background: #060910;
    border-bottom: 1px solid var(--border-color);
  }

  .editor-tab {
    background: transparent;
    border: none;
    border-right: 1px solid var(--border-color);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.45rem 0.85rem;
    cursor: pointer;
  }

  .editor-tab.active {
    background: #0d1424;
    color: var(--ps1-cyan);
    border-bottom: 2px solid var(--ps1-cyan);
  }

  .tab-badge {
    font-size: 0.6rem;
    padding: 0.1rem 0.3rem;
    background: #1e293b;
    color: #94a3b8;
    margin-left: 0.3rem;
  }

  .editor-surface {
    flex: 1;
    display: flex;
    background: #05070e;
    min-height: 480px;
    position: relative;
  }

  .line-numbers {
    width: 40px;
    background: #030408;
    color: #475569;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    padding: 0.5rem 0.3rem;
    text-align: right;
    user-select: none;
  }

  #code-textarea {
    flex: 1;
    background: transparent;
    border: none;
    color: #e2e8f0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.4;
    padding: 0.5rem;
    resize: none;
    outline: none;
    white-space: pre;
    overflow-x: auto;
  }

  .editor-statusbar {
    display: flex;
    justify-content: space-between;
    background: #030408;
    border-top: 1px solid var(--border-color);
    padding: 0.25rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: #64748b;
  }

  /* AI Copilot Styling */
  .ai-copilot-body {
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .engine-selector-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: #090e18;
    border: 1px solid #1a253a;
    padding: 0.45rem 0.65rem;
    flex-wrap: wrap;
  }

  .selector-heading {
    font-family: var(--font-pixel);
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .engine-toggle-buttons {
    display: flex;
    gap: 0.4rem;
    flex: 1;
    flex-wrap: wrap;
  }

  .btn-engine-toggle {
    background: #0d1424;
    border: 1px solid #23314d;
    color: #94a3b8;
    font-family: var(--font-pixel);
    font-size: 0.72rem;
    padding: 0.35rem 0.75rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: all 0.15s ease;
  }

  .btn-engine-toggle:hover {
    border-color: var(--ps1-cyan);
    color: var(--text-bright);
  }

  .btn-engine-toggle.active {
    background: #0e2a38;
    border-color: var(--ps1-cyan);
    color: var(--ps1-cyan);
    box-shadow: 0 0 8px rgba(0, 240, 255, 0.25);
    font-weight: bold;
  }

  .badge-unique {
    font-size: 0.58rem;
    padding: 0.1rem 0.35rem;
    background: #e11d48;
    color: #fff;
    border-radius: 2px;
    font-weight: 800;
  }

  .ai-prompt-row {
    display: flex;
    gap: 0.5rem;
    align-items: stretch;
  }

  .prompt-input-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    background: #080c14;
    border: 1px solid var(--border-color);
    padding: 0 0.6rem;
  }

  .prompt-prefix {
    font-family: var(--font-pixel);
    font-size: 0.7rem;
    color: var(--ps1-cyan);
    margin-right: 0.5rem;
    white-space: nowrap;
  }

  .ai-prompt-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-bright);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.6rem 0;
    outline: none;
  }

  .ai-generate-btn {
    font-family: var(--font-pixel);
    font-size: 0.8rem;
    padding: 0 1.25rem;
    white-space: nowrap;
  }

  .ai-chips-row {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .chips-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-family: var(--font-pixel);
  }

  .ai-chip {
    background: #0e1526;
    border: 1px solid #1e293b;
    color: #94a3b8;
    font-size: 0.72rem;
    padding: 0.25rem 0.55rem;
    cursor: pointer;
    font-family: var(--font-mono);
    transition: all 0.15s ease;
  }

  .ai-chip:hover {
    border-color: var(--ps1-cyan);
    color: var(--ps1-cyan);
    background: #141e34;
  }

  .ai-status-indicator {
    padding: 0.6rem 0.8rem;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    border-left: 3px solid var(--ps1-cyan);
