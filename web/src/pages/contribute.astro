---
import Layout from '../layouts/Layout.astro';

const manifestTemplate = `{
  "$schema": "https://raw.githubusercontent.com/FrancisCuarto/MODELCODER/main/schemas/generator-v1.json",
  "id": "below_nominal.furniture.mi_familia",
  "version": "1.0.0",
  "name": "Mi Mueble Procedural",
  "description": "Descripción clara del objeto y su propósito en la estación.",
  "author": { "name": "Tu Nombre o Alias", "github": "tu-usuario" },
  "license": "CC-BY-4.0",
  "category": "furniture",
  "tags": ["furniture", "sci-fi", "psx", "low-poly"],
  "parameters": [
    {
      "key": "width",
      "label": "Ancho (m)",
      "type": "float",
      "default": 1.20,
      "min": 0.80,
      "max": 2.50,
      "step": 0.05,
      "group": "Dimensiones"
    },
    {
      "key": "has_drawer",
      "label": "Incluir Gaveta",
      "type": "boolean",
      "default": true,
      "group": "Accesorios"
    }
  ],
  "presets": [
    {
      "id": "standard",
      "name": "Estándar",
      "values": { "width": 1.20, "has_drawer": true }
    }
  ],
  "export_capabilities": {
    "target_tri_budget": 450,
    "supports_collision": true,
    "default_collision_suffix": "-convcolonly"
  }
}`;

const generatorTemplate = `import bpy
from ...core.base_generator import BaseAssetGenerator
from ...materials.palette import get_or_create_material
from .config import MiFamiliaConfig

class MiFamiliaGenerator(BaseAssetGenerator):
    def generate(self) -> bpy.types.Object:
        cfg = self.config  # Instancia de MiFamiliaConfig
        # 1. Crear geometría base
        mesh = bpy.data.meshes.new(f"{cfg.name}_mesh")
        obj = bpy.data.objects.new(cfg.name, mesh)
        bpy.context.collection.objects.link(obj)

        # 2. Asignar material PS1 usando paleta de sector
        mat = get_or_create_material("casing", palette_name=cfg.palette_name)
        obj.data.materials.append(mat)

        # 3. Compactar ranuras y retornar
        self.compact_materials(obj)
        return obj`;
---

<Layout title="Cómo funciona ModelCoder — Guía de Uso y Creación 3D">
  <div class="guide-container">
    <div class="ps1-window guide-header-window">
      <div class="ps1-titlebar">
        <span>// GUÍA Y MANUAL DE MODELCODER</span>
        <span class="ps1-telemetry-tag">GUÍA DE USO Y CREACIÓN</span>
      </div>
      <div class="guide-header-body">
        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; flex-wrap: wrap;">
          <img src="/logo.png" alt="ModelCoder Logo" style="width: 52px; height: 52px; object-fit: contain; border-radius: 6px; border: 1px solid var(--ps1-gold); background: #000; box-shadow: 0 0 12px rgba(255, 176, 0, 0.4);" />
          <div>
            <h1 class="guide-title" style="margin: 0;">CÓMO FUNCIONA MODELCODER</h1>
            <span style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--ps1-cyan);">
              PROYECTO INDEPENDIENTE POR <a href="https://ivorbitgames.online" target="_blank" rel="noopener noreferrer" style="color: var(--ps1-gold); text-decoration: underline; font-weight: bold;">IV ORBIT GAMES</a> &bull; FRANCISCUARTO
            </span>
          </div>
        </div>
        <p class="guide-lead">
          ModelCoder te permite obtener modelos 3D listos para tus videojuegos o proyectos sin empezar desde cero. 
          Podés usar la web sin saber programar, o podés crear y aportar tus propios generadores con Python y Blender.
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; margin-top: 1.5rem;">
          <div class="ps1-inset" style="padding: 1rem; background: #070c18;">
            <h3 style="font-family: var(--font-pixel); font-size: 0.85rem; color: var(--ps1-cyan); margin-bottom: 0.4rem;">
              🎮 Para Desarrolladores y Diseñadores
            </h3>
            <p style="font-size: 0.82rem; color: var(--text-dim); line-height: 1.5; margin: 0;">
              Elegí cualquier objeto del catálogo, ajustá sus dimensiones y paleta con los controles visuales, y descargá el archivo <strong>.GLB</strong> optimizado para importarlo directo en Godot 4, Unity o Blender.
            </p>
          </div>
          <div class="ps1-inset" style="padding: 1rem; background: #070c18;">
            <h3 style="font-family: var(--font-pixel); font-size: 0.85rem; color: var(--ps1-gold); margin-bottom: 0.4rem;">
              💻 Para Creadores y Programadores
            </h3>
            <p style="font-size: 0.82rem; color: var(--text-dim); line-height: 1.5; margin: 0;">
              Usá nuestro <strong>Studio 3D con IA integrada</strong> para generar modelos por prompt, o programá scripts procedurales en Python con las plantillas que te mostramos a continuación.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- 1-Click Fast Track: Zero Setup Cloud & Local -->
    <div class="ps1-window fast-track-window">
      <div class="ps1-titlebar" style="background: linear-gradient(90deg, #003344, #001122);">
        <span>// FAST_TRACK: ACCESO EN 1-CLIC (SIN CONFIGURACIÓN MANUAL)</span>
        <span class="ps1-telemetry-tag" style="color: var(--ps1-cyan);">READY-TO-USE</span>
      </div>
      <div style="padding: 1.25rem;">
        <p style="color: var(--text-bright); font-size: 0.9rem; margin-bottom: 1rem;">
          Para programar, probar o generar sin complicaciones técnicas, tienes dos vías inmediatas:
        </p>
        <div class="fast-track-grid">
          <div class="ps1-inset fast-track-card">
            <h3 style="color: var(--ps1-cyan); font-family: var(--font-pixel); font-size: 0.85rem; margin-bottom: 0.5rem;">
              ☁️ EN LA NUBE: GITHUB CODESPACES
            </h3>
            <p style="font-size: 0.8rem; color: var(--text-dim); margin-bottom: 0.8rem; line-height: 1.45;">
              Abre un Visual Studio Code completo en tu navegador con Python, Node.js y Blender 5.0 preinstalados. No necesitas instalar nada en tu PC.
            </p>
            <a 
              href="https://codespaces.new/FrancisCuarto/MODELCODER" 
              target="_blank" 
              rel="noopener noreferrer"
              class="btn btn-cyan" 
              style="font-size: 0.75rem; text-decoration: none; display: inline-block;"
            >
              🚀 ABRIR EN CODESPACES (1-CLIC)
            </a>
          </div>

          <div class="ps1-inset fast-track-card">
            <h3 style="color: var(--ps1-gold); font-family: var(--font-pixel); font-size: 0.85rem; margin-bottom: 0.5rem;">
              💻 EN TU PC: LANZADOR AUTOMÁTICO
            </h3>
            <p style="font-size: 0.8rem; color: var(--text-dim); margin-bottom: 0.8rem; line-height: 1.45;">
              Descarga el lanzador para Windows. Detecta tu instalación de Blender, instala librerías necesarias y levanta el worker de generación automáticamente.
            </p>
            <a 
              href="/INICIAR_MODELCODER.bat" 
              download="INICIAR_MODELCODER.bat"
              class="btn btn-gold" 
              style="font-size: 0.75rem; text-decoration: none; display: inline-block;"
            >
              📥 DESCARGAR LANZADOR (.BAT)
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Stepper Grid -->
    <div class="steps-flow">
      <!-- Step 1 -->
      <section class="ps1-window step-card">
        <div class="ps1-titlebar">
          <span>// STEP_01: ESTRUCTURA_DE_LA_FAMILIA</span>
          <span class="step-num">[01/05]</span>
        </div>
        <div class="step-body">
          <p>
            Crea una carpeta dentro de <code>procedural_assets/generators/&lt;nombre_familia&gt;/</code>
            con los siguientes 4 archivos estandarizados:
          </p>

          <pre class="ps1-inset file-tree"><code>procedural_assets/generators/mi_familia/
├── __init__.py     # Exporta Config y Generator
├── config.py       # Dataclass con parámetros tipados
├── generator.py    # Lógica de malla procedural (hereda de BaseAssetGenerator)
└── manifest.json   # Contrato declarativo y presets curados</code></pre>
        </div>
      </section>

      <!-- Step 2 -->
      <section class="ps1-window step-card">
        <div class="ps1-titlebar">
          <span>// STEP_02: CONTRATO_DECLARATIVO</span>
          <span class="step-num">[02/05]</span>
        </div>
        <div class="step-body">
          <p>
            El manifiesto permite a la plataforma web generar automáticamente los controles interactivos
            y a la consola inyectar los flags de CLI sin código manual. Debe validar contra <code>schemas/generator-v1.json</code>.
          </p>

          <pre class="ps1-inset code-box"><code>{manifestTemplate}</code></pre>
        </div>
      </section>

      <!-- Step 3 -->
      <section class="ps1-window step-card">
        <div class="ps1-titlebar">
          <span>// STEP_03: LOGICA_DE_MALLA_PYTHON</span>
          <span class="step-num">[03/05]</span>
        </div>
        <div class="step-body">
          <p>
            Hereda de <code>BaseAssetGenerator</code>. Utiliza operaciones primitivas (cubos, biseles, extrusiones)
            y asigna materiales semánticos desde la paleta PS1 reutilizable:
          </p>

          <pre class="ps1-inset code-box"><code>{generatorTemplate}</code></pre>
        </div>
      </section>

      <!-- Step 4 -->
      <section class="ps1-window step-card">
        <div class="ps1-titlebar">
          <span>// STEP_04: VERIFICACION_Y_TESTS</span>
          <span class="step-num">[04/05]</span>
        </div>
        <div class="step-body">
          <p>
            Antes de enviar un Pull Request, verifica la generación local y la suite completa de pruebas:
          </p>

          <div class="ps1-inset terminal-command-card">
            <span class="terminal-cmd-label">&gt; 1. Probar generación y exportación GLB:</span>
            <code>blender -b --python generate.py -- --family mi_familia --collision</code>
          </div>

          <div class="ps1-inset terminal-command-card" style="margin-top: 0.75rem;">
            <span class="terminal-cmd-label">&gt; 2. Ejecutar la suite de pruebas unitarias:</span>
            <code>blender -b --python run_tests.py</code>
          </div>
        </div>
      </section>

      <!-- Step 5 -->
      <section class="ps1-window step-card">
        <div class="ps1-titlebar">
          <span>// STEP_05: CRITERIOS_DE_ACEPTACION_CI</span>
          <span class="step-num">[05/05]</span>
        </div>
        <div class="step-body">
          <p>
            Cada aporte enviado vía GitHub Pull Request pasa por una batería automatizada en runner aislado:
          </p>
          <ul class="guidelines-list">
            <li><strong>Presupuesto de polígonos:</strong> Mallas low-poly optimizadas (menos de 1,200 triángulos).</li>
            <li><strong>Estricta seguridad AST:</strong> Prohibido el uso de llamadas a sistema (<code>subprocess</code>, <code>os.system</code>), red o accesos fuera del sandbox.</li>
            <li><strong>Pivote normalizado:</strong> La base del modelo debe apoyarse exactamente en <code>Z = 0.0</code> (Floor Contact).</li>
            <li><strong>Materiales exportables:</strong> Materiales calibrados compatibles con glTF 2.0 y Godot 4.</li>
            <li><strong>Licencia abierta:</strong> Declaración explícita bajo licencia CC-BY-4.0 o MIT.</li>
          </ul>
        </div>
      </section>

      <!-- Sobre el Creador & IV Orbit Games -->
      <section class="ps1-window step-card" style="border-color: var(--ps1-gold);">
        <div class="ps1-titlebar" style="background: linear-gradient(90deg, #332200, #110b00);">
          <span>// SOBRE EL PROYECTO & EL ESTUDIO CREADOR</span>
          <span class="ps1-telemetry-tag" style="color: var(--ps1-gold);">IV ORBIT GAMES</span>
        </div>
        <div class="step-body">
          <div style="display: flex; gap: 1.25rem; align-items: flex-start; flex-wrap: wrap;">
            <img src="/logo.png" alt="ModelCoder Logo" style="width: 64px; height: 64px; object-fit: contain; border-radius: 6px; border: 2px solid var(--ps1-gold); background: #000; box-shadow: 0 0 12px rgba(255, 176, 0, 0.4); flex-shrink: 0;" />
            <div style="flex: 1; min-width: 250px;">
              <h3 style="font-family: var(--font-title); font-size: 1.1rem; color: #ffffff; margin-bottom: 0.35rem;">
                Franciscuarto &bull; IV Orbit Games
              </h3>
              <p style="font-size: 0.85rem; color: #b8ccdf; line-height: 1.5; margin-bottom: 0.75rem;">
                ModelCoder fue concebido y desarrollado de forma independiente desde Buenos Aires, Argentina. Surgió como la solución de producción técnica para generar y optimizar decenas de accesorios, consolas y módulos espaciales de <strong>Below Nominal</strong> (Godot Engine).
              </p>
              <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
                <a href="https://ivorbitgames.online" target="_blank" rel="noopener noreferrer" class="btn btn-gold" style="font-size: 0.75rem; text-decoration: none;">
                  🪐 ivorbitgames.online &rarr;
                </a>
                <a href="https://iv-orbit.itch.io" target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="font-size: 0.75rem; text-decoration: none;">
                  🎮 itch.io
                </a>
                <a href="https://www.youtube.com/@Franciscuarto" target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="font-size: 0.75rem; text-decoration: none;">
                  📺 YouTube
                </a>
                <a href="https://github.com/FrancisCuarto" target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="font-size: 0.75rem; text-decoration: none;">
                  🐙 GitHub
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .guide-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0.5rem 0 3rem;
  }

  .guide-header-window {
    margin-bottom: 2rem;
  }

  .guide-header-body {
    padding: 1.5rem;
  }

  .ps1-telemetry-tag {
    font-family: var(--font-telemetry);
    font-size: 1.1rem;
    color: var(--ps1-cyan);
  }

  .guide-title {
    font-family: var(--font-title);
    font-size: 1.35rem;
    line-height: 1.5;
    color: var(--ps1-gold);
    margin-bottom: 0.75rem;
    text-shadow: 2px 2px 0px #000;
  }

  .guide-lead {
    font-size: 0.95rem;
    color: #c0cde0;
    line-height: 1.6;
  }

  .steps-flow {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .step-card {
    display: flex;
    flex-direction: column;
  }

  .step-num {
    font-family: var(--font-telemetry);
    font-size: 1.15rem;
    color: var(--ps1-gold);
  }

  .step-body {
    padding: 1.25rem;
  }

  .step-body p {
    color: #b0c0d4;
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .file-tree, .code-box {
    padding: 1rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #9cb2cc;
    line-height: 1.45;
  }

  .terminal-command-card {
    padding: 0.75rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .terminal-cmd-label {
    font-family: var(--font-pixel);
    font-size: 0.68rem;
    color: var(--ps1-gold);
  }

  .terminal-command-card code {
    color: var(--ps1-cyan);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .guidelines-list {
    margin-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: #a0b2c6;
    font-size: 0.88rem;
  }

  .guidelines-list strong {
    color: var(--ps1-gold);
  }

  .fast-track-window {
    border-color: var(--ps1-cyan);
    box-shadow: 0 4px 16px rgba(0, 240, 255, 0.12);
  }

  .fast-track-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .fast-track-card {
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: #080d1a;
  }
</style>
