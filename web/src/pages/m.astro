---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Visor 3D Público · ModelCoder";
const pageDescription = "Visor interactivo 3D para inspeccionar, rotar, probar animaciones y descargar modelos procedurales de ModelCoder.";
---

<Layout 
  title={pageTitle}
  description={pageDescription}
>
  <div class="m-viewer-container">
    <!-- Top Breadcrumb & Status Bar -->
    <div class="ps1-window m-topbar">
      <div class="ps1-titlebar">
        <div class="m-topbar-left">
          <a href="/" class="m-crumb-link">&lt; [CATÁLOGO]</a>
          <span class="m-crumb-sep">/</span>
          <span id="m-model-category-tag" class="ps1-telemetry-tag" style="color: var(--ps1-cyan);">3D ASSET</span>
          <span class="m-crumb-sep">/</span>
          <span id="m-topbar-model-name" class="m-crumb-current">CARGANDO MODELO...</span>
        </div>
        <div class="m-topbar-right">
          <span id="m-telemetry-status" class="ps1-telemetry-tag" style="color: var(--ps1-green);">● INTERACTIVO</span>
        </div>
      </div>
    </div>

    <!-- Main Workspace: 3D Viewport + Side Inspector -->
    <div class="m-workspace-grid">
      <!-- 3D Canvas Viewport Section -->
      <section class="ps1-window m-viewport-window" id="m-viewport-card">
        <div class="m-viewport-mount" id="m-viewport-mount">
          <!-- WebGL Canvas will be mounted here -->
        </div>

        <!-- Loading Overlay -->
        <div id="m-loading-overlay" class="m-overlay-screen">
          <div class="ps1-window m-status-box">
            <div class="m-spinner-icon">⏳</div>
            <div class="m-loading-title">INICIALIZANDO MOTOR PROCEDURAL 3D</div>
            <div class="m-loading-subtitle" id="m-loading-detail">Descomprimiendo geometría y compilando materiales PBR...</div>
          </div>
        </div>

        <!-- Error State Overlay -->
        <div id="m-error-overlay" class="m-overlay-screen hidden">
          <div class="ps1-window m-status-box" style="border-color: var(--ps1-red);">
            <div class="m-spinner-icon" style="color: var(--ps1-red);">⚠️</div>
            <div class="m-loading-title" style="color: var(--ps1-red);">MODELO NO ENCONTRADO</div>
            <p class="m-loading-subtitle" id="m-error-message">
              El identificador o enlace del modelo no existe o está dañado.
            </p>
            <div style="display: flex; gap: 0.75rem; justify-content: center; margin-top: 1rem; flex-wrap: wrap;">
              <a href="/" class="btn btn-primary" style="font-size: 0.75rem; text-decoration: none;">
                📦 Ver Catálogo General
              </a>
              <a href="/studio" class="btn btn-gold" style="font-size: 0.75rem; text-decoration: none;">
                ⚡ Crear en Studio 3D
              </a>
            </div>
          </div>
        </div>

        <!-- Floating Viewport Tools (Top Right) -->
        <div class="m-floating-tools">
          <button type="button" id="btn-toggle-shading" class="m-tool-btn" title="Alternar Sombreado (PBR / Alámbrico / Plano)">
            🎨 <span id="label-shading-mode">PBR</span>
          </button>
          <button type="button" id="btn-toggle-grid" class="m-tool-btn active" title="Alternar Rejilla Métrica">
            🌐 Rejilla
          </button>
          <button type="button" id="btn-reset-cam" class="m-tool-btn" title="Centrar Cámara">
            🎯 Centrar
          </button>
          <button type="button" id="btn-toggle-fullscreen" class="m-tool-btn" title="Pantalla Completa">
            ⛶
          </button>
        </div>

        <!-- Floating Animation Dock (Bottom Bar - Visible only if model has animations) -->
        <div id="m-animation-dock" class="m-animation-dock hidden">
          <div class="m-anim-inner ps1-inset">
            <button type="button" id="btn-anim-play" class="btn btn-green m-anim-play-btn" title="Reproducir / Pausar">
              <span id="anim-play-icon">▶</span>
            </button>
            <div class="m-anim-slider-wrap">
              <div class="m-anim-info-row">
                <span id="anim-clip-title" class="m-anim-clip-title">ANIMACIÓN</span>
                <span id="anim-time-display" class="m-anim-time-display">0.0s / 0.0s</span>
              </div>
              <input type="range" id="anim-progress-scrubber" min="0" max="100" value="0" step="0.5" class="m-scrubber-slider" />
            </div>
            <div class="m-anim-options">
              <button type="button" id="btn-anim-speed" class="m-tool-btn" title="Velocidad de Reproducción">
                <span id="label-anim-speed">1.0x</span>
              </button>
              <button type="button" id="btn-anim-loop" class="m-tool-btn active" title="Bucle Continuo o 1 Vez">
                🔁 Bucle
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- Side Inspector / Telemetry Card -->
      <aside class="ps1-window m-telemetry-aside">
        <div class="ps1-titlebar">
          <span>FICHA TÉCNICA · TELEMETRÍA</span>
          <span class="ps1-telemetry-tag">GLTF 2.0</span>
        </div>

        <div class="m-aside-inner">
          <!-- Model Title & Identity -->
          <div class="m-model-header-block">
            <h1 id="m-display-title" class="m-display-title">Modelo Procedural</h1>
            <div class="m-meta-author-row">
              <span class="m-author-label">CREADOR:</span>
              <span id="m-display-author" class="m-author-val">Piloto de la Comunidad</span>
            </div>
            <p id="m-display-desc" class="m-display-desc">
              Cargando especificaciones técnicas del modelo...
            </p>
          </div>

          <!-- Geometry Metrics Grid -->
          <div class="m-metrics-grid ps1-inset">
            <div class="m-metric-cell">
              <span class="m-metric-lbl">TRIÁNGULOS</span>
              <strong id="m-metric-tris" class="m-metric-val text-gold">0</strong>
            </div>
            <div class="m-metric-cell">
              <span class="m-metric-lbl">PIEZAS</span>
              <strong id="m-metric-parts" class="m-metric-val text-cyan">0</strong>
            </div>
            <div class="m-metric-cell" style="grid-column: span 2;">
              <span class="m-metric-lbl">DIMENSIONES (METROS)</span>
              <strong id="m-metric-dims" class="m-metric-val">0.0 × 0.0 × 0.0 m</strong>
            </div>
          </div>

          <!-- Primary Actions -->
          <div class="m-actions-stack">
            <button type="button" id="btn-open-in-studio" class="btn btn-gold m-action-btn">
              ⚡ ABRIR Y EDITAR EN STUDIO
            </button>
            <button type="button" id="btn-download-glb-direct" class="btn btn-primary m-action-btn">
              💾 DESCARGAR ARCHIVO .GLB
            </button>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
              <button type="button" id="btn-open-share-dialog" class="btn btn-outline m-action-btn-sm">
                📋 COMPARTIR
              </button>
              <button type="button" id="btn-open-code-dialog" class="btn btn-outline m-action-btn-sm">
                🎮 VER CÓDIGO
              </button>
            </div>
          </div>

          <!-- Direct Integration Hint -->
          <div class="ps1-inset m-integration-hint">
            <span class="hint-title">COMPATIBILIDAD LISTA:</span>
            <div class="hint-tags">
              <span>GODOT 4</span>
              <span>UNITY</span>
              <span>THREE.JS</span>
              <span>BLENDER</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <!-- MODAL: COMPARTIR ENLACE -->
  <dialog id="m-share-dialog" class="ps1-window" style="max-width: 520px; width: 92%;">
    <div class="ps1-titlebar">
      <span>COMPARTIR MODELO 3D</span>
      <button type="button" id="btn-close-share-dialog" class="ps1-ctrl-btn">X</button>
    </div>
    <div class="ps1-inset" style="padding: 1.25rem; margin: 1rem; background: #070c18;">
      <p style="font-size: 0.82rem; color: #c0d8f0; margin-bottom: 0.75rem; line-height: 1.5;">
        Copia este enlace directo para enviar el modelo a amigos o compartirlo en redes sociales. El visor cargará la geometría tridimensional al instante.
      </p>
      <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
        <input type="text" id="m-share-url-input" class="ps1-input" style="flex: 1; font-size: 0.8rem; padding: 0.45rem;" readonly />
        <button type="button" id="btn-copy-share-link" class="btn btn-gold" style="font-size: 0.78rem; padding: 0.45rem 0.85rem;">
          COPIAR
        </button>
      </div>
      <div id="m-share-toast" class="status-msg hidden" style="font-size: 0.8rem; text-align: center; color: var(--ps1-green);">
        ✅ ¡Enlace copiado al portapapeles!
      </div>
    </div>
  </dialog>

  <!-- MODAL: CÓDIGO DE INTEGRACIÓN (Godot / Unity / Three.js) -->
  <dialog id="m-code-dialog" class="ps1-window" style="max-width: 720px; width: 94%;">
    <div class="ps1-titlebar">
      <span>CÓDIGO DE INTEGRACIÓN PARA VIDEOJUEGOS</span>
      <button type="button" id="btn-close-code-dialog" class="ps1-ctrl-btn">X</button>
    </div>
    <div style="padding: 1rem;">
      <div style="display: flex; gap: 0.5rem; margin-bottom: 0.75rem; border-bottom: 2px solid var(--ps1-steel); padding-bottom: 0.5rem;">
        <button type="button" class="btn-code-tab active" data-tab="godot">Godot 4 (GDScript)</button>
        <button type="button" class="btn-code-tab" data-tab="unity">Unity (C#)</button>
        <button type="button" class="btn-code-tab" data-tab="three">Three.js (JS)</button>
      </div>
      <div style="position: relative;">
        <pre class="ps1-inset" style="padding: 1rem; margin: 0; max-height: 380px; overflow-y: auto; font-family: var(--font-mono); font-size: 0.8rem; color: #d0e4fc; line-height: 1.45;"><code id="m-code-target"># Cargando código...</code></pre>
        <button type="button" id="btn-copy-integration-code" class="btn btn-gold" style="position: absolute; top: 0.6rem; right: 0.6rem; font-size: 0.65rem; padding: 0.25rem 0.6rem;">
          COPIAR CÓDIGO
        </button>
      </div>
    </div>
  </dialog>
</Layout>

<style>
  .m-viewer-container {
    max-width: 1440px;
    margin: 1rem auto 3rem auto;
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Top Bar */
  .m-topbar {
    width: 100%;
  }

  .m-topbar-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    overflow: hidden;
  }

  .m-crumb-link {
    color: var(--ps1-gold);
    text-decoration: none;
    font-weight: bold;
  }

  .m-crumb-link:hover {
    text-decoration: underline;
  }

  .m-crumb-sep {
    color: var(--text-dim);
  }

  .m-crumb-current {
    color: var(--text-bright);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 320px;
  }

  /* Workspace Grid: Viewport + Telemetry Panel */
  .m-workspace-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1rem;
    min-height: calc(100vh - 180px);
  }

  /* 3D Viewport Frame */
  .m-viewport-window {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 520px;
    background: #000414;
    overflow: hidden;
  }

  .m-viewport-mount {
    flex: 1;
    width: 100%;
    height: 100%;
    min-height: 480px;
    cursor: grab;
  }

  .m-viewport-mount:active {
    cursor: grabbing;
  }

  /* Overlays (Loading & Error) */
  .m-overlay-screen {
    position: absolute;
    inset: 0;
    background: rgba(0, 4, 20, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 50;
    padding: 1.5rem;
  }

  .m-status-box {
    max-width: 460px;
    width: 100%;
    padding: 2rem 1.5rem;
    text-align: center;
    background: #070c18;
  }

  .m-spinner-icon {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
    animation: pulse 1.5s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.1); opacity: 0.75; }
  }

  .m-loading-title {
    font-family: var(--font-pixel);
    font-size: 0.92rem;
    color: var(--ps1-gold);
    margin-bottom: 0.4rem;
  }

  .m-loading-subtitle {
    font-size: 0.8rem;
    color: #9cb2cc;
    line-height: 1.5;
  }

  /* Floating Tools */
  .m-floating-tools {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    gap: 0.4rem;
    z-index: 30;
  }

  .m-tool-btn {
    background: rgba(10, 16, 28, 0.88);
    border: 1px solid var(--ps1-steel-light);
    color: #c4d4ec;
    font-family: var(--font-pixel);
    font-size: 0.62rem;
    padding: 0.35rem 0.6rem;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: all 0.1s ease;
  }

  .m-tool-btn:hover {
    border-color: var(--ps1-gold);
    color: var(--ps1-gold);
  }

  .m-tool-btn.active {
    border-color: var(--ps1-cyan);
    color: var(--ps1-cyan);
    background: rgba(0, 240, 255, 0.12);
  }

  /* Floating Animation Dock */
  .m-animation-dock {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    right: 0.75rem;
    z-index: 30;
  }

  .m-anim-inner {
    padding: 0.5rem 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    background: rgba(7, 12, 22, 0.92);
    border: 2px inset var(--ps1-steel);
    backdrop-filter: blur(4px);
  }

  .m-anim-play-btn {
    padding: 0.4rem 0.75rem;
    font-size: 0.8rem;
    min-width: 44px;
  }

  .m-anim-slider-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .m-anim-info-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.68rem;
    color: var(--ps1-cyan);
    font-family: var(--font-pixel);
  }

  .m-scrubber-slider {
    width: 100%;
    height: 6px;
    accent-color: var(--ps1-gold);
    cursor: pointer;
  }

  .m-anim-options {
    display: flex;
    gap: 0.35rem;
  }

  /* Side Telemetry Aside */
  .m-telemetry-aside {
    display: flex;
    flex-direction: column;
  }

  .m-aside-inner {
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    overflow-y: auto;
  }

  .m-display-title {
    font-family: var(--font-pixel);
    font-size: 1.1rem;
    color: var(--ps1-gold);
    margin: 0 0 0.4rem 0;
    line-height: 1.35;
  }

  .m-meta-author-row {
    font-size: 0.75rem;
    margin-bottom: 0.65rem;
  }

  .m-author-label {
    color: var(--text-dim);
  }

  .m-author-val {
    color: var(--ps1-cyan);
    font-weight: bold;
  }

  .m-display-desc {
    font-size: 0.8rem;
    color: #b0c4de;
    line-height: 1.5;
    margin: 0;
  }

  /* Metrics Grid */
  .m-metrics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
    padding: 0.85rem;
    background: #060a14;
  }

  .m-metric-cell {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .m-metric-lbl {
    font-family: var(--font-pixel);
    font-size: 0.58rem;
    color: var(--text-dim);
  }

  .m-metric-val {
    font-size: 0.88rem;
    color: #ffffff;
  }

  /* Action Buttons */
  .m-actions-stack {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .m-action-btn {
    width: 100%;
    padding: 0.75rem;
    font-size: 0.82rem;
  }

  .m-action-btn-sm {
    width: 100%;
    padding: 0.5rem;
    font-size: 0.7rem;
  }

  /* Integration Hint */
  .m-integration-hint {
    padding: 0.75rem;
    background: #060912;
    text-align: center;
  }

  .hint-title {
    font-family: var(--font-pixel);
    font-size: 0.58rem;
    color: var(--ps1-cyan);
    display: block;
    margin-bottom: 0.4rem;
  }

  .hint-tags {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.65rem;
    color: #9cb2cc;
    font-family: var(--font-mono);
  }

  /* Code Tabs */
  .btn-code-tab {
    background: #141c2c;
    border: 1px solid var(--ps1-steel);
    color: #a0b4cc;
    font-family: var(--font-pixel);
    font-size: 0.65rem;
    padding: 0.35rem 0.65rem;
    cursor: pointer;
  }

  .btn-code-tab.active {
    background: var(--ps1-gold);
    color: #000;
    border-color: var(--ps1-gold);
  }

  /* Responsive */
  @media (max-width: 980px) {
    .m-workspace-grid {
      grid-template-columns: 1fr;
    }
    .m-viewport-window {
      min-height: 440px;
    }
  }
</style>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
  import { ProceduralEngine } from '../lib/studio/procedural-engine';
  import { AnimationEngine } from '../lib/studio/animation-engine';
  import { GLBExporterService } from '../lib/studio/glb-exporter';
  import { deserializeSpec, compressSpecToHash } from '../lib/studio/share-serializer';
  import { getCommunityModels } from '../lib/supabase';
  import { generateGodotScript, generateUnityScript, generateThreeJsScript } from '../lib/studio/gamedev-exporter';
  import type { ModelSpec, ShadingMode } from '../lib/studio/types';

  // State
  let activeSpec: ModelSpec | null = null;
  let activeAuthor: string = 'Piloto de la Comunidad';
  let activeSlugOrId: string = '';
  let activeCategory: string = 'fixtures';

  // Three.js scene objects
  let scene: THREE.Scene;
  let camera: THREE.PerspectiveCamera;
  let renderer: THREE.WebGLRenderer;
  let controls: OrbitControls;
  let gridHelper: THREE.GridHelper;
  let currentGroup: THREE.Group | null = null;
  let activeMaterialsMap: Map<THREE.Mesh, THREE.Material | THREE.Material[]> = new Map();

  // Animation system
  let mixer: THREE.AnimationMixer | null = null;
  let activeAction: THREE.AnimationAction | null = null;
  let animClock = new THREE.Clock();
  let isPlaying = false;
  let animSpeed = 1.0;
  let isLoop = true;
  let animDuration = 0;

  // Viewport display state
  let currentShading: ShadingMode = 'shaded';
  let isGridVisible = true;

  // DOM Elements
  const viewportMount = document.getElementById('m-viewport-mount');
  const loadingOverlay = document.getElementById('m-loading-overlay');
  const errorOverlay = document.getElementById('m-error-overlay');
  const errorMessage = document.getElementById('m-error-message');
  const topbarModelName = document.getElementById('m-topbar-model-name');
  const displayTitle = document.getElementById('m-display-title');
  const displayAuthor = document.getElementById('m-display-author');
  const displayDesc = document.getElementById('m-display-desc');
  const metricTris = document.getElementById('m-metric-tris');
  const metricParts = document.getElementById('m-metric-parts');
  const metricDims = document.getElementById('m-metric-dims');
  const modelCategoryTag = document.getElementById('m-model-category-tag');

  // Animation Dock DOM
  const animDock = document.getElementById('m-animation-dock');
  const btnAnimPlay = document.getElementById('btn-anim-play');
  const animPlayIcon = document.getElementById('anim-play-icon');
  const animTimeDisplay = document.getElementById('anim-time-display');
  const animClipTitle = document.getElementById('anim-clip-title');
  const animProgressScrubber = document.getElementById('anim-progress-scrubber') as HTMLInputElement | null;
  const btnAnimSpeed = document.getElementById('btn-anim-speed');
  const labelAnimSpeed = document.getElementById('label-anim-speed');
  const btnAnimLoop = document.getElementById('btn-anim-loop');

  // Tool Buttons DOM
  const btnToggleShading = document.getElementById('btn-toggle-shading');
  const labelShadingMode = document.getElementById('label-shading-mode');
  const btnToggleGrid = document.getElementById('btn-toggle-grid');
  const btnResetCam = document.getElementById('btn-reset-cam');
  const btnToggleFullscreen = document.getElementById('btn-toggle-fullscreen');
  const viewportCard = document.getElementById('m-viewport-card');

  // Actions DOM
  const btnOpenInStudio = document.getElementById('btn-open-in-studio');
  const btnDownloadGlb = document.getElementById('btn-download-glb-direct');
  const btnOpenShareDialog = document.getElementById('btn-open-share-dialog');
  const btnOpenCodeDialog = document.getElementById('btn-open-code-dialog');
  const shareDialog = document.getElementById('m-share-dialog') as HTMLDialogElement | null;
  const btnCloseShareDialog = document.getElementById('btn-close-share-dialog');
  const shareUrlInput = document.getElementById('m-share-url-input') as HTMLInputElement | null;
  const btnCopyShareLink = document.getElementById('btn-copy-share-link');
  const shareToast = document.getElementById('m-share-toast');
  const codeDialog = document.getElementById('m-code-dialog') as HTMLDialogElement | null;
  const btnCloseCodeDialog = document.getElementById('btn-close-code-dialog');
  const codeTarget = document.getElementById('m-code-target');
  const btnCopyIntegrationCode = document.getElementById('btn-copy-integration-code');

  // 1. Initialize Three.js Viewport
  function initThree() {
    if (!viewportMount) return;

    scene = new THREE.Scene();
    scene.background = new THREE.Color(0x060914);

    const width = viewportMount.clientWidth || 800;
    const height = viewportMount.clientHeight || 520;
    camera = new THREE.PerspectiveCamera(45, width / height, 0.05, 100);
    camera.position.set(2.4, 1.8, 3.2);

    renderer = new THREE.WebGLRenderer({ antialias: true, preserveDrawingBuffer: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.1;
    viewportMount.appendChild(renderer.domElement);

    controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.target.set(0, 0.8, 0);

    // Lights
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.9);
    scene.add(ambientLight);

    const dirLight1 = new THREE.DirectionalLight(0xffeedd, 1.6);
    dirLight1.position.set(5, 10, 7);
    scene.add(dirLight1);

    const dirLight2 = new THREE.DirectionalLight(0x88bbff, 0.8);
    dirLight2.position.set(-5, -2, -5);
    scene.add(dirLight2);

    // Grid
    gridHelper = new THREE.GridHelper(10, 20, 0x00f0ff, 0x162444);
    gridHelper.position.y = -0.001;
    scene.add(gridHelper);

    // Resize handling
    window.addEventListener('resize', onWindowResize);

    // Animation Loop
    function animate() {
      requestAnimationFrame(animate);
      const delta = animClock.getDelta();

      if (mixer && isPlaying) {
        mixer.update(delta * animSpeed);

        if (activeAction && animDuration > 0) {
          const currentTime = activeAction.time % animDuration;
          if (animProgressScrubber) {
            animProgressScrubber.value = String((currentTime / animDuration) * 100);
          }
          if (animTimeDisplay) {
            animTimeDisplay.textContent = `${currentTime.toFixed(1)}s / ${animDuration.toFixed(1)}s`;
          }
        }
      }

      controls.update();
      renderer.render(scene, camera);
    }
    animate();
  }

  function onWindowResize() {
    if (!viewportMount || !renderer || !camera) return;
    const width = viewportMount.clientWidth;
    const height = viewportMount.clientHeight;
    camera.aspect = width / height;
    camera.updateProjectionMatrix();
    renderer.setSize(width, height);
  }

  // 2. Load Model Pipeline
  async function loadTargetModel() {
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const slugParam = urlParams.get('slug') || urlParams.get('id');
      const hash = window.location.hash;

      // Strategy A: URL Hash token (#model=...)
      if (hash && (hash.includes('model=') || hash.length > 20)) {
        const decoded = await deserializeSpec(hash);
        if (decoded) {
          activeSpec = decoded;
          activeAuthor = decoded.author?.name || 'Creador de la Pieza';
          activeSlugOrId = decoded.id || 'modelo_compartido';
          renderLoadedModel(decoded);
          return;
        }
      }

      // Strategy B: Slug or ID from Supabase Community Models
      if (slugParam) {
        activeSlugOrId = slugParam;
        const communityModels = await getCommunityModels({ onlyPublic: false });
        const found = communityModels.find((m) => m.slug === slugParam || m.id === slugParam);

        if (found && found.spec) {
          activeSpec = found.spec;
          activeAuthor = found.author_name || 'Piloto de la Comunidad';
          activeCategory = found.category || found.spec.category || 'fixtures';
          renderLoadedModel(found.spec, found);
          return;
        }
      }

      // Strategy C: Built-in catalog sample fallback if no params provided
      showErrorState('No se especificó ningún modelo para visualizar. Abre un modelo desde el catálogo o desde el Studio 3D.');
    } catch (err: any) {
      showErrorState(err.message || 'Error al decodificar la geometría 3D.');
    }
  }

  // 3. Render 3D Model into Viewport
  function renderLoadedModel(spec: ModelSpec, metadata?: any) {
    if (!scene) return;

    if (currentGroup) {
      scene.remove(currentGroup);
      currentGroup = null;
    }
    if (mixer) {
      mixer.stopAllAction();
      mixer.uncacheRoot(mixer.getRoot());
      mixer = null;
    }

    try {
      const { group, stats } = ProceduralEngine.buildModelFromSpec(spec);
      currentGroup = group;
      scene.add(currentGroup);

      // Cache materials for wireframe/shading toggles
      activeMaterialsMap.clear();
      group.traverse((child) => {
        if ((child as THREE.Mesh).isMesh) {
          const mesh = child as THREE.Mesh;
          activeMaterialsMap.set(mesh, mesh.material);
        }
      });

      // Fit camera nicely
      const box = new THREE.Box3().setFromObject(group);
      const center = box.getCenter(new THREE.Vector3());
      const size = box.getSize(new THREE.Vector3());
      const maxDim = Math.max(size.x, size.y, size.z, 1.0);

      controls.target.copy(center);
      camera.position.set(center.x + maxDim * 1.5, center.y + maxDim * 1.0, center.z + maxDim * 1.8);
      controls.update();

      // Populate UI Telemetry
      const modelName = metadata?.name || spec.name || 'Modelo Procedural';
      if (topbarModelName) topbarModelName.textContent = modelName.toUpperCase();
      if (displayTitle) displayTitle.textContent = modelName;
      if (displayAuthor) displayAuthor.textContent = metadata?.author_name || activeAuthor;
      if (displayDesc) displayDesc.textContent = metadata?.description || spec.description || 'Modelo procedural 3D optimizado con materiales PBR.';
      if (modelCategoryTag) modelCategoryTag.textContent = (metadata?.category || spec.category || activeCategory).toUpperCase();

      if (metricTris) metricTris.textContent = String(stats.triangles || 0);
      if (metricParts) metricParts.textContent = String(stats.componentCount || spec.components?.length || 0);
      if (metricDims && stats.dimensions) {
        metricDims.textContent = `${stats.dimensions.width.toFixed(2)} × ${stats.dimensions.height.toFixed(2)} × ${stats.dimensions.depth.toFixed(2)} m`;
      }

      // Setup Animations if present
      setupModelAnimations(spec, group);

      // Hide loading overlay
      if (loadingOverlay) loadingOverlay.classList.add('hidden');
    } catch (err: any) {
      showErrorState(`Fallo al construir la malla procedural: ${err.message || err}`);
    }
  }

  // 4. Setup Animation Playback Dock
  function setupModelAnimations(spec: ModelSpec, rootGroup: THREE.Group) {
    if (!spec.animations || spec.animations.length === 0) {
      if (animDock) animDock.classList.add('hidden');
      return;
    }

    try {
      const clips = AnimationEngine.compileAnimations(spec, rootGroup);
      if (!clips || clips.length === 0) {
        if (animDock) animDock.classList.add('hidden');
        return;
      }

      mixer = new THREE.AnimationMixer(rootGroup);
      const firstClip = clips[0];
      activeAction = mixer.clipAction(firstClip);
      animDuration = firstClip.duration || 1.0;

      activeAction.setLoop(isLoop ? THREE.LoopRepeat : THREE.LoopOnce, Infinity);
      activeAction.clampWhenFinished = !isLoop;
      activeAction.play();
      isPlaying = true;

      if (animPlayIcon) animPlayIcon.textContent = '⏸';
      if (animClipTitle) animClipTitle.textContent = firstClip.name.toUpperCase();
      if (animDock) animDock.classList.remove('hidden');
    } catch (err) {
      console.warn('[ModelCoder Viewer] Could not compile animations:', err);
      if (animDock) animDock.classList.add('hidden');
    }
  }

  function showErrorState(msg: string) {
    if (loadingOverlay) loadingOverlay.classList.add('hidden');
    if (errorOverlay) {
      errorOverlay.classList.remove('hidden');
      if (errorMessage) errorMessage.textContent = msg;
    }
  }

  // 5. Controls and Interaction Listeners
  btnAnimPlay?.addEventListener('click', () => {
    if (!activeAction) return;
    isPlaying = !isPlaying;
    if (isPlaying) {
      activeAction.paused = false;
      if (animPlayIcon) animPlayIcon.textContent = '⏸';
    } else {
      activeAction.paused = true;
      if (animPlayIcon) animPlayIcon.textContent = '▶';
    }
  });

  animProgressScrubber?.addEventListener('input', (e) => {
    if (!activeAction || animDuration <= 0) return;
    const pct = parseFloat((e.target as HTMLInputElement).value) / 100;
    activeAction.time = pct * animDuration;
    mixer?.update(0);
  });

  btnAnimSpeed?.addEventListener('click', () => {
    if (animSpeed === 1.0) animSpeed = 2.0;
    else if (animSpeed === 2.0) animSpeed = 0.5;
    else animSpeed = 1.0;

    if (labelAnimSpeed) labelAnimSpeed.textContent = `${animSpeed.toFixed(1)}x`;
  });

  btnAnimLoop?.addEventListener('click', () => {
    if (!activeAction) return;
    isLoop = !isLoop;
    activeAction.setLoop(isLoop ? THREE.LoopRepeat : THREE.LoopOnce, Infinity);
    activeAction.clampWhenFinished = !isLoop;

    if (btnAnimLoop) {
      btnAnimLoop.classList.toggle('active', isLoop);
      btnAnimLoop.textContent = isLoop ? '🔁 Bucle' : '⏭ 1 Vez';
    }
  });

  // Viewport Shading Modes
  btnToggleShading?.addEventListener('click', () => {
    if (currentShading === 'shaded') {
      currentShading = 'wireframe';
    } else if (currentShading === 'wireframe') {
      currentShading = 'flat';
    } else {
      currentShading = 'shaded';
    }

    if (labelShadingMode) {
      labelShadingMode.textContent = currentShading === 'shaded' ? 'PBR' : currentShading === 'wireframe' ? 'MALLA' : 'PLANO';
    }

    activeMaterialsMap.forEach((origMat, mesh) => {
      if (currentShading === 'wireframe') {
        mesh.material = new THREE.MeshBasicMaterial({ wireframe: true, color: 0x00f0ff });
      } else if (currentShading === 'flat') {
        mesh.material = new THREE.MeshLambertMaterial({ color: 0xc0d0e0 });
      } else {
        mesh.material = origMat;
      }
    });
  });

  btnToggleGrid?.addEventListener('click', () => {
    isGridVisible = !isGridVisible;
    if (gridHelper) gridHelper.visible = isGridVisible;
    btnToggleGrid?.classList.toggle('active', isGridVisible);
  });

  btnResetCam?.addEventListener('click', () => {
    if (!currentGroup) return;
    const box = new THREE.Box3().setFromObject(currentGroup);
    const center = box.getCenter(new THREE.Vector3());
    const size = box.getSize(new THREE.Vector3());
    const maxDim = Math.max(size.x, size.y, size.z, 1.0);

    controls.target.copy(center);
    camera.position.set(center.x + maxDim * 1.5, center.y + maxDim * 1.0, center.z + maxDim * 1.8);
    controls.update();
  });

  btnToggleFullscreen?.addEventListener('click', () => {
    if (!document.fullscreenElement) {
      viewportCard?.requestFullscreen?.();
    } else {
      document.exitFullscreen?.();
    }
  });

  // Action: Open in Studio
  btnOpenInStudio?.addEventListener('click', async () => {
    if (!activeSpec) return;
    try {
      const hash = await compressSpecToHash(activeSpec);
      window.location.href = `/studio#model=${hash}`;
    } catch {
      window.location.href = `/studio`;
    }
  });

  // Action: Download .GLB
  btnDownloadGlb?.addEventListener('click', async () => {
    if (!activeSpec) return;
    const btn = btnDownloadGlb as HTMLButtonElement;
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '⏳ GENERANDO .GLB...';

    try {
      const glbBuffer = await GLBExporterService.exportSpec(activeSpec);
      const blob = new Blob([glbBuffer], { type: 'model/gltf-binary' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      const filename = `${(activeSpec.name || 'modelo').toLowerCase().replace(/[^a-z0-9]/g, '_')}.glb`;
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    } catch (err) {
      alert('Error exportando modelo GLB: ' + err);
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  });

  // Action: Share Modal
  btnOpenShareDialog?.addEventListener('click', async () => {
    if (!shareDialog || !activeSpec) return;
    const origin = window.location.origin;
    let shareUrl = '';

    if (activeSlugOrId && !activeSlugOrId.startsWith('#')) {
      // Short clean URL for published models
      shareUrl = `${origin}/m?slug=${activeSlugOrId}`;
    } else {
      // Compressed Deflate token
      const hashToken = await compressSpecToHash(activeSpec);
      shareUrl = `${origin}/m#model=${hashToken}`;
    }

    if (shareUrlInput) shareUrlInput.value = shareUrl;
    if (shareToast) shareToast.classList.add('hidden');
    shareDialog.showModal();
  });

  btnCopyShareLink?.addEventListener('click', () => {
    if (shareUrlInput && shareUrlInput.value) {
      navigator.clipboard.writeText(shareUrlInput.value).then(() => {
        if (shareToast) shareToast.classList.remove('hidden');
      });
    }
  });

  btnCloseShareDialog?.addEventListener('click', () => {
    shareDialog?.close();
  });

  // Action: Integration Code Modal
  let currentCodeTab = 'godot';
  function updateIntegrationCode() {
    if (!activeSpec || !codeTarget) return;
    if (currentCodeTab === 'godot') {
      codeTarget.textContent = generateGodotScript(activeSpec);
    } else if (currentCodeTab === 'unity') {
      codeTarget.textContent = generateUnityScript(activeSpec);
    } else {
      codeTarget.textContent = generateThreeJsScript(activeSpec);
    }
  }

  btnOpenCodeDialog?.addEventListener('click', () => {
    if (!codeDialog || !activeSpec) return;
    updateIntegrationCode();
    codeDialog.showModal();
  });

  btnCloseCodeDialog?.addEventListener('click', () => {
    codeDialog?.close();
  });

  document.querySelectorAll('.btn-code-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.btn-code-tab').forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      currentCodeTab = (tab as HTMLElement).dataset.tab || 'godot';
      updateIntegrationCode();
    });
  });

  btnCopyIntegrationCode?.addEventListener('click', () => {
    if (codeTarget && codeTarget.textContent) {
      navigator.clipboard.writeText(codeTarget.textContent).then(() => {
        const orig = btnCopyIntegrationCode.textContent;
        btnCopyIntegrationCode.textContent = '¡COPIADO!';
        setTimeout(() => {
          btnCopyIntegrationCode.textContent = orig;
        }, 1500);
      });
    }
  });

  // Start initialization
  initThree();
  loadTargetModel();
</script>
