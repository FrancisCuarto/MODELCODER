---
import Layout from '../layouts/Layout.astro';
import catalog from '../data/catalog.json';

// Calculate category counts
const categoryCounts: Record<string, number> = {};
catalog.forEach((item) => {
  categoryCounts[item.category] = (categoryCounts[item.category] || 0) + 1;
});

const categories = [
  { id: 'all', label: 'TODOS', count: catalog.length },
  { id: 'furniture', label: 'MOBILIARIO', count: categoryCounts['furniture'] || 0 },
  { id: 'fixtures', label: 'LUCES & DISPOSITIVOS', count: categoryCounts['fixtures'] || 0 },
  { id: 'infrastructure', label: 'INFRAESTRUCTURA', count: categoryCounts['infrastructure'] || 0 },
  { id: 'medical', label: 'MÉDICO & LAB', count: categoryCounts['medical'] || 0 },
  { id: 'architecture', label: 'ARQUITECTURA', count: categoryCounts['architecture'] || 0 },
];
---

<Layout title="Catálogo de Generadores 3D">
  <!-- Hero Window -->
  <section class="ps1-window hero-window">
    <div class="ps1-titlebar">
      <span>// MODELCODER — GENERADORES 3D PROCEDURALES</span>
      <span class="ps1-title-status">SISTEMA ACTIVO</span>
    </div>

    <div class="hero-body">
      <div class="hero-header-line">
        <h1 class="hero-title">Creá modelos 3D para tus proyectos, sin empezar desde cero.</h1>
      </div>
      <p class="hero-description">
        Explorá objetos, cambiá su forma con controles simples y descargá el resultado en formato universal GLB.
        Si te interesa, también podés descubrir y personalizar el código Python que los construye.
      </p>

      <!-- Dos Recorridos Claros: Usar vs Crear -->
      <div class="user-journeys-container">
        <div class="journey-card ps1-inset journey-user">
          <div class="journey-header">
            <span class="journey-badge">[ RECORRIDO PRINCIPAL ]</span>
            <h2 class="journey-title">Quiero usar y personalizar un modelo</h2>
          </div>
          <p class="journey-desc">
            Elegí un objeto del catálogo, ajustá sus dimensiones o colores con controles visuales y descargá tu archivo <strong>.GLB</strong> listo para tu motor o escena. No necesitás conocimientos técnicos.
          </p>
          <a href="#catalog-controls" class="btn btn-primary journey-btn">
            [ EXPLORAR EL CATÁLOGO ({catalog.length}) ↓ ]
          </a>
        </div>

        <div class="journey-card ps1-inset journey-creator">
          <div class="journey-header">
            <span class="journey-badge journey-badge-gold">[ HERRAMIENTAS AVANZADAS ]</span>
            <h2 class="journey-title">Quiero crear o programar generadores</h2>
          </div>
          <p class="journey-desc">
            Diseñá nuevos objetos describiéndolos con <strong>Gemini 3.8 Flash</strong> o editá código Python en vivo para Blender. Podés publicar tus modelos en el repositorio abierto.
          </p>
          <div class="journey-links-row">
            <a href="/studio" class="btn btn-gold journey-btn">
              ⚡ STUDIO 3D CON IA
            </a>
            <a href="/contribute" class="btn btn-outline journey-btn">
              📖 CÓMO FUNCIONA
            </a>
          </div>
        </div>
      </div>

      <!-- Explicación en 3 pasos -->
      <div class="three-steps-container">
        <div class="step-card ps1-inset">
          <div class="step-badge">PASO 01</div>
          <h3 class="step-title">Elegí un objeto</h3>
          <p class="step-desc">Explorá los {catalog.length} modelos low-poly organizados por categorías según lo que necesite tu escena.</p>
        </div>
        <div class="step-card ps1-inset">
          <div class="step-badge">PASO 02</div>
          <h3 class="step-title">Personalizalo</h3>
          <p class="step-desc">Ajustá sus medidas, paletas de color retro y accesorios con controles visuales en tiempo real.</p>
        </div>
        <div class="step-card ps1-inset">
          <div class="step-badge">PASO 03</div>
          <h3 class="step-title">Descargalo</h3>
          <p class="step-desc">Obtené tu archivo .GLB listo para importar directo en Godot 4, Unity, Blender o la web.</p>
        </div>
      </div>

      <!-- Retro PS1 HUD Telemetry -->
      <div class="metrics-grid">
        <div class="ps1-inset metric-card">
          <span class="metric-lbl">TOTAL MODELOS</span>
          <span class="metric-val text-gold">{catalog.length}</span>
        </div>
        <div class="ps1-inset metric-card">
          <span class="metric-lbl">PALETAS RETRO</span>
          <span class="metric-val text-cyan">5</span>
        </div>
        <div class="ps1-inset metric-card">
          <span class="metric-lbl">LICENCIA</span>
          <span class="metric-val text-green">CC-BY 4.0</span>
        </div>
        <div class="ps1-inset metric-card">
          <span class="metric-lbl">FORMATO</span>
          <span class="metric-val text-gold">GLTF / GLB</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PS1 Tactical Filter Controls -->
  <section class="ps1-window catalog-controls-window" id="catalog-controls">
    <div class="ps1-titlebar">
      <span>// BÚSQUEDA Y FILTRADO DEL CATÁLOGO</span>
      <span id="results-count" class="results-telemetry">{catalog.length} MODELOS ENCONTRADOS</span>
    </div>

    <div class="controls-body">
      <div class="search-row">
        <span class="search-prompt">&gt; BUSCAR:</span>
        <div class="search-box">
          <input 
            type="text" 
            id="search-input" 
            placeholder="Buscá una puerta, una mesa, una máquina, un panel, una litera..." 
            autocomplete="off"
          />
        </div>
      </div>

      <div class="category-filters">
        <span class="filter-prompt">&gt; CATEGORÍA:</span>
        <div class="filter-buttons-wrap">
          {categories.map((cat) => (
            <button 
              class={`filter-btn ${cat.id === 'all' ? 'active' : ''}`}
              data-category={cat.id}
            >
              [{cat.label}: {cat.count}]
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Generator Cards Grid -->
  <div class="generators-grid" id="generators-container">
    {catalog.map((gen) => (
      <article 
        class="ps1-window generator-card"
        data-family={gen.family}
        data-category={gen.category}
        data-tags={gen.tags.join(' ')}
        data-name={gen.name.toLowerCase()}
        data-desc={gen.description.toLowerCase()}
      >
        <div class="ps1-titlebar card-titlebar">
          <span class="card-category-badge">[{gen.category.toUpperCase()}]</span>
          <span class="card-license-tag">{gen.license}</span>
        </div>

        <div class="ps1-inset card-preview">
          {gen.has_model ? (
            <model-viewer
              src={gen.model_url}
              alt={gen.name}
              auto-rotate
              rotation-per-second="25deg"
              camera-controls
              interaction-prompt="none"
              shadow-intensity="1.0"
              loading="lazy"
              class="model-preview"
            ></model-viewer>
          ) : (
            <div class="placeholder-preview">
              <span>[ VISTA 3D EN LOCAL ]</span>
            </div>
          )}

          <div class="preview-badges">
            <span class={`category-badge category-${gen.category}`}>
              {gen.category}
            </span>
            <span class="preset-badge">
              {gen.presets.length} PRESET{gen.presets.length === 1 ? '' : 'S'}
            </span>
          </div>
        </div>

        <div class="card-body">
          <h2 class="card-title">
            <a href={`/generators/${gen.family}`}>{gen.name}</a>
          </h2>
          <p class="card-description">{gen.description}</p>

          <div class="card-meta">
            <span class="ps1-inset meta-tag">📐 {gen.parameters.length} CONTROLES</span>
            <span class="ps1-inset meta-tag">~{gen.export_capabilities?.target_tri_budget || 450} TRIS</span>
            <span class="ps1-inset meta-tag">v{gen.version}</span>
          </div>
        </div>

        <div class="card-footer">
          <a href={`/generators/${gen.family}`} class="btn btn-primary" style="flex: 1;">
            PERSONALIZAR & 3D &gt;&gt;
          </a>
          {gen.has_model && (
            <a 
              href={gen.model_url} 
              download={`${gen.family}.glb`}
              class="btn btn-outline" 
              title="Descargar archivo GLB directamente"
            >
              BAJAR .GLB
            </a>
          )}
        </div>
      </article>
    ))}
  </div>

  <div id="no-results" class="ps1-window no-results" style="display: none;">
    <div class="ps1-titlebar">
      <span>// NO_MATCH_FOUND</span>
    </div>
    <div style="padding: 2rem; text-align: center;">
      <p style="color: var(--ps1-gold); font-family: var(--font-pixel); margin-bottom: 1rem;">
        NO SE ENCONTRARON GENERADORES QUE COINCIDAN CON LOS FILTROS.
      </p>
      <button id="reset-filters-btn" class="btn btn-primary">
        [ RESTABLECER FILTROS ]
      </button>
    </div>
  </div>
</Layout>

<script>
  // Client-side filtering logic
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.generator-card');
  const resultsCount = document.getElementById('results-count');
  const noResults = document.getElementById('no-results');
  const resetBtn = document.getElementById('reset-filters-btn');

  let activeCategory = 'all';
  let searchQuery = '';

  function applyFilters() {
    let visible = 0;

    cards.forEach((cardEl) => {
      const card = cardEl as HTMLElement;
      const category = card.dataset.category || '';
      const name = card.dataset.name || '';
      const desc = card.dataset.desc || '';
      const family = card.dataset.family || '';
      const tags = card.dataset.tags || '';

      const matchesCat = activeCategory === 'all' || category === activeCategory;
      const q = searchQuery.toLowerCase().trim();
      const matchesSearch = !q || 
        name.includes(q) || 
        desc.includes(q) || 
        family.includes(q) || 
        tags.includes(q);

      if (matchesCat && matchesSearch) {
        card.style.display = 'flex';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });

    if (resultsCount) {
      resultsCount.textContent = `${visible} / ${cards.length} RECORDS`;
    }

    if (noResults) {
      noResults.style.display = visible === 0 ? 'block' : 'none';
    }
  }

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    applyFilters();
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeCategory = btn.getAttribute('data-category') || 'all';
      applyFilters();
    });
  });

  resetBtn?.addEventListener('click', () => {
    searchQuery = '';
    activeCategory = 'all';
    if (searchInput) searchInput.value = '';
    filterBtns.forEach((b) => {
      if (b.getAttribute('data-category') === 'all') b.classList.add('active');
      else b.classList.remove('active');
    });
    applyFilters();
  });
</script>

<style>
  /* Hero Briefing Window */
  .hero-window {
    margin-bottom: 2rem;
  }

  .hero-body {
    padding: 1.5rem;
  }

  .ps1-title-status {
    color: var(--ps1-green);
    font-family: var(--font-telemetry);
    font-size: 1.1rem;
  }

  .hero-title {
    font-family: var(--font-title);
    font-size: 1.35rem;
    line-height: 1.5;
    color: var(--ps1-gold);
    margin-bottom: 0.75rem;
    letter-spacing: 0.04em;
    text-shadow: 2px 2px 0px #000000;
  }

  .hero-description {
    font-size: 0.95rem;
    color: #c0cde0;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    max-width: 1000px;
  }

  /* Dual User Journeys */
  .user-journeys-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .journey-card {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: #090e1c;
    border: 2px outset var(--ps1-steel);
  }

  .journey-user {
    border-left: 4px solid var(--ps1-cyan);
  }

  .journey-creator {
    border-left: 4px solid var(--ps1-gold);
    background: #0d1222;
  }

  .journey-badge {
    font-family: var(--font-pixel);
    font-size: 0.65rem;
    color: var(--ps1-cyan);
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.25rem;
  }

  .journey-badge-gold {
    color: var(--ps1-gold);
  }

  .journey-title {
    font-family: var(--font-pixel);
    font-size: 0.9rem;
    color: #ffffff;
    margin: 0;
    line-height: 1.35;
  }

  .journey-desc {
    font-size: 0.85rem;
    color: #b0c0d8;
    line-height: 1.5;
    margin: 0;
    flex: 1;
  }

  .journey-btn {
    text-align: center;
    font-size: 0.75rem;
    padding: 0.6rem 0.85rem;
    text-decoration: none;
  }

  .journey-links-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .journey-links-row .journey-btn {
    flex: 1;
  }

  /* 3-Step Guide */
  .three-steps-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .step-card {
    padding: 1.1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    border: 1px solid var(--ps1-steel);
    background: #060912;
  }

  .step-badge {
    font-family: var(--font-pixel);
    font-size: 0.65rem;
    color: var(--ps1-cyan);
    letter-spacing: 0.05em;
  }

  .step-title {
    font-family: var(--font-pixel);
    font-size: 0.85rem;
    color: #ffffff;
    margin: 0;
  }

  .step-desc {
    font-size: 0.82rem;
    color: var(--text-dim);
    line-height: 1.5;
    margin: 0;
  }

  /* Retro HUD Telemetry Metrics */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.85rem;
  }

  .metric-card {
    padding: 0.85rem 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .metric-lbl {
    font-family: var(--font-pixel);
    font-size: 0.65rem;
    color: var(--text-dim);
    margin-bottom: 0.25rem;
    letter-spacing: 0.05em;
  }

  .metric-val {
    font-family: var(--font-telemetry);
    font-size: 1.85rem;
    line-height: 1;
    font-weight: 700;
  }

  .text-gold { color: var(--ps1-gold); }
  .text-cyan { color: var(--ps1-cyan); }
  .text-green { color: var(--ps1-green); }

  /* Tactical Catalog Controls Window */
  .catalog-controls-window {
    margin-bottom: 2rem;
  }

  .controls-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .results-telemetry {
    color: var(--ps1-cyan);
    font-family: var(--font-telemetry);
    font-size: 1.15rem;
  }

  .search-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .search-prompt, .filter-prompt {
    font-family: var(--font-pixel);
    font-size: 0.75rem;
    color: var(--ps1-gold);
    min-width: 90px;
  }

  .search-box {
    flex: 1;
  }

  .search-box input {
    width: 100%;
    background: #050810;
    border: 2px inset var(--ps1-steel);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    padding: 0.55rem 0.85rem;
    outline: none;
    box-shadow: inset 2px 2px 0px #000000;
  }

  .search-box input:focus {
    border-color: var(--ps1-gold);
    background: #090e1c;
  }

  .category-filters {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .filter-buttons-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex: 1;
  }

  .filter-btn {
    background: #182030;
    border: 2px outset var(--ps1-steel-light);
    color: #c2cfdf;
    font-family: var(--font-pixel);
    font-size: 0.68rem;
    padding: 0.4rem 0.65rem;
    cursor: pointer;
    box-shadow: 1px 1px 0px #000;
  }

  .filter-btn:hover {
    background: #232f48;
    color: var(--ps1-gold);
    border-color: var(--ps1-gold);
  }

  .filter-btn.active {
    background: #735b22;
    border: 2px inset var(--ps1-gold-light);
    color: #ffffff;
    font-weight: 700;
    box-shadow: inset 1px 1px 0px #000;
  }

  /* Grid & Generator Cards */
  .generators-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .generator-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .card-titlebar {
    font-size: 0.7rem;
    padding: 0.35rem 0.65rem;
  }

  .card-family-tag {
    color: var(--ps1-cyan);
    font-family: var(--font-mono);
  }

  .card-license-tag {
    color: var(--text-dim);
    font-size: 0.65rem;
  }

  .card-preview {
    position: relative;
    height: 220px;
    margin: 0.5rem;
    background: radial-gradient(circle at center, #1b2640 0%, #060912 100%);
  }

  .model-preview {
    width: 100%;
    height: 100%;
    --poster-color: transparent;
  }

  .placeholder-preview {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dim);
    font-family: var(--font-pixel);
    font-size: 0.75rem;
  }

  .preview-badges {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    right: 0.5rem;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  .card-body {
    padding: 0.85rem 1rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-title {
    font-family: var(--font-pixel);
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
  }

  .card-title a {
    color: #ffffff;
    text-decoration: none;
  }

  .card-title a:hover {
    color: var(--ps1-gold);
    text-decoration: underline;
  }

  .card-description {
    font-size: 0.85rem;
    color: #a0aec0;
    line-height: 1.45;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .meta-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.15rem 0.45rem;
    color: var(--ps1-cyan);
  }

  .card-footer {
    padding: 0.75rem 1rem;
    background: #0a0e18;
    border-top: 2px solid var(--ps1-steel);
    display: flex;
    gap: 0.5rem;
  }

  .card-category-badge {
    color: var(--ps1-gold);
    font-family: var(--font-pixel);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    .user-journeys-container {
      grid-template-columns: 1fr;
    }
    .three-steps-container {
      grid-template-columns: 1fr;
    }
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .hero-title {
      font-size: 1.05rem;
    }
    .search-row, .category-filters {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
