---
import Layout from '../layouts/Layout.astro';
import catalog from '../data/catalog.json';
import { getAllModularModels } from '../data/modular-catalog.ts';

const modularModels = getAllModularModels();

// Calculate category counts
const categoryCounts: Record<string, number> = {};
catalog.forEach((item) => {
  categoryCounts[item.category] = (categoryCounts[item.category] || 0) + 1;
});
modularModels.forEach((item) => {
  categoryCounts[item.category] = (categoryCounts[item.category] || 0) + 1;
});

const totalModelsCount = catalog.length + modularModels.length;
const modularCount = modularModels.length;

const ANIMATED_FAMILIES = new Set([
  'antenna_dish',
  'alarm_siren',
  'security_camera',
  'door',
  'maintenance_hatch',
  'crate'
]);

const animatedCount = catalog.filter((item) => ANIMATED_FAMILIES.has(item.family)).length;

const categories = [
  { id: 'all', label: 'TODOS', count: totalModelsCount },
  { id: 'furniture', label: 'MOBILIARIO', count: categoryCounts['furniture'] || 0 },
  { id: 'fixtures', label: 'LUCES & DISPOSITIVOS', count: categoryCounts['fixtures'] || 0 },
  { id: 'infrastructure', label: 'INFRAESTRUCTURA', count: categoryCounts['infrastructure'] || 0 },
  { id: 'medical', label: 'MÉDICO & LAB', count: categoryCounts['medical'] || 0 },
  { id: 'architecture', label: 'ARQUITECTURA', count: categoryCounts['architecture'] || 0 },
];
---

<Layout 
  title="Modelos 3D Low-Poly y Generadores Procedurales Gratis (GLB)"
  description="Biblioteca abierta de modelos 3D low-poly y generadores procedurales en formato universal GLB para Godot 4, Unity y Blender. Personalizá y descargá assets 3D optimizados para videojuegos."
  keywords="modelos 3d gratis, descargar glb, generadores 3d procedurales, low poly 3d, godot 3d assets, unity 3d props, blender assets, ps1 3d, sci fi 3d models"
>
  <!-- Hero Window -->
  <section class="ps1-window hero-window">
    <div class="ps1-titlebar">
      <span>MODELCODER — GENERADORES 3D PROCEDURALES</span>
      <span class="ps1-title-status">SISTEMA ACTIVO</span>
    </div>

    <div class="hero-body">
      <div class="hero-creator-banner">
        <img src="/logo.png" alt="ModelCoder Logo" class="hero-logo-img" width="64" height="64" />
        <div class="hero-creator-meta">
          <div class="hero-creator-tag">
            <span class="pulse-dot"></span>
            <span>PROYECTO INDEPENDIENTE · IV ORBIT GAMES</span>
          </div>
          <span class="hero-creator-by">
            POR <a href="https://ivorbitgames.online" target="_blank" rel="noopener noreferrer">IV ORBIT GAMES</a> &bull; FRANCISCUARTO &bull; BUENOS AIRES
          </span>
        </div>
      </div>

      <div class="hero-header-line">
        <h1 class="hero-title">Creá modelos 3D para tus proyectos, sin empezar desde cero.</h1>
      </div>
      <p class="hero-description">
        Explorá objetos, cambiá su forma con controles simples y descargá el resultado en formato universal GLB.
        Si te interesa, también podés descubrir y personalizar el código Python que los construye.
      </p>

      <!-- Dos Recorridos Claros: Usar vs Crear -->
      <div class="user-journeys-container">
        <div class="journey-card ps1-inset journey-user">
          <div class="journey-header">
            <span class="journey-badge">[ RECORRIDO PRINCIPAL ]</span>
            <h2 class="journey-title">Quiero usar y personalizar un modelo</h2>
          </div>
          <p class="journey-desc">
            Elegí un objeto del catálogo, ajustá sus dimensiones o colores con controles visuales y descargá tu archivo <strong>.GLB</strong> listo para tu motor o escena. No necesitás conocimientos técnicos.
          </p>
          <a href="#catalog-controls" class="btn btn-primary journey-btn">
            <span id="hero-explore-btn-text">[ EXPLORAR EL CATÁLOGO ({totalModelsCount}) ↓ ]</span>
          </a>
        </div>

        <div class="journey-card ps1-inset journey-creator">
          <div class="journey-header">
            <span class="journey-badge journey-badge-gold">[ HERRAMIENTAS AVANZADAS ]</span>
            <h2 class="journey-title">Quiero crear o programar generadores</h2>
          </div>
          <p class="journey-desc">
            Diseñá nuevos objetos describiéndolos con <strong>Gemini 3.8 Flash</strong> o editá código Python en vivo para Blender. Podés publicar tus modelos en el repositorio abierto.
          </p>
          <div class="journey-links-row">
            <a href="/studio" class="btn btn-gold journey-btn">
              ⚡ STUDIO 3D CON IA
            </a>
            <a href="/contribute" class="btn btn-outline journey-btn">
              📖 CÓMO FUNCIONA
            </a>
          </div>
        </div>
      </div>

      <!-- Explicación en 3 pasos -->
      <div class="three-steps-container">
        <div class="step-card ps1-inset">
          <div class="step-badge">PASO 01</div>
          <h3 class="step-title">Elegí un objeto</h3>
          <p class="step-desc">Explorá los <span id="step-models-count">{totalModelsCount}</span> modelos low-poly organizados por categorías según lo que necesite tu escena.</p>
        </div>
        <div class="step-card ps1-inset">
          <div class="step-badge">PASO 02</div>
          <h3 class="step-title">Personalizalo</h3>
          <p class="step-desc">Ajustá sus medidas, paletas de color retro y accesorios con controles visuales en tiempo real.</p>
        </div>
        <div class="step-card ps1-inset">
          <div class="step-badge">PASO 03</div>
          <h3 class="step-title">Descargalo</h3>
          <p class="step-desc">Obtené tu archivo .GLB listo para importar directo en Godot 4, Unity, Blender o la web.</p>
        </div>
      </div>

      <!-- Retro PS1 HUD Telemetry -->
      <div class="metrics-grid">
        <div class="ps1-inset metric-card">
          <span class="metric-lbl">TOTAL MODELOS</span>
          <span id="metric-total-models" class="metric-val text-gold">{totalModelsCount}</span>
        </div>
        <div class="ps1-inset metric-card">
          <span class="metric-lbl">PALETAS RETRO</span>
          <span class="metric-val text-cyan">5</span>
        </div>
        <div class="ps1-inset metric-card">
          <span class="metric-lbl">LICENCIA</span>
          <span class="metric-val text-green">CC-BY 4.0</span>
        </div>
        <div class="ps1-inset metric-card">
          <span class="metric-lbl">FORMATO</span>
          <span class="metric-val text-gold">GLTF / GLB</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PS1 Tactical Filter Controls -->
  <section class="ps1-window catalog-controls-window" id="catalog-controls">
    <div class="ps1-titlebar">
      <span>BÚSQUEDA Y FILTRADO DEL CATÁLOGO</span>
      <span id="results-count" class="results-telemetry">{totalModelsCount} MODELOS ENCONTRADOS</span>
    </div>

    <div class="controls-body">
      <div class="search-row">
        <span class="search-prompt">&gt; BUSCAR:</span>
        <div class="search-box">
          <input 
            type="text" 
            id="search-input" 
            placeholder="Buscá una puerta, una mesa, una máquina, un panel, una litera..." 
            autocomplete="off"
          />
        </div>
      </div>

      <div class="category-filters">
        <span class="filter-prompt">&gt; CATEGORÍA:</span>
        <div class="filter-buttons-wrap">
          {categories.map((cat) => (
            <button 
              class={`filter-btn ${cat.id === 'all' ? 'active' : ''}`}
              data-category={cat.id}
            >
              [{cat.label}: {cat.count}]
            </button>
          ))}
          <button 
            class="filter-btn filter-btn-modular"
            id="btn-filter-modular"
            data-category="modular"
            title="Mostrar modelos modulares construidos en la web con piezas 100% editables"
          >
            [ ✨ MODULARES: {modularCount} ]
          </button>
          <button 
            class="filter-btn filter-btn-anim"
            id="btn-filter-animated"
            data-category="animated"
            title="Mostrar modelos interactivos con animaciones cinemáticas"
          >
            [ 🎬 ANIMADOS: {animatedCount} ]
          </button>
          <button 
            class="filter-btn filter-btn-fav"
            id="btn-filter-favorites"
            data-category="favorites"
            title="Mostrar solo modelos guardados en favoritos"
          >
            [ ⭐ FAVORITOS: <span id="fav-count-badge">0</span> ]
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Generator Cards Grid -->
  <div class="generators-grid" id="generators-container">
    {/* Modelos Modulares Procedurales 100% Editables */}
    {modularModels.map((mod) => (
      <article 
        class="ps1-window generator-card card-modular"
        data-family={mod.family}
        data-category={mod.category}
        data-modular="true"
        data-animated="false"
        data-tags={`${mod.tags.join(' ')} modular editable studio 3d capas piezas componentes ${mod.name.toLowerCase()} ${mod.description.toLowerCase()}`}
        data-name={mod.name.toLowerCase()}
        data-desc={mod.description.toLowerCase()}
      >
        <div class="ps1-titlebar card-titlebar card-titlebar-modular">
          <div style="display: flex; align-items: center; gap: 0.4rem;">
            <button 
              type="button"
              class="btn-card-fav"
              data-id={mod.family}
              data-name={mod.name}
              data-category={mod.category}
              data-type="modular"
              data-url={mod.glbUrl}
              title="Guardar en favoritos"
              aria-label="Guardar en favoritos"
            >
              <span class="fav-star">☆</span>
            </button>
            <span class="card-category-badge">[{mod.category.toUpperCase()}]</span>
            <span class="card-modular-tag" title="Modelo paramétrico 100% editable por capas individuales en Studio 3D">✨ 100% EDITABLE</span>
          </div>
          <span class="card-batch-tag">LOTE {mod.batch}</span>
        </div>

        <div class="ps1-inset card-preview">
          <model-viewer
            src={mod.glbUrl}
            alt={mod.name}
            auto-rotate
            rotation-per-second="25deg"
            camera-controls
            interaction-prompt="none"
            shadow-intensity="1.0"
            loading="lazy"
            class="model-preview"
          ></model-viewer>

          <div class="preview-badges">
            <span class={`category-badge category-${mod.category}`}>
              {mod.category}
            </span>
            <span class="category-badge badge-modular-pill" title="Modelo procedural con piezas separadas y modificables">
              ✨ MODULAR
            </span>
            <span class="preset-badge">
              {mod.spec.components.length} PIEZAS
            </span>
          </div>
        </div>

        <div class="card-body">
          <h2 class="card-title">
            <a href={`/m?modular=${mod.family}`}>{mod.name}</a>
          </h2>
          <p class="card-description">{mod.description}</p>

          <div class="card-meta">
            <span class="ps1-inset meta-tag tag-modular" title="Cada pieza se puede mover, cambiar textura, duplicar o editar su código">✨ 100% EDITABLE</span>
            <span class="ps1-inset meta-tag">🧩 {mod.spec.components.length} PIEZAS</span>
            <span class="ps1-inset meta-tag">~{mod.triBudget} TRIS</span>
            <span class="ps1-inset meta-tag">📦 LOTE {mod.batch}</span>
          </div>
        </div>

        <div class="card-footer">
          <a href={`/studio?modular=${mod.family}`} class="btn btn-gold" title="Abrir en Studio 3D para editar cada pieza por separado">
            ⚡ EDITAR EN STUDIO
          </a>
          <a 
            href={mod.glbUrl} 
            download={`${mod.family}.glb`}
            class="btn btn-outline btn-download" 
            title="Descargar archivo GLB directamente"
          >
            BAJAR .GLB
          </a>
        </div>
      </article>
    ))}

    {catalog.map((gen) => {
      const isAnim = ANIMATED_FAMILIES.has(gen.family);
      return (
      <article 
        class={`ps1-window generator-card ${isAnim ? 'card-animated' : ''}`}
        data-family={gen.family}
        data-category={gen.category}
        data-animated={isAnim ? "true" : "false"}
        data-tags={`${gen.tags.join(' ')}${isAnim ? ' animacion anim animado cinetica movimiento' : ''}`}
        data-name={gen.name.toLowerCase()}
        data-desc={gen.description.toLowerCase()}
      >
        <div class="ps1-titlebar card-titlebar">
          <div style="display: flex; align-items: center; gap: 0.4rem;">
            <button 
              type="button"
              class="btn-card-fav"
              data-id={gen.family}
              data-name={gen.name}
              data-category={gen.category}
              data-type="catalog"
              data-url={gen.model_url}
              title="Guardar en favoritos"
              aria-label="Guardar en favoritos"
            >
              <span class="fav-star">☆</span>
            </button>
            <span class="card-category-badge">[{gen.category.toUpperCase()}]</span>
            {isAnim && (
              <span class="card-anim-tag" title="Modelo 3D con animación cinemática integrada">🎬 ANIMADO</span>
            )}
          </div>
          <span class="card-license-tag">{gen.license}</span>
        </div>

        <div class="ps1-inset card-preview">
          {gen.has_model ? (
            <model-viewer
              src={gen.model_url}
              alt={gen.name}
              auto-rotate
              rotation-per-second="25deg"
              camera-controls
              interaction-prompt="none"
              shadow-intensity="1.0"
              loading="lazy"
              class="model-preview"
            ></model-viewer>
          ) : (
            <div class="placeholder-preview">
              <span>[ VISTA 3D EN LOCAL ]</span>
            </div>
          )}

          <div class="preview-badges">
            <span class={`category-badge category-${gen.category}`}>
              {gen.category}
            </span>
            <span class="category-badge badge-baked-pill" title="Modelo 3D con geometría horneada (mesh unificado para motores de juegos)">
              🧊 BAKEADO
            </span>
            {isAnim && (
              <span class="category-badge badge-anim-pill" title="Pista de animación lista para motores de juegos">
                🎬 ANIMACIÓN
              </span>
            )}
            <span class="preset-badge">
              {gen.presets.length} PRESET{gen.presets.length === 1 ? '' : 'S'}
            </span>
          </div>
        </div>

        <div class="card-body">
          <h2 class="card-title">
            <a href={`/generators/${gen.family}`}>{gen.name}</a>
          </h2>
          <p class="card-description">{gen.description}</p>

          <div class="card-meta">
            <span class="ps1-inset meta-tag tag-baked" title="Malla horneada no modificable por piezas individuales">🧊 MALLA BAKEADA</span>
            <span class="ps1-inset meta-tag">📐 {gen.parameters.length} CONTROLES</span>
            <span class="ps1-inset meta-tag">~{gen.export_capabilities?.target_tri_budget || 450} TRIS</span>
            <span class="ps1-inset meta-tag">v{gen.version}</span>
          </div>
        </div>

        <div class="card-footer">
          <a href={`/generators/${gen.family}`} class="btn btn-primary" title="Abrir generador para personalizar en 3D">
            PERSONALIZAR 3D
          </a>
          {gen.has_model && (
            <a 
              href={gen.model_url} 
              download={`${gen.family}.glb`}
              class="btn btn-outline btn-download" 
              title="Descargar archivo GLB directamente"
            >
              BAJAR .GLB
            </a>
          )}
        </div>
      </article>
      );
    })}
  </div>

  <div id="no-results" class="ps1-window no-results" style="display: none;">
    <div class="ps1-titlebar">
      <span>SIN RESULTADOS</span>
    </div>
    <div style="padding: 2rem; text-align: center;">
      <p id="no-results-msg" style="color: var(--ps1-gold); font-family: var(--font-pixel); margin-bottom: 1rem;">
        NO SE ENCONTRARON GENERADORES QUE COINCIDAN CON LOS FILTROS.
      </p>
      <button id="reset-filters-btn" class="btn btn-primary">
        [ RESTABLECER FILTROS ]
      </button>
    </div>
  </div>

  <!-- Sección: Sobre el Creador / IV Orbit Games -->
  <section class="ps1-window creator-showcase-window" id="sobre-el-creador">
    <div class="ps1-titlebar">
      <span>EL CREADOR · SOBRE IV ORBIT GAMES & EL ECOSISTEMA DE BELOW NOMINAL</span>
      <span class="ps1-title-status">BUENOS AIRES, ARGENTINA</span>
    </div>
    <div class="creator-showcase-body">
      <div class="creator-showcase-grid">
        <!-- Tarjeta de Identidad del Creador -->
        <div class="creator-card ps1-inset">
          <div class="creator-card-header">
            <img src="/logo.png" alt="Logo de ModelCoder e IV Orbit" class="creator-logo-avatar" width="72" height="72" />
            <div class="creator-header-meta">
              <span class="creator-badge">[ CREADOR INDEPENDIENTE ]</span>
              <h3 class="creator-name">FRANCISCUARTO</h3>
              <span class="creator-studio-name">IV ORBIT GAMES &bull; ARGENTINA</span>
            </div>
          </div>
          <p class="creator-bio-p">
            Desarrollo videojuegos independientes y herramientas propias desde Buenos Aires, Argentina. Me interesa combinar mecánicas interesantes, atmósferas cuidadas y soluciones técnicas que hagan realidad cada idea.
          </p>
          <div class="creator-specs-row">
            <div class="spec-pill"><span class="lbl">MOTOR:</span> <span class="val">Godot Engine</span></div>
            <div class="spec-pill"><span class="lbl">MODELADO:</span> <span class="val">Blender & ModelCoder</span></div>
            <div class="spec-pill"><span class="lbl">ESTÉTICA:</span> <span class="val">PS1 / 32-Bit Low-Poly</span></div>
          </div>
          <div class="creator-links-group">
            <a href="https://ivorbitgames.online" target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-sm">
              🪐 ivorbitgames.online &rarr;
            </a>
            <a href="https://iv-orbit.itch.io" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
              🎮 itch.io
            </a>
            <a href="https://www.youtube.com/@Franciscuarto" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
              📺 YouTube
            </a>
            <a href="https://github.com/FrancisCuarto" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
              🐙 GitHub
            </a>
          </div>
        </div>

        <!-- Tarjeta del Origen y Videojuegos de IV Orbit Games -->
        <div class="creator-games-card ps1-inset">
          <div class="games-card-header">
            <span class="spotlight-tag">[ EL ORIGEN DE MODELCODER ]</span>
            <h4 class="games-card-title">Diseñado para crear assets reales de videojuegos</h4>
          </div>
          <p class="games-card-desc">
            ModelCoder no es un experimento aislado: nació como el conjunto de generadores modulares para crear el equipamiento, las consolas y los props industriales de <strong>Below Nominal</strong>, un juego de terror y supervivencia bajo el hielo de la luna Europa desarrollado con Godot Engine.
          </p>

          <div class="games-showcase-list">
            <div class="game-item-box">
              <div class="game-item-top">
                <span class="game-item-title">🧊 Below Nominal</span>
                <span class="game-badge-dev">EN DESARROLLO (PC)</span>
              </div>
              <p class="game-item-text">
                Una estación científica en la luna Europa. Mantené con vida los sistemas de oxígeno y energía mientras descubrís los horrores que yacen bajo el hielo.
              </p>
              <a href="https://iv-orbit.itch.io/belownominal" target="_blank" rel="noopener noreferrer" class="game-link">
                Descargar Demo Técnica en itch.io &rarr;
              </a>
            </div>

            <div class="game-item-box">
              <div class="game-item-top">
                <span class="game-item-title">🚗 Puchito &bull; Taller Espacial</span>
                <span class="game-badge-avail">DISPONIBLE (PC)</span>
              </div>
              <p class="game-item-text">
                Minijuegos y gestión arcade a ritmo frenético atendiendo naves espaciales en una estación de servicio intergaláctica.
              </p>
              <a href="https://ivorbitgames.online/juegos/puchito" target="_blank" rel="noopener noreferrer" class="game-link">
                Ver ficha de Puchito &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { getCommunityModels } from '../lib/supabase';
  import { toggleFavorite, isFavorite, getFavorites } from '../lib/user-inventory';

  // Client-side filtering logic
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const filterBtns = document.querySelectorAll('.filter-btn');
  const generatorsContainer = document.getElementById('generators-container');
  const resultsCount = document.getElementById('results-count');
  const noResults = document.getElementById('no-results');
  const resetBtn = document.getElementById('reset-filters-btn');
  const favCountBadge = document.getElementById('fav-count-badge');

  let activeCategory = 'all';
  let searchQuery = '';
  let communityModelsList: any[] = [];

  function getCards(): HTMLElement[] {
    return Array.from(document.querySelectorAll('.generator-card')) as HTMLElement[];
  }

  function updateFavoritesUI(): void {
    const favs = getFavorites();
    if (favCountBadge) favCountBadge.textContent = `${favs.length}`;

    document.querySelectorAll('.btn-card-fav').forEach((btn) => {
      const id = (btn as HTMLElement).dataset.id;
      if (!id) return;
      const star = btn.querySelector('.fav-star');
      const isFav = isFavorite(id);
      if (star) {
        star.textContent = isFav ? '⭐' : '☆';
        star.classList.toggle('active', isFav);
      }
      btn.setAttribute('title', isFav ? 'Quitar de favoritos' : 'Guardar en favoritos');
    });
  }

  function wireFavoriteButtons(): void {
    document.querySelectorAll('.btn-card-fav').forEach((btn) => {
      (btn as HTMLElement).onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        const el = e.currentTarget as HTMLElement;
        const id = el.dataset.id;
        const name = el.dataset.name || id || '';
        const cat = el.dataset.category || 'furniture';
        const type = (el.dataset.type as any) || 'catalog';
        const url = el.dataset.url;
        if (!id) return;

        toggleFavorite({
          id,
          name,
          category: cat,
          type,
          model_url: url,
        });

        updateFavoritesUI();
        if (activeCategory === 'favorites') {
          applyFilters();
        }
      };
    });
    updateFavoritesUI();
  }

  function applyFilters() {
    let visible = 0;
    const cards = getCards();

    cards.forEach((card) => {
      const category = card.dataset.category || '';
      const name = card.dataset.name || '';
      const desc = card.dataset.desc || '';
      const family = card.dataset.family || '';
      const tags = card.dataset.tags || '';

      let matchesCat = false;
      if (activeCategory === 'all') {
        matchesCat = true;
      } else if (activeCategory === 'favorites') {
        matchesCat = isFavorite(family);
      } else if (activeCategory === 'animated') {
        matchesCat = card.dataset.animated === 'true';
      } else if (activeCategory === 'modular') {
        matchesCat = card.dataset.modular === 'true';
      } else {
        matchesCat = category === activeCategory;
      }

      const q = searchQuery.toLowerCase().trim();
      const matchesSearch = !q || 
        name.includes(q) || 
        desc.includes(q) || 
        family.includes(q) || 
        tags.includes(q);

      if (matchesCat && matchesSearch) {
        card.style.display = 'flex';
        card.style.flexDirection = 'column';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });

    if (resultsCount) {
      resultsCount.textContent = `${visible} DE ${cards.length} MODELOS ENCONTRADOS`;
    }

    if (noResults) {
      if (visible === 0) {
        noResults.style.display = 'block';
        const msgEl = document.getElementById('no-results-msg');
        if (msgEl) {
          if (activeCategory === 'favorites') {
            msgEl.textContent = 'NO TIENES MODELOS GUARDADOS COMO FAVORITOS AÚN. HAZ CLIC EN LA ESTRELLA ⭐ DE CUALQUIER MODELO PARA GUARDARLO.';
          } else if (activeCategory === 'animated') {
            msgEl.textContent = 'NO SE ENCONTRARON MODELOS CON ANIMACIÓN QUE COINCIDAN CON LOS FILTROS.';
          } else if (activeCategory === 'modular') {
            msgEl.textContent = 'NO SE ENCONTRARON MODELOS MODULARES QUE COINCIDAN CON LOS FILTROS.';
          } else {
            msgEl.textContent = 'NO SE ENCONTRARON GENERADORES QUE COINCIDAN CON LOS FILTROS.';
          }
        }
      } else {
        noResults.style.display = 'none';
      }
    }
  }

  function escapeHtml(str: unknown): string {
    return String(str ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  // Pause auto-rotate and animation loops on off-screen <model-viewer> instances to save GPU/CPU frames
  const viewerObserver = typeof IntersectionObserver !== 'undefined'
    ? new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const mv = entry.target as any;
          if (entry.isIntersecting) {
            mv.setAttribute('auto-rotate', '');
            if (mv.availableAnimations && mv.availableAnimations.length > 0 && typeof mv.play === 'function') {
              try { mv.play({ repetitions: Infinity }); } catch {}
            }
          } else {
            mv.removeAttribute('auto-rotate');
            if (typeof mv.pause === 'function') {
              try { mv.pause(); } catch {}
            }
          }
        });
      }, { rootMargin: '120px' })
    : null;

  function observeModelViewers() {
    if (!viewerObserver) return;
    document.querySelectorAll('model-viewer.model-preview').forEach((mv) => {
      viewerObserver.observe(mv);
    });
  }

  // Cargar y mostrar modelos subidos directamente por colaboradores
  async function loadCommunityModels() {
    try {
      communityModelsList = await getCommunityModels({ onlyPublic: true });
      if (!generatorsContainer || communityModelsList.length === 0) {
        wireFavoriteButtons();
        observeModelViewers();
        return;
      }

      communityModelsList.forEach((m) => {
        const article = document.createElement('article');
        article.className = 'ps1-window generator-card community-card';
        article.style.display = 'flex';
        article.style.flexDirection = 'column';
        article.style.overflow = 'hidden';
        const safeSlug = escapeHtml(m.slug);
        const safeName = escapeHtml(m.name);
        const safeCat = escapeHtml(m.category || 'furniture');
        const safeDesc = escapeHtml(m.description || 'Modelo procedural creado por el equipo de colaboradores de ModelCoder.');
        const safeAuthor = escapeHtml(m.author_name || 'Comunidad');
        const safeGlb = escapeHtml(m.glb_data || '');

        article.dataset.family = m.slug;
        article.dataset.category = m.category || 'furniture';
        article.dataset.tags = `comunidad colaborador ${String(m.name || '').toLowerCase()} ${String(m.description || '').toLowerCase()}`;
        article.dataset.name = String(m.name || '').toLowerCase();
        article.dataset.desc = String(m.description || '').toLowerCase();

        const previewContent = m.glb_data
          ? `<model-viewer
              src="${safeGlb}"
              alt="${safeName}"
              auto-rotate
              rotation-per-second="25deg"
              camera-controls
              interaction-prompt="none"
              shadow-intensity="1.0"
              loading="lazy"
              class="model-preview"
            ></model-viewer>`
          : `<div class="placeholder-preview" style="display:flex; flex-direction:column; justify-content:center; align-items:center; background:#070d18; height:100%;">
              <span style="font-size:2.5rem; margin-bottom: 0.35rem;">📦</span>
              <span style="font-family: var(--font-pixel); font-size:0.7rem; color:var(--ps1-gold);">MODELO PROCEDURAL EN NUBE</span>
            </div>`;

        article.innerHTML = `
          <div class="ps1-titlebar card-titlebar" style="background: linear-gradient(90deg, #172433, #0a131e); border-bottom: 1px solid var(--ps1-gold);">
            <div style="display: flex; align-items: center; gap: 0.4rem;">
              <button 
                type="button"
                class="btn-card-fav"
                data-id="${safeSlug}"
                data-name="${safeName}"
                data-category="${safeCat}"
                data-type="community"
                data-url="${safeGlb}"
                title="Guardar en favoritos"
                aria-label="Guardar en favoritos"
              >
                <span class="fav-star">☆</span>
              </button>
              <span class="card-category-badge" style="color: var(--ps1-gold);">[${safeCat.toUpperCase()}]</span>
            </div>
            <span class="card-license-tag" style="color: var(--ps1-green); font-weight: bold;">👑 COMUNIDAD</span>
          </div>

          <div class="ps1-inset card-preview">
            ${previewContent}
            <div class="preview-badges">
              <span class="category-badge category-${safeCat}">
                ${safeCat}
              </span>
              <span class="preset-badge" style="background: var(--ps1-gold); color: #000; font-weight: bold;">
                EQUIPO OFICIAL
              </span>
            </div>
          </div>

          <div class="card-body">
            <h2 class="card-title">
              <a href="/m?slug=${safeSlug}" class="comm-open-link" data-slug="${safeSlug}" title="Inspeccionar en visor 3D público">${safeName}</a>
            </h2>
            <p class="card-description">${safeDesc}</p>

            <div class="card-meta">
              <span class="ps1-inset meta-tag">📐 ${Number(m.spec?.components?.length) || 0} PIEZAS</span>
              <span class="ps1-inset meta-tag">~${Number(m.tri_count) || 350} TRIS</span>
              <span class="ps1-inset meta-tag" style="color: var(--ps1-cyan);">👤 ${safeAuthor}</span>
            </div>
          </div>

          <div class="card-footer" style="display: flex; gap: 0.35rem; flex-wrap: wrap;">
            <a href="/m?slug=${safeSlug}" class="btn btn-outline" style="flex: 1; text-align: center; text-decoration: none; font-size: 0.72rem; padding: 0.4rem 0.5rem;" title="Ver e interactuar en el visor 3D">
              👁️ VER 3D
            </a>
            <button type="button" class="btn btn-primary btn-open-comm-studio" data-slug="${safeSlug}" style="flex: 1.2; font-size: 0.72rem; padding: 0.4rem 0.5rem;" title="Abrir en Studio 3D para editar">
              ⚡ STUDIO
            </button>
            ${m.glb_data ? `<a href="${safeGlb}" download="${safeSlug}.glb" class="btn btn-outline btn-download" style="font-size: 0.72rem; padding: 0.4rem 0.5rem;" title="Descargar archivo GLB directamente">.GLB</a>` : ''}
          </div>
        `;

        generatorsContainer.prepend(article);
      });

      generatorsContainer.querySelectorAll('.btn-open-comm-studio, .comm-open-link').forEach((el) => {
        el.addEventListener('click', (e) => {
          e.preventDefault();
          const slug = (e.currentTarget as HTMLElement).dataset.slug;
          const found = communityModelsList.find((x) => x.slug === slug);
          if (found && found.spec) {
            localStorage.setItem('modelcoder_spec', JSON.stringify(found.spec));
            window.location.href = '/studio';
          }
        });
      });

      // Actualizar contadores globales y métricas dinámicas
      const totalCount = 101 + communityModelsList.length;

      const headerCountEl = document.getElementById('header-models-count');
      if (headerCountEl) headerCountEl.textContent = `${totalCount} MODELOS DISPONIBLES`;

      const heroExploreText = document.getElementById('hero-explore-btn-text');
      if (heroExploreText) heroExploreText.textContent = `[ EXPLORAR EL CATÁLOGO (${totalCount}) ↓ ]`;

      const stepModelsEl = document.getElementById('step-models-count');
      if (stepModelsEl) stepModelsEl.textContent = `${totalCount}`;

      const metricTotalEl = document.getElementById('metric-total-models');
      if (metricTotalEl) metricTotalEl.textContent = `${totalCount}`;

      const allBtn = document.querySelector('.filter-btn[data-category="all"]');
      if (allBtn) allBtn.textContent = `[TODOS: ${totalCount}]`;

      wireFavoriteButtons();
      observeModelViewers();
      applyFilters();
    } catch (err) {
      console.warn('[ModelCoder] Could not load community models on homepage:', err);
      wireFavoriteButtons();
      observeModelViewers();
    }
  }

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    applyFilters();
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeCategory = btn.getAttribute('data-category') || 'all';
      applyFilters();
    });
  });

  resetBtn?.addEventListener('click', () => {
    searchQuery = '';
    activeCategory = 'all';
    if (searchInput) searchInput.value = '';
    filterBtns.forEach((b) => {
      if (b.getAttribute('data-category') === 'all') b.classList.add('active');
      else b.classList.remove('active');
    });
    applyFilters();
  });

  window.addEventListener('modelcoder:inventory_updated', () => {
    updateFavoritesUI();
    if (activeCategory === 'favorites') {
      applyFilters();
    }
  });

  loadCommunityModels();
  wireFavoriteButtons();
  observeModelViewers();
</script>

