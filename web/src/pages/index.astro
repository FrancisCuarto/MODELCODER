---
import Layout from '../layouts/Layout.astro';
import catalog from '../data/catalog.json';

// Calculate category counts
const categoryCounts: Record<string, number> = {};
catalog.forEach((item) => {
  categoryCounts[item.category] = (categoryCounts[item.category] || 0) + 1;
});

const categories = [
  { id: 'all', label: 'Todos', count: catalog.length },
  { id: 'furniture', label: 'Mobiliario', count: categoryCounts['furniture'] || 0 },
  { id: 'fixtures', label: 'Accesorios & Focos', count: categoryCounts['fixtures'] || 0 },
  { id: 'infrastructure', label: 'Infraestructura', count: categoryCounts['infrastructure'] || 0 },
  { id: 'medical', label: 'Médico & Lab', count: categoryCounts['medical'] || 0 },
  { id: 'architecture', label: 'Arquitectura', count: categoryCounts['architecture'] || 0 },
];
---

<Layout title="Catálogo de Generadores 3D">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-badge">PLATAFORMA ABIERTA DE MODELOS 3D</div>
    <h1 class="hero-title">Generadores Procedurales para Below Nominal</h1>
    <p class="hero-description">
      No sólo descargues modelos 3D estáticos. Personaliza el código que los construye,
      inspecciona sus parámetros matemáticos en tiempo real y expórtalos optimizados para Godot y glTF.
    </p>

    <!-- Metrics Bar -->
    <div class="metrics-grid">
      <div class="metric-card">
        <span class="metric-val">{catalog.length}</span>
        <span class="metric-lbl">Generadores</span>
      </div>
      <div class="metric-card">
        <span class="metric-val">5</span>
        <span class="metric-lbl">Sectores / Categorías</span>
      </div>
      <div class="metric-card">
        <span class="metric-val">100%</span>
        <span class="metric-lbl">Código Abierto</span>
      </div>
      <div class="metric-card">
        <span class="metric-val">PSX</span>
        <span class="metric-lbl">Estética Retro-SciFi</span>
      </div>
    </div>
  </section>

  <!-- Filter Controls -->
  <section class="catalog-controls">
    <div class="search-box">
      <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        type="text" 
        id="search-input" 
        placeholder="Buscar por nombre, etiquetas, autor o familia (ej. mesa, medbay, crt, panel)..." 
        autocomplete="off"
      />
    </div>

    <div class="category-filters">
      {categories.map((cat) => (
        <button 
          class={`filter-btn ${cat.id === 'all' ? 'active' : ''}`}
          data-category={cat.id}
        >
          {cat.label} <span class="filter-count">({cat.count})</span>
        </button>
      ))}
    </div>
  </section>

  <!-- Results count -->
  <div class="results-header">
    <span id="results-count">Mostrando {catalog.length} generadores</span>
  </div>

  <!-- Generator Cards Grid -->
  <div class="generators-grid" id="generators-container">
    {catalog.map((gen) => (
      <article 
        class="generator-card"
        data-family={gen.family}
        data-category={gen.category}
        data-tags={gen.tags.join(' ')}
        data-name={gen.name.toLowerCase()}
        data-desc={gen.description.toLowerCase()}
      >
        <div class="card-preview">
          {gen.has_model ? (
            <model-viewer
              src={gen.model_url}
              alt={gen.name}
              auto-rotate
              rotation-per-second="20deg"
              camera-controls
              interaction-prompt="none"
              shadow-intensity="0.8"
              loading="lazy"
              class="model-preview"
            ></model-viewer>
          ) : (
            <div class="placeholder-preview">
              <span>Vista 3D disponible en local</span>
            </div>
          )}

          <div class="preview-badges">
            <span class={`category-badge category-${gen.category}`}>
              {gen.category}
            </span>
            <span class="preset-badge">
              {gen.presets.length} {gen.presets.length === 1 ? 'Preset' : 'Presets'}
            </span>
          </div>
        </div>

        <div class="card-body">
          <h2 class="card-title">
            <a href={`/generators/${gen.family}`}>{gen.name}</a>
          </h2>
          <p class="card-description">{gen.description}</p>

          <div class="card-meta">
            <span class="meta-tag">{gen.parameters.length} Parámetros</span>
            <span class="meta-tag">{gen.license}</span>
            <span class="meta-tag">v{gen.version}</span>
          </div>
        </div>

        <div class="card-footer">
          <a href={`/generators/${gen.family}`} class="btn btn-primary" style="flex: 1;">
            Personalizar & 3D &rarr;
          </a>
          {gen.has_model && (
            <a 
              href={gen.model_url} 
              download={`${gen.family}.glb`}
              class="btn btn-outline" 
              title="Descargar GLB pre-renderizado"
            >
              GLB
            </a>
          )}
        </div>
      </article>
    ))}
  </div>

  <div id="no-results" class="no-results" style="display: none;">
    <p>No se encontraron generadores que coincidan con los filtros seleccionados.</p>
    <button id="reset-filters-btn" class="btn btn-outline" style="margin-top: 1rem;">
      Restablecer Filtros
    </button>
  </div>
</Layout>

<script>
  // Client-side filtering logic
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.generator-card');
  const resultsCount = document.getElementById('results-count');
  const noResults = document.getElementById('no-results');
  const resetBtn = document.getElementById('reset-filters-btn');

  let activeCategory = 'all';
  let searchQuery = '';

  function applyFilters() {
    let visible = 0;

    cards.forEach((cardEl) => {
      const card = cardEl as HTMLElement;
      const category = card.dataset.category || '';
      const name = card.dataset.name || '';
      const desc = card.dataset.desc || '';
      const family = card.dataset.family || '';
      const tags = card.dataset.tags || '';

      const matchesCat = activeCategory === 'all' || category === activeCategory;
      const q = searchQuery.toLowerCase().trim();
      const matchesSearch = !q || 
        name.includes(q) || 
        desc.includes(q) || 
        family.includes(q) || 
        tags.includes(q);

      if (matchesCat && matchesSearch) {
        card.style.display = 'flex';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });

    if (resultsCount) {
      resultsCount.textContent = `Mostrando ${visible} de ${cards.length} generadores`;
    }

    if (noResults) {
      noResults.style.display = visible === 0 ? 'block' : 'none';
    }
  }

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    applyFilters();
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeCategory = btn.getAttribute('data-category') || 'all';
      applyFilters();
    });
  });

  resetBtn?.addEventListener('click', () => {
    searchQuery = '';
    activeCategory = 'all';
    if (searchInput) searchInput.value = '';
    filterBtns.forEach((b) => {
      if (b.getAttribute('data-category') === 'all') b.classList.add('active');
      else b.classList.remove('active');
    });
    applyFilters();
  });
</script>

<style>
  .hero-section {
    text-align: center;
    padding: 3rem 1rem 2.5rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-amber);
    background: rgba(255, 176, 0, 0.1);
    border: 1px solid rgba(255, 176, 0, 0.3);
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    margin-bottom: 1.25rem;
    letter-spacing: 0.08em;
  }

  .hero-title {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
    background: linear-gradient(180deg, #ffffff 0%, #a0aec0 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-description {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .metric-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 1.25rem 0.5rem;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .metric-val {
    font-family: var(--font-mono);
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--accent-cyan);
  }

  .metric-lbl {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  /* Catalog Controls */
  .catalog-controls {
    margin: 2rem 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .search-box {
    position: relative;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
  }

  .search-box input {
    width: 100%;
    background: var(--bg-input);
    border: 1px solid var(--border-subtle);
    color: var(--text-main);
    font-family: var(--font-sans);
    font-size: 1rem;
    padding: 0.9rem 1rem 0.9rem 2.85rem;
    border-radius: 6px;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .search-box input:focus {
    border-color: var(--accent-amber);
    box-shadow: 0 0 0 3px rgba(255, 176, 0, 0.15);
  }

  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-btn {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.45rem 0.85rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filter-btn:hover {
    border-color: #58a6ff;
    color: var(--text-main);
  }

  .filter-btn.active {
    background: rgba(255, 176, 0, 0.15);
    border-color: var(--accent-amber);
    color: var(--accent-amber);
    font-weight: 700;
  }

  .filter-count {
    opacity: 0.7;
    font-size: 0.75rem;
  }

  .results-header {
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* Grid */
  .generators-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .generator-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .generator-card:hover {
    transform: translateY(-3px);
    border-color: #3b4563;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .card-preview {
    position: relative;
    height: 220px;
    background: radial-gradient(circle, #1a202c 0%, #0d0f14 100%);
    border-bottom: 1px solid var(--border-subtle);
  }

  .model-preview {
    width: 100%;
    height: 100%;
    --poster-color: transparent;
  }

  .placeholder-preview {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .preview-badges {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    right: 0.75rem;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  .preset-badge {
    background: rgba(12, 14, 20, 0.75);
    border: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    color: var(--text-muted);
  }

  .card-body {
    padding: 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .card-title a {
    color: var(--text-main);
    text-decoration: none;
  }

  .card-title a:hover {
    color: var(--accent-amber);
    text-decoration: none;
  }

  .card-description {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .meta-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    color: #8b949e;
  }

  .card-footer {
    padding: 0.9rem 1.25rem;
    background: #0d1017;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    gap: 0.5rem;
  }

  .no-results {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  @media (max-width: 768px) {
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .hero-title {
      font-size: 2rem;
    }
  }
</style>
