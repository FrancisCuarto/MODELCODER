---
import Layout from '../layouts/Layout.astro';
import catalog from '../data/catalog.json';
import { getAllModularModels } from '../data/modular-catalog.ts';

const modularModels = getAllModularModels();

const categoryCounts: Record<string, number> = {};
catalog.forEach((item) => {
  categoryCounts[item.category] = (categoryCounts[item.category] || 0) + 1;
});
modularModels.forEach((item) => {
  categoryCounts[item.category] = (categoryCounts[item.category] || 0) + 1;
});

const totalModelsCount = catalog.length + modularModels.length;
const modularCount = modularModels.length;

const ANIMATED_FAMILIES = new Set([
  'antenna_dish',
  'alarm_siren',
  'security_camera',
  'door',
  'maintenance_hatch',
  'crate'
]);

const animatedCount = catalog.filter((item) => ANIMATED_FAMILIES.has(item.family)).length;

const categories = [
  { id: 'all', label: 'Todos', count: totalModelsCount },
  { id: 'furniture', label: 'Mobiliario', count: categoryCounts['furniture'] || 0 },
  { id: 'fixtures', label: 'Luces & Dispositivos', count: categoryCounts['fixtures'] || 0 },
  { id: 'infrastructure', label: 'Infraestructura', count: categoryCounts['infrastructure'] || 0 },
  { id: 'medical', label: 'Médico & Lab', count: categoryCounts['medical'] || 0 },
  { id: 'architecture', label: 'Arquitectura', count: categoryCounts['architecture'] || 0 },
];
---

<Layout
  title="Modelos 3D Low-Poly y Generadores Procedurales Gratis (GLB)"
  description="Biblioteca abierta de modelos 3D low-poly y generadores procedurales en formato universal GLB para Godot 4, Unity y Blender. Personalizá y descargá assets 3D optimizados para videojuegos."
  keywords="modelos 3d gratis, descargar glb, generadores 3d procedurales, low poly 3d, godot 3d assets, unity 3d props, blender assets, ps1 3d, sci fi 3d models"
>
  <script is:inline>
    if (typeof window !== 'undefined' && (
      '__TAURI_INTERNALS__' in window ||
      '__TAURI__' in window ||
      window.location.hostname === 'tauri.localhost' ||
      window.location.protocol === 'tauri:'
    )) {
      const search = window.location.search || '';
      const hash = window.location.hash || '';
      window.location.replace('/studio' + search + hash);
    }
  </script>

  <!-- MULTICA-STYLE EDITORIAL HERO -->
  <section class="mc-hero">
    <div class="mc-hero-eyebrow">
      <span class="mc-eyebrow-dot"></span>
      <span>MODELCODER · IV ORBIT GAMES · CC-BY 4.0</span>
    </div>

    <h1 class="mc-hero-title">
      Modelos 3D low-poly y generadores procedurales, en un solo lugar.
    </h1>

    <p class="mc-hero-subtitle">
      Explorá más de <span id="hero-inline-count">{totalModelsCount}</span> objetos optimizados, personalizá sus piezas y materiales PBR en tiempo real y exportá archivos <strong>.GLB</strong> listos para Godot 4, Unity o Blender.
    </p>

    <div class="mc-hero-ctas">
      <a href="/studio" class="btn btn-primary mc-cta-lg">
        <span>Abrir Studio 3D</span>
        <span aria-hidden="true">→</span>
      </a>
      <a href="#catalog-controls" class="btn btn-outline mc-cta-lg">
        <span id="hero-explore-btn-text">Explorar catálogo ({totalModelsCount})</span>
      </a>
    </div>

    <!-- Framed Workspace Overview (Multica Showcase Frame) -->
    <div class="mc-showcase-frame">
      <div class="mc-showcase-bar">
        <div class="mc-window-dots" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <span class="mc-showcase-caption">WORKFLOW · DE IDEA A .GLB UNIVERSAL</span>
        <span class="mc-showcase-status">Godot 4 · Unity · Blender</span>
      </div>

      <div class="mc-showcase-grid">
        <div class="mc-track-card">
          <span class="mc-track-label">01 · CATÁLOGO Y PERSONALIZACIÓN</span>
          <h2 class="mc-track-title">Usar y adaptar un modelo</h2>
          <p class="mc-track-desc">
            Elegí un objeto, ajustá dimensiones, paletas o piezas modulares desde el navegador y descargá tu <code>.GLB</code> con colisiones listas para tu motor.
          </p>
          <a href="#catalog-controls" class="mc-track-link">Ver modelos disponibles ↓</a>
        </div>

        <div class="mc-track-card">
          <span class="mc-track-label">02 · STUDIO 3D + IA GENERATIVA</span>
          <h2 class="mc-track-title">Crear desde cero o con código</h2>
          <p class="mc-track-desc">
            Diseñá objetos pieza por pieza, describilos con <strong>Gemini Flash</strong> o editá código procedural y scripts Python para Blender en vivo.
          </p>
          <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href="/studio" class="mc-track-link">Ir a Studio 3D →</a>
            <a href="/contribute" class="mc-track-link mc-track-link-muted">Cómo funciona →</a>
          </div>
        </div>
      </div>

      <div class="mc-steps-strip">
        <div class="mc-step-item">
          <span class="mc-step-num">PASO 01</span>
          <strong>Elegí un objeto</strong>
          <span>Explorá <span id="step-models-count">{totalModelsCount}</span> modelos organizados por categoría.</span>
        </div>
        <div class="mc-step-item">
          <span class="mc-step-num">PASO 02</span>
          <strong>Personalizalo</strong>
          <span>Ajustá medidas, texturas PBR y piezas en vivo.</span>
        </div>
        <div class="mc-step-item">
          <span class="mc-step-num">PASO 03</span>
          <strong>Exportalo</strong>
          <span>Descargá en .GLB, .TSCN o paquete Blender.</span>
        </div>
      </div>

      <div class="mc-metrics-strip">
        <div class="mc-metric-cell">
          <span class="mc-metric-lbl">TOTAL MODELOS</span>
          <span id="metric-total-models" class="mc-metric-val">{totalModelsCount}</span>
        </div>
        <div class="mc-metric-cell">
          <span class="mc-metric-lbl">TEXTURAS PBR</span>
          <span class="mc-metric-val">138</span>
        </div>
        <div class="mc-metric-cell">
          <span class="mc-metric-lbl">LICENCIA</span>
          <span class="mc-metric-val">CC-BY 4.0</span>
        </div>
        <div class="mc-metric-cell">
          <span class="mc-metric-lbl">FORMATO</span>
          <span class="mc-metric-val">GLTF / GLB</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CATALOG CONTROLS -->
  <section class="mc-catalog-controls" id="catalog-controls">
    <div class="mc-catalog-header">
      <div>
        <h2 class="mc-section-title">Catálogo de modelos</h2>
        <p class="mc-section-sub" id="results-count">{totalModelsCount} modelos disponibles</p>
      </div>

      <div class="mc-search-wrap">
        <svg class="mc-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
          type="text"
          id="search-input"
          class="mc-search-input"
          placeholder="Buscar puerta, mesa, consola, panel, litera..."
          autocomplete="off"
        />
      </div>
    </div>

    <div class="mc-filter-pills" role="tablist" aria-label="Filtrar catálogo por categoría">
      {categories.map((cat) => (
        <button
          class={`filter-btn mc-filter-pill ${cat.id === 'all' ? 'active' : ''}`}
          data-category={cat.id}
        >
          {cat.label} <span class="pill-count">{cat.count}</span>
        </button>
      ))}
      <button
        class="filter-btn mc-filter-pill"
        id="btn-filter-modular"
        data-category="modular"
        title="Modelos modulares con piezas 100% editables en Studio 3D"
      >
        ✨ Modulares <span class="pill-count">{modularCount}</span>
      </button>
      <button
        class="filter-btn mc-filter-pill"
        id="btn-filter-animated"
        data-category="animated"
        title="Modelos con animaciones cinemáticas integradas"
      >
        🎬 Animados <span class="pill-count">{animatedCount}</span>
      </button>
      <button
        class="filter-btn mc-filter-pill mc-filter-fav"
        id="btn-filter-favorites"
        data-category="favorites"
        title="Modelos guardados en favoritos"
      >
        ★ Favoritos <span class="pill-count" id="fav-count-badge">0</span>
      </button>
    </div>
  </section>

  <!-- CATALOG GRID -->
  <div class="generators-grid" id="generators-container">
    {modularModels.map((mod) => (
      <article
        class="generator-card card-modular"
        data-family={mod.family}
        data-category={mod.category}
        data-modular="true"
        data-animated="false"
        data-tags={`${mod.tags.join(' ')} modular editable studio 3d capas piezas componentes ${mod.name.toLowerCase()} ${mod.description.toLowerCase()}`}
        data-name={mod.name.toLowerCase()}
        data-desc={mod.description.toLowerCase()}
      >
        <div class="card-preview">
          <model-viewer
            src={mod.glbUrl}
            alt={mod.name}
            auto-rotate
            rotation-per-second="25deg"
            camera-controls
            interaction-prompt="none"
            shadow-intensity="1.0"
            loading="lazy"
            class="model-preview"
          ></model-viewer>

          <div class="preview-top-bar">
            <span class={`category-badge category-${mod.category}`}>
              {mod.category} · Modular
            </span>
            <button
              type="button"
              class="btn-card-fav"
              data-id={mod.family}
              data-name={mod.name}
              data-category={mod.category}
              data-type="modular"
              data-url={mod.glbUrl}
              title="Guardar en favoritos"
              aria-label="Guardar en favoritos"
            >
              <span class="fav-star">☆</span>
            </button>
          </div>
        </div>

        <div class="card-body">
          <h3 class="card-title">
            <a href={`/m?modular=${mod.family}`}>{mod.name}</a>
          </h3>
          <p class="card-description">{mod.description}</p>
          <div class="card-meta-line">
            <span>{mod.spec.components.length} piezas</span>
            <span>·</span>
            <span>~{mod.triBudget} tris</span>
            <span>·</span>
            <span>Lote {mod.batch}</span>
          </div>
        </div>

        <div class="card-footer">
          <a href={`/studio?modular=${mod.family}`} class="btn btn-primary" title="Abrir en Studio 3D para editar cada pieza">
            Editar en Studio
          </a>
          <a
            href={mod.glbUrl}
            download={`${mod.family}.glb`}
            class="btn btn-outline btn-download"
            title="Descargar archivo GLB"
          >
            .GLB
          </a>
        </div>
      </article>
    ))}

    {catalog.map((gen) => {
      const isAnim = ANIMATED_FAMILIES.has(gen.family);
      return (
      <article
        class={`generator-card ${isAnim ? 'card-animated' : ''}`}
        data-family={gen.family}
        data-category={gen.category}
        data-animated={isAnim ? "true" : "false"}
        data-tags={`${gen.tags.join(' ')}${isAnim ? ' animacion anim animado cinetica movimiento' : ''}`}
        data-name={gen.name.toLowerCase()}
        data-desc={gen.description.toLowerCase()}
      >
        <div class="card-preview">
          {gen.has_model ? (
            <model-viewer
              src={gen.model_url}
              alt={gen.name}
              auto-rotate
              rotation-per-second="25deg"
              camera-controls
              interaction-prompt="none"
              shadow-intensity="1.0"
              loading="lazy"
              class="model-preview"
            ></model-viewer>
          ) : (
            <div class="placeholder-preview">
              <span>Vista 3D en local</span>
            </div>
          )}

          <div class="preview-top-bar">
            <span class={`category-badge category-${gen.category}`}>
              {gen.category}{isAnim ? ' · Animado' : ''}
            </span>
            <button
              type="button"
              class="btn-card-fav"
              data-id={gen.family}
              data-name={gen.name}
              data-category={gen.category}
              data-type="catalog"
              data-url={gen.model_url}
              title="Guardar en favoritos"
              aria-label="Guardar en favoritos"
            >
              <span class="fav-star">☆</span>
            </button>
          </div>
        </div>

        <div class="card-body">
          <h3 class="card-title">
            <a href={`/generators/${gen.family}`}>{gen.name}</a>
          </h3>
          <p class="card-description">{gen.description}</p>
          <div class="card-meta-line">
            <span>{gen.parameters.length} controles</span>
            <span>·</span>
            <span>~{gen.export_capabilities?.target_tri_budget || 450} tris</span>
            <span>·</span>
            <span>{gen.presets.length} preset{gen.presets.length === 1 ? '' : 's'}</span>
          </div>
        </div>

        <div class="card-footer">
          <a href={`/generators/${gen.family}`} class="btn btn-primary" title="Personalizar parámetros en 3D">
            Personalizar
          </a>
          {gen.has_model && (
            <a
              href={gen.model_url}
              download={`${gen.family}.glb`}
              class="btn btn-outline btn-download"
              title="Descargar archivo GLB"
            >
              .GLB
            </a>
          )}
        </div>
      </article>
      );
    })}
  </div>

  <!-- NO RESULTS -->
  <div id="no-results" class="mc-empty-results" style="display: none;">
    <p id="no-results-msg">No se encontraron modelos que coincidan con tu búsqueda.</p>
    <button id="reset-filters-btn" class="btn btn-outline btn-sm">Restablecer filtros</button>
  </div>

  <!-- TEXTURE STUDIO SECTION -->
  <section class="mc-feature-section" id="texture-studio">
    <div class="mc-feature-header">
      <div>
        <span class="mc-eyebrow-text">COMPLEMENTO DE ESCRITORIO · OPEN SOURCE (MIT)</span>
        <h2 class="mc-feature-title">IV Orbit Texture Studio</h2>
        <p class="mc-feature-lead">
          Suite nativa para Windows para extraer texturas desde fotografías con homografías 3×3, crear mosaicos seamless y generar sets completos de mapas PBR (Normales OpenGL/DirectX, Rugosidad, Altura, AO y ORM) listos para Godot 4, Unity y Blender.
        </p>
      </div>
      <div class="mc-feature-actions">
        <a href="https://github.com/FrancisCuarto/IV-Orbit-Texture-Studio/releases/latest/download/IV_Orbit_Texture_Studio_Setup.exe" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Descargar para Windows (.exe)
        </a>
        <a href="https://github.com/FrancisCuarto/IV-Orbit-Texture-Studio/releases/download/v0.1.0/IV_Orbit_Texture_Studio_Portable.zip" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
          Portable (.zip)
        </a>
        <a href="https://ivorbitgames.online/herramientas/texture-studio" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
          Ver ficha ↗
        </a>
      </div>
    </div>

    <div class="mc-feature-pillars">
      <div class="mc-pillar-card">
        <h3>Texture Ripper 3×3</h3>
        <p>Rectificación de perspectiva con homografías 3×3 y 4 esquinas magnéticas con interpolación Lanczos4.</p>
      </div>
      <div class="mc-pillar-card">
        <h3>Seamless & Mosaico</h3>
        <p>Mezcla cosenoidal suave en dos pasadas sin costuras visibles y vista previa en cuadrícula.</p>
      </div>
      <div class="mc-pillar-card">
        <h3>Mapas PBR Tangenciales</h3>
        <p>Normales OpenGL (+Y) / DirectX (-Y), Rugosidad, Altura, AO y empaquetado ORM/RMA.</p>
      </div>
      <div class="mc-pillar-card">
        <h3>Sprites & Atlas 2D</h3>
        <p>Detección automática por canal alfa, empaquetador MaxRects y exportación dual PNG + JSON.</p>
      </div>
    </div>
  </section>

  <!-- CREATOR & IV ORBIT SECTION -->
  <section class="mc-creator-section" id="sobre-el-creador">
    <div class="mc-creator-grid">
      <div class="mc-creator-card">
        <div class="mc-creator-head">
          <img src="/logo.png" alt="Logo de IV Orbit Games" width="48" height="48" class="mc-creator-avatar" />
          <div>
            <span class="mc-eyebrow-text">CREADOR INDEPENDIENTE · BUENOS AIRES</span>
            <h2 class="mc-creator-name">Franciscuarto · IV Orbit Games</h2>
          </div>
        </div>
        <p class="mc-creator-bio">
          ModelCoder nació como herramienta interna para generar la maquinaria, mobiliario y accesorios modulares de <strong>Below Nominal</strong>, un juego de terror y supervivencia bajo el hielo de Europa desarrollado en Godot Engine.
        </p>
        <div class="mc-creator-links">
          <a href="https://ivorbitgames.online" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">ivorbitgames.online ↗</a>
          <a href="https://iv-orbit.itch.io" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">itch.io ↗</a>
          <a href="https://www.youtube.com/@Franciscuarto" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">YouTube ↗</a>
          <a href="https://github.com/FrancisCuarto" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">GitHub ↗</a>
        </div>
      </div>

      <div class="mc-games-col">
        <a href="https://iv-orbit.itch.io/belownominal" target="_blank" rel="noopener noreferrer" class="mc-game-card">
          <div class="mc-game-top">
            <strong>🧊 Below Nominal</strong>
            <span class="preset-badge">En desarrollo · PC</span>
          </div>
          <p>Terror y supervivencia en una estación científica bajo el hielo de Europa (Godot Engine).</p>
        </a>
        <a href="https://ivorbitgames.online/juegos/puchito" target="_blank" rel="noopener noreferrer" class="mc-game-card">
          <div class="mc-game-top">
            <strong>🚗 Puchito · Taller Espacial</strong>
            <span class="preset-badge">Disponible · PC</span>
          </div>
          <p>Gestión y minijuegos arcade atendiendo naves espaciales en una estación intergaláctica.</p>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { getCommunityModels } from '../lib/supabase';
  import { toggleFavorite, isFavorite, getFavorites } from '../lib/user-inventory';

  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const filterBtns = document.querySelectorAll('.filter-btn');
  const generatorsContainer = document.getElementById('generators-container');
  const resultsCount = document.getElementById('results-count');
  const noResults = document.getElementById('no-results');
  const resetBtn = document.getElementById('reset-filters-btn');
  const favCountBadge = document.getElementById('fav-count-badge');

  let activeCategory = 'all';
  let searchQuery = '';
  let communityModelsList: any[] = [];

  function getCards(): HTMLElement[] {
    return Array.from(document.querySelectorAll('.generator-card')) as HTMLElement[];
  }

  function updateFavoritesUI(): void {
    const favs = getFavorites();
    if (favCountBadge) favCountBadge.textContent = `${favs.length}`;

    document.querySelectorAll('.btn-card-fav').forEach((btn) => {
      const id = (btn as HTMLElement).dataset.id;
      if (!id) return;
      const star = btn.querySelector('.fav-star');
      const isFav = isFavorite(id);
      if (star) {
        star.textContent = isFav ? '★' : '☆';
        star.classList.toggle('active', isFav);
      }
      btn.setAttribute('title', isFav ? 'Quitar de favoritos' : 'Guardar en favoritos');
    });
  }

  function wireFavoriteButtons(): void {
    document.querySelectorAll('.btn-card-fav').forEach((btn) => {
      (btn as HTMLElement).onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        const el = e.currentTarget as HTMLElement;
        const id = el.dataset.id;
        const name = el.dataset.name || id || '';
        const cat = el.dataset.category || 'furniture';
        const type = (el.dataset.type as any) || 'catalog';
        const url = el.dataset.url;
        if (!id) return;

        toggleFavorite({ id, name, category: cat, type, model_url: url });
        updateFavoritesUI();
        if (activeCategory === 'favorites') applyFilters();
      };
    });
    updateFavoritesUI();
  }

  function applyFilters() {
    let visible = 0;
    const cards = getCards();

    cards.forEach((card) => {
      const category = card.dataset.category || '';
      const name = card.dataset.name || '';
      const desc = card.dataset.desc || '';
      const family = card.dataset.family || '';
      const tags = card.dataset.tags || '';

      let matchesCat = false;
      if (activeCategory === 'all') matchesCat = true;
      else if (activeCategory === 'favorites') matchesCat = isFavorite(family);
      else if (activeCategory === 'animated') matchesCat = card.dataset.animated === 'true';
      else if (activeCategory === 'modular') matchesCat = card.dataset.modular === 'true';
      else matchesCat = category === activeCategory;

      const q = searchQuery.toLowerCase().trim();
      const matchesSearch = !q || name.includes(q) || desc.includes(q) || family.includes(q) || tags.includes(q);

      if (matchesCat && matchesSearch) {
        card.style.display = 'flex';
        card.style.flexDirection = 'column';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });

    if (resultsCount) {
      resultsCount.textContent = `${visible} de ${cards.length} modelos mostrados`;
    }

    if (noResults) {
      if (visible === 0) {
        noResults.style.display = 'block';
        const msgEl = document.getElementById('no-results-msg');
        if (msgEl) {
          if (activeCategory === 'favorites') {
            msgEl.textContent = 'Todavía no guardaste modelos en favoritos. Hacé clic en la estrella de cualquier modelo.';
          } else {
            msgEl.textContent = 'No se encontraron modelos que coincidan con los filtros.';
          }
        }
      } else {
        noResults.style.display = 'none';
      }
    }
  }

  function escapeHtml(str: unknown): string {
    return String(str ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  const viewerObserver = typeof IntersectionObserver !== 'undefined'
    ? new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const mv = entry.target as any;
          if (entry.isIntersecting) {
            mv.setAttribute('auto-rotate', '');
            if (mv.availableAnimations && mv.availableAnimations.length > 0 && typeof mv.play === 'function') {
              try { mv.play({ repetitions: Infinity }); } catch {}
            }
          } else {
            mv.removeAttribute('auto-rotate');
            if (typeof mv.pause === 'function') {
              try { mv.pause(); } catch {}
            }
          }
        });
      }, { rootMargin: '120px' })
    : null;

  function observeModelViewers() {
    if (!viewerObserver) return;
    document.querySelectorAll('model-viewer.model-preview').forEach((mv) => {
      viewerObserver.observe(mv);
    });
  }

  async function loadCommunityModels() {
    try {
      communityModelsList = await getCommunityModels({ onlyPublic: true });
      if (!generatorsContainer || communityModelsList.length === 0) {
        wireFavoriteButtons();
        observeModelViewers();
        return;
      }

      communityModelsList.forEach((m) => {
        const article = document.createElement('article');
        article.className = 'generator-card community-card';
        const safeSlug = escapeHtml(m.slug);
        const safeName = escapeHtml(m.name);
        const safeCat = escapeHtml(m.category || 'furniture');
        const safeDesc = escapeHtml(m.description || 'Modelo procedural creado por colaboradores de ModelCoder.');
        const safeAuthor = escapeHtml(m.author_name || 'Comunidad');
        const safeGlb = escapeHtml(m.glb_data || '');

        article.dataset.family = m.slug;
        article.dataset.category = m.category || 'furniture';
        article.dataset.tags = `comunidad colaborador ${String(m.name || '').toLowerCase()} ${String(m.description || '').toLowerCase()}`;
        article.dataset.name = String(m.name || '').toLowerCase();
        article.dataset.desc = String(m.description || '').toLowerCase();

        const previewContent = m.glb_data
          ? `<model-viewer src="${safeGlb}" alt="${safeName}" auto-rotate rotation-per-second="25deg" camera-controls interaction-prompt="none" shadow-intensity="1.0" loading="lazy" class="model-preview"></model-viewer>`
          : `<div class="placeholder-preview"><span>Modelo en la nube</span></div>`;

        article.innerHTML = `
          <div class="card-preview">
            ${previewContent}
            <div class="preview-top-bar">
              <span class="category-badge category-${safeCat}">${safeCat} · Comunidad</span>
              <button type="button" class="btn-card-fav" data-id="${safeSlug}" data-name="${safeName}" data-category="${safeCat}" data-type="community" data-url="${safeGlb}" title="Guardar en favoritos" aria-label="Guardar en favoritos">
                <span class="fav-star">☆</span>
              </button>
            </div>
          </div>

          <div class="card-body">
            <h3 class="card-title">
              <a href="/m?slug=${safeSlug}" class="comm-open-link" data-slug="${safeSlug}">${safeName}</a>
            </h3>
            <p class="card-description">${safeDesc}</p>
            <div class="card-meta-line">
              <span>${Number(m.spec?.components?.length) || 0} piezas</span>
              <span>·</span>
              <span>~${Number(m.tri_count) || 350} tris</span>
              <span>·</span>
              <span>por ${safeAuthor}</span>
            </div>
          </div>

          <div class="card-footer">
            <a href="/m?slug=${safeSlug}" class="btn btn-outline">Ver 3D</a>
            <button type="button" class="btn btn-primary btn-open-comm-studio" data-slug="${safeSlug}">Editar en Studio</button>
            ${m.glb_data ? `<a href="${safeGlb}" download="${safeSlug}.glb" class="btn btn-outline btn-download">.GLB</a>` : ''}
          </div>
        `;

        generatorsContainer.prepend(article);
      });

      generatorsContainer.querySelectorAll('.btn-open-comm-studio, .comm-open-link').forEach((el) => {
        el.addEventListener('click', (e) => {
          e.preventDefault();
          const slug = (e.currentTarget as HTMLElement).dataset.slug;
          const found = communityModelsList.find((x) => x.slug === slug);
          if (found && found.spec) {
            localStorage.setItem('modelcoder_spec', JSON.stringify(found.spec));
            window.location.href = '/studio';
          }
        });
      });

      const allCards = getCards();
      const totalCount = allCards.length;

      const headerCountEl = document.getElementById('header-models-count');
      if (headerCountEl) headerCountEl.textContent = `${totalCount} modelos`;

      const heroExploreText = document.getElementById('hero-explore-btn-text');
      if (heroExploreText) heroExploreText.textContent = `Explorar catálogo (${totalCount})`;

      const heroInline = document.getElementById('hero-inline-count');
      if (heroInline) heroInline.textContent = `${totalCount}`;

      const stepModelsEl = document.getElementById('step-models-count');
      if (stepModelsEl) stepModelsEl.textContent = `${totalCount}`;

      const metricTotalEl = document.getElementById('metric-total-models');
      if (metricTotalEl) metricTotalEl.textContent = `${totalCount}`;

      const allBtnCount = document.querySelector('.filter-btn[data-category="all"] .pill-count');
      if (allBtnCount) allBtnCount.textContent = `${totalCount}`;

      const catCounts: Record<string, number> = {};
      allCards.forEach((c) => {
        const cat = c.dataset.category;
        if (cat) catCounts[cat] = (catCounts[cat] || 0) + 1;
      });

      document.querySelectorAll('.filter-btn').forEach((btn) => {
        const cat = (btn as HTMLElement).dataset.category;
        if (!cat || cat === 'all' || cat === 'modular' || cat === 'animated' || cat === 'favorites') return;
        const countSpan = btn.querySelector('.pill-count');
        if (countSpan) countSpan.textContent = `${catCounts[cat] || 0}`;
      });

      wireFavoriteButtons();
      observeModelViewers();
      applyFilters();
    } catch (err) {
      console.warn('[ModelCoder] Could not load community models on homepage:', err);
      wireFavoriteButtons();
      observeModelViewers();
    }
  }

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    applyFilters();
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeCategory = btn.getAttribute('data-category') || 'all';
      applyFilters();
    });
  });

  resetBtn?.addEventListener('click', () => {
    searchQuery = '';
    activeCategory = 'all';
    if (searchInput) searchInput.value = '';
    filterBtns.forEach((b) => {
      b.classList.toggle('active', b.getAttribute('data-category') === 'all');
    });
    applyFilters();
  });

  window.addEventListener('modelcoder:inventory_updated', () => {
    updateFavoritesUI();
    if (activeCategory === 'favorites') applyFilters();
  });

  loadCommunityModels();
  wireFavoriteButtons();
  observeModelViewers();
</script>

