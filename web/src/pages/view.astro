---
// Forward /view?slug=... to /m?slug=... preserving query params and hash
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Visor 3D · ModelCoder</title>
  </head>
  <body style="background: #000424; color: #ffffff; font-family: sans-serif; display: flex; align-items: center; justify-content: center; min-height: 100vh;">
    <p>Redireccionando al visor 3D...</p>
    <script>
      const dest = '/m' + window.location.search + window.location.hash;
      window.location.replace(dest);
    </script>
  </body>
</html>
