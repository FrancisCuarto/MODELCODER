  /* Toolbar de Modelos */
  .models-toolbar {
    margin-bottom: 1.25rem;
    padding: 0.85rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .models-stats-pills {
    display: flex;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #a0b2cc;
  }

  .models-filter-group {
    display: flex;
    gap: 0.35rem;
  }

  .btn-filter-models {
    font-family: var(--font-pixel);
    font-size: 0.65rem;
    padding: 0.35rem 0.75rem;
    background: #060912;
    border: 1px solid var(--ps1-steel);
    color: var(--text-dim);
