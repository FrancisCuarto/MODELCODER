    background: rgba(0, 240, 255, 0.1);
  }

  .role-collaborator {
    color: var(--ps1-green);
    border-color: var(--ps1-green);
    background: rgba(57, 255, 20, 0.1);
  }

  .sql-code-box {
    background: #050810;
    border: 1px inset var(--ps1-steel);
    padding: 1.25rem;
    color: #9cb6d8;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.45;
    overflow-x: auto;
  }

  .status-msg {
    margin-top: 0.75rem;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .status-msg.success {
    background: rgba(57, 255, 20, 0.12);
    border: 1px solid var(--ps1-green);
    color: var(--ps1-green);
  }

  .status-msg.error {
    background: rgba(255, 56, 46, 0.12);
    border: 1px solid var(--ps1-red);
    color: #ff7770;
  }
</style>
