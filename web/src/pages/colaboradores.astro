  }

  .btn-filter-models.active {
    border-color: var(--ps1-cyan);
    color: var(--ps1-cyan);
    background: #0c1426;
  }

  /* Grid de Modelos */
  .collab-models-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
  }

  .model-card-item {
    display: flex;
    flex-direction: column;
  }

  .model-card-body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .model-preview-box {
    height: 90px;
    background: #050810;
    border: 1px inset var(--ps1-steel);
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .preview-cube-icon {
    font-size: 2.2rem;
    filter: drop-shadow(0 0 8px rgba(255, 176, 0, 0.4));
  }

  .preview-cat-badge {
    position: absolute;
    bottom: 6px;
    right: 8px;
    font-family: var(--font-pixel);
    font-size: 0.58rem;
    color: var(--ps1-cyan);
    background: #000;
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--ps1-cyan);
  }

  .model-card-name {
    font-family: var(--font-title);
    font-size: 0.95rem;
    color: #ffffff;
    margin: 0;
  }

  .model-card-desc {
    font-size: 0.78rem;
    color: #9cb2cc;
    line-height: 1.4;
    margin: 0;
    flex: 1;
  }

  .model-card-meta {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-dim);
    border-top: 1px solid #142036;
    padding-top: 0.5rem;
  }

  .model-card-actions {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.3rem;
  }

  .model-card-actions .btn {
    flex: 1;
  }

  /* Gestión de Equipo */
  .team-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .box-subtitle {
    font-family: var(--font-pixel);
    font-size: 0.8rem;
    color: var(--ps1-gold);
    margin: 0 0 0.5rem 0;
  }

  .box-desc {
    font-size: 0.82rem;
    color: #a0b6d0;
    line-height: 1.45;
    margin-bottom: 1rem;
  }

  .add-collab-box {
    padding: 1.25rem;
    background: #080d1a;
  }

  .form-inputs-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .form-field label {
    font-family: var(--font-pixel);
    font-size: 0.62rem;
    color: var(--ps1-cyan);
  }

  .collab-table-wrap {
    overflow-x: auto;
