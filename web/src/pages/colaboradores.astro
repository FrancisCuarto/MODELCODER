---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Portal de Colaboradores y Publicación Directa"
  description="Acceso exclusivo para colaboradores y creadores de ModelCoder para moderar y publicar modelos 3D en el catálogo oficial."
>
  <div class="collab-container">
    <!-- Pantalla 1: No autenticado -->
    <div id="auth-required-box" class="ps1-window state-window">
      <div class="ps1-titlebar">
        <span>ACCESO RESTRINGIDO · IDENTIFICACIÓN REQUERIDA</span>
        <span class="ps1-telemetry-tag" style="color: var(--ps1-gold);">SECURITY LEVEL 4</span>
      </div>
      <div class="window-inner-pad">
        <h2 class="state-title">PANEL DE COLABORADORES & PUBLICACIÓN DIRECTA</h2>
        <p class="state-desc">
          Este apartado es exclusivo para el creador y colaboradores autorizados de ModelCoder para publicar modelos 3D directamente en el catálogo sin pasar por GitHub.
        </p>
        <div class="ps1-inset notice-inset">
          <p style="margin: 0; font-size: 0.85rem; color: #c0d0e0; line-height: 1.5;">
            🔒 Inicia sesión con tu cuenta de correo o GitHub para verificar tus credenciales de colaborador.
          </p>
        </div>
        <div style="margin-top: 1.5rem;">
          <button id="btn-login-collab" type="button" class="btn btn-primary" style="font-size: 0.85rem; padding: 0.65rem 1.5rem;">
            👤 INICIAR SESIÓN DE PILOTO
          </button>
        </div>
      </div>
    </div>

    <!-- Pantalla 2: Usuario autenticado pero NO autorizado -->
    <div id="unauthorized-box" class="ps1-window state-window" style="display: none; border-color: var(--ps1-red);">
      <div class="ps1-titlebar" style="background: linear-gradient(90deg, #440000, #1a0000);">
        <span>ACCESO DENEGADO · PERMISOS INSUFICIENTES</span>
        <span class="ps1-telemetry-tag" style="color: var(--ps1-red);">ACCESS RESTRICTED</span>
      </div>
      <div class="window-inner-pad">
        <h2 class="state-title" style="color: var(--ps1-red);">CUENTA NO AUTORIZADA</h2>
        <p class="state-desc">
          Has iniciado sesión como <strong id="unauth-email-text" style="color: #ffffff;"></strong>, pero este identificador aún no se encuentra registrado en la lista de colaboradores.
        </p>

        <!-- Desbloqueo rápido para el Creador (FrancisCuarto) en nuevas PCs -->
        <div class="ps1-inset" style="padding: 1rem; background: #080d1a; border-left: 4px solid var(--ps1-gold); margin-bottom: 1.25rem;">
          <span style="font-family: var(--font-pixel); font-size: 0.78rem; color: var(--ps1-gold); display: block; margin-bottom: 0.35rem;">
            👑 ¿ERES FRANCISCUARTO EN UNA NUEVA COMPUTADORA?
          </span>
          <p style="font-size: 0.78rem; color: #b8cde4; line-height: 1.45; margin-bottom: 0.75rem;">
            Si iniciaste sesión desde otra PC o navegador y GitHub no transmitió tu usuario automáticamente, ingresa tu clave maestra de creador para activar tus permisos de Dueño en este equipo:
          </p>
          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <input type="password" id="owner-passphrase-input" class="ps1-input" placeholder="Clave de creador (ej: franciscuarto)" style="flex: 1; min-width: 200px; font-size: 0.8rem; padding: 0.45rem 0.6rem;" />
            <button id="btn-claim-owner" type="button" class="btn btn-gold" style="font-size: 0.78rem; padding: 0.45rem 1rem;">
              👑 AUTORIZAR ESTA COMPUTADORA
            </button>
          </div>
          <div id="claim-owner-status" style="margin-top: 0.5rem; font-size: 0.75rem; display: none;"></div>
        </div>

        <div class="ps1-inset" style="padding: 1rem; background: #0c0507; border-color: var(--ps1-red); margin-bottom: 1.5rem;">
          <p style="margin: 0; font-size: 0.82rem; color: #ffb8b8; line-height: 1.5;">
            Si eres desarrollador externo o colaborador del proyecto, solicita al creador (Franciscuarto) que agregue tu correo o usuario de GitHub al panel de colaboradores.
          </p>
        </div>
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
          <a href="https://ivorbitgames.online/contacto" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
            🪐 Contactar al Creador
          </a>
          <a href="/studio" class="btn btn-gold">
            🛠️ Ir al Studio 3D Público
          </a>
        </div>
      </div>
    </div>

    <!-- Pantalla 3: Panel Principal de Colaboradores (AUTORIZADO) -->
    <div id="collab-dashboard" style="display: none;">
      <!-- Header del Dashboard -->
      <div class="ps1-window dashboard-header-window">
        <div class="ps1-titlebar">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <img src="/logo.png" alt="Logo" style="width: 20px; height: 20px; object-fit: contain; border-radius: 3px;" />
            <span>PORTAL DE COLABORADORES & MODERACIÓN DE LA COMUNIDAD</span>
          </div>
          <span id="badge-user-role" class="ps1-telemetry-tag badge-role">COLABORADOR</span>
        </div>
        <div class="dashboard-header-body">
          <div class="user-greeting-row">
            <div>
              <span class="greeting-lbl">&gt; PILOTO IDENTIFICADO:</span>
              <h1 class="user-greeting-email" id="user-greeting-email">cargando...</h1>
            </div>
            <div class="header-action-buttons">
              <a href="/studio" class="btn btn-gold btn-create-model">
                ⚡ ABRIR STUDIO 3D (CREAR)
              </a>
            </div>
          </div>

          <!-- Pestañas del Panel -->
          <div class="panel-tabs-row">
            <button type="button" class="panel-tab active" data-tab="tab-pending">
              ⏳ SOLICITUDES PENDIENTES (<span id="count-pending-tab">0</span>)
            </button>
            <button type="button" class="panel-tab" data-tab="tab-models">
              📁 MODELOS EN CATÁLOGO (<span id="count-models-tab">0</span>)
            </button>
            <button type="button" class="panel-tab" id="tab-btn-team" data-tab="tab-team" style="display: none;">
              👑 GESTIÓN DE COLABORADORES
            </button>
            <button type="button" class="panel-tab" data-tab="tab-sql">
              ⚙️ CONFIGURACIÓN SUPABASE (SQL)
            </button>
          </div>
        </div>
      </div>

      <!-- TAB 0: SOLICITUDES PENDIENTES DE REVISIÓN -->
      <div id="tab-pending" class="tab-content-panel active">
        <div class="models-toolbar ps1-window">
          <div class="models-stats-pills">
            <span class="stat-pill">SOLICITUDES PENDIENTES: <strong id="stat-pending-models" class="text-gold">0</strong></span>
          </div>
          <p style="margin: 0; font-size: 0.78rem; color: var(--text-dim); align-self: center;">
            Revisa las creaciones que la comunidad envía desde la web. Pruébalas en Studio 3D y decide si aprobarlas para el catálogo oficial o descartarlas.
          </p>
        </div>

        <!-- Grid de Solicitudes Pendientes -->
        <div id="collab-pending-grid" class="collab-models-grid">
          <!-- Renderizado dinámico -->
        </div>

        <!-- Estado vacío de pendientes -->
        <div id="pending-empty-state" class="ps1-window" style="display: none; text-align: center; padding: 2.5rem 1.5rem;">
          <p style="font-family: var(--font-pixel); font-size: 0.85rem; color: var(--ps1-green); margin-bottom: 0.5rem;">
            ✨ MESA DE REVISIÓN AL DÍA
          </p>
          <p style="font-size: 0.82rem; color: var(--text-dim); max-width: 550px; margin: 0 auto;">
            No hay solicitudes de publicación pendientes de moderación en este momento. Cualquier modelo enviado por usuarios sin permisos de colaborador aparecerá aquí para tu aprobación.
          </p>
        </div>
      </div>

      <!-- TAB 1: MODELOS DEL EQUIPO (PUBLICADOS) -->
      <div id="tab-models" class="tab-content-panel" style="display: none;">
        <!-- Barra de Telemetría y Filtro -->
        <div class="models-toolbar ps1-window">
          <div class="models-stats-pills">
            <span class="stat-pill">TOTAL: <strong id="stat-total-models" class="text-gold">0</strong></span>
            <span class="stat-pill">EN CATÁLOGO: <strong id="stat-public-models" class="text-green">0</strong></span>
            <span class="stat-pill">PRIVADOS EQUIPO: <strong id="stat-private-models" class="text-cyan">0</strong></span>
          </div>
          <div class="models-filter-group">
            <button type="button" class="btn-filter-models active" data-filter="all">TODOS</button>
            <button type="button" class="btn-filter-models" data-filter="public">PÚBLICOS</button>
            <button type="button" class="btn-filter-models" data-filter="private">PRIVADOS</button>
          </div>
        </div>

        <!-- Grid de Modelos -->
        <div id="collab-models-grid" class="collab-models-grid">
          <!-- Renderizado dinámico -->
        </div>

        <!-- Estado vacío -->
        <div id="models-empty-state" class="ps1-window" style="display: none; text-align: center; padding: 2.5rem 1.5rem;">
          <p style="font-family: var(--font-pixel); font-size: 0.85rem; color: var(--ps1-gold); margin-bottom: 0.75rem;">
            AÚN NO HAY MODELOS SUBIDOS DIRECTAMENTE
          </p>
          <p style="font-size: 0.82rem; color: var(--text-dim); max-width: 600px; margin: 0 auto 1.5rem;">
            Genera un modelo en el Studio 3D (con IA o mediante piezas procedurales) y utiliza el nuevo botón de publicación directa para subirlo aquí al instante.
          </p>
          <a href="/studio" class="btn btn-primary">
            🚀 IR AL STUDIO AHORA
          </a>
        </div>
      </div>

      <!-- TAB 2: GESTIÓN DE EQUIPO (SOLO ADMIN / OWNER) -->
      <div id="tab-team" class="tab-content-panel" style="display: none;">
        <div class="ps1-window team-window">
          <div class="ps1-titlebar">
            <span>CONTROL DE ACCESO · LISTA BLANCA DE COLABORADORES</span>
            <span class="ps1-telemetry-tag" style="color: var(--ps1-gold);">ADMIN ONLY</span>
          </div>
          <div class="team-body">
            <!-- Formulario para agregar colaborador -->
            <div class="ps1-inset add-collab-box">
              <h3 class="box-subtitle">&gt; AGREGAR NUEVO COLABORADOR AUTORIZADO</h3>
              <p class="box-desc">
                Ingresa el correo electrónico con el que tu colaborador iniciará sesión en ModelCoder (vía email o GitHub).
              </p>
              <form id="form-add-collab" class="add-collab-form">
                <div class="form-inputs-row">
                  <div class="form-field" style="flex: 2;">
                    <label for="new-collab-email">CORREO ELECTRÓNICO *</label>
                    <input type="email" id="new-collab-email" class="ps1-input" required placeholder="colaborador@correo.com" />
                  </div>
                  <div class="form-field" style="flex: 1.5;">
                    <label for="new-collab-name">NOMBRE O ALIAS</label>
                    <input type="text" id="new-collab-name" class="ps1-input" placeholder="ej. Lucas (3D Artist)" />
                  </div>
                  <div class="form-field" style="flex: 1;">
                    <label for="new-collab-role">ROL</label>
                    <select id="new-collab-role" class="ps1-input">
                      <option value="collaborator">Colaborador</option>
                      <option value="admin">Administrador</option>
                    </select>
                  </div>
                </div>
                <div style="margin-top: 1rem; display: flex; justify-content: flex-end;">
                  <button type="submit" class="btn btn-green">
                    [ + AUTORIZAR COLABORADOR ]
                  </button>
                </div>
              </form>
              <div id="add-collab-status" class="status-msg hidden"></div>
            </div>

            <!-- Tabla de Colaboradores -->
            <div class="collab-table-wrap">
              <h3 class="box-subtitle">&gt; COLABORADORES ACTIVOS</h3>
              <table class="collab-table">
                <thead>
                  <tr>
                    <th>PILOTO / CORREO</th>
                    <th>NOMBRE</th>
                    <th>ROL</th>
                    <th>FECHA ALTA</th>
                    <th>ACCIONES</th>
                  </tr>
                </thead>
                <tbody id="collab-table-body">
                  <!-- Render dinámico -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 3: CONFIGURACIÓN SUPABASE SQL -->
      <div id="tab-sql" class="tab-content-panel" style="display: none;">
        <div class="ps1-window">
          <div class="ps1-titlebar">
            <span>MIGRACIÓN SQL PARA EL DASHBOARD DE SUPABASE</span>
            <span class="ps1-telemetry-tag">POSTGRESQL</span>
          </div>
          <div class="window-inner-pad">
            <p style="font-size: 0.85rem; color: #c0d0e0; margin-bottom: 1rem; line-height: 1.5;">
              Para que los modelos se sincronicen globalmente en la nube entre múltiples dispositivos y navegadores, copia este script y ejecútalo en el <strong>SQL Editor</strong> de tu proyecto Supabase:
            </p>
            <div style="position: relative;">
              <pre class="sql-code-box"><code>-- Ejecuta en https://supabase.com/dashboard/project/jegdicdnhetdzmcuznqy/sql
CREATE EXTENSION IF NOT EXISTS "pgcrypto";

CREATE TABLE IF NOT EXISTS public.collaborators (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    email TEXT UNIQUE NOT NULL,
    name TEXT,
    role TEXT NOT NULL DEFAULT 'collaborator' CHECK (role IN ('owner', 'admin', 'collaborator')),
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE TABLE IF NOT EXISTS public.community_models (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    slug TEXT UNIQUE NOT NULL,
    name TEXT NOT NULL,
    category TEXT NOT NULL DEFAULT 'furniture',
    description TEXT DEFAULT '',
    spec JSONB NOT NULL,
    tri_count INTEGER DEFAULT 0,
    author_name TEXT NOT NULL,
    author_email TEXT NOT NULL,
    is_public BOOLEAN NOT NULL DEFAULT true,
    status TEXT NOT NULL DEFAULT 'approved' CHECK (status IN ('pending', 'approved', 'rejected')),
    glb_data TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

ALTER TABLE public.community_models ADD COLUMN IF NOT EXISTS status TEXT NOT NULL DEFAULT 'approved' CHECK (status IN ('pending', 'approved', 'rejected'));

CREATE TABLE IF NOT EXISTS public.model_comments (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    model_slug TEXT NOT NULL,
    author_name TEXT NOT NULL,
    content TEXT NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_community_models_slug ON public.community_models(slug);
CREATE INDEX IF NOT EXISTS idx_community_models_public ON public.community_models(is_public);
CREATE INDEX IF NOT EXISTS idx_community_models_status ON public.community_models(status);
CREATE INDEX IF NOT EXISTS idx_collaborators_email ON public.collaborators(email);
CREATE INDEX IF NOT EXISTS idx_model_comments_slug ON public.model_comments(model_slug);

ALTER TABLE public.collaborators ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.community_models ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.model_comments ENABLE ROW LEVEL SECURITY;

CREATE OR REPLACE FUNCTION public.is_owner_or_admin()
RETURNS BOOLEAN AS $$
BEGIN
  RETURN (
    lower(coalesce(auth.jwt() -> 'user_metadata' ->> 'user_name', '')) = 'franciscuarto'
    OR lower(coalesce(auth.jwt() -> 'user_metadata' ->> 'preferred_username', '')) = 'franciscuarto'
    OR lower(coalesce(auth.jwt() -> 'user_metadata' ->> 'name', '')) LIKE '%franciscuarto%'
    OR lower(coalesce(auth.jwt() -> 'user_metadata' ->> 'full_name', '')) LIKE '%franciscuarto%'
    OR lower(coalesce(auth.jwt() ->> 'email', '')) LIKE '%franciscuarto%'
    OR lower(coalesce(auth.jwt() ->> 'email', '')) LIKE '%ivorbitgames%'
    OR EXISTS (
      SELECT 1 FROM public.collaborators
      WHERE (
        email = lower(auth.jwt() ->> 'email')
        OR email = lower(coalesce(auth.jwt() -> 'user_metadata' ->> 'user_name', ''))
        OR email = '@' || lower(coalesce(auth.jwt() -> 'user_metadata' ->> 'user_name', ''))
        OR email = lower(coalesce(auth.jwt() -> 'user_metadata' ->> 'preferred_username', ''))
      ) AND role IN ('owner', 'admin')
    )
  );
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

CREATE POLICY "Lectura publica de colaboradores" ON public.collaborators FOR SELECT USING (true);
CREATE POLICY "Gestion exclusiva de colaboradores para owner y admin" ON public.collaborators FOR ALL TO authenticated USING (public.is_owner_or_admin()) WITH CHECK (public.is_owner_or_admin());

CREATE POLICY "Lectura de modelos publicos o privados de equipo" ON public.community_models FOR SELECT USING (true);
CREATE POLICY "Publicacion de modelos en comunidad" ON public.community_models FOR INSERT WITH CHECK (true);
CREATE POLICY "Edicion de modelos" ON public.community_models FOR UPDATE TO authenticated USING (public.is_owner_or_admin() OR author_email = (auth.jwt() ->> 'email') OR author_name ILIKE ('%' || coalesce(auth.jwt() -> 'user_metadata' ->> 'user_name', 'xyz') || '%'));
CREATE POLICY "Eliminacion de modelos" ON public.community_models FOR DELETE TO authenticated USING (public.is_owner_or_admin() OR author_email = (auth.jwt() ->> 'email') OR author_name ILIKE ('%' || coalesce(auth.jwt() -> 'user_metadata' ->> 'user_name', 'xyz') || '%'));

CREATE POLICY "Lectura publica de comentarios" ON public.model_comments FOR SELECT USING (true);
CREATE POLICY "Publicacion de comentarios" ON public.model_comments FOR INSERT WITH CHECK (true);
CREATE POLICY "Eliminacion de comentarios" ON public.model_comments FOR DELETE TO authenticated USING (public.is_owner_or_admin());

DELETE FROM public.community_models WHERE slug = 'test_connection_1792201558636' OR name = 'Test Model';

INSERT INTO public.collaborators (email, name, role)
VALUES 
    ('franciscuarto@ivorbitgames.online', 'Franciscuarto (Dueño)', 'owner'),
    ('franciscuarto', 'Franciscuarto (GitHub)', 'owner'),
    ('@franciscuarto', 'Franciscuarto (GitHub Handle)', 'owner')
ON CONFLICT (email) DO NOTHING;</code></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import {
    getCurrentUser,
    onAuthStateChange,
    checkUserRole,
    getCollaborators,
    addCollaborator,
    removeCollaborator,
    getCommunityModels,
    getPendingCommunityModels,
    approveCommunityModel,
    toggleModelVisibility,
    deleteCommunityModel,
    type Collaborator,
    type CommunityModel
  } from '../lib/supabase';

  const authRequiredBox = document.getElementById('auth-required-box');
  const unauthorizedBox = document.getElementById('unauthorized-box');
  const unauthEmailText = document.getElementById('unauth-email-text');
  const collabDashboard = document.getElementById('collab-dashboard');
  const btnLoginCollab = document.getElementById('btn-login-collab');
  const userGreetingEmail = document.getElementById('user-greeting-email');
  const badgeUserRole = document.getElementById('badge-user-role');
  const tabBtnTeam = document.getElementById('tab-btn-team');

  const panelTabs = document.querySelectorAll('.panel-tab');
  const tabPanels = {
    'tab-pending': document.getElementById('tab-pending'),
    'tab-models': document.getElementById('tab-models'),
    'tab-team': document.getElementById('tab-team'),
    'tab-sql': document.getElementById('tab-sql'),
  };

  const collabPendingGrid = document.getElementById('collab-pending-grid');
  const pendingEmptyState = document.getElementById('pending-empty-state');
  const countPendingTab = document.getElementById('count-pending-tab');
  const statPendingModels = document.getElementById('stat-pending-models');

  const collabModelsGrid = document.getElementById('collab-models-grid');
  const modelsEmptyState = document.getElementById('models-empty-state');
  const countModelsTab = document.getElementById('count-models-tab');
  const statTotalModels = document.getElementById('stat-total-models');
  const statPublicModels = document.getElementById('stat-public-models');
  const statPrivateModels = document.getElementById('stat-private-models');

  const formAddCollab = document.getElementById('form-add-collab') as HTMLFormElement;
  const newCollabEmail = document.getElementById('new-collab-email') as HTMLInputElement;
  const newCollabName = document.getElementById('new-collab-name') as HTMLInputElement;
  const newCollabRole = document.getElementById('new-collab-role') as HTMLSelectElement;
  const addCollabStatus = document.getElementById('add-collab-status');
  const collabTableBody = document.getElementById('collab-table-body');
  const filterBtns = document.querySelectorAll('.btn-filter-models');

  const btnClaimOwner = document.getElementById('btn-claim-owner');
  const ownerPassInput = document.getElementById('owner-passphrase-input') as HTMLInputElement;
  const claimOwnerStatus = document.getElementById('claim-owner-status');

  let currentActiveUser: any = null;
  let currentUserRole: 'owner' | 'admin' | 'collaborator' | null = null;
  let allApprovedModels: CommunityModel[] = [];
  let allPendingModels: CommunityModel[] = [];
  let currentModelFilter = 'all';

  // Desbloqueo de creador en nueva PC
  btnClaimOwner?.addEventListener('click', async () => {
    const val = (ownerPassInput?.value || '').trim().toLowerCase();
    if (val === 'franciscuarto' || val === 'ivorbitgames' || val === 'admin') {
      localStorage.setItem('modelcoder_claimed_owner', 'true');
      if (claimOwnerStatus) {
        claimOwnerStatus.style.display = 'block';
        claimOwnerStatus.style.color = 'var(--ps1-green)';
        claimOwnerStatus.textContent = '✓ Permisos de Dueño activados para este equipo. Actualizando...';
      }
      setTimeout(() => {
        window.location.reload();
      }, 500);
    } else {
      if (claimOwnerStatus) {
        claimOwnerStatus.style.display = 'block';
        claimOwnerStatus.style.color = 'var(--ps1-red)';
        claimOwnerStatus.textContent = '❌ Clave incorrecta. Contacta con Franciscuarto.';
      }
    }
  });

  // Abrir modal de autenticación si se presiona el botón
  btnLoginCollab?.addEventListener('click', () => {
    const authBtn = document.getElementById('btn-open-auth');
    authBtn?.click();
  });

  // Switcher de pestañas del panel
  panelTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      panelTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      const targetId = tab.getAttribute('data-tab');
      Object.keys(tabPanels).forEach((k) => {
        const p = tabPanels[k as keyof typeof tabPanels];
        if (p) p.style.display = k === targetId ? 'block' : 'none';
      });
    });
  });

  // Inicialización y escucha de estado de sesión
  async function initSession(user: any) {
    currentActiveUser = user;
    const isLocalClaimed = typeof window !== 'undefined' && localStorage.getItem('modelcoder_claimed_owner') === 'true';

    if (!user && !isLocalClaimed) {
      if (authRequiredBox) authRequiredBox.style.display = 'block';
      if (unauthorizedBox) unauthorizedBox.style.display = 'none';
      if (collabDashboard) collabDashboard.style.display = 'none';
      return;
    }

    const { isCollaborator, role, identifier } = await checkUserRole(user || 'franciscuarto');
    currentUserRole = role;

    if (!isCollaborator && !isLocalClaimed) {
      if (authRequiredBox) authRequiredBox.style.display = 'none';
      if (unauthorizedBox) unauthorizedBox.style.display = 'block';
      const ghName = user?.user_metadata?.user_name || user?.user_metadata?.preferred_username;
      if (unauthEmailText) {
        unauthEmailText.innerHTML = `Email: <strong>${user?.email || 'No público'}</strong> ${ghName ? `| GitHub: <strong>@${ghName}</strong>` : ''}`;
      }
      if (collabDashboard) collabDashboard.style.display = 'none';
      return;
    }

    // Usuario Autorizado
    if (authRequiredBox) authRequiredBox.style.display = 'none';
    if (unauthorizedBox) unauthorizedBox.style.display = 'none';
    if (collabDashboard) collabDashboard.style.display = 'block';

    if (userGreetingEmail) {
      const ghName = user?.user_metadata?.user_name || user?.user_metadata?.preferred_username;
      userGreetingEmail.textContent = ghName ? `@${ghName} (${user?.email || 'GitHub'})` : (user?.email || 'FrancisCuarto (Dueño)');
    }
    if (badgeUserRole) {
      if (role === 'owner' || isLocalClaimed) {
        badgeUserRole.textContent = '👑 DUEÑO / ADMINISTRADOR';
        badgeUserRole.style.color = 'var(--ps1-gold)';
      } else if (role === 'admin') {
        badgeUserRole.textContent = '⚡ ADMINISTRADOR';
        badgeUserRole.style.color = 'var(--ps1-cyan)';
      } else {
        badgeUserRole.textContent = '🛠️ COLABORADOR AUTORIZADO';
        badgeUserRole.style.color = 'var(--ps1-green)';
      }
    }

    // Mostrar pestaña de equipo a admins y owners
    if (tabBtnTeam) {
      tabBtnTeam.style.display = (role === 'owner' || role === 'admin' || isLocalClaimed) ? 'block' : 'none';
    }

    // Cargar datos
    await loadAllData();
    if (role === 'owner' || role === 'admin' || isLocalClaimed) {
      loadTeamTable();
    }
  }

  async function loadAllData() {
    await Promise.all([loadPendingModels(), loadApprovedModels()]);
  }

  // 1. Cargar y renderizar Solicitudes Pendientes
  async function loadPendingModels() {
    allPendingModels = await getPendingCommunityModels();
    renderPendingModels();
  }

  function renderPendingModels() {
    if (!collabPendingGrid) return;
    collabPendingGrid.innerHTML = '';

    const count = allPendingModels.length;
    if (countPendingTab) countPendingTab.textContent = String(count);
    if (statPendingModels) statPendingModels.textContent = String(count);

    if (count === 0) {
      if (pendingEmptyState) pendingEmptyState.style.display = 'block';
      return;
    }
    if (pendingEmptyState) pendingEmptyState.style.display = 'none';

    allPendingModels.forEach((model) => {
      const card = document.createElement('div');
      card.className = 'ps1-window model-card-item';
      card.style.borderColor = 'var(--ps1-gold)';

      card.innerHTML = `
        <div class="ps1-titlebar" style="background: linear-gradient(90deg, #332200, #171100);">
          <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 200px;">SOLICITUD: ${model.name}</span>
          <span class="ps1-telemetry-tag" style="color: var(--ps1-gold);">⏳ REVISIÓN</span>
        </div>
        <div class="model-card-body">
          <div class="model-preview-box" style="background: #090c14;">
            <span class="preview-cube-icon">📦</span>
            <span class="preview-cat-badge">${model.category.toUpperCase()}</span>
          </div>
          <h3 class="model-card-name" style="color: var(--ps1-gold);">${model.name}</h3>
          <p class="model-card-desc">${model.description || 'Sin descripción provista.'}</p>
          <div class="model-card-meta">
            <span>👤 ${model.author_name}</span>
            <span>📐 ${model.spec?.components?.length || 0} piezas</span>
            <span>~${model.tri_count || 350} tris</span>
          </div>
          <div class="model-card-actions" style="grid-template-columns: 1fr 1fr 1fr; gap: 0.35rem; margin-top: 0.85rem;">
            <button type="button" class="btn btn-sm btn-outline btn-test-pending" data-slug="${model.slug}" title="Abrir y probar en el Studio 3D">
              👁️ Probar
            </button>
            <button type="button" class="btn btn-sm btn-green btn-approve-pending" data-id="${model.id}" title="Aprobar y publicar en el catálogo">
              ✓ Aprobar
            </button>
            <button type="button" class="btn btn-sm btn-danger btn-reject-pending" data-id="${model.id}" title="Rechazar y descartar solicitud">
              ✗ Descartar
            </button>
          </div>
        </div>
      `;

      collabPendingGrid.appendChild(card);
    });

    // Listeners de pendientes
    collabPendingGrid.querySelectorAll('.btn-test-pending').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const slug = (e.currentTarget as HTMLElement).dataset.slug;
        const model = allPendingModels.find((m) => m.slug === slug);
        if (model && model.spec) {
          localStorage.setItem('modelcoder_spec', JSON.stringify(model.spec));
          window.location.href = '/studio';
        }
      });
    });

    collabPendingGrid.querySelectorAll('.btn-approve-pending').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id || '';
        const btnElem = e.currentTarget as HTMLButtonElement;
        btnElem.disabled = true;
        btnElem.textContent = '...';
        await approveCommunityModel(id);
        await loadAllData();
      });
    });

    collabPendingGrid.querySelectorAll('.btn-reject-pending').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id || '';
        if (confirm('¿Deseas rechazar y eliminar esta solicitud de publicación?')) {
          await deleteCommunityModel(id);
          await loadAllData();
        }
      });
    });
  }

  // 2. Cargar y renderizar Modelos Aprobados del Catálogo
  async function loadApprovedModels() {
    allApprovedModels = await getCommunityModels({ onlyPublic: false, status: 'approved' });
    renderApprovedModels();
  }

  function renderApprovedModels() {
    if (!collabModelsGrid) return;
    collabModelsGrid.innerHTML = '';

    const filtered = allApprovedModels.filter((m) => {
      if (currentModelFilter === 'public') return m.is_public;
      if (currentModelFilter === 'private') return !m.is_public;
      return true;
    });

    // Actualizar contadores
    const totalCount = allApprovedModels.length;
    const publicCount = allApprovedModels.filter((m) => m.is_public).length;
    const privateCount = totalCount - publicCount;

    if (countModelsTab) countModelsTab.textContent = String(totalCount);
    if (statTotalModels) statTotalModels.textContent = String(totalCount);
    if (statPublicModels) statPublicModels.textContent = String(publicCount);
    if (statPrivateModels) statPrivateModels.textContent = String(privateCount);

    if (filtered.length === 0) {
      if (modelsEmptyState) modelsEmptyState.style.display = 'block';
      return;
    }
    if (modelsEmptyState) modelsEmptyState.style.display = 'none';

    filtered.forEach((model) => {
      const card = document.createElement('div');
      card.className = 'ps1-window model-card-item';
      const isPublic = model.is_public;

      card.innerHTML = `
        <div class="ps1-titlebar" style="background: ${isPublic ? 'linear-gradient(90deg, #002233, #001122)' : 'linear-gradient(90deg, #332200, #110b00)'}">
          <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 200px;">${model.name}</span>
          <span class="ps1-telemetry-tag" style="color: ${isPublic ? 'var(--ps1-green)' : 'var(--ps1-gold)'}">
            ${isPublic ? '● EN CATÁLOGO' : '🔒 PRIVADO'}
          </span>
        </div>
        <div class="model-card-body">
          <div class="model-preview-box">
            <span class="preview-cube-icon">📦</span>
            <span class="preview-cat-badge">${model.category.toUpperCase()}</span>
          </div>
          <h3 class="model-card-name">${model.name}</h3>
          <p class="model-card-desc">${model.description || 'Sin descripción detallada.'}</p>
          <div class="model-card-meta">
            <span>👤 ${model.author_name}</span>
            <span>📐 ${model.spec?.components?.length || 0} piezas</span>
            <span>~${model.tri_count || 350} tris</span>
          </div>
          <div class="model-card-actions">
            <button type="button" class="btn btn-sm btn-outline btn-toggle-vis" data-id="${model.id}" data-public="${isPublic}">
              ${isPublic ? 'Ocultar' : 'Publicar'}
            </button>
            <button type="button" class="btn btn-sm btn-gold btn-edit-studio" data-slug="${model.slug}">
              Editar
            </button>
            <button type="button" class="btn btn-sm btn-danger btn-delete-model" data-id="${model.id}" title="Eliminar del catálogo">
              🗑️
            </button>
          </div>
        </div>
      `;

      collabModelsGrid.appendChild(card);
    });

    // Listeners de tarjetas aprobadas
    collabModelsGrid.querySelectorAll('.btn-toggle-vis').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLElement;
        const id = target.dataset.id || '';
        const currentPub = target.dataset.public === 'true';
        await toggleModelVisibility(id, !currentPub);
        await loadApprovedModels();
      });
    });

    collabModelsGrid.querySelectorAll('.btn-edit-studio').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const slug = (e.currentTarget as HTMLElement).dataset.slug;
        const model = allApprovedModels.find((m) => m.slug === slug);
        if (model && model.spec) {
          localStorage.setItem('modelcoder_spec', JSON.stringify(model.spec));
          window.location.href = '/studio';
        }
      });
    });

    collabModelsGrid.querySelectorAll('.btn-delete-model').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id || '';
        if (confirm('¿Estás seguro de que deseas eliminar este modelo del catálogo?')) {
          await deleteCommunityModel(id);
          await loadApprovedModels();
        }
      });
    });
  }

  // Filtros de modelos aprobados
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentModelFilter = btn.getAttribute('data-filter') || 'all';
      renderApprovedModels();
    });
  });

  // Cargar tabla de colaboradores
  async function loadTeamTable() {
    if (!collabTableBody) return;
    collabTableBody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding: 1rem;">Cargando colaboradores...</td></tr>';
    const list = await getCollaborators();
    collabTableBody.innerHTML = '';

    list.forEach((c) => {
      const tr = document.createElement('tr');
      const isOwner = c.role === 'owner';
      tr.innerHTML = `
        <td><strong style="color: #ffffff;">${c.email}</strong></td>
        <td>${c.name || '—'}</td>
        <td><span class="role-pill role-${c.role}">${c.role.toUpperCase()}</span></td>
        <td>${c.created_at ? new Date(c.created_at).toLocaleDateString() : 'Activo'}</td>
        <td>
          ${isOwner ? '<span style="color: var(--text-dim); font-size: 0.75rem;">Dueño principal</span>' : `
            <button type="button" class="btn btn-sm btn-outline btn-remove-collab" data-id="${c.id}" style="color: var(--ps1-red); border-color: var(--ps1-red);">
              Revocar
            </button>
          `}
        </td>
      `;
      collabTableBody.appendChild(tr);
    });

    collabTableBody.querySelectorAll('.btn-remove-collab').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id || '';
        if (confirm('¿Revocar permisos de colaborador a esta cuenta?')) {
          await removeCollaborator(id);
          await loadTeamTable();
        }
      });
    });
  }

  // Formulario de agregar colaborador
  formAddCollab?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!newCollabEmail) return;
    const email = newCollabEmail.value.trim();
    const name = newCollabName ? newCollabName.value.trim() : '';
    const role = (newCollabRole ? newCollabRole.value : 'collaborator') as any;

    const res = await addCollaborator(email, name, role);
    if (res.success) {
      if (addCollabStatus) {
        addCollabStatus.textContent = `✓ ${email} ha sido autorizado como ${role}.`;
        addCollabStatus.className = 'status-msg success';
        addCollabStatus.classList.remove('hidden');
      }
      newCollabEmail.value = '';
      if (newCollabName) newCollabName.value = '';
      await loadTeamTable();
    } else {
      if (addCollabStatus) {
        addCollabStatus.textContent = `Error: ${res.error || 'No se pudo agregar'}`;
        addCollabStatus.className = 'status-msg error';
        addCollabStatus.classList.remove('hidden');
      }
    }
  });

  // Escuchar sesión
  onAuthStateChange((user) => {
    initSession(user);
  });

  getCurrentUser().then((user) => {
    initSession(user);
  });
</script>

<style>
