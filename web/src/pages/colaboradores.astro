    max-width: 650px;
    margin: 3rem auto;
  }

  .window-inner-pad {
    padding: 1.75rem;
  }

  .state-title {
    font-family: var(--font-title);
    font-size: 1.25rem;
    color: var(--ps1-gold);
    margin-bottom: 0.75rem;
    letter-spacing: 0.04em;
  }

  .state-desc {
    font-size: 0.88rem;
    color: #b0c0d8;
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .notice-inset {
    padding: 1rem;
    background: #080d1a;
  }

  /* Header del Dashboard */
  .dashboard-header-window {
    margin-bottom: 1.5rem;
  }

  .dashboard-header-body {
    padding: 1.25rem 1.5rem;
  }

  .user-greeting-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .greeting-lbl {
    font-family: var(--font-pixel);
    font-size: 0.65rem;
    color: var(--ps1-cyan);
    display: block;
    margin-bottom: 0.25rem;
  }

  .user-greeting-email {
    font-family: var(--font-title);
    font-size: 1.2rem;
    color: #ffffff;
    margin: 0;
  }

  .badge-role {
    color: var(--ps1-gold);
    font-weight: bold;
  }

  .panel-tabs-row {
    display: flex;
    gap: 0.5rem;
    border-top: 1px solid var(--ps1-steel);
    padding-top: 1rem;
    flex-wrap: wrap;
  }

  .panel-tab {
    font-family: var(--font-pixel);
    font-size: 0.72rem;
    padding: 0.5rem 1rem;
    background: #090e1c;
    border: 1px solid var(--ps1-steel);
    color: #a0b2cc;
    cursor: pointer;
    transition: all 0.2s;
  }

  .panel-tab:hover {
    color: #ffffff;
    border-color: var(--ps1-cyan);
  }

  .panel-tab.active {
    background: #121c33;
    border-color: var(--ps1-gold);
