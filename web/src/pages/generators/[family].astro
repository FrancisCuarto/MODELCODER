---
import Layout from '../../layouts/Layout.astro';
import catalog from '../../data/catalog.json';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  return catalog.map((gen) => ({
    params: { family: gen.family },
    props: { gen },
  }));
}

const { gen } = Astro.props;

// Detectar qué archivos de paletas realmente existen en el disco
const modelsDir = fs.existsSync(path.resolve('public/models'))
  ? path.resolve('public/models')
  : path.resolve('web/public/models');

let availablePalettes: string[] = [];
try {
  const allFiles = fs.readdirSync(modelsDir);
  availablePalettes = allFiles
    .filter((f) => f.startsWith(`${gen.family}_`) && f.endsWith('.glb'))
    .map((f) => f.replace(`${gen.family}_`, '').replace('.glb', ''));
} catch (e) {
  availablePalettes = [];
}

// Group parameters by parameter.group
const groupedParams: Record<string, any[]> = {};
gen.parameters.forEach((param: any) => {
  const g = param.group || 'General';
  if (!groupedParams[g]) groupedParams[g] = [];
  groupedParams[g].push(param);
});
---

<Layout title={`${gen.name} - Generador 3D Procedural`}>
  <!-- PS1 Breadcrumbs -->
  <nav class="ps1-breadcrumb">
    <a href="/" class="crumb-link">&lt; [CATÁLOGO]</a>
    <span class="crumb-sep">/</span>
    <span class={`category-badge category-${gen.category}`}>{gen.category}</span>
    <span class="crumb-sep">/</span>
    <span class="active-crumb">{gen.name.toUpperCase()}</span>
  </nav>

  <div class="generator-workspace">
    <!-- Left Column: 3D Viewport & Metadata -->
    <div class="viewport-column">
      <!-- 3D Viewport Window -->
      <div class="ps1-window viewport-window">
        <div class="ps1-titlebar">
          <span>// 3D_VIEWPORT: [{gen.family.toUpperCase()}]</span>
          <span class="ps1-telemetry-tag">FPS: 60 // PBR_PSX</span>
        </div>

        <div class="ps1-inset viewport-container">
          {gen.has_model ? (
            <model-viewer
              id="main-viewer"
              src={gen.model_url}
              data-base-src={gen.model_url}
              data-available-palettes={JSON.stringify(availablePalettes)}
              alt={gen.name}
              camera-controls
              auto-rotate
              rotation-per-second="20deg"
              shadow-intensity="1.0"
              exposure="1.0"
              ar
              class="interactive-viewer"
            >
              <div slot="poster" class="viewer-loading">
                <span>[ CARGANDO MALLA 3D... ]</span>
              </div>
            </model-viewer>
          ) : (
            <div class="no-preview-box">
              <p>[ MODELO GLB GENERADO EN LOCAL CON BLENDER ]</p>
            </div>
          )}

          <!-- 3D Controls Overlay -->
          <div class="viewport-overlay-controls">
            <button id="toggle-rotate-btn" class="ps1-ctrl-btn" title="Pausar / Reanudar Rotación">
              🔄 ROTACIÓN
            </button>
            <button id="reset-cam-btn" class="ps1-ctrl-btn" title="Restablecer Cámara">
              🎯 CENTRAR
            </button>
            <button id="screenshot-btn" class="ps1-ctrl-btn" title="Captura de Pantalla">
              📷 CAPTURA
            </button>
          </div>

          <!-- Preset Quick Pills Bar -->
          {gen.presets.length > 0 && (
            <div class="preset-pill-bar">
              <span class="preset-pill-label">PRESETS:</span>
              <div class="preset-pill-scroll">
                {gen.presets.map((pr: any, idx: number) => (
                  <button 
                    class={`preset-pill ${idx === 0 ? 'active' : ''}`}
                    data-preset-id={pr.id}
                    data-preset-values={JSON.stringify(pr.values)}
                    title={pr.description}
                  >
                    [{pr.name.toUpperCase()}]
                  </button>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Live Telemetry & Tip Bar under Viewport -->
        <div class="viewport-status-bar">
          <div class="status-indicator-row">
            <span class="status-dot-pulse"></span>
            <span id="viewer-status-text" class="status-live-text">● Vista previa 3D interactiva en tiempo real</span>
          </div>
          <p class="viewport-hint">
            💡 Arrastrá con el ratón para rotar en 360°, rueda para zoom. Los ajustes de la derecha se previsualizan al instante.
          </p>
        </div>
      </div>

      <!-- Herramientas Avanzadas para Desarrolladores (Plegado por defecto) -->
      <details class="ps1-window advanced-tools-window">
        <summary class="ps1-titlebar advanced-tools-summary">
          <span>⚙️ HERRAMIENTAS AVANZADAS (PYTHON, CLI Y MANIFIESTO)</span>
          <span class="meta-pill-ver">DESARROLLADORES</span>
        </summary>
        <div class="advanced-tools-body">
          <p class="advanced-tools-intro">
            Información técnica, código fuente y comandos para reproducir este modelo de forma nativa en Blender o scripts propios:
          </p>

          <!-- Especificaciones Técnicas -->
          <div class="capabilities-grid">
            <div class="ps1-inset cap-card">
              <span class="cap-label">PRESUPUESTO TRIÁNGULOS</span>
              <span class="cap-val text-gold">{gen.export_capabilities?.target_tri_budget || '400~500'} TRIS</span>
            </div>
            <div class="ps1-inset cap-card">
              <span class="cap-label">COLISIÓN EN MOTOR</span>
              <span class="cap-val text-green">
                {gen.export_capabilities?.supports_collision ? 'ACTIVA (-convcolonly)' : 'SOLO VISUAL'}
              </span>
            </div>
            <div class="ps1-inset cap-card">
              <span class="cap-label">ORIGEN DE PIVOTE</span>
              <span class="cap-val">CENTRO SUELO (Z=0.0)</span>
            </div>
            <div class="ps1-inset cap-card">
              <span class="cap-label">SOCKETS DE ANCLAJE</span>
              <span class="cap-val text-cyan">
                {gen.export_capabilities?.supports_sockets ? 'INTERACTIVO + LUZ' : 'ESTÁNDAR'}
              </span>
            </div>
          </div>

          <!-- Código Python del Generador -->
          <div class="advanced-sub-block">
            <div class="advanced-sub-header">
              <span class="sub-title">// CÓDIGO PYTHON PROCEDURAL [generator.py]</span>
              <button id="copy-code-btn" type="button" class="btn btn-outline btn-sm">
                [ COPIAR CÓDIGO ]
              </button>
            </div>
            <pre class="ps1-inset code-block"><code id="python-source">{gen.source_code}</code></pre>
          </div>

          <!-- Blender CLI Command -->
          <div class="advanced-sub-block">
            <div class="advanced-sub-header">
              <span class="sub-title">// COMANDO CLI DE BLENDER</span>
              <button id="copy-cli-btn" class="btn btn-outline btn-sm">
                [ COPIAR ]
              </button>
            </div>
            <div class="ps1-inset cli-box">
              <code id="cli-command-output" class="cli-code">
                blender -b --python generate.py -- --family {gen.family}
              </code>
            </div>
          </div>

          <!-- Descarga de Manifiesto y Lanzador Local -->
          <div class="advanced-footer-row">
            <a 
              href={`data:text/json;charset=utf-8,${encodeURIComponent(JSON.stringify(gen, null, 2))}`}
              download={`${gen.family}_manifest.json`}
              class="btn btn-outline"
              style="flex: 1; font-size: 0.7rem; text-align: center;"
            >
              📥 DESCARGAR MANIFIESTO (.JSON)
            </a>
            <a 
              href="/INICIAR_MODELCODER.bat" 
              download="INICIAR_MODELCODER.bat" 
              class="btn btn-gold" 
              style="font-size: 0.7rem; text-align: center;"
              title="Descargar lanzador automatizado para Windows"
            >
              ⚡ LANZADOR LOCAL (.BAT)
            </a>
          </div>
        </div>
      </details>
    </div>

    <!-- Right Column: Interactive Parameter Configurator -->
    <div class="configurator-column">
      <!-- Model Title & Description Header Card -->
      <div class="ps1-window model-info-card">
        <div class="ps1-titlebar">
          <span>// INFORMACIÓN DEL OBJETO</span>
          <span class="meta-pill-ver">v{gen.version}</span>
        </div>
        <div class="model-info-body">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem; margin-bottom: 0.5rem;">
            <div>
              <h1 class="generator-title">{gen.name}</h1>
              <span class="model-category-label">Categoría: {gen.category}</span>
            </div>
            <span class="meta-pill">{gen.license}</span>
          </div>
          <p class="summary-desc">
            {gen.description}
          </p>
        </div>
      </div>

      <div class="ps1-window configurator-card">
        <div class="ps1-titlebar">
          <span>// CONTROLES Y PARÁMETROS</span>
          <span class="param-count-badge">[{gen.parameters.length} CONTROLES]</span>
        </div>

        <div class="config-body">
          <div class="config-lead-row">
            <p class="config-subtext">
              Modificá las medidas o el estilo para previsualizarlo en tiempo real:
            </p>
            <button type="button" id="reset-params-btn" class="btn btn-outline btn-reset-params">
              ↺ Restablecer valores
            </button>
          </div>

          <!-- Presets Dropdown Selector -->
          {gen.presets.length > 0 && (
            <div class="preset-select-group">
              <label for="preset-select" class="field-label">&gt; PRESET CURADO:</label>
              <select id="preset-select" class="form-select">
                {gen.presets.map((pr: any) => (
                  <option value={pr.id} data-values={JSON.stringify(pr.values)}>
                    {pr.name} ({pr.id})
                  </option>
                ))}
              </select>
            </div>
          )}

          <!-- Dynamic Parameter Inputs by Group -->
          <form id="generator-form" class="parameter-form">
            {Object.entries(groupedParams).map(([groupName, params]) => (
              <fieldset class="parameter-group">
                <legend class="group-legend">[ {groupName.toUpperCase()} ]</legend>
                <div class="group-inputs">
                  {params.map((p: any) => (
                    <div class="input-row" data-param-key={p.key} data-param-type={p.type}>
                      <div class="input-label-row">
                        <label for={`param-${p.key}`} class="input-label">
                          &gt; {p.label}:
                        </label>
                        {(p.type === 'float' || p.type === 'int' || p.type === 'seed') && (
                          <span class="live-val" id={`val-${p.key}`}>{p.default}</span>
                        )}
                      </div>

                      {p.type === 'float' && (
                        <input 
                          type="range"
                          id={`param-${p.key}`}
                          name={p.key}
                          min={p.min !== undefined && p.min !== null ? p.min : 0.0}
                          max={p.max !== undefined && p.max !== null ? p.max : 5.0}
                          step={p.step || 0.05}
                          value={p.default}
                          class="form-range"
                        />
                      )}

                      {(p.type === 'int' || p.type === 'seed') && (
                        <input 
                          type="number"
                          id={`param-${p.key}`}
                          name={p.key}
                          min={p.min !== undefined && p.min !== null ? p.min : 0}
                          max={p.max !== undefined && p.max !== null ? p.max : 100}
                          step={p.step || 1}
                          value={p.default}
                          class="form-input"
                        />
                      )}

                      {p.type === 'boolean' && (
                        <label class="toggle-switch">
                          <input 
                            type="checkbox"
                            id={`param-${p.key}`}
                            name={p.key}
                            checked={p.default === true}
                          />
                          <span class="slider"></span>
                        </label>
                      )}

                      {p.type === 'enum' && (
                        <select id={`param-${p.key}`} name={p.key} class="form-select">
                          {p.options ? p.options.map((opt: any) => (
                            <option value={opt.value} selected={opt.value === p.default}>
                              {opt.label || opt.value}
                            </option>
                          )) : (
                            <option value={p.default}>{p.default}</option>
                          )}
                        </select>
                      )}

                      {p.type === 'string' && (
                        <input 
                          type="text"
                          id={`param-${p.key}`}
                          name={p.key}
                          value={p.default || ''}
                          class="form-input"
                        />
                      )}

                      {p.description && (
                        <p class="param-help">// {p.description}</p>
                      )}
                    </div>
                  ))}
                </div>
              </fieldset>
            ))}
          </form>

          <!-- Sección de Descarga Inequívoca y Asistencia -->
          <div class="download-section-box">
            <!-- Acción Principal Única -->
            <button type="button" id="download-custom-glb-btn" class="btn btn-primary btn-download-hero">
              💾 DESCARGAR MODELO PERSONALIZADO (.GLB)
            </button>

            <!-- Acción Secundaria Claramente Diferenciada -->
            <div class="secondary-download-row">
              <span class="secondary-download-label">¿Preferís el archivo base original sin alterar?</span>
              <a 
                href={gen.model_url} 
                download={`${gen.family}.glb`}
                class="secondary-download-link"
                title="Descargar archivo GLB original sin las modificaciones del formulario"
              >
                Bajar versión base original (.glb) ➜
              </a>
            </div>

            <!-- Cartel de Éxito y Guía de Importación Post-Descarga -->
            <div id="download-success-box" class="ps1-inset download-success-box" style="display: none;">
              <div class="success-header-row">
                <span class="success-badge">✅ MODELO DESCARGADO</span>
                <span class="success-filename">{gen.family}_custom.glb</span>
              </div>
              <p class="success-message">
                Tu modelo está listo. Podés importarlo en Godot, Unity, Blender u otro programa compatible con GLB.
              </p>
              <button type="button" id="toggle-import-guide-btn" class="btn btn-cyan btn-sm" style="width: 100%; margin-top: 0.4rem;">
                📖 ¿CÓMO USO ESTE ARCHIVO EN MI MOTOR?
              </button>

              <!-- Panel Desplegable de Instrucciones de Importación -->
              <div id="import-guide-panel" class="import-guide-panel" style="display: none;">
                <div class="import-step-card">
                  <span class="import-engine-name">🎮 Godot 4:</span>
                  <p class="import-step-text">
                    Arrastrá el archivo <code>.glb</code> a tu carpeta <code>res://assets/</code>. Godot generará automáticamente la escena o nodo 3D con materiales listos.
                  </p>
                </div>
                <div class="import-step-card">
                  <span class="import-engine-name">⚡ Unity:</span>
                  <p class="import-step-text">
                    Colocá el <code>.glb</code> en la carpeta <code>Assets/</code> de tu proyecto. Arrastralo directamente a la jerarquía de tu escena o conviértelo en Prefab.
                  </p>
                </div>
                <div class="import-step-card">
                  <span class="import-engine-name">🎨 Blender:</span>
                  <p class="import-step-text">
                    En Blender andá a <code>Archivo &gt; Importar &gt; glTF 2.0 (.glb)</code>. Conserva las coordenadas UV y el origen centrado en el suelo.
                  </p>
                </div>
              </div>
            </div>

            <!-- Reporte de Problemas de este Modelo -->
            <div class="report-problem-box">
              <span class="report-problem-text">¿Encontraste algún problema o defecto en este modelo?</span>
              <a 
                href={`https://github.com/FrancisCuarto/MODELCODER/issues/new?title=%5BReporte%5D+${encodeURIComponent(gen.name)}&body=Familia%3A+${gen.family}%0AVersi%C3%B3n%3A+${gen.version}%0A%0A%C2%BFQu%C3%A9+problema+encontraste+en+el+modelo+o+descarga%3F%3A%0A`}
                target="_blank" 
                rel="noopener noreferrer"
                class="report-problem-link"
              >
                Reportar error en GitHub ➜
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Community Comments & Feedback Terminal (Native Supabase + Local Fallback) -->
    <div class="ps1-window community-comments-window" style="margin-top: 2rem;">
      <div class="ps1-titlebar" style="background: linear-gradient(90deg, #112233, #08111e);">
        <span>// TRANSMISIONES_LOG: COMENTARIOS Y DISCUSIÓN SOBRE {gen.name.toUpperCase()}</span>
        <span class="ps1-telemetry-tag" style="color: var(--ps1-green);">CANAL ACTIVO</span>
      </div>
      <div style="padding: 1.5rem; background: #070c18;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
          <div>
            <h3 style="font-family: var(--font-pixel); font-size: 0.85rem; color: var(--ps1-gold); margin-bottom: 0.3rem;">
              TERMINAL DE TRANSMISIONES DE LA COMUNIDAD
            </h3>
            <p style="font-size: 0.8rem; color: var(--text-dim); margin: 0;">
              Comparte feedback sobre este modelo 3D, notas de integración en tu videojuego o sugerencias de optimización.
            </p>
          </div>
          <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
            <a 
              href="https://github.com/FrancisCuarto/MODELCODER/discussions" 
              target="_blank" 
              rel="noopener noreferrer"
              class="btn btn-outline"
              style="font-size: 0.72rem; padding: 0.4rem 0.8rem; text-decoration: none;"
            >
              🌐 Discusiones en GitHub
            </a>
          </div>
        </div>

        <!-- Formulario para agregar transmisión -->
        <div class="ps1-inset" style="padding: 1rem; background: #050914; margin-bottom: 1.5rem; border-left: 3px solid var(--ps1-cyan);">
          <div style="font-family: var(--font-pixel); font-size: 0.75rem; color: var(--ps1-cyan); margin-bottom: 0.65rem;">
            &gt; ENVIAR NUEVA TRANSMISIÓN AL REGISTRO
          </div>
          <form id="comment-form" style="display: flex; flex-direction: column; gap: 0.75rem;">
            <div>
              <label for="comment-author" style="font-family: var(--font-pixel); font-size: 0.62rem; color: #a0b8d0; display: block; margin-bottom: 0.2rem;">TU NOMBRE / ALIAS DE PILOTO</label>
              <input type="text" id="comment-author" class="ps1-input" placeholder="ej. Piloto_Retro o FrancisCuarto" style="width: 100%; font-size: 0.8rem; padding: 0.4rem 0.5rem;" required />
            </div>
            <div>
              <label for="comment-content" style="font-family: var(--font-pixel); font-size: 0.62rem; color: #a0b8d0; display: block; margin-bottom: 0.2rem;">MENSAJE / OBSERVACIÓN TÉCNICA</label>
              <textarea id="comment-content" class="ps1-input" rows="3" placeholder="Escribe tu observación, sugerencia de paleta o reporte de colisión..." style="width: 100%; font-size: 0.8rem; padding: 0.4rem 0.5rem; resize: vertical;" required></textarea>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
              <span id="comment-status-msg" style="font-size: 0.75rem; display: none;"></span>
              <button id="btn-submit-comment" type="submit" class="btn btn-green" style="margin-left: auto; font-size: 0.78rem; padding: 0.45rem 1rem;">
                📡 TRANSMITIR COMENTARIO
              </button>
            </div>
          </form>
        </div>

        <!-- Lista de Comentarios Transmitidos -->
        <div id="comments-list-container" style="display: flex; flex-direction: column; gap: 0.75rem;">
          <div style="text-align: center; color: var(--text-dim); font-size: 0.8rem; padding: 1rem;">
            Cargando transmisiones de la comunidad...
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Interactive parameter, WebGL material sync, and CLI generation script
  const form = document.getElementById('generator-form') as HTMLFormElement;
  const cliOutput = document.getElementById('cli-command-output');
  const copyCliBtn = document.getElementById('copy-cli-btn');
  const copyCodeBtn = document.getElementById('copy-code-btn');
  const pythonSource = document.getElementById('python-source');
  const presetSelect = document.getElementById('preset-select') as HTMLSelectElement;
  const presetPills = document.querySelectorAll('.preset-pill');
  const viewer = document.getElementById('main-viewer') as any;
  const toggleRotateBtn = document.getElementById('toggle-rotate-btn');
  const resetCamBtn = document.getElementById('reset-cam-btn');
  const screenshotBtn = document.getElementById('screenshot-btn');
  const downloadCustomGlbBtn = document.getElementById('download-custom-glb-btn') as HTMLButtonElement;
  const downloadGlbBtn = document.querySelector('a[download$=".glb"]') as HTMLAnchorElement;
  const liveGenBtn = document.getElementById('live-generate-btn') as HTMLButtonElement;
  const liveStatus = document.getElementById('live-generate-status');
  const downloadSuccessBox = document.getElementById('download-success-box');
  const toggleImportGuideBtn = document.getElementById('toggle-import-guide-btn');
  const importGuidePanel = document.getElementById('import-guide-panel');
  const viewerStatusText = document.getElementById('viewer-status-text');

  toggleImportGuideBtn?.addEventListener('click', () => {
    if (importGuidePanel) {
      const isClosed = importGuidePanel.style.display === 'none';
      importGuidePanel.style.display = isClosed ? 'flex' : 'none';
      if (toggleImportGuideBtn) {
        toggleImportGuideBtn.textContent = isClosed 
          ? '▲ OCULTAR GUÍA DE IMPORTACIÓN' 
          : '📖 ¿CÓMO USO ESTE ARCHIVO EN MI MOTOR?';
      }
    }
  });

  function showDownloadSuccess() {
    if (downloadSuccessBox) {
      downloadSuccessBox.style.display = 'block';
    }
    if (viewerStatusText) {
      viewerStatusText.textContent = '✅ Modelo personalizado descargado correctamente';
    }
  }

  // URL family from path
  const pathParts = window.location.pathname.split('/').filter(Boolean);
  const familyName = pathParts[pathParts.length - 1] || 'model';

  // Palette definitions corresponding to Below Nominal procedural engine
  const PALETTES: Record<string, { primary: number[]; secondary: number[]; metal: number[]; roughness: number }> = {
    industrial_hazard: {
      primary: [0.92, 0.68, 0.08, 1.0], // hazard yellow
      secondary: [0.20, 0.22, 0.25, 1.0], // dark charcoal
      metal: [0.35, 0.38, 0.42, 1.0],
      roughness: 0.65
    },
    medbay_clean: {
      primary: [0.88, 0.94, 0.98, 1.0], // sterile white
      secondary: [0.10, 0.65, 0.85, 1.0], // clean cyan
      metal: [0.55, 0.60, 0.65, 1.0],
      roughness: 0.35
    },
    command_bridge: {
      primary: [0.12, 0.16, 0.28, 1.0], // bridge navy
      secondary: [0.92, 0.52, 0.12, 1.0], // amber alert
      metal: [0.30, 0.32, 0.36, 1.0],
      roughness: 0.50
    },
    habitation_worn: {
      primary: [0.46, 0.42, 0.36, 1.0], // khaki / worn olive
      secondary: [0.24, 0.20, 0.18, 1.0], // dark wood/brown
      metal: [0.32, 0.34, 0.36, 1.0],
      roughness: 0.70
    },
    derelict_decay: {
      primary: [0.38, 0.22, 0.15, 1.0], // oxidized rust
      secondary: [0.18, 0.14, 0.12, 1.0], // dark grime
      metal: [0.25, 0.24, 0.24, 1.0],
      roughness: 0.85
    }
  };

  // Live WebGL Material Customization in <model-viewer>
  function applyLiveMaterials() {
    if (!viewer || !viewer.model || !viewer.model.materials) return;

    // Detect selected palette from form
    let selectedPalette = 'industrial_hazard';
    let wearLevel = 0.65;

    if (form) {
      const paletteInput = (form.elements.namedItem('palette') || form.elements.namedItem('palette_name')) as HTMLSelectElement;
      if (paletteInput && paletteInput.value && PALETTES[paletteInput.value]) {
        selectedPalette = paletteInput.value;
      }

      const wearInput = form.elements.namedItem('wear_level') as HTMLInputElement;
      if (wearInput && wearInput.value) {
        wearLevel = parseFloat(wearInput.value);
      }
    }

    const pal = PALETTES[selectedPalette] || PALETTES['industrial_hazard'];
    const materials = viewer.model.materials;

    materials.forEach((mat: any) => {
      const name = (mat.name || '').toLowerCase();
      const pbr = mat.pbrMetallicRoughness;
      if (!pbr) return;

      // Adjust roughness based on wear level
      pbr.setRoughnessFactor(Math.min(1.0, Math.max(0.1, wearLevel * 0.9 + 0.1)));

      // Apply palette colors based on material purpose
      if (name.includes('casing') || name.includes('body') || name.includes('frame') || name.includes('panel')) {
        pbr.setBaseColorFactor(pal.primary);
      } else if (name.includes('metal') || name.includes('support') || name.includes('pipe') || name.includes('steel')) {
        pbr.setBaseColorFactor(pal.metal);
        pbr.setMetallicFactor(0.85);
      } else if (name.includes('btn') || name.includes('screen') || name.includes('light') || name.includes('accent')) {
        pbr.setBaseColorFactor(pal.secondary);
      }
    });
  }

  // Update CLI command & trigger live material update
  function updateLiveValuesAndCLI() {
    if (!form || !cliOutput) return;

    const cliArgs: string[] = [`--family ${familyName}`];

    form.querySelectorAll('.input-row').forEach((rowEl) => {
      const row = rowEl as HTMLElement;
      const key = row.dataset.paramKey;
      const type = row.dataset.paramType;
      if (!key) return;

      const input = form.elements.namedItem(key) as HTMLInputElement | HTMLSelectElement;
      if (!input) return;

      const liveValEl = document.getElementById(`val-${key}`);

      if (type === 'boolean') {
        const checked = (input as HTMLInputElement).checked;
        if (checked) cliArgs.push(`--${key.replace(/_/g, '-')}`);
        else cliArgs.push(`--no-${key.replace(/_/g, '-')}`);
      } else {
        const val = input.value;
        if (liveValEl) liveValEl.textContent = val;
        if (val !== undefined && val !== '') {
          cliArgs.push(`--${key.replace(/_/g, '-')} ${val}`);
        }
      }
    });

    cliOutput.textContent = `blender -b --python generate.py -- ${cliArgs.join(' ')}`;

    // Real-time 3D dimensional scaling in <model-viewer>
    if (viewer && form) {
      let sx = 1.0, sy = 1.0, sz = 1.0;

      const widthInput = form.elements.namedItem('width') as HTMLInputElement;
      if (widthInput && widthInput.value) {
        const defW = parseFloat(widthInput.getAttribute('value') || '1.0');
        const curW = parseFloat(widthInput.value);
        if (defW > 0 && curW > 0) sx = curW / defW;
      }

      const lengthInput = (form.elements.namedItem('length') || form.elements.namedItem('depth')) as HTMLInputElement;
      if (lengthInput && lengthInput.value) {
        const defL = parseFloat(lengthInput.getAttribute('value') || '1.0');
        const curL = parseFloat(lengthInput.value);
        if (defL > 0 && curL > 0) sy = curL / defL;
      }

      const heightInput = form.elements.namedItem('height') as HTMLInputElement;
      if (heightInput && heightInput.value) {
        const defH = parseFloat(heightInput.getAttribute('value') || '1.0');
        const curH = parseFloat(heightInput.value);
        if (defH > 0 && curH > 0) sz = curH / defH;
      }

      // Constrain scale between 0.35 and 2.5 for visual stability
      sx = Math.min(2.5, Math.max(0.35, sx));
      sy = Math.min(2.5, Math.max(0.35, sy));
      sz = Math.min(2.5, Math.max(0.35, sz));

      viewer.scale = `${sx.toFixed(3)} ${sy.toFixed(3)} ${sz.toFixed(3)}`;
    }

    // Dynamic Palette Model Swapping (Instant Authentic 3D Color/Texture Update)
    if (viewer && form) {
      let selectedPalette = 'industrial_hazard';
      const palInput = (form.elements.namedItem('palette_name') || form.elements.namedItem('palette') || form.elements.namedItem('style_palette') || form.elements.namedItem('body_color_preset')) as HTMLSelectElement;
      if (palInput && palInput.value) {
        selectedPalette = palInput.value;
      }

      let availablePalettes: string[] = [];
      try {
        availablePalettes = JSON.parse(viewer.dataset.availablePalettes || '[]');
      } catch {}

      const baseModelUrl = viewer.dataset.baseSrc || `/models/${familyName}.glb`;

      if (availablePalettes.includes(selectedPalette)) {
        const targetPaletteGlb = `/models/${familyName}_${selectedPalette}.glb`;
        if (!viewer.src || !viewer.src.endsWith(targetPaletteGlb)) {
          viewer.src = targetPaletteGlb;
          if (downloadGlbBtn) {
            downloadGlbBtn.href = targetPaletteGlb;
            downloadGlbBtn.download = `${familyName}_${selectedPalette}.glb`;
          }
        }
      } else {
        // Fallback al modelo base predeterminado si no existe el GLB pre-renderizado de esa paleta
        if (!viewer.src || viewer.src.includes(`_${selectedPalette}.glb`)) {
          viewer.src = baseModelUrl;
          if (downloadGlbBtn) {
            downloadGlbBtn.href = baseModelUrl;
            downloadGlbBtn.download = `${familyName}.glb`;
          }
        }
      }
    }

    // Update 3D viewport materials live in browser
    applyLiveMaterials();
  }

  form?.addEventListener('input', updateLiveValuesAndCLI);
  form?.addEventListener('change', updateLiveValuesAndCLI);

  viewer?.addEventListener('error', (err: any) => {
    console.warn('[ModelCoder] Fallo al cargar modelo GLB en visor, restaurando modelo base:', err);
    const baseModelUrl = viewer.dataset.baseSrc || `/models/${familyName}.glb`;
    if (viewer.src && !viewer.src.endsWith(baseModelUrl)) {
      viewer.src = baseModelUrl;
      if (downloadGlbBtn) {
        downloadGlbBtn.href = baseModelUrl;
        downloadGlbBtn.download = `${familyName}.glb`;
      }
    }
  });

  viewer?.addEventListener('load', () => {
    // Re-apply scale on new palette model load
    if (form && viewer) {
      let sx = 1.0, sy = 1.0, sz = 1.0;
      const widthInput = form.elements.namedItem('width') as HTMLInputElement;
      if (widthInput && widthInput.value) {
        const defW = parseFloat(widthInput.getAttribute('value') || '1.0');
        const curW = parseFloat(widthInput.value);
        if (defW > 0 && curW > 0) sx = curW / defW;
      }
      const lengthInput = (form.elements.namedItem('length') || form.elements.namedItem('depth')) as HTMLInputElement;
      if (lengthInput && lengthInput.value) {
        const defL = parseFloat(lengthInput.getAttribute('value') || '1.0');
        const curL = parseFloat(lengthInput.value);
        if (defL > 0 && curL > 0) sy = curL / defL;
      }
      const heightInput = form.elements.namedItem('height') as HTMLInputElement;
      if (heightInput && heightInput.value) {
        const defH = parseFloat(heightInput.getAttribute('value') || '1.0');
        const curH = parseFloat(heightInput.value);
        if (defH > 0 && curH > 0) sz = curH / defH;
      }
      sx = Math.min(2.5, Math.max(0.35, sx));
      sy = Math.min(2.5, Math.max(0.35, sy));
      sz = Math.min(2.5, Math.max(0.35, sz));
      viewer.scale = `${sx.toFixed(3)} ${sy.toFixed(3)} ${sz.toFixed(3)}`;
    }
    applyLiveMaterials();
  });

  // Preset selector handler
  function applyPreset(values: Record<string, any>) {
    if (!form) return;
    Object.entries(values).forEach(([k, val]) => {
      const input = form.elements.namedItem(k) as HTMLInputElement | HTMLSelectElement;
      if (input) {
        if (input.type === 'checkbox') {
          (input as HTMLInputElement).checked = Boolean(val);
        } else {
          input.value = String(val);
        }
        const liveValEl = document.getElementById(`val-${k}`);
        if (liveValEl) liveValEl.textContent = String(val);
      }
    });
    updateLiveValuesAndCLI();
  }

  presetSelect?.addEventListener('change', () => {
    const selectedOpt = presetSelect.options[presetSelect.selectedIndex];
    const dataValues = selectedOpt.getAttribute('data-values');
    if (dataValues) {
      applyPreset(JSON.parse(dataValues));
    }
  });

  presetPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      presetPills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      const dataValues = pill.getAttribute('data-preset-values');
      const presetId = pill.getAttribute('data-preset-id');
      if (presetSelect && presetId) {
        presetSelect.value = presetId;
      }
      if (dataValues) {
        applyPreset(JSON.parse(dataValues));
      }
    });
  });

  // Copy buttons
  copyCliBtn?.addEventListener('click', () => {
    if (cliOutput) {
      navigator.clipboard.writeText(cliOutput.textContent?.trim() || '');
      copyCliBtn.textContent = '[ ¡COPIADO! ]';
      setTimeout(() => { copyCliBtn.textContent = '[ COPIAR ]'; }, 2000);
    }
  });

  copyCodeBtn?.addEventListener('click', () => {
    if (pythonSource) {
      navigator.clipboard.writeText(pythonSource.textContent || '');
      copyCodeBtn.textContent = '[ ¡COPIADO! ]';
      setTimeout(() => { copyCodeBtn.textContent = '[ COPIAR CÓDIGO ]'; }, 2000);
    }
  });

  // Viewer controls
  let isRotating = true;
  toggleRotateBtn?.addEventListener('click', () => {
    if (viewer) {
      isRotating = !isRotating;
      viewer.autoRotate = isRotating;
      toggleRotateBtn.textContent = isRotating ? '🔄 ROTACIÓN' : '⏸️ PAUSADO';
    }
  });

  resetCamBtn?.addEventListener('click', () => {
    if (viewer) {
      viewer.resetTurntable();
      viewer.cameraOrbit = '0deg 75deg 105%';
    }
  });

  screenshotBtn?.addEventListener('click', () => {
    if (viewer) {
      const dataUrl = viewer.toDataURL('image/png');
      const a = document.createElement('a');
      a.href = dataUrl;
      a.download = `${familyName}_psx_screenshot.png`;
      a.click();
    }
  });

  // Download Custom GLB directly from browser memory
  downloadCustomGlbBtn?.addEventListener('click', async () => {
    if (!viewer) return;

    downloadCustomGlbBtn.disabled = true;
    downloadCustomGlbBtn.textContent = '⏳ Empaquetando GLB...';

    try {
      if (typeof viewer.exportScene === 'function') {
        const glbBlob = await viewer.exportScene({ binary: true });
        const blobUrl = URL.createObjectURL(glbBlob);
        const a = document.createElement('a');
        a.href = blobUrl;
        a.download = `${familyName}_custom.glb`;
        a.click();
      } else {
        // Fallback to base GLB url
        const a = document.createElement('a');
        a.href = viewer.src;
        a.download = `${familyName}.glb`;
        a.click();
      }
      showDownloadSuccess();
    } catch (err) {
      // Fallback to base model
      const a = document.createElement('a');
      a.href = `/models/${familyName}.glb`;
      a.download = `${familyName}.glb`;
      a.click();
      showDownloadSuccess();
    } finally {
      downloadCustomGlbBtn.disabled = false;
      downloadCustomGlbBtn.textContent = '💾 DESCARGAR MODELO PERSONALIZADO (.GLB)';
    }
  });

  // Live generation trigger (Smart dual-mode: Remote Worker or Web Standalone)
  liveGenBtn?.addEventListener('click', async () => {
    if (!form) return;
    
    // 1. Immediately apply WebGL parameters and dimension scaling client-side
    updateLiveValuesAndCLI();

    // Visual pulse on viewport
    if (viewer) {
      viewer.style.transition = 'filter 0.15s ease';
      viewer.style.filter = 'brightness(1.35) contrast(1.15)';
      setTimeout(() => {
        if (viewer) viewer.style.filter = 'none';
      }, 250);
    }

    // 2. Collect parameters
    const params: Record<string, any> = {};
    form.querySelectorAll('.input-row').forEach((rowEl) => {
      const row = rowEl as HTMLElement;
      const key = row.dataset.paramKey;
      const type = row.dataset.paramType;
      if (!key) return;

      const input = form.elements.namedItem(key) as HTMLInputElement | HTMLSelectElement;
      if (!input) return;

      if (type === 'boolean') {
        params[key] = (input as HTMLInputElement).checked;
      } else if (type === 'float') {
        params[key] = parseFloat(input.value);
      } else if (type === 'int' || type === 'seed') {
        params[key] = parseInt(input.value, 10);
      } else {
        params[key] = input.value;
      }
    });

    const payload = {
      family: familyName,
      parameters: params,
      preset: presetSelect?.value || undefined
    };

    liveGenBtn.disabled = true;
    liveGenBtn.textContent = '⏳ Sincronizando Malla 3D...';
    if (liveStatus) {
      liveStatus.style.display = 'block';
      liveStatus.className = 'live-status-box status-loading';
      liveStatus.textContent = '[ PROCESANDO ] Aplicando parámetros y conectando con el entorno de generación...';
    }

    // Immediately apply palette and scale transforms in client viewport
    updateLiveValuesAndCLI();

    // Determine API URL: user-configured -> window global -> localhost fallback
    const configuredUrl = localStorage.getItem('modelcoder_worker_url');
    const apiUrl = configuredUrl || (window as any).__MODELCODER_API_URL__ || (window.location.hostname === 'localhost' ? 'http://localhost:8000/api/generate' : null);

    if (!apiUrl) {
      // Web Standalone Mode: No worker configured, succeed via client-side generation
      if (liveStatus) {
        liveStatus.className = 'live-status-box status-success';
        liveStatus.innerHTML = `✅ <strong>[ MODO NAVEGADOR ACTIVO ]</strong><br>Malla 3D actualizada en tiempo real con las nuevas dimensiones y materiales.<br><small style="color: var(--text-dim); margin-top: 3px; display: inline-block;">Usa el botón <strong>"DESCARGAR GLB PERSONALIZADO"</strong> o copia el comando CLI para recalcular geometría en Blender.</small>`;
      }
      liveGenBtn.disabled = false;
      liveGenBtn.textContent = '⚡ GENERAR MALLA 3D EN VIVO';
      return;
    }

    try {
      const res = await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!res.ok) {
        const errJson = await res.json().catch(() => ({ detail: 'Error en el servidor de generación.' }));
        throw new Error(errJson.detail || `Error HTTP ${res.status}`);
      }

      const cacheStatus = res.headers.get('X-Cache') || 'MISS';
      const blob = await res.blob();
      const newGlbUrl = URL.createObjectURL(blob);

      if (viewer) {
        viewer.scale = "1 1 1";
        viewer.src = newGlbUrl;
        viewer.addEventListener('load', () => {
          applyLiveMaterials();
        }, { once: true });
      }

      if (liveStatus) {
        liveStatus.className = 'live-status-box status-success';
        liveStatus.textContent = `✅ [ WORKER OK ] ¡Nueva malla 3D compilada y cargada en el visor! (Cache: ${cacheStatus})`;
      }
    } catch (err: any) {
      // Graceful fallback to client-side mode with clear, helpful instructions
      if (liveStatus) {
        liveStatus.className = 'live-status-box status-info';
        liveStatus.innerHTML = `ℹ️ <strong>[ MODO NAVEGADOR ACTIVO ]</strong><br>Variante visual y materiales actualizados en el visor en tiempo real.<br><small style="color: var(--text-dim); margin-top: 4px; display: inline-block;">Para re-calcular geometría en un servidor remoto de Blender, puedes configurar la URL de tu worker en la pestaña de abajo o ejecutar el comando CLI en tu terminal local.</small>`;
      }
    } finally {
      liveGenBtn.disabled = false;
      liveGenBtn.textContent = '⚡ GENERAR MALLA 3D EN VIVO';
    }
  });

  // Worker URL configuration and fast-track actions
  const workerUrlInput = document.getElementById('worker-url-input') as HTMLInputElement;
  const saveWorkerUrlBtn = document.getElementById('save-worker-url-btn');
  const setLocalhostBtn = document.getElementById('set-localhost-btn');
  const clearWorkerBtn = document.getElementById('clear-worker-btn');
  const workerPingStatus = document.getElementById('worker-ping-status');

  // Load existing saved URL
  const savedWorkerUrl = localStorage.getItem('modelcoder_worker_url');
  if (savedWorkerUrl && workerUrlInput) {
    workerUrlInput.value = savedWorkerUrl;
    if (workerPingStatus) {
      workerPingStatus.style.display = 'block';
      workerPingStatus.style.color = 'var(--ps1-cyan)';
      workerPingStatus.textContent = `● Configurado: ${savedWorkerUrl}`;
    }
  }

  async function pingWorker(url: string) {
    if (!workerPingStatus) return;
    workerPingStatus.style.display = 'block';
    workerPingStatus.style.color = 'var(--ps1-gold)';
    workerPingStatus.textContent = '⏳ Comprobando conexión con el worker...';

    try {
      const baseUrl = url.replace(/\/api\/generate\/?$/, '');
      const testUrl = `${baseUrl}/api/health`;
      const res = await fetch(testUrl, { method: 'GET', signal: AbortSignal.timeout(3500) }).catch(() => null);
      if (res && res.ok) {
        workerPingStatus.style.color = '#33ff88';
        workerPingStatus.textContent = '✅ [ EN LÍNEA ] Worker de Blender conectado y respondiendo.';
      } else {
        workerPingStatus.style.color = 'var(--ps1-cyan)';
        workerPingStatus.textContent = `ℹ️ URL guardada. Se usará en la próxima generación.`;
      }
    } catch {
      workerPingStatus.style.color = 'var(--ps1-cyan)';
      workerPingStatus.textContent = `ℹ️ URL guardada. Asegúrate de tener el worker activo.`;
    }
  }

  saveWorkerUrlBtn?.addEventListener('click', () => {
    const rawVal = workerUrlInput?.value.trim() || '';
    if (!rawVal) {
      localStorage.removeItem('modelcoder_worker_url');
      if (workerPingStatus) {
        workerPingStatus.style.display = 'block';
        workerPingStatus.style.color = 'var(--text-dim)';
        workerPingStatus.textContent = 'Modo Navegador Autónomo restaurado.';
      }
      return;
    }
    let target = rawVal;
    if (!target.includes('/api/generate')) {
      target = target.replace(/\/+$/, '') + '/api/generate';
    }
    localStorage.setItem('modelcoder_worker_url', target);
    if (workerUrlInput) workerUrlInput.value = target;
    pingWorker(target);
  });

  setLocalhostBtn?.addEventListener('click', () => {
    const localUrl = 'http://localhost:8000/api/generate';
    if (workerUrlInput) workerUrlInput.value = localUrl;
    localStorage.setItem('modelcoder_worker_url', localUrl);
    pingWorker(localUrl);
  });

  clearWorkerBtn?.addEventListener('click', () => {
    localStorage.removeItem('modelcoder_worker_url');
    if (workerUrlInput) workerUrlInput.value = '';
    if (workerPingStatus) {
      workerPingStatus.style.display = 'block';
      workerPingStatus.style.color = '#88aacc';
      workerPingStatus.textContent = '✅ Desconectado. Usando modo navegador autónomo.';
    }
  });

  const resetParamsBtn = document.getElementById('reset-params-btn');
  resetParamsBtn?.addEventListener('click', () => {
    if (form) {
      form.reset();
      updateLiveValuesAndCLI();
    }
  });

  // Initial update
  updateLiveValuesAndCLI();

  // ============================================================================
  // Community Transmissions & Feedback System (Native Supabase + Local Fallback)
  // ============================================================================
  import { getModelComments, addModelComment, deleteModelComment, getCurrentUser, checkUserRole } from '../../lib/supabase';

  const commentForm = document.getElementById('comment-form') as HTMLFormElement;
  const commentAuthorInput = document.getElementById('comment-author') as HTMLInputElement;
  const commentContentInput = document.getElementById('comment-content') as HTMLTextAreaElement;
  const commentStatusMsg = document.getElementById('comment-status-msg');
  const btnSubmitComment = document.getElementById('btn-submit-comment') as HTMLButtonElement;
  const commentsListContainer = document.getElementById('comments-list-container');

  let currentCommentUserRole: any = null;

  async function initCommentUser() {
    try {
      const user = await getCurrentUser();
      const roleInfo = await checkUserRole(user);
      currentCommentUserRole = roleInfo;

      if (commentAuthorInput && !commentAuthorInput.value) {
        if (roleInfo.identifier) {
          commentAuthorInput.value = roleInfo.identifier;
        } else if (user?.user_metadata?.user_name) {
          commentAuthorInput.value = `@${user.user_metadata.user_name}`;
        }
      }
    } catch {}
  }

  async function loadComments() {
    if (!commentsListContainer) return;
    try {
      const list = await getModelComments(familyName);
      renderComments(list);
    } catch (err) {
      commentsListContainer.innerHTML = `
        <div style="font-size:0.75rem; color:var(--text-dim); text-align:center; padding:1rem;">
          No se pudieron cargar las transmisiones en este momento.
        </div>
      `;
    }
  }

  function renderComments(list: any[]) {
    if (!commentsListContainer) return;
    commentsListContainer.innerHTML = '';

    if (!list || list.length === 0) {
      commentsListContainer.innerHTML = `
        <div class="ps1-inset" style="padding: 1.25rem; background: #040812; text-align: center; color: var(--text-dim); font-size: 0.8rem;">
          📡 Aún no hay transmisiones registradas para este modelo. ¡Sé el primero en dejar una observación!
        </div>
      `;
      return;
    }

    const canModerate = currentCommentUserRole?.role === 'owner' || currentCommentUserRole?.role === 'admin';

    list.forEach((c) => {
      const item = document.createElement('div');
      item.className = 'ps1-inset comment-item';
      item.style.padding = '0.75rem 1rem';
      item.style.background = '#040814';
      item.style.borderLeft = '3px solid var(--ps1-steel)';
      item.style.display = 'flex';
      item.style.flexDirection = 'column';
      item.style.gap = '0.35rem';

      const isOwner = c.author_name.toLowerCase().includes('franciscuarto') || c.author_name.toLowerCase().includes('creador');

      item.innerHTML = `
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
          <div style="display: flex; align-items: center; gap: 0.4rem;">
            <span style="font-size: 0.9rem;">${isOwner ? '👑' : '👤'}</span>
            <strong style="font-family: var(--font-pixel); font-size: 0.72rem; color: ${isOwner ? 'var(--ps1-gold)' : 'var(--ps1-cyan)'};">
              ${c.author_name}
            </strong>
            ${isOwner ? '<span style="font-size:0.6rem; background:rgba(255,176,0,0.15); color:var(--ps1-gold); padding:1px 4px; border:1px solid var(--ps1-gold);">OFICIAL</span>' : ''}
          </div>
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span style="font-size: 0.68rem; color: var(--text-dim);">
              ${c.created_at ? new Date(c.created_at).toLocaleString() : ''}
            </span>
            ${canModerate ? `
              <button type="button" class="btn btn-sm btn-danger btn-del-comment" data-id="${c.id}" style="padding: 1px 6px; font-size: 0.65rem;" title="Eliminar comentario">
                🗑️
              </button>
            ` : ''}
          </div>
        </div>
        <p style="font-size: 0.8rem; color: #d0e0f0; margin: 0; line-height: 1.45; white-space: pre-wrap;">${c.content}</p>
      `;

      commentsListContainer.appendChild(item);
    });

    if (canModerate) {
      commentsListContainer.querySelectorAll('.btn-del-comment').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.id || '';
          if (confirm('¿Eliminar esta transmisión?')) {
            await deleteModelComment(id, familyName);
            await loadComments();
          }
        });
      });
    }
  }

  commentForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!commentContentInput || !commentAuthorInput) return;
    const author = commentAuthorInput.value.trim() || 'Piloto de la Comunidad';
    const content = commentContentInput.value.trim();
    if (!content) return;

    if (btnSubmitComment) {
      btnSubmitComment.disabled = true;
      btnSubmitComment.textContent = '📡 Transmitiendo...';
    }

    try {
      const res = await addModelComment(familyName, author, content);
      if (res.success) {
        commentContentInput.value = '';
        if (commentStatusMsg) {
          commentStatusMsg.style.display = 'inline';
          commentStatusMsg.style.color = 'var(--ps1-green)';
          commentStatusMsg.textContent = '✓ Transmisión registrada correctamente.';
          setTimeout(() => {
            if (commentStatusMsg) commentStatusMsg.style.display = 'none';
          }, 4000);
        }
        await loadComments();
      } else {
        if (commentStatusMsg) {
          commentStatusMsg.style.display = 'inline';
          commentStatusMsg.style.color = 'var(--ps1-red)';
          commentStatusMsg.textContent = `Error: ${res.error || 'No se pudo transmitir'}`;
        }
      }
    } catch (err: any) {
      if (commentStatusMsg) {
        commentStatusMsg.style.display = 'inline';
        commentStatusMsg.style.color = 'var(--ps1-red)';
        commentStatusMsg.textContent = `Error: ${err.message || err}`;
      }
    } finally {
      if (btnSubmitComment) {
        btnSubmitComment.disabled = false;
        btnSubmitComment.textContent = '📡 TRANSMITIR COMENTARIO';
      }
    }
  });

  initCommentUser();
  loadComments();
</script>

