</style>

<script>
  // Manejo de Copiado de Código
  document.querySelectorAll('.btn-copy-code').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = (btn as HTMLElement).dataset.target;
      if (!targetId) return;
      const codeElem = document.getElementById(targetId);
      if (!codeElem) return;

      const codeText = codeElem.textContent || '';
      navigator.clipboard.writeText(codeText).then(() => {
        const originalText = btn.textContent;
        btn.textContent = '¡Copiado!';
        btn.style.background = 'var(--ps1-green)';
        btn.style.color = '#000000';
        setTimeout(() => {
          btn.textContent = originalText;
          btn.style.background = '';
          btn.style.color = '';
        }, 2000);
      });
    });
  });

  // Buscador / Filtro Rápido en Sidebar
  const searchInput = document.getElementById('docs-search-input') as HTMLInputElement;
  const navItems = document.querySelectorAll('.docs-nav-item');
  const navGroups = document.querySelectorAll('.nav-group');

  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase().trim();

    navItems.forEach((item) => {
      const text = item.textContent?.toLowerCase() || '';
      const href = item.getAttribute('href')?.toLowerCase() || '';
      const match = text.includes(query) || href.includes(query);
      (item as HTMLElement).style.display = match ? 'block' : 'none';
    });

    navGroups.forEach((group) => {
      const visibleItems = group.querySelectorAll('.docs-nav-item[style*="display: block"], .docs-nav-item:not([style*="display: none"])');
      const shouldShowGroup = !query || visibleItems.length > 0;
      (group as HTMLElement).style.display = shouldShowGroup ? 'flex' : 'none';
    });
  });

  // Resaltado de sección activa mediante IntersectionObserver
  const sections = document.querySelectorAll('.doc-block');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');
        if (!id) return;

        navItems.forEach((nav) => {
          if (nav.getAttribute('href') === `#${id}`) {
            nav.classList.add('active');
            const breadcrumb = document.getElementById('current-section-breadcrumb');
            if (breadcrumb) {
              breadcrumb.textContent = `DOCUMENTACIÓN TÉCNICA / ${nav.textContent?.toUpperCase()}`;
            }
          } else {
            nav.classList.remove('active');
          }
        });
      }
    });
  }, { rootMargin: '-10% 0px -75% 0px' });

  sections.forEach((sec) => observer.observe(sec));
</script>
