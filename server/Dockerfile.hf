# Multi-stage lightweight Dockerfile for Hugging Face Spaces (Free 24/7 Cloud Worker)
FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PORT=7860 \
    BLENDER_URL=https://download.blender.org/release/Blender4.2/blender-4.2.0-linux-x64.tar.xz

# Install system dependencies required for headless Blender rendering
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    xz-utils \
    libx11-6 \
    libxxf86vm1 \
    libxcursor1 \
    libxi6 \
    libxrandr2 \
    libxinerama1 \
    libegl1 \
    libopengl0 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Download and extract Blender Linux binary
WORKDIR /opt
RUN wget -q $BLENDER_URL && \
    tar -xf blender-4.2.0-linux-x64.tar.xz && \
    rm blender-4.2.0-linux-x64.tar.xz && \
    ln -s /opt/blender-4.2.0-linux-x64/blender /usr/local/bin/blender

# Hugging Face runs with non-root user UID 1000
RUN useradd -m -u 1000 user
USER user
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH

WORKDIR /home/user/app

COPY --chown=user server/requirements.txt requirements.txt
RUN pip install --no-cache-dir --user -r requirements.txt

COPY --chown=user . .

EXPOSE 7860

CMD ["python", "server/main.py", "--port", "7860"]
