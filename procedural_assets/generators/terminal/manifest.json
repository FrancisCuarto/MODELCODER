    {
      "key": "screen_w",
      "label": "Screen W",
      "type": "float",
      "default": 0.36,
      "group": "General",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "screen_h",
      "label": "Screen H",
      "type": "float",
      "default": 0.26,
      "group": "General",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "phosphor_color",
      "label": "Phosphor Color",
      "type": "string",
      "default": "green",
      "group": "General"
    },
    {
      "key": "crt_bulge",
      "label": "Crt Bulge",
      "type": "float",
      "default": 0.025,
      "group": "General",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "keyboard_style",
      "label": "Keyboard Style",
      "type": "string",
      "default": "integrated",
      "group": "General"
    },
    {
      "key": "has_card_reader",
      "label": "Has Card Reader",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "card_reader_side",
      "label": "Card Reader Side",
      "type": "string",
      "default": "right",
      "group": "General"
    },
    {
      "key": "has_floppy_drive",
      "label": "Has Floppy Drive",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "has_speaker_grill",
      "label": "Has Speaker Grill",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "has_hanging_cables",
      "label": "Has Hanging Cables",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "cable_count",
      "label": "Cable Count",
      "type": "int",
      "default": 2,
      "group": "General",
      "min": 0,
      "step": 1
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "Estándar / Por Defecto",
      "description": "Configuración base del generador",
      "values": {
        "seed": 42,
        "target_tri_budget": 450,
        "name": "terminal",
        "wear_level": 0.5,
        "add_collision_mesh": false,
        "collision_type": "box",
        "collision_suffix": "-convcolonly",
        "pivot_rule": "floor_center",
        "export_subcomponents": false,
        "palette_name": "industrial_hazard",
        "emission_scale": 1.0,
        "terminal_type": "wall",
        "state": "active",
        "width": 0.55,
        "height": 0.65,
        "depth": 0.35,
        "screen_w": 0.36,
        "screen_h": 0.26,
        "phosphor_color": "green",
        "crt_bulge": 0.025,
        "keyboard_style": "integrated",
        "has_card_reader": true,
        "card_reader_side": "right",
        "has_floppy_drive": true,
        "has_speaker_grill": true,
        "has_hanging_cables": true,
        "cable_count": 2
      }
    }
  ],
  "export_capabilities": {
    "supports_collision": true,
    "default_collision_suffix": "-convcolonly",
    "supports_sockets": false
  }
}