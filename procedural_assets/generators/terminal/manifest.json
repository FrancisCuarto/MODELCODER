{
  "$schema": "https://raw.githubusercontent.com/usuario/modelcoder-community/main/schemas/generator-v1.json",
  "id": "below_nominal.infrastructure.terminal",
  "version": "1.0.0",
  "name": "Terminal",
  "description": "Generador procedural paramétrico de terminal para Below Nominal.",
  "author": {
    "name": "Below Nominal Team",
    "github": "below-nominal",
    "url": "https://belownominal.com"
  },
  "license": "CC-BY-4.0",
  "category": "infrastructure",
  "tags": [
    "infrastructure",
    "terminal",
    "psx",
    "low-poly",
    "retro-sci-fi"
  ],
  "compatibility": {
    "engine_version": ">=1.5.0",
    "blender_version": ">=4.2"
  },
  "parameters": [
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": 42,
      "group": "Rendimiento",
      "min": 0,
      "max": 2147483647,
      "step": 1
    },
    {
      "key": "target_tri_budget",
      "label": "Target Tri Budget",
      "type": "int",
      "default": 450,
      "group": "Rendimiento",
      "min": 0,
      "step": 1
    },
    {
      "key": "name",
      "label": "Name",
      "type": "string",
      "default": "terminal",
      "group": "General"
    },
    {
      "key": "wear_level",
      "label": "Wear Level",
      "type": "float",
      "default": 0.5,
      "group": "Materiales",
      "min": 0.0,
      "max": 1.0,
      "step": 0.05
    },
    {
      "key": "add_collision_mesh",
      "label": "Add Collision Mesh",
      "type": "boolean",
      "default": false,
      "group": "General"
    },
    {
      "key": "collision_type",
      "label": "Collision Type",
      "type": "string",
      "default": "box",
      "group": "General"
    },
    {
      "key": "collision_suffix",
      "label": "Collision Suffix",
      "type": "string",
      "default": "-convcolonly",
      "group": "General"
    },
    {
      "key": "pivot_rule",
      "label": "Pivot Rule",
      "type": "string",
      "default": "floor_center",
      "group": "General"
    },
    {
      "key": "export_subcomponents",
      "label": "Export Subcomponents",
      "type": "boolean",
      "default": false,
      "group": "General"
    },
    {
      "key": "palette_name",
      "label": "Palette Name",
      "type": "enum",
      "default": "industrial_hazard",
      "group": "Materiales",
      "options": [
        {
          "value": "industrial_hazard",
          "label": "Industrial Hazard"
        },
        {
          "value": "medbay_clean",
          "label": "Medbay Clean"
        },
        {
          "value": "command_bridge",
          "label": "Command Bridge"
        },
        {
          "value": "habitation_worn",
          "label": "Habitation Worn"
        },
        {
          "value": "derelict_decay",
          "label": "Derelict Decay"
        }
      ]
    },
    {
      "key": "emission_scale",
      "label": "Emission Scale",
      "type": "float",
      "default": 1.0,
      "group": "General",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "extra_params",
      "label": "Extra Params",
      "type": "string",
      "default": null,
      "group": "General"
    },
    {
      "key": "terminal_type",
      "label": "Terminal Type",
      "type": "string",
      "default": "wall",
      "group": "General"
    },
    {
      "key": "state",
      "label": "State",
      "type": "string",
      "default": "active",
      "group": "General"
    },
    {
      "key": "width",
      "label": "Width",
      "type": "float",
      "default": 0.55,
      "group": "Dimensiones",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "height",
      "label": "Height",
      "type": "float",
      "default": 0.65,
      "group": "Dimensiones",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "depth",
      "label": "Depth",
      "type": "float",
      "default": 0.35,
      "group": "Dimensiones",
      "min": 0.0,
      "step": 0.05
