{
  "id": "below_nominal.habitation.personal_effects_box",
  "name": "Personal Effects Box",
  "category": "habitation",
  "version": "1.0.0",
  "description": "Hermetic crew personal effects trunk with corner impact bumpers, draw latches, folding carry handle, and crew ID nameplate.",
  "author": {
    "name": "ModelCoder Core Team",
    "github": "FrancisCuarto"
  },
  "parameters": [
    {
      "key": "width",
      "type": "float",
      "default": 0.44,
      "min": 0.30,
      "max": 0.70,
      "description": "Container width in meters"
    },
    {
      "key": "depth",
      "type": "float",
      "default": 0.32,
      "min": 0.20,
      "max": 0.50,
      "description": "Container depth in meters"
    },
    {
      "key": "height",
      "type": "float",
      "default": 0.22,
      "min": 0.15,
      "max": 0.40,
      "description": "Container total height in meters"
    },
    {
      "key": "box_state",
      "type": "enum",
      "default": "closed",
      "options": ["closed", "open", "damaged"],
      "description": "Lid position and structural state"
    },
    {
      "key": "has_latches",
      "type": "bool",
      "default": true,
      "description": "Include dual front toggle draw latches"
    },
    {
      "key": "has_handle",
      "type": "bool",
      "default": true,
      "description": "Include reinforced folding carry handle"
    },
    {
      "key": "has_nameplate",
      "type": "bool",
      "default": true,
      "description": "Include crew identification nameplate / stencil label"
    },
    {
      "key": "has_corner_gussets",
      "type": "bool",
      "default": true,
      "description": "Include rubberized corner impact gussets"
    }
  ],
  "presets": [
    {
      "id": "officer_locker",
      "label": "Officer Locker",
