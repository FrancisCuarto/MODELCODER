    {
      "key": "caster_wheels",
      "label": "Caster Wheels",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "curtain_damage",
      "label": "Curtain Damage",
      "type": "string",
      "default": "intact",
      "group": "General"
