        "collision_suffix": "-convcolonly",
        "pivot_rule": "floor_center",
        "export_subcomponents": false,
        "palette_name": "industrial_hazard",
        "emission_scale": 1.0,
        "screen_type": "three_panel",
        "panel_count": 3,
        "fold_angle_deg": 30.0,
        "panel_width": 0.6,
        "panel_height": 1.75,
        "caster_wheels": true,
        "curtain_damage": "intact"
