      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": 42,
      "group": "Rendimiento",
      "min": 0,
      "max": 2147483647,
      "step": 1
    },
    {
      "key": "target_tri_budget",
      "label": "Target Tri Budget",
      "type": "int",
      "default": 260,
      "group": "Rendimiento",
      "min": 0,
      "step": 1
    },
    {
      "key": "name",
      "label": "Name",
      "type": "string",
      "default": "asset",
      "group": "General"
    },
    {
      "key": "wear_level",
      "label": "Wear Level",
      "type": "float",
      "default": 0.5,
      "group": "Materiales",
      "min": 0.0,
      "max": 1.0,
      "step": 0.05
