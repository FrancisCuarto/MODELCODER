    {
      "key": "extra_params",
      "label": "Extra Params",
      "type": "string",
      "default": null,
      "group": "General"
    },
    {
      "key": "screen_type",
      "label": "Screen Type",
      "type": "string",
      "default": "three_panel",
      "group": "General"
    },
    {
      "key": "panel_count",
