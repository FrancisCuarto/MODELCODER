{
  "$schema": "https://raw.githubusercontent.com/usuario/modelcoder-community/main/schemas/generator-v1.json",
  "id": "below_nominal.medical.medical_screen",
  "version": "1.0.0",
  "name": "Medical Screen",
  "description": "Generador procedural paramétrico de medical screen para Below Nominal.",
  "author": {
    "name": "Below Nominal Team",
    "github": "below-nominal",
    "url": "https://belownominal.com"
  },
  "license": "CC-BY-4.0",
  "category": "medical",
