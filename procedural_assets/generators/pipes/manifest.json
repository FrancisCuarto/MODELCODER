{
  "$schema": "https://raw.githubusercontent.com/usuario/modelcoder-community/main/schemas/generator-v1.json",
  "id": "below_nominal.infrastructure.pipes",
  "version": "1.0.0",
  "name": "Pipes",
  "description": "Generador procedural paramétrico de pipes para Below Nominal.",
  "author": {
    "name": "Below Nominal Team",
    "github": "below-nominal",
    "url": "https://belownominal.com"
  },
  "license": "CC-BY-4.0",
  "category": "infrastructure",
  "tags": [
    "infrastructure",
    "pipes",
    "psx",
    "low-poly",
    "retro-sci-fi"
  ],
  "compatibility": {
    "engine_version": ">=1.5.0",
    "blender_version": ">=4.2"
  },
  "parameters": [
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": 42,
      "group": "Rendimiento",
      "min": 0,
      "max": 2147483647,
      "step": 1
    },
    {
      "key": "target_tri_budget",
      "label": "Target Tri Budget",
      "type": "int",
      "default": 400,
      "group": "Rendimiento",
      "min": 0,
      "step": 1
    },
    {
      "key": "name",
      "label": "Name",
      "type": "string",
      "default": "pipe_assembly",
      "group": "General"
    },
    {
      "key": "wear_level",
      "label": "Wear Level",
      "type": "float",
      "default": 0.5,
      "group": "Materiales",
      "min": 0.0,
      "max": 1.0,
      "step": 0.05
    },
    {
      "key": "add_collision_mesh",
      "label": "Add Collision Mesh",
      "type": "boolean",
      "default": false,
      "group": "General"
    },
    {
      "key": "collision_type",
      "label": "Collision Type",
      "type": "string",
      "default": "box",
      "group": "General"
    },
    {
      "key": "collision_suffix",
      "label": "Collision Suffix",
      "type": "string",
      "default": "-convcolonly",
      "group": "General"
    },
    {
      "key": "pivot_rule",
      "label": "Pivot Rule",
      "type": "string",
      "default": "floor_center",
      "group": "General"
    },
    {
      "key": "export_subcomponents",
      "label": "Export Subcomponents",
      "type": "boolean",
      "default": false,
      "group": "General"
    },
    {
      "key": "palette_name",
      "label": "Palette Name",
      "type": "enum",
      "default": "industrial_hazard",
      "group": "Materiales",
      "options": [
        {
          "value": "industrial_hazard",
          "label": "Industrial Hazard"
        },
        {
          "value": "medbay_clean",
          "label": "Medbay Clean"
        },
        {
          "value": "command_bridge",
          "label": "Command Bridge"
        },
        {
          "value": "habitation_worn",
          "label": "Habitation Worn"
        },
        {
          "value": "derelict_decay",
          "label": "Derelict Decay"
        }
      ]
    },
    {
      "key": "emission_scale",
      "label": "Emission Scale",
      "type": "float",
      "default": 1.0,
      "group": "General",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "extra_params",
      "label": "Extra Params",
      "type": "string",
      "default": null,
      "group": "General"
    },
    {
      "key": "pipe_type",
      "label": "Pipe Type",
      "type": "string",
      "default": "valve_assembly",
      "group": "General"
    },
    {
      "key": "radius",
      "label": "Radius",
      "type": "float",
      "default": 0.09,
      "group": "Dimensiones",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "length",
      "label": "Length",
      "type": "float",
      "default": 1.8,
      "group": "Dimensiones",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "valve_type",
      "label": "Valve Type",
      "type": "string",
      "default": "handwheel_red",
      "group": "General"
    },
    {
      "key": "has_pressure_gauge",
      "label": "Has Pressure Gauge",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "has_insulation_layer",
      "label": "Has Insulation Layer",
      "type": "boolean",
      "default": false,
      "group": "General"
    },
    {
      "key": "has_flange_couplings",
      "label": "Has Flange Couplings",
      "type": "boolean",
      "default": true,
      "group": "General"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "Estándar / Por Defecto",
      "description": "Configuración base del generador",
      "values": {
        "seed": 42,
        "target_tri_budget": 400,
        "name": "pipe_assembly",
        "wear_level": 0.5,
        "add_collision_mesh": false,
        "collision_type": "box",
        "collision_suffix": "-convcolonly",
        "pivot_rule": "floor_center",
        "export_subcomponents": false,
        "palette_name": "industrial_hazard",
        "emission_scale": 1.0,
        "pipe_type": "valve_assembly",
        "radius": 0.09,
        "length": 1.8,
        "valve_type": "handwheel_red",
        "has_pressure_gauge": true,
        "has_insulation_layer": false,
        "has_flange_couplings": true
      }
    }
  ],
  "export_capabilities": {
    "supports_collision": true,
    "default_collision_suffix": "-convcolonly",
    "supports_sockets": true
  }
}