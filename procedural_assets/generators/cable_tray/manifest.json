{
  "id": "below_nominal.infrastructure.cable_tray",
  "name": "Bandeja Portacables Industrial",
  "version": "1.0.0",
  "description": "Canalización portacables suspendida tipo escalera o canastilla ranurada para distribución de cableado eléctrico, de fibra y potencia a lo largo de galerías y techos técnicos de la estación espacial. Perfiles laterales en C galvanizados, peldaños tubulares de sujeción, mazos de cableado de alta y baja tensión con bridas de precinto, tirantes roscados de anclaje superior a vigas y tramos opcionales de tapa de protección contra esquirlas.",
  "author": {
    "name": "ModelCoder Core Team",
    "github": "FrancisCuarto"
  },
  "license": "CC-BY-4.0",
  "category": "infrastructure",
  "tags": [
    "psx",
    "low-poly",
    "cable_tray",
    "wiring",
    "ceiling",
    "ladder",
    "corridor",
    "infrastructure",
    "below_nominal"
  ],
