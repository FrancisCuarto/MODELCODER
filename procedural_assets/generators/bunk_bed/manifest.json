      "label": "Ladder Position",
      "type": "string",
      "default": "front_right",
      "group": "General"
    },
    {
      "key": "upper_guardrail",
      "label": "Upper Guardrail",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "lower_bunk_state",
      "label": "Lower Bunk State",
      "type": "string",
      "default": "made",
      "group": "General"
    },
    {
      "key": "upper_bunk_state",
      "label": "Upper Bunk State",
      "type": "string",
      "default": "made",
      "group": "General"
    },
    {
      "key": "has_reading_lights",
      "label": "Has Reading Lights",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "has_storage_lockers",
      "label": "Has Storage Lockers",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "has_curtains",
      "label": "Has Curtains",
      "type": "boolean",
      "default": false,
      "group": "General"
    },
    {
      "key": "blanket_color",
      "label": "Blanket Color",
      "type": "string",
      "default": "station_gray",
      "group": "General"
    }
