  "presets": [
    {
      "id": "default",
      "name": "Estándar / Por Defecto",
      "description": "Configuración base del generador",
      "values": {
        "seed": 42,
        "target_tri_budget": 480,
        "name": "asset",
        "wear_level": 0.5,
        "add_collision_mesh": false,
        "collision_type": "box",
        "collision_suffix": "-convcolonly",
        "pivot_rule": "floor_center",
        "export_subcomponents": false,
        "palette_name": "industrial_hazard",
        "emission_scale": 1,
        "frame_style": "tubular_metal",
        "width": 1.05,
        "length": 2.05,
        "height": 2.05,
        "ladder_position": "front_right",
        "upper_guardrail": true,
        "lower_bunk_state": "made",
        "upper_bunk_state": "made",
        "has_reading_lights": true,
        "has_storage_lockers": true,
        "has_curtains": false,
        "blanket_color": "station_gray"
      }
    }
  ],
  "export_capabilities": {
    "supports_collision": true,
    "default_collision_suffix": "-convcolonly",
    "supports_sockets": false
  }
}
