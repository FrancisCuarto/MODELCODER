{
  "$schema": "https://raw.githubusercontent.com/usuario/modelcoder-community/main/schemas/generator-v1.json",
  "id": "below_nominal.furniture.bunk_bed",
  "version": "1.0.0",
  "name": "Cama Litera Modular",
  "description": "Litera metálica de dos niveles con escalera de acceso frontal. Podés ajustar sus medidas, nivel de desgaste y paleta de color para descargar en formato GLB.",
  "author": {
    "name": "Below Nominal Team",
    "github": "below-nominal",
    "url": "https://belownominal.com"
  },
  "license": "CC-BY-4.0",
  "category": "furniture",
  "tags": [
    "furniture",
    "bunk_bed",
    "psx",
    "low-poly",
    "retro-sci-fi"
  ],
  "compatibility": {
    "engine_version": ">=1.5.0",
    "blender_version": ">=4.2"
  },
  "parameters": [
    {
      "key": "seed",
      "label": "Semilla Aleatoria",
      "type": "seed",
      "default": 42,
      "group": "Rendimiento",
      "min": 0,
      "max": 2147483647,
      "step": 1
    },
    {
      "key": "target_tri_budget",
      "label": "Presupuesto de Triángulos",
      "type": "int",
      "default": 480,
      "group": "Rendimiento",
      "min": 0,
      "step": 1
    },
    {
      "key": "name",
      "label": "Nombre de Instancia",
      "type": "string",
      "default": "asset",
      "group": "General"
    },
    {
      "key": "wear_level",
      "label": "Nivel de Desgaste",
      "type": "float",
      "default": 0.5,
      "group": "Materiales",
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "key": "add_collision_mesh",
      "label": "Generar Colisión",
      "type": "boolean",
      "default": false,
      "group": "Opciones de Exportación"
    },
    {
      "key": "collision_type",
      "label": "Tipo de Colisión",
      "type": "string",
      "default": "box",
      "group": "Opciones de Exportación"
    },
    {
      "key": "collision_suffix",
      "label": "Sufijo de Colisión",
      "type": "string",
      "default": "-convcolonly",
      "group": "Opciones de Exportación"
    },
    {
      "key": "pivot_rule",
      "label": "Regla de Pivote",
      "type": "string",
      "default": "floor_center",
      "group": "Opciones de Exportación"
    },
    {
      "key": "export_subcomponents",
      "label": "Exportar Subcomponentes",
      "type": "boolean",
      "default": false,
      "group": "Opciones de Exportación"
