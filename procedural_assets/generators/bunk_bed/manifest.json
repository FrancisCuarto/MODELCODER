      "label": "Paleta de Color",
      "type": "enum",
      "default": "industrial_hazard",
      "group": "Materiales",
      "options": [
        {
          "value": "industrial_hazard",
          "label": "Industrial Hazard"
        },
        {
          "value": "medbay_clean",
          "label": "Medbay Clean"
        },
        {
          "value": "command_bridge",
          "label": "Command Bridge"
        },
        {
          "value": "habitation_worn",
          "label": "Habitation Worn"
        },
        {
          "value": "derelict_decay",
          "label": "Derelict Decay"
        }
      ]
    },
    {
      "key": "emission_scale",
      "label": "Intensidad de Emisión",
      "type": "float",
      "default": 1,
      "group": "Materiales",
      "min": 0,
      "step": 0.05
    },
    {
      "key": "extra_params",
      "label": "Extra Params",
      "type": "string",
      "default": null,
      "group": "General"
    },
    {
      "key": "frame_style",
      "label": "Frame Style",
      "type": "string",
      "default": "tubular_metal",
      "group": "General"
    },
    {
      "key": "width",
      "label": "Ancho (m)",
      "type": "float",
      "default": 1.05,
      "group": "Dimensiones",
      "min": 0,
      "step": 0.05
