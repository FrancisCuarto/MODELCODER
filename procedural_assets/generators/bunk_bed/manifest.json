{
  "$schema": "https://raw.githubusercontent.com/usuario/modelcoder-community/main/schemas/generator-v1.json",
  "id": "below_nominal.furniture.bunk_bed",
  "version": "1.0.0",
  "name": "Bunk Bed",
  "description": "Generador procedural paramétrico de bunk bed para Below Nominal.",
  "author": {
    "name": "Below Nominal Team",
    "github": "below-nominal",
    "url": "https://belownominal.com"
  },
  "license": "CC-BY-4.0",
  "category": "furniture",
  "tags": [
    "furniture",
    "bunk_bed",
    "psx",
    "low-poly",
    "retro-sci-fi"
  ],
  "compatibility": {
    "engine_version": ">=1.5.0",
    "blender_version": ">=4.2"
  },
  "parameters": [
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": 42,
      "group": "Rendimiento",
      "min": 0,
      "max": 2147483647,
      "step": 1
    },
    {
      "key": "target_tri_budget",
      "label": "Target Tri Budget",
      "type": "int",
      "default": 480,
      "group": "Rendimiento",
      "min": 0,
      "step": 1
    },
    {
      "key": "name",
      "label": "Name",
      "type": "string",
      "default": "asset",
      "group": "General"
    },
    {
      "key": "wear_level",
      "label": "Wear Level",
      "type": "float",
      "default": 0.5,
      "group": "Materiales",
      "min": 0.0,
      "max": 1.0,
      "step": 0.05
    },
    {
      "key": "add_collision_mesh",
      "label": "Add Collision Mesh",
      "type": "boolean",
      "default": false,
      "group": "General"
    },
    {
      "key": "collision_type",
      "label": "Collision Type",
      "type": "string",
      "default": "box",
      "group": "General"
    },
    {
      "key": "collision_suffix",
      "label": "Collision Suffix",
      "type": "string",
      "default": "-convcolonly",
      "group": "General"
    },
    {
      "key": "pivot_rule",
      "label": "Pivot Rule",
      "type": "string",
      "default": "floor_center",
      "group": "General"
    },
    {
      "key": "export_subcomponents",
      "label": "Export Subcomponents",
      "type": "boolean",
      "default": false,
      "group": "General"
    },
    {
      "key": "palette_name",
      "label": "Palette Name",
      "type": "enum",
      "default": "industrial_hazard",
      "group": "Materiales",
      "options": [
        {
          "value": "industrial_hazard",
          "label": "Industrial Hazard"
        },
        {
          "value": "medbay_clean",
          "label": "Medbay Clean"
        },
        {
          "value": "command_bridge",
          "label": "Command Bridge"
        },
        {
          "value": "habitation_worn",
          "label": "Habitation Worn"
        },
        {
          "value": "derelict_decay",
          "label": "Derelict Decay"
        }
      ]
    },
    {
      "key": "emission_scale",
      "label": "Emission Scale",
      "type": "float",
      "default": 1.0,
      "group": "General",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "extra_params",
      "label": "Extra Params",
      "type": "string",
      "default": null,
      "group": "General"
    },
    {
      "key": "frame_style",
      "label": "Frame Style",
      "type": "string",
      "default": "tubular_metal",
      "group": "General"
    },
    {
      "key": "width",
      "label": "Width",
      "type": "float",
      "default": 1.05,
      "group": "Dimensiones",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "length",
      "label": "Length",
      "type": "float",
      "default": 2.05,
      "group": "Dimensiones",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "height",
      "label": "Height",
      "type": "float",
      "default": 2.05,
      "group": "Dimensiones",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "ladder_position",
      "label": "Ladder Position",
      "type": "string",
      "default": "front_right",
      "group": "General"
    },
    {
      "key": "upper_guardrail",
      "label": "Upper Guardrail",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "lower_bunk_state",
      "label": "Lower Bunk State",
      "type": "string",
      "default": "made",
      "group": "General"
    },
    {
      "key": "upper_bunk_state",
      "label": "Upper Bunk State",
      "type": "string",
      "default": "made",
      "group": "General"
    },
    {
      "key": "has_reading_lights",
      "label": "Has Reading Lights",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "has_storage_lockers",
      "label": "Has Storage Lockers",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "has_curtains",
      "label": "Has Curtains",
      "type": "boolean",
      "default": false,
      "group": "General"
    },
    {
      "key": "blanket_color",
      "label": "Blanket Color",
      "type": "string",
      "default": "station_gray",
      "group": "General"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "Estándar / Por Defecto",
      "description": "Configuración base del generador",
      "values": {
        "seed": 42,
        "target_tri_budget": 480,
        "name": "asset",
        "wear_level": 0.5,
        "add_collision_mesh": false,
        "collision_type": "box",
        "collision_suffix": "-convcolonly",
        "pivot_rule": "floor_center",
        "export_subcomponents": false,
        "palette_name": "industrial_hazard",
        "emission_scale": 1.0,
        "frame_style": "tubular_metal",
        "width": 1.05,
        "length": 2.05,
        "height": 2.05,
        "ladder_position": "front_right",
        "upper_guardrail": true,
        "lower_bunk_state": "made",
        "upper_bunk_state": "made",
        "has_reading_lights": true,
        "has_storage_lockers": true,
        "has_curtains": false,
        "blanket_color": "station_gray"
      }
    }
  ],
  "export_capabilities": {
    "supports_collision": true,
    "default_collision_suffix": "-convcolonly",
    "supports_sockets": false
  }
}