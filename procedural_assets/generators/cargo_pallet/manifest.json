{
  "id": "below_nominal.cargo.cargo_pallet",
  "name": "Palé Industrial de Carga 4 Vías",
  "version": "1.0.0",
  "description": "Base de estiba y transporte logístico de 4 entradas para carretillas elevadoras y transpaletas de la estación. Fabricado en polímero técnico reciclado de alta densidad o estructura de acero tubular reforzado, tablillas superiores antideslizantes con biselado de entrada para horquillas, 9 tacos esquineros macizos, anclajes perimetrales para cinchas tensoras de amarre y carga opcional estibada.",
  "author": {
    "name": "ModelCoder Core Team",
    "github": "FrancisCuarto"
  },
  "license": "CC-BY-4.0",
  "category": "cargo",
  "tags": [
    "psx",
    "low-poly",
    "pallet",
    "cargo",
    "freight",
    "warehouse",
    "logistics",
    "below_nominal"
  ],
  "parameters": [
    {
      "key": "length",
      "label": "Largo de Plataforma (m)",
      "type": "float",
      "default": 1.20,
      "min": 0.80,
      "max": 1.60,
      "step": 0.05,
      "group": "Dimensiones"
    },
    {
      "key": "width",
      "label": "Ancho de Plataforma (m)",
      "type": "float",
      "default": 1.00,
      "min": 0.80,
      "max": 1.40,
      "step": 0.05,
      "group": "Dimensiones"
    },
    {
      "key": "deck_style",
      "label": "Tipo de Tablero",
      "type": "enum",
      "options": [
        {"value": "slotted_deck", "label": "Tablillas Ranuradas"},
        {"value": "solid_flat", "label": "Tablero Macizo"},
        {"value": "reinforced_steel", "label": "Acero Reforzado"}
      ],
      "default": "slotted_deck",
      "group": "Estructura"
    },
    {
      "key": "has_cargo_payload",
      "label": "Carga Estibada Sobre Plataforma",
      "type": "bool",
      "default": false,
      "group": "Carga"
    },
    {
      "key": "has_strap_down",
      "label": "Cinchas Tensoras con Trinquetes",
      "type": "bool",
      "default": true,
      "group": "Carga"
    },
    {
      "key": "pallet_condition",
      "label": "Condición Estructural",
      "type": "enum",
      "options": [
        {"value": "nominal", "label": "Nominal"},
        {"value": "damaged_corner", "label": "Esquina Dañada"},
        {"value": "chemical_stained", "label": "Manchado Químico"}
      ],
      "default": "nominal",
      "group": "Estado"
    },
    {
      "key": "wear_level",
      "label": "Desgaste y Suciedad",
      "type": "float",
      "default": 0.50,
      "min": 0.0,
      "max": 1.0,
      "step": 0.05,
      "group": "Material"
    }
  ],
  "presets": [
    {
      "id": "empty_warehouse",
      "label": "Estiba Vacía",
      "description": "Palé de tablillas ranurado listo para carga en almacén.",
      "values": {
        "length": 1.20,
        "width": 1.00,
        "deck_style": "slotted_deck",
        "has_cargo_payload": false,
        "has_strap_down": false,
        "pallet_condition": "nominal",
        "wear_level": 0.35
      }
    },
    {
      "id": "loaded_secured",
      "label": "Carga Asegurada",
      "description": "Palé con cajas de raciones sintéticas flejadas con cinchas de seguridad.",
      "values": {
        "length": 1.20,
        "width": 1.00,
        "deck_style": "slotted_deck",
        "has_cargo_payload": true,
        "has_strap_down": true,
        "pallet_condition": "nominal",
        "wear_level": 0.40
      }
    },
    {
      "id": "damaged_impact",
      "label": "Logística Forzada",
      "description": "Palé reforzado de acero con esquina dañada por impacto de transpaleta.",
      "values": {
        "length": 1.20,
        "width": 1.00,
        "deck_style": "reinforced_steel",
        "has_cargo_payload": false,
        "has_strap_down": true,
        "pallet_condition": "damaged_corner",
        "wear_level": 0.70
      }
    }
  ],
  "export_capabilities": {
    "supports_collision": true,
    "default_collision_suffix": "-convcolonly"
  }
}
