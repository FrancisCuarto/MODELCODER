{
  "$schema": "https://raw.githubusercontent.com/usuario/modelcoder-community/main/schemas/generator-v1.json",
  "id": "below_nominal.architecture.station_room",
  "version": "1.0.0",
  "name": "Station Room",
  "description": "Generador procedural paramétrico de station room para Below Nominal.",
  "author": {
    "name": "Below Nominal Team",
    "github": "below-nominal",
    "url": "https://belownominal.com"
  },
  "license": "CC-BY-4.0",
  "category": "architecture",
  "tags": [
    "architecture",
    "station_room",
    "psx",
    "low-poly",
    "retro-sci-fi"
  ],
  "compatibility": {
    "engine_version": ">=1.5.0",
    "blender_version": ">=4.2"
  },
  "parameters": [
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": 42,
      "group": "Rendimiento",
      "min": 0,
      "max": 2147483647,
      "step": 1
    },
    {
      "key": "target_tri_budget",
      "label": "Target Tri Budget",
      "type": "int",
      "default": 750,
      "group": "Rendimiento",
      "min": 0,
      "step": 1
    },
    {
      "key": "name",
      "label": "Name",
      "type": "string",
      "default": "asset",
      "group": "General"
    },
    {
      "key": "wear_level",
      "label": "Wear Level",
      "type": "float",
      "default": 0.5,
      "group": "Materiales",
      "min": 0.0,
      "max": 1.0,
      "step": 0.05
    },
    {
      "key": "add_collision_mesh",
      "label": "Add Collision Mesh",
      "type": "boolean",
      "default": false,
      "group": "General"
    },
    {
