      "default": true,
      "group": "General"
    },
    {
      "key": "door_south",
      "label": "Door South",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "door_east",
      "label": "Door East",
      "type": "boolean",
      "default": false,
      "group": "General"
    },
    {
      "key": "door_west",
      "label": "Door West",
