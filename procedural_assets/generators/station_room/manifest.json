        "height": 3.4,
        "door_north": true,
        "door_south": true,
        "door_east": false,
        "door_west": false,
        "doorway_width": 2.0,
        "doorway_height": 2.4,
        "pillar_layout": "perimeter_buttresses",
        "floor_elevation": "flat",
        "has_observation_window": false,
        "has_overhead_gantry": false,
        "has_floor_drain": false,
        "lighting_color": "clean_white"
