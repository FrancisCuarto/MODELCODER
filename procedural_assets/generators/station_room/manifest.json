      "default": "flat",
      "group": "General"
    },
    {
      "key": "has_observation_window",
      "label": "Has Observation Window",
      "type": "boolean",
      "default": false,
      "group": "General"
    },
    {
      "key": "has_overhead_gantry",
      "label": "Has Overhead Gantry",
      "type": "boolean",
      "default": false,
      "group": "General"
    },
    {
      "key": "has_floor_drain",
      "label": "Has Floor Drain",
      "type": "boolean",
      "default": false,
      "group": "General"
    },
    {
      "key": "lighting_color",
      "label": "Lighting Color",
      "type": "string",
      "default": "clean_white",
      "group": "General"
    },
    {
      "key": "doorway_sockets",
      "label": "Doorway Sockets",
      "type": "string",
      "default": null,
      "group": "General"
    }
