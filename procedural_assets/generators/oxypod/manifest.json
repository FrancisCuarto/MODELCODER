{
  "$schema": "https://raw.githubusercontent.com/usuario/modelcoder-community/main/schemas/generator-v1.json",
  "id": "below_nominal.medical.oxypod",
  "version": "1.0.0",
  "name": "Oxypod",
  "description": "Generador procedural paramétrico de oxypod para Below Nominal.",
  "author": {
    "name": "Below Nominal Team",
    "github": "below-nominal",
    "url": "https://belownominal.com"
  },
  "license": "CC-BY-4.0",
  "category": "medical",
  "tags": [
    "medical",
    "oxypod",
    "psx",
    "low-poly",
    "retro-sci-fi"
  ],
  "compatibility": {
    "engine_version": ">=1.5.0",
    "blender_version": ">=4.2"
  },
  "parameters": [
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": 42,
      "group": "Rendimiento",
      "min": 0,
      "max": 2147483647,
      "step": 1
    },
    {
      "key": "target_tri_budget",
      "label": "Target Tri Budget",
      "type": "int",
      "default": 440,
      "group": "Rendimiento",
      "min": 0,
      "step": 1
    },
    {
      "key": "name",
      "label": "Name",
      "type": "string",
      "default": "oxypod",
      "group": "General"
    },
    {
      "key": "wear_level",
      "label": "Wear Level",
      "type": "float",
      "default": 0.5,
      "group": "Materiales",
      "min": 0.0,
      "max": 1.0,
      "step": 0.05
    },
    {
      "key": "add_collision_mesh",
      "label": "Add Collision Mesh",
      "type": "boolean",
      "default": false,
      "group": "General"
    },
    {
      "key": "collision_type",
      "label": "Collision Type",
      "type": "string",
      "default": "box",
      "group": "General"
    },
    {
      "key": "collision_suffix",
      "label": "Collision Suffix",
      "type": "string",
      "default": "-convcolonly",
      "group": "General"
    },
    {
