      "label": "Pivot Rule",
      "type": "string",
      "default": "floor_center",
      "group": "General"
    },
    {
      "key": "export_subcomponents",
      "label": "Export Subcomponents",
      "type": "boolean",
      "default": false,
      "group": "General"
    },
    {
      "key": "palette_name",
      "label": "Palette Name",
      "type": "enum",
      "default": "industrial_hazard",
      "group": "Materiales",
      "options": [
        {
          "value": "industrial_hazard",
          "label": "Industrial Hazard"
        },
        {
          "value": "medbay_clean",
          "label": "Medbay Clean"
        },
        {
          "value": "command_bridge",
          "label": "Command Bridge"
        },
        {
          "value": "habitation_worn",
          "label": "Habitation Worn"
        },
        {
          "value": "derelict_decay",
          "label": "Derelict Decay"
        }
      ]
    },
    {
      "key": "emission_scale",
      "label": "Emission Scale",
      "type": "float",
      "default": 1.0,
      "group": "General",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "extra_params",
      "label": "Extra Params",
      "type": "string",
      "default": null,
      "group": "General"
    },
    {
      "key": "station_type",
      "label": "Station Type",
      "type": "string",
      "default": "wall_station",
      "group": "General"
    },
    {
      "key": "tank_height",
      "label": "Tank Height",
      "type": "float",
      "default": 0.95,
      "group": "General",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "tank_radius",
      "label": "Tank Radius",
      "type": "float",
      "default": 0.18,
      "group": "General",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "oxygen_level",
      "label": "Oxygen Level",
      "type": "float",
      "default": 0.85,
      "group": "General",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "has_gauge_sight",
      "label": "Has Gauge Sight",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "has_protective_cage",
      "label": "Has Protective Cage",
      "type": "boolean",
      "default": false,
      "group": "General"
    },
    {
      "key": "has_mask_dock",
      "label": "Has Mask Dock",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "has_coiled_hose",
      "label": "Has Coiled Hose",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "has_dual_gauges",
      "label": "Has Dual Gauges",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "beacon_state",
      "label": "Beacon State",
      "type": "string",
      "default": "cyan",
      "group": "General"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "Estándar / Por Defecto",
      "description": "Configuración base del generador",
      "values": {
        "seed": 42,
        "target_tri_budget": 440,
        "name": "oxypod",
        "wear_level": 0.5,
        "add_collision_mesh": false,
        "collision_type": "box",
        "collision_suffix": "-convcolonly",
        "pivot_rule": "floor_center",
        "export_subcomponents": false,
        "palette_name": "industrial_hazard",
        "emission_scale": 1.0,
        "station_type": "wall_station",
        "tank_height": 0.95,
        "tank_radius": 0.18,
        "oxygen_level": 0.85,
        "has_gauge_sight": true,
        "has_protective_cage": false,
        "has_mask_dock": true,
        "has_coiled_hose": true,
        "has_dual_gauges": true,
        "beacon_state": "cyan"
      }
    }
  ],
  "export_capabilities": {
    "supports_collision": true,
    "default_collision_suffix": "-convcolonly",
    "supports_sockets": false
  }
}