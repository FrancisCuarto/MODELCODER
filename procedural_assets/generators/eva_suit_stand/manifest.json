      "options": [
        { "value": "relaxed", "label": "Brazos Relajados (Vertical)" },
        { "value": "extended", "label": "Brazos Adelantados (Inspección)" },
        { "value": "t_pose", "label": "Postura en T (Calibración)" }
      ],
      "group": "Mecanismo"
