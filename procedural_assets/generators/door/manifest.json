{
  "$schema": "https://raw.githubusercontent.com/usuario/modelcoder-community/main/schemas/generator-v1.json",
  "id": "below_nominal.architecture.door",
  "version": "1.0.0",
  "name": "Puerta Corrediza Industrial",
  "description": "Puerta corrediza automatizada para mamparas y accesos entre sectores. Podés ajustar el ancho, alto, franjas de peligro y luces de estado para descargar en formato GLB.",
  "author": {
    "name": "Below Nominal Team",
    "github": "below-nominal",
    "url": "https://belownominal.com"
  },
  "license": "CC-BY-4.0",
  "category": "architecture",
  "tags": [
    "architecture",
    "door",
    "psx",
    "low-poly",
    "retro-sci-fi"
  ],
  "compatibility": {
    "engine_version": ">=1.5.0",
    "blender_version": ">=4.2"
  },
  "parameters": [
    {
      "key": "seed",
      "label": "Semilla Aleatoria",
      "type": "seed",
      "default": 42,
      "group": "Rendimiento",
      "min": 0,
      "max": 2147483647,
      "step": 1
    },
    {
      "key": "target_tri_budget",
      "label": "Presupuesto de Triángulos",
      "type": "int",
      "default": 480,
      "group": "Rendimiento",
      "min": 0,
      "step": 1
    },
    {
      "key": "name",
      "label": "Nombre de Instancia",
      "type": "string",
      "default": "station_door",
      "group": "General"
    },
    {
      "key": "wear_level",
      "label": "Nivel de Desgaste",
      "type": "float",
      "default": 0.5,
      "group": "Materiales",
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "key": "add_collision_mesh",
      "label": "Generar Colisión",
      "type": "boolean",
      "default": false,
      "group": "Opciones de Exportación"
    },
    {
      "key": "collision_type",
      "label": "Tipo de Colisión",
      "type": "string",
      "default": "box",
      "group": "Opciones de Exportación"
    },
    {
      "key": "collision_suffix",
      "label": "Sufijo de Colisión",
      "type": "string",
      "default": "-convcolonly",
      "group": "Opciones de Exportación"
    },
    {
      "key": "pivot_rule",
      "label": "Regla de Pivote",
      "type": "string",
      "default": "floor_center",
      "group": "Opciones de Exportación"
    },
    {
      "key": "export_subcomponents",
      "label": "Exportar Subcomponentes",
      "type": "boolean",
      "default": false,
      "group": "Opciones de Exportación"
    },
    {
      "key": "palette_name",
      "label": "Paleta de Color",
      "type": "enum",
      "default": "industrial_hazard",
      "group": "Materiales",
      "options": [
        {
          "value": "industrial_hazard",
          "label": "Industrial Hazard"
        },
        {
          "value": "medbay_clean",
          "label": "Medbay Clean"
        },
        {
          "value": "command_bridge",
          "label": "Command Bridge"
        },
        {
          "value": "habitation_worn",
          "label": "Habitation Worn"
        },
        {
          "value": "derelict_decay",
          "label": "Derelict Decay"
        }
      ]
    },
    {
      "key": "emission_scale",
      "label": "Intensidad de Emisión",
      "type": "float",
      "default": 1,
      "group": "Materiales",
      "min": 0,
      "step": 0.05
    },
    {
      "key": "extra_params",
      "label": "Extra Params",
      "type": "string",
      "default": null,
      "group": "General"
    },
    {
      "key": "door_type",
      "label": "Door Type",
      "type": "string",
      "default": "standard_sliding",
      "group": "General"
    },
    {
      "key": "width",
      "label": "Ancho (m)",
      "type": "float",
      "default": 2,
      "group": "Dimensiones",
      "min": 0,
      "step": 0.05
    },
    {
      "key": "height",
      "label": "Alto (m)",
      "type": "float",
      "default": 2.4,
      "group": "Dimensiones",
      "min": 0,
      "step": 0.05
    },
    {
      "key": "frame_depth",
      "label": "Frame Depth",
      "type": "float",
      "default": 0.35,
      "group": "General",
      "min": 0,
      "step": 0.05
    },
    {
      "key": "frame_thickness",
      "label": "Frame Thickness",
      "type": "float",
      "default": 0.18,
      "group": "General",
      "min": 0,
      "step": 0.05
    },
    {
      "key": "open_ratio",
      "label": "Open Ratio",
      "type": "float",
      "default": 0,
      "group": "General",
      "min": 0,
      "step": 0.05
    },
    {
      "key": "access_interface",
      "label": "Access Interface",
      "type": "string",
      "default": "card_reader",
      "group": "General"
    },
    {
      "key": "has_reinforced_window",
      "label": "Has Reinforced Window",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "has_hazard_stripes",
      "label": "Has Hazard Stripes",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "has_hydraulic_pistons",
      "label": "Has Hydraulic Pistons",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "has_status_light",
      "label": "Has Status Light",
      "type": "boolean",
      "default": true,
      "group": "General"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "Estándar / Por Defecto",
      "description": "Configuración base del generador",
      "values": {
        "seed": 42,
        "target_tri_budget": 480,
        "name": "station_door",
        "wear_level": 0.5,
        "add_collision_mesh": false,
        "collision_type": "box",
        "collision_suffix": "-convcolonly",
        "pivot_rule": "floor_center",
        "export_subcomponents": false,
        "palette_name": "industrial_hazard",
        "emission_scale": 1,
        "door_type": "standard_sliding",
        "width": 2,
        "height": 2.4,
        "frame_depth": 0.35,
        "frame_thickness": 0.18,
        "open_ratio": 0,
        "access_interface": "card_reader",
        "has_reinforced_window": true,
        "has_hazard_stripes": true,
        "has_hydraulic_pistons": true,
        "has_status_light": true
      }
    }
  ],
  "export_capabilities": {
    "supports_collision": true,
    "default_collision_suffix": "-convcolonly",
    "supports_sockets": false
  }
}
