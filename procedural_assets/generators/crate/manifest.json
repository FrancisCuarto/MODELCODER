{
  "$schema": "https://raw.githubusercontent.com/usuario/modelcoder-community/main/schemas/generator-v1.json",
  "id": "below_nominal.infrastructure.crate",
  "version": "1.0.0",
  "name": "Crate",
  "description": "Generador procedural paramétrico de crate para Below Nominal.",
  "author": {
    "name": "Below Nominal Team",
    "github": "below-nominal",
    "url": "https://belownominal.com"
  },
  "license": "CC-BY-4.0",
  "category": "infrastructure",
  "tags": [
    "infrastructure",
    "crate",
    "psx",
    "low-poly",
    "retro-sci-fi"
  ],
  "compatibility": {
    "engine_version": ">=1.5.0",
    "blender_version": ">=4.2"
  },
  "parameters": [
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": 42,
      "group": "Rendimiento",
      "min": 0,
      "max": 2147483647,
      "step": 1
    },
    {
      "key": "target_tri_budget",
      "label": "Target Tri Budget",
      "type": "int",
      "default": 340,
      "group": "Rendimiento",
      "min": 0,
      "step": 1
    },
    {
      "key": "name",
      "label": "Name",
      "type": "string",
      "default": "crate",
      "group": "General"
    },
    {
      "key": "wear_level",
      "label": "Wear Level",
      "type": "float",
      "default": 0.5,
      "group": "Materiales",
      "min": 0.0,
      "max": 1.0,
      "step": 0.05
    },
    {
      "key": "add_collision_mesh",
      "label": "Add Collision Mesh",
      "type": "boolean",
      "default": false,
      "group": "General"
    },
    {
      "key": "collision_type",
      "label": "Collision Type",
      "type": "string",
      "default": "box",
      "group": "General"
    },
    {
      "key": "collision_suffix",
      "label": "Collision Suffix",
      "type": "string",
      "default": "-convcolonly",
      "group": "General"
    },
    {
      "key": "pivot_rule",
      "label": "Pivot Rule",
      "type": "string",
      "default": "floor_center",
      "group": "General"
    },
    {
      "key": "export_subcomponents",
      "label": "Export Subcomponents",
      "type": "boolean",
      "default": false,
      "group": "General"
    },
    {
      "key": "palette_name",
      "label": "Palette Name",
      "type": "enum",
      "default": "industrial_hazard",
      "group": "Materiales",
      "options": [
        {
          "value": "industrial_hazard",
          "label": "Industrial Hazard"
        },
        {
          "value": "medbay_clean",
          "label": "Medbay Clean"
        },
        {
          "value": "command_bridge",
          "label": "Command Bridge"
        },
        {
          "value": "habitation_worn",
          "label": "Habitation Worn"
        },
        {
          "value": "derelict_decay",
          "label": "Derelict Decay"
        }
      ]
    },
    {
      "key": "emission_scale",
      "label": "Emission Scale",
      "type": "float",
      "default": 1.0,
      "group": "General",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "extra_params",
      "label": "Extra Params",
      "type": "string",
      "default": null,
      "group": "General"
    },
    {
      "key": "crate_type",
      "label": "Crate Type",
      "type": "string",
      "default": "cargo_chest",
      "group": "General"
    },
    {
      "key": "lid_state",
      "label": "Lid State",
      "type": "string",
      "default": "closed",
      "group": "General"
    },
    {
      "key": "width",
      "label": "Width",
      "type": "float",
      "default": 0.8,
      "group": "Dimensiones",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "height",
      "label": "Height",
      "type": "float",
      "default": 0.65,
      "group": "Dimensiones",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "depth",
      "label": "Depth",
      "type": "float",
      "default": 0.6,
      "group": "Dimensiones",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "has_handles",
      "label": "Has Handles",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "has_reinforced_corners",
      "label": "Has Reinforced Corners",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "has_latches",
      "label": "Has Latches",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "has_hazard_marking",
      "label": "Has Hazard Marking",
      "type": "boolean",
      "default": true,
      "group": "General"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "Estándar / Por Defecto",
      "description": "Configuración base del generador",
      "values": {
        "seed": 42,
        "target_tri_budget": 340,
        "name": "crate",
        "wear_level": 0.5,
        "add_collision_mesh": false,
        "collision_type": "box",
        "collision_suffix": "-convcolonly",
        "pivot_rule": "floor_center",
        "export_subcomponents": false,
        "palette_name": "industrial_hazard",
        "emission_scale": 1.0,
        "crate_type": "cargo_chest",
        "lid_state": "closed",
        "width": 0.8,
        "height": 0.65,
        "depth": 0.6,
        "has_handles": true,
        "has_reinforced_corners": true,
        "has_latches": true,
        "has_hazard_marking": true
      }
    }
  ],
  "export_capabilities": {
    "supports_collision": true,
    "default_collision_suffix": "-convcolonly",
    "supports_sockets": false
  }
}