{
  "id": "below_nominal.command.nav_console",
  "name": "Consola de Navegación Orbital",
  "description": "Puesto de pilotaje y telemetría espacial con panel angular de pantallas CRT, mandos HOTAS de empuje y joystick, botoneras mecánicas y zócalo con reposapiés.",
  "category": "command",
  "tags": ["nav_console", "bridge", "cockpit", "flight", "command", "telemetry", "retro"],
  "author": {
    "name": "ModelCoder Core Team",
    "github": "FrancisCuarto"
  },
  "license": "CC-BY-4.0",
  "version": "1.0.0",
  "parameters": [
    {
      "key": "width",
      "label": "Ancho de Consola (m)",
      "type": "float",
      "default": 1.4,
      "min": 1.0,
      "max": 2.2,
      "step": 0.1,
      "group": "Dimensiones"
    },
    {
      "key": "depth",
      "label": "Profundidad Total (m)",
      "type": "float",
      "default": 0.95,
      "min": 0.7,
      "max": 1.3,
      "step": 0.05,
      "group": "Dimensiones"
    },
    {
      "key": "height",
      "label": "Altura del Tablero (m)",
      "type": "float",
      "default": 1.15,
      "min": 0.9,
      "max": 1.4,
      "step": 0.05,
      "group": "Dimensiones"
    },
    {
      "key": "screen_count",
      "label": "Número de Pantallas",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 4,
      "step": 1,
      "group": "Componentes"
    },
    {
      "key": "has_joystick",
      "label": "Palanca de Actitud Joystick",
      "type": "bool",
      "default": true,
      "group": "Mandos"
    },
    {
      "key": "has_throttle",
      "label": "Palanca de Empuje Throttle",
      "type": "bool",
      "default": true,
      "group": "Mandos"
    },
    {
      "key": "console_state",
      "label": "Estado de Telemetría",
      "type": "select",
      "default": "active",
      "options": ["active", "standby", "signal_lost", "offline"],
      "group": "Lógica"
    }
  ],
  "presets": [
    {
      "id": "bridge_nominal",
      "label": "Puente de Mando Nominal",
      "description": "Consola de navegación con 3 monitores en verde fósforo, joystick y acelerador HOTAS operativos.",
      "values": {
        "width": 1.4,
        "depth": 0.95,
        "height": 1.15,
        "screen_count": 3,
        "has_joystick": true,
        "has_throttle": true,
        "console_state": "active"
      }
    },
    {
      "id": "unstable_telemetry",
      "label": "Pérdida de Telemetría",
      "description": "Pantallas en alarma ámbar/rojo con ruido estático y alertas de desvío orbital.",
      "values": {
        "width": 1.5,
        "depth": 1.0,
        "height": 1.2,
        "screen_count": 3,
        "has_joystick": true,
        "has_throttle": true,
        "console_state": "signal_lost"
      }
    },
    {
      "id": "derelict_offline",
      "label": "Puesto Abandonado",
      "description": "Consola apagada, mandos trabados y chasis con polvo y rozaduras de despresurización.",
      "values": {
        "width": 1.3,
        "depth": 0.9,
        "height": 1.1,
        "screen_count": 2,
        "has_joystick": false,
        "has_throttle": true,
        "console_state": "offline"
      }
    }
  ],
  "export_capabilities": {
    "supports_collision": true,
    "default_collision_suffix": "-convcolonly"
  }
}
