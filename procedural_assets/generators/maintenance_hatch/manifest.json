{
  "id": "below_nominal.architecture.maintenance_hatch",
  "name": "Escotilla de Mantenimiento Estanca",
  "version": "1.0.0",
  "description": "Compuerta estanca de acceso técnico para pozos de servicio, conductos de climatización y túneles de cables en mamparos de la estación Europa. Incorpora cerco perimetral con brida de atornillado reforzada, bisagras de palastro macizo, volante central de apriete con mecanismo de trinchas excéntricas, junta tórica de neopreno perimetral e indicador luminoso de presurización.",
  "author": {
    "name": "ModelCoder Core Team",
    "github": "FrancisCuarto"
  },
  "license": "CC-BY-4.0",
  "category": "architecture",
