{
  "$schema": "https://raw.githubusercontent.com/usuario/modelcoder-community/main/schemas/generator-v1.json",
  "id": "below_nominal.furniture.locker_bench",
  "version": "1.0.0",
  "name": "Locker Bench",
  "description": "Generador procedural paramétrico de locker bench para Below Nominal.",
  "author": {
    "name": "Below Nominal Team",
    "github": "below-nominal",
    "url": "https://belownominal.com"
  },
  "license": "CC-BY-4.0",
  "category": "furniture",
  "tags": [
