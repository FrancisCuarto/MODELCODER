        {
          "value": "industrial_hazard",
          "label": "Industrial Hazard"
        },
        {
          "value": "medbay_clean",
          "label": "Medbay Clean"
        },
        {
          "value": "command_bridge",
          "label": "Command Bridge"
        },
        {
          "value": "habitation_worn",
          "label": "Habitation Worn"
        },
        {
          "value": "derelict_decay",
          "label": "Derelict Decay"
        }
      ]
    },
    {
      "key": "emission_scale",
      "label": "Emission Scale",
      "type": "float",
      "default": 1.0,
      "group": "General",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "extra_params",
      "label": "Extra Params",
      "type": "string",
      "default": null,
      "group": "General"
    },
    {
      "key": "bench_type",
      "label": "Bench Type",
      "type": "string",
      "default": "perforated_metal",
      "group": "General"
    },
    {
      "key": "length",
      "label": "Length",
      "type": "float",
      "default": 1.6,
      "group": "Dimensiones",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "width",
      "label": "Width",
      "type": "float",
      "default": 0.45,
      "group": "Dimensiones",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "height",
      "label": "Height",
      "type": "float",
      "default": 0.48,
      "group": "Dimensiones",
      "min": 0.0,
      "step": 0.05
    },
    {
      "key": "has_shoe_shelf",
      "label": "Has Shoe Shelf",
      "type": "boolean",
      "default": true,
      "group": "General"
    },
    {
      "key": "leg_style",
      "label": "Leg Style",
      "type": "string",
      "default": "tubular_flanged",
      "group": "General"
    },
    {
      "key": "has_forgotten_gear",
      "label": "Has Forgotten Gear",
      "type": "boolean",
      "default": true,
      "group": "General"
    }
